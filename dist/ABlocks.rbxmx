-- Names people give things in Roblox often enough that guessing is a help
-- rather than a hazard.  Only consulted when the document says nothing.
local CONVENTIONS = {
		part = "Part", brick = "Part", block = "Part", door = "Part", coin = "Part",
		hum = "Humanoid", humanoid = "Humanoid",
		char = "Model", character = "Model", model = "Model", rig = "Model",
		player = "Player", plr = "Player", localPlayer = "Player",
		gui = "ScreenGui", label = "TextLabel", button = "TextButton",
		sound = "Sound", camera = "Camera", cam = "Camera", tool = "Tool",
		prompt = "ProximityPrompt", detector = "ClickDetector",
}

--=============================================================================
-- member lookup
--=============================================================================

local memberCache = {}

local function classEntry(name)
		return CLASSES[name] or SERVICES[name]
end

-- Every member of a class, walking up the inheritance chain.
function i.membersOf(className)
		if memberCache[className] then return memberCache[className] end
		local list = {}
		local seen = {}
		local current = className
		local guard = 0
		while current and guard < 12 do
			guard = guard + 1
			local entry = classEntry(current)
			if not entry then break end
			local gathered = {}
			members("property", entry.p, gathered)
			members("method", entry.m, gathered)
			members("event", entry.e, gathered)
			for _, member in ipairs(gathered) do
				if not seen[member.name] then
					seen[member.name] = true
					member.owner = current
					list[#list + 1] = member
				end
			end
			current = entry.extends
		end
		memberCache[className] = list
		return list
end

function i.libraryMembers(name)
		local entry = LIBS[name]
		if not entry then return nil end
		local key = "lib:" .. name
		if memberCache[key] then return memberCache[key] end
		local list = members("method", entry.m, {})
		for _, member in ipairs(list) do member.owner = name end
		memberCache[key] = list
		return list
end

function i.classNames()
		local list = {}
		for name in pairs(CLASSES) do list[#list + 1] = name end
		table.sort(list)
		return list
end

function i.serviceNames()
		local list = {}
		for name in pairs(SERVICES) do list[#list + 1] = name end
		table.sort(list)
		return list
end

function i.enumNames()
		local list = {}
		for name in pairs(ENUMS) do list[#list + 1] = name end
		table.sort(list)
		return list
end

function i.enumItems(family)
		local list = {}
		for item in string.gmatch(ENUMS[family] or "", "[^;]+") do
			list[#list + 1] = item
		end
		return list
end

-- Property names across every class, for fields that want a property name.
function i.propertyNames()
		if memberCache["*props"] then return memberCache["*props"] end
		local seen, list = {}, {}
		for className in pairs(CLASSES) do
			for _, member in ipairs(i.membersOf(className)) do
				if member.kind == "property" and not seen[member.name] then
					seen[member.name] = true
					list[#list + 1] = member
				end
			end
		end
		table.sort(list, function(a, b) return a.name < b.name end)
		memberCache["*props"] = list
		return list
end

--=============================================================================
-- fuzzy matching
--
-- Subsequence matching with the bonuses people expect: a prefix beats a hit in
-- the middle, and matching the capitals of a name ("ffc" -> FindFirstChild)
-- beats matching letters scattered through it.
--=============================================================================

local function isUpper(ch) return ch >= "A" and ch <= "Z" end
local function isWordChar(ch)
		return ch ~= "" and (ch == "_" or string.match(ch, "%w") ~= nil)
end

function i.score(query, candidate)
		if query == "" then return 1 end
		if #query > #candidate then return nil end

		local lowerQuery = string.lower(query)
		local lowerCandidate = string.lower(candidate)

		local total = 0
		local at = 1
		local lastHit = 0
		local firstHit = nil

		for index = 1, #lowerQuery do
			local wanted = string.sub(lowerQuery, index, index)
			local found = string.find(lowerCandidate, wanted, at, true)
			if not found then return nil end
			firstHit = firstHit or found

			local bonus = 0
			if found == lastHit + 1 then bonus = bonus + 8 end
			local before = string.sub(candidate, found - 1, found - 1)
			if found == 1 then
				bonus = bonus + 14
			elseif isUpper(string.sub(candidate, found, found)) then
				bonus = bonus + 10
			elseif not isWordChar(before) then
				bonus = bonus + 8
			end
			if string.sub(candidate, found, found) == string.sub(query, index, index) then
				bonus = bonus + 2
			end

			total = total + 6 + bonus
			lastHit = found
			at = found + 1
		end

		-- prefer short names and matches that start early
		total = total - math.min((firstHit or 1) - 1, 12)
		total = total - math.min(math.floor((#candidate - #query) / 2), 14)
		if lowerCandidate == lowerQuery then total = total + 40 end
		if string.sub(lowerCandidate, 1, #lowerQuery) == lowerQuery then total = total + 22 end
		return total
end

local KIND_RANK = {
		variable = 1, ["function"] = 1, parameter = 1, service = 2, property = 3,
		method = 3, event = 3, snippet = 4, library = 5, global = 5, class = 5,
		enum = 6, keyword = 8,
}

local function sortItems(items)
		table.sort(items, function(a, b)
			if a.score ~= b.score then return a.score > b.score end
			local ra = KIND_RANK[a.kind] or 9
			local rb = KIND_RANK[b.kind] or 9
			if ra ~= rb then return ra < rb end
			return a.name < b.name
		end)
end

--=============================================================================
-- type resolution
--=============================================================================

local function normaliseType(text)
		if not text then return nil end
		local name = string.match(text, "^([%a_][%w_]*)")
		if not name then return nil end
		if classEntry(name) then return name end
		return nil
end

local function findMember(className, memberName)
		for _, member in ipairs(i.membersOf(className)) do
			if member.name == memberName then return member end
		end
		return nil
end

-- What is `path` -- "Player", "Workspace", a library name, or nil?
-- `doc` may be nil; when given, names the document declares are consulted.
function i.resolveType(doc, path, depth)
		depth = (depth or 0) + 1
		if not path or path == "" or depth > 8 then return nil end

		local head, name = string.match(path, "^(.*)%.([%a_][%w_]*)$")
		if head and head ~= "" then
			local ownerType = i.resolveType(doc, head, depth)
			if ownerType == "game" then
				if SERVICES[name] then return name end
				return nil
			end
			if ownerType then
				local member = findMember(ownerType, name)
				if member and member.kind == "property" then
					return normaliseType(member.detail)
				end
			end
			-- `something.Parent` is always an Instance of some sort
			if name == "Parent" then return "Instance" end
			if name == "Character" then return "Model" end
			if name == "LocalPlayer" then return "Player" end
			if name == "Humanoid" then return "Humanoid" end
			return nil
		end

		if path == "game" then return "game" end
		if path == "workspace" or path == "Workspace" then return "Workspace" end
		if path == "script" then return "Instance" end
		if SERVICES[path] then return path end
		if CLASSES[path] then return path end
		if LIBS[path] then return "lib:" .. path end
		if path == "Enum" then return "enum" end

		if doc then
			for _, symbol in ipairs(d.symbols(doc)) do
				if symbol.name == path then
					if symbol.detail and classEntry(symbol.detail) then return symbol.detail end
					if symbol.kind == "service" then return symbol.name end
					break
				end
			end
		end

		return CONVENTIONS[path]
end

--=============================================================================
-- context detection
--=============================================================================

-- Is the caret inside a string literal, and if so where did it open?
local function stringContext(prefix)
		local quote, openedAt = nil, nil
		local index = 1
		while index <= #prefix do
			local ch = string.sub(prefix, index, index)
			if quote then
				if ch == "\\" then
					index = index + 1
				elseif ch == quote then
					quote, openedAt = nil, nil
				end
			elseif ch == '"' or ch == "'" then
				quote, openedAt = ch, index
			end
			index = index + 1
		end
		if quote then return openedAt end
		return nil
end

local STRING_HINTS = {
		{ pattern = "Instance%.new%($", hint = "class" },
		{ pattern = "GetService%($", hint = "service" },
		{ pattern = ":IsA%($", hint = "class" },
		{ pattern = "FindFirstChildOfClass%($", hint = "class" },
		{ pattern = "FindFirstChildWhichIsA%($", hint = "class" },
		{ pattern = "GetPropertyChangedSignal%($", hint = "prop" },
}

-- Works out what the caret is asking for.
function i.contextAt(text, cursor)
		local prefix = string.sub(text, 1, cursor - 1)

		local quoteAt = stringContext(prefix)
		if quoteAt then
			local before = string.sub(prefix, 1, quoteAt - 1)
			local hint = nil
			for _, rule in ipairs(STRING_HINTS) do
				if string.find(before, rule.pattern) then
					hint = rule.hint
					break
				end
			end
			return {
				kind = "string",
				query = string.sub(prefix, quoteAt + 1),
				from = quoteAt + 1,
				hint = hint,
			}
		end

		local word = string.match(prefix, "[%a_][%w_]*$") or ""
		local wordStart = #prefix - #word + 1
		local accessor = string.sub(prefix, wordStart - 1, wordStart - 1)

		if accessor == "." or accessor == ":" then
			local basePart = string.sub(prefix, 1, wordStart - 2)
			local base = string.match(basePart, "[%a_][%w_%.]*$")
			return {
				kind = "member",
				query = word,
				from = wordStart,
				base = base,
				accessor = accessor,
				unresolved = base == nil,
			}
		end

		return { kind = "word", query = word, from = wordStart }
end

--=============================================================================
-- candidate building
--=============================================================================

local function push(items, entry, query)
		local score = i.score(query, entry.name)
		if not score then return end
		entry.score = score
		items[#items + 1] = entry
end

local function memberInsert(member, accessor)
		if member.kind == "method" then
			local args = member.detail and string.match(member.detail, "^%((.*)%)") or ""
			if args == "" or string.match(member.detail or "", "^%(%)") then
				return member.name .. "()", nil
			end
			return member.name .. "()", #member.name + 1
		end
		return member.name, nil
end

local function addMembers(items, query, className, accessor)
		for _, member in ipairs(i.membersOf(className)) do
			local wanted = accessor ~= ":" or member.kind ~= "property"
			if wanted then
				local insert, caret = memberInsert(member, accessor)
				push(items, {
					name = member.name, kind = member.kind, detail = member.detail,
					doc = member.doc, owner = member.owner, insert = insert, caret = caret,
				}, query)
			end
		end
end

local function addLibrary(items, query, libName)
		for _, member in ipairs(i.libraryMembers(libName) or {}) do
			local isValue = member.detail and not string.match(member.detail, "^%(")
			push(items, {
				name = member.name,
				kind = isValue and "property" or "method",
				detail = member.detail, doc = member.doc, owner = libName,
				insert = isValue and member.name or (member.name .. "()"),
				caret = (not isValue) and (#member.name + 1) or nil,
			}, query)
		end
end

local function addGlobals(items, query)
		for _, line in ipairs(GLOBALS) do
			local name, detail, doc = string.match(line, "^([^|]*)|([^|]*)|(.*)$")
			local kind = "global"
			if detail == "library" then kind = "library" end
			if detail == "enum" then kind = "enum" end
			local insert = name
			local caret = nil
			if string.sub(detail, 1, 1) == "(" and detail ~= "(...)" then
				insert = name .. "()"
				caret = #name + 1
			elseif detail == "(...)" then
				insert = name .. "()"
				caret = #name + 1
			end
			push(items, {
				name = name, kind = kind, detail = detail, doc = doc,
				insert = insert, caret = caret,
			}, query)
		end
end

local function addDocSymbols(items, query, doc)
		if not doc then return end
		for _, symbol in ipairs(d.symbols(doc)) do
			push(items, {
				name = symbol.name, kind = symbol.kind,
				detail = symbol.detail or "from your blocks",
				doc = symbol.kind == "service" and "A service your blocks already opened."
					or "Declared by a block in this project.",
				insert = symbol.name,
			}, query)
		end
end

-- Blocks you made yourself that carry no slots become a real `local function`
-- in the generated script, so their names are worth completing: this is how
-- you call one of your own blocks from inside a field.
local function addCustomHelpers(items, query)
		for _, custom in ipairs(q.list()) do
			if q.isHelper(custom) and custom.fn then
				local names = {}
				for _, field in ipairs(custom.fields) do names[#names + 1] = field.key end
				local signature = custom.fn .. "(" .. table.concat(names, ", ") .. ")"
				push(items, {
					name = custom.fn,
					kind = "function",
					detail = signature,
					doc = "Your block \"" .. custom.label .. "\". It is written into " ..
						"the script as a function the first time you use it.",
					insert = custom.fn .. "(",
				}, query)
			end
		end
end

--=============================================================================
-- entry point
--=============================================================================

-- request = { text, cursor, doc, field }
--   field.kind / field.hint steer the list for non-expression fields.
-- Returns { items, from, kind, base } -- replace text[from .. cursor-1] with
-- the chosen item's `insert`.
function i.complete(request)
		local text = request.text or ""
		local cursor = math.clamp(request.cursor or (#text + 1), 1, #text + 1)
		local field = request.field or {}
		local doc = request.doc
		local items = {}

		-- Fields that are not Luau expressions have their own short lists.
		if field.kind == "choice" then
			for _, option in ipairs(field.options or {}) do
				push(items, { name = option, kind = "choice", insert = option }, text)
			end
			sortItems(items)
			return { items = items, from = 1, kind = "choice" }
		end

		if field.kind ~= "expr" and field.kind ~= "multiline" then
			local hint = field.hint
			if hint == "class" then
				for _, name in ipairs(i.classNames()) do
					push(items, { name = name, kind = "class", insert = name,
						doc = "A Roblox class." }, text)
				end
			elseif hint == "service" then
				for _, name in ipairs(i.serviceNames()) do
					push(items, { name = name, kind = "service", insert = name,
						doc = "A Roblox service." }, text)
				end
			elseif hint == "prop" then
				for _, member in ipairs(i.propertyNames()) do
					push(items, { name = member.name, kind = "property",
						detail = member.detail, doc = member.doc, owner = member.owner,
						insert = member.name }, text)
				end
			elseif hint == "keycode" then
				for _, item in ipairs(i.enumItems("KeyCode")) do
					push(items, { name = item, kind = "enum", insert = item }, text)
				end
			elseif hint == "type" then
				for _, name in ipairs({ "number", "string", "boolean", "any", "Instance",
					"BasePart", "Player", "Humanoid", "Vector3", "CFrame", "Color3",
					"{ number }", "{ string }", "{ [string]: any }" }) do
					push(items, { name = name, kind = "class", insert = name }, text)
				end
			end
			if #items == 0 then return { items = {}, from = 1, kind = "none" } end
			sortItems(items)
			return { items = items, from = 1, kind = "field" }
		end

		local context = i.contextAt(text, cursor)

		if context.kind == "string" then
			if context.hint == "class" then
				for _, name in ipairs(i.classNames()) do
					push(items, { name = name, kind = "class", insert = name }, context.query)
				end
			elseif context.hint == "service" then
				for _, name in ipairs(i.serviceNames()) do
					push(items, { name = name, kind = "service", insert = name }, context.query)
				end
			elseif context.hint == "prop" then
				for _, member in ipairs(i.propertyNames()) do
					push(items, { name = member.name, kind = "property",
						detail = member.detail, doc = member.doc, insert = member.name },
						context.query)
				end
			end
			sortItems(items)
			return { items = items, from = context.from, kind = "string" }
		end

		if context.kind == "member" then
			local resolved = context.base and i.resolveType(doc, context.base) or nil

			if resolved == "enum" then
				for _, name in ipairs(i.enumNames()) do
					push(items, { name = name, kind = "enum", insert = name,
						doc = "A fixed list Roblox understands." }, context.query)
				end
			elseif context.base and string.match(context.base, "^Enum%.([%a_][%w_]*)$") then
				local family = string.match(context.base, "^Enum%.([%a_][%w_]*)$")
				for _, item in ipairs(i.enumItems(family)) do
					push(items, { name = item, kind = "enum", insert = item,
						detail = "Enum." .. family }, context.query)
				end
			elseif resolved == "game" then
				for _, name in ipairs(i.serviceNames()) do
					push(items, { name = name, kind = "service", insert = name,
						doc = "Reachable from game, though GetService is safer." },
						context.query)
				end
				push(items, { name = "GetService", kind = "method", detail = "(name): Instance",
					doc = "The reliable way to reach a service.",
					insert = "GetService()", caret = 11 }, context.query)
			elseif resolved and string.sub(resolved, 1, 4) == "lib:" then
				addLibrary(items, context.query, string.sub(resolved, 5))
			elseif resolved then
				addMembers(items, context.query, resolved, context.accessor)
			else
				-- Unknown base: Instance members are the safest guess in Roblox code.
				addMembers(items, context.query, "Instance", context.accessor)
			end

			sortItems(items)
			return {
				items = items, from = context.from, kind = "member",
				base = context.base, resolved = resolved,
				accessor = context.accessor,
			}
		end

		addDocSymbols(items, context.query, doc)
		addCustomHelpers(items, context.query)
		addGlobals(items, context.query)
		for _, snippet in ipairs(SNIPPETS) do
			push(items, {
				name = snippet.name, kind = "snippet", detail = snippet.detail,
				doc = snippet.doc, insert = snippet.insert,
			}, context.query)
		end
		if #context.query > 0 then
			for _, word in ipairs(KEYWORDS) do
				push(items, { name = word, kind = "keyword", insert = word }, context.query)
			end
		end

		sortItems(items)
		return { items = items, from = context.from, kind = "word" }
end

--=============================================================================
-- signature help
--=============================================================================

-- Which call is the caret inside, and which argument is it on?
function i.signature(text, cursor, doc)
		local prefix = string.sub(text, 1, (cursor or (#text + 1)) - 1)
		local depth = 0
		local index = #prefix
		local commas = 0
		while index > 0 do
			local ch = string.sub(prefix, index, index)
			if ch == ")" or ch == "}" or ch == "]" then
				depth = depth + 1
			elseif ch == "(" then
				if depth == 0 then break end
				depth = depth - 1
			elseif ch == "{" or ch == "[" then
				if depth > 0 then depth = depth - 1 end
			elseif ch == "," and depth == 0 then
				commas = commas + 1
			end
			index = index - 1
		end
		if index <= 0 then return nil end

		local callee = string.match(string.sub(prefix, 1, index - 1), "([%a_][%w_%.:]*)$")
		if not callee then return nil end

		local head, sep, name = string.match(callee, "^(.*)([%.:])([%a_][%w_]*)$")
		local member = nil
		if head then
			local resolved = i.resolveType(doc, head)
			if resolved and string.sub(resolved, 1, 4) == "lib:" then
				for _, entry in ipairs(i.libraryMembers(string.sub(resolved, 5)) or {}) do
					if entry.name == name then member = entry end
				end
			elseif resolved and resolved ~= "game" and resolved ~= "enum" then
				member = findMember(resolved, name)
			end
		else
			for _, line in ipairs(GLOBALS) do
				local globalName, detail, docText = string.match(line, "^([^|]*)|([^|]*)|(.*)$")
				if globalName == callee and string.sub(detail, 1, 1) == "(" then
					member = { name = globalName, detail = detail, doc = docText }
				end
			end
		end

		if not member or not member.detail then return nil end
		return {
			label = member.name .. member.detail,
			doc = member.doc,
			argument = commas + 1,
		}
end

return i
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX10">
			<Properties>
				<string name="Name">j</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- j  ·  tutorial content
--
-- Thirty-two lessons: one for each of the ten teaching categories, five more
-- for the bigger systems people reach for next, and seventeen on the craft of
-- using the editor and of writing Roblox code that behaves.
--
-- A step is a small tagged table, rendered by `k`:
--   { p = "..." }        a paragraph
--   { h = "..." }        a sub-heading
--   { code = "..." }     Luau, syntax highlighted
--   { blocks = "a,b" }   the blocks this lesson uses, as chips
--   { note = "..." }     an aside worth knowing
--   { warn = "..." }     a mistake worth avoiding
--   { list = { ... } }   a numbered run of short lines
--   { try = "..." }      something to go and do
--
-- `example` is real Luau.  The lesson's "put this on my canvas" button runs it
-- through the importer, so every example is also a test of the converter.

local j = {}

j.tutorials = {}

local function T(entry)
		j.tutorials[#j.tutorials + 1] = entry
		return entry
end

--=============================================================================
-- category lessons
--=============================================================================

T{
		id = "cat-events", kind = "category", cat = "events", minutes = 5,
		level = "start",
		title = "Events: code that waits",
		blurb = "Nothing in a Roblox game runs because you asked nicely. Something has to happen first.",
		steps = {
			{ p = "A script that runs top to bottom and stops is not much of a game. Roblox games are built out of moments: a player joins, a part is touched, a key goes down, a frame is drawn. An event block is how you say 'when that moment comes, run these blocks'." },
			{ h = "The shape of an event" },
			{ p = "Every event block is a container. The blocks you drop inside it do not run when the script starts -- they sit there, waiting, and run each time the event fires. That is why the inside of an event block is indented: it belongs to the event, not to the script." },
			{ blocks = "onTouch,onPlayerAdded,onHeartbeat,onKey" },
			{ p = "Drag `when {part} is touched by {hit}` onto the canvas, put a `print` inside it, and look at the Luau panel:" },
			{ code = 'script.Parent.Touched:Connect(function(hit)\n\tprint(hit)\nend)' },
			{ p = "`Connect` is the important word. You are handing Roblox a function and asking it to hold on to it. Roblox calls it back later, once per touch, and hands you information about what happened -- here, the part that did the touching." },
			{ h = "The value the event gives you" },
			{ p = "That `hit` is a gift. A Touched event without it would only tell you that something happened; with it you can ask what happened. `hit.Parent` is usually the character model, which is how you get from 'a part was touched' to 'a player stepped on it'." },
			{ code = 'script.Parent.Touched:Connect(function(hit)\n\tlocal hum = hit.Parent:FindFirstChildOfClass("Humanoid")\n\tif hum then\n\t\thum:TakeDamage(10)\n\tend\nend)' },
			{ note = "Touched fires a lot -- once per limb, several times a second, for one player standing on a part. Every event block that fires often deserves a check inside it that gets out early." },
			{ h = "Events fire more than once" },
			{ p = "This surprises everyone at least once. `CharacterAdded` fires on every respawn, not just the first spawn. `Touched` fires again the moment a foot wobbles. If your code must only happen once, you have to say so -- with a variable that remembers, or with the `the first time ... happens` block, which disconnects itself after one fire." },
			{ warn = "If you connect an event inside another event, you create a new connection every time the outer one fires. Connect a Touched handler inside PlayerAdded for a hundred players and you have a hundred handlers on the same part." },
			{ try = "Build a part that damages a player once, waits three seconds, then can damage again. You will need an event block, a variable, and an if block." },
		},
		example = [[
local Players = game:GetService("Players")

local trap = script.Parent
local armed = true

trap.Touched:Connect(function(hit)
		if not armed then return end
		local hum = hit.Parent:FindFirstChildOfClass("Humanoid")
		if hum then
			armed = false
			hum:TakeDamage(25)
			task.wait(3)
			armed = true
		end
end)

Players.PlayerAdded:Connect(function(player)
		print(player.Name)
end)
]],
}

T{
		id = "cat-control", kind = "category", cat = "control", minutes = 5,
		level = "start",
		title = "Control: choosing and repeating",
		blurb = "Two ideas -- do this only sometimes, and do this again -- cover most of what a program does.",
		steps = {
			{ p = "Control blocks decide which of your other blocks run, and how often. There are only a handful of them and you will use them constantly." },
			{ h = "Choosing" },
			{ p = "`if` runs the blocks inside only when its condition is true. `if / else` adds a second path that runs when it is not. Dropping another `if / else` into the `otherwise` slot builds a chain -- and the code panel writes that back as `elseif`, so a five-way choice stays flat instead of marching off the right of the screen." },
			{ blocks = "if,ifelse,while,for,foripairs,wait" },
			{ h = "Repeating" },
			{ p = "There are four ways to repeat, and picking the right one makes the rest of the code easier." },
			{ list = {
				"`count {i} from {a} to {b}` -- when you know how many times, and you want the number.",
				"`repeat {n} times` -- when you know how many times and do not care about the number.",
				"`for each item` -- when you have a list and want each thing in it.",
				"`keep going while {condition}` -- when you do not know how many times, only when to stop.",
			} },
			{ code = 'for i = 1, 10 do\n\tprint(i)\nend\n\nfor _, part in ipairs(workspace:GetChildren()) do\n\tprint(part.Name)\nend' },
			{ h = "The one rule about while" },
			{ p = "A `while` loop with no wait inside it never gives the rest of the game a turn. Roblox will freeze, and after a few seconds Studio will stop the script and tell you it was not responding. Put a `wait` block inside every `while` loop unless you can prove it finishes quickly." },
			{ warn = "`while true do ... end` with no wait is the single most common way to lock up a place. If your test freezes the moment you press Play, this is why." },
			{ h = "Stopping early" },
			{ p = "`stop the loop` leaves the loop it is inside straight away. `skip to the next turn` abandons this pass and starts the next one. Both only make sense inside a loop, and the editor will let you put them elsewhere -- Luau will not." },
			{ try = "Count down from 5 to 1 with a one-second wait between each, then print 'go'. Use `count by step` with a step of -1." },
		},
		example = [[
for i = 5, 1, -1 do
		print(i)
		task.wait(1)
end

print("go")

local coins = { "gold", "silver", "bronze" }

for index, coin in ipairs(coins) do
		print(index, coin)
end

local hunting = true

while hunting do
		task.wait(0.5)
		if #coins == 0 then
			hunting = false
		end
end
]],
}

T{
		id = "cat-logic", kind = "category", cat = "logic", minutes = 4,
		level = "start",
		title = "Logic: true or false",
		blurb = "Every branch in your game comes down to one question with a yes-or-no answer.",
		steps = {
			{ p = "A condition is any expression that comes out true or false. Logic blocks are the questions worth asking, written the way you would say them out loud." },
			{ blocks = "ifCompare,ifBoth,ifEither,ifNot,ifExists,guard,ifIsA" },
			{ h = "Comparing" },
			{ p = "The `if {a} {op} {b}` block covers all six comparisons in one block -- pick the operator from the dropdown. `==` asks whether two things are the same. `~=` asks whether they differ, and that squiggle catches everyone once; in Luau it is `~=`, not `!=`." },
			{ warn = "`=` and `==` are different. One `=` sets a value; two `==` compares. `if hp = 0` is not a question, it is a mistake, and Luau will refuse it." },
			{ h = "Combining" },
			{ p = "`and` needs both sides to be true. `or` needs at least one. Both are lazy: if the left side of an `and` is false, Luau never looks at the right side. That is not a detail, it is a tool -- it is what makes this safe:" },
			{ code = 'if hum and hum.Health > 0 then\n\tprint("alive")\nend' },
			{ p = "If `hum` is nil, the check stops there and never touches `.Health`, which would have thrown an error. Written the other way round it would crash." },
			{ h = "Truthiness" },
			{ p = "In Luau only two values are false: `false` and `nil`. Everything else is true -- including 0 and the empty string, which trip up people arriving from other languages. That is why `if {value} exists` is the standard way to check whether an object was found." },
			{ h = "Guards" },
			{ p = "`stop here unless {condition}` puts the check at the top and leaves early when it fails. Three guards at the top of a function are much easier to read than three nested ifs, because the real work stays at the left margin." },
			{ code = 'local function damage(player, amount)\n\tif not player then return end\n\tlocal char = player.Character\n\tif not char then return end\n\tlocal hum = char:FindFirstChildOfClass("Humanoid")\n\tif not hum then return end\n\thum:TakeDamage(amount)\nend' },
			{ try = "Take a deeply nested if from something you have written and turn the outer layers into guards. Count the indentation you got back." },
		},
		example = [[
local function damage(player, amount)
		if not player then return end
		local char = player.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		hum:TakeDamage(amount)
end

local hp = 100

if hp <= 0 then
		print("dead")
elseif hp < 25 then
		print("hurt")
else
		print("fine")
end
]],
}

T{
		id = "cat-math", kind = "category", cat = "math", minutes = 5,
		level = "build",
		title = "Math: numbers that move things",
		blurb = "Scores, speeds, positions, chances. Six or seven blocks cover nearly all of it.",
		steps = {
			{ p = "Most game maths is small: add some, keep it in range, pick a random one, measure how far apart two things are. The blocks are named after what you are trying to do rather than after the function they call." },
			{ blocks = "changeBy,mathOp,clamp,randomInt,lerp,distance,roundTo" },
			{ h = "Changing a number you already have" },
			{ p = "`change {var} by {n}` is the workhorse. It writes `score += 10`, which is Luau shorthand for `score = score + 10`. A negative amount subtracts, so one block covers both directions." },
			{ h = "Keeping a number sensible" },
			{ p = "`clamp` pins a value inside a range. It is the cure for health bars that creep past 100 and for cameras that end up under the floor." },
			{ code = 'hum.Health = math.clamp(hum.Health + 25, 0, hum.MaxHealth)' },
			{ h = "Randomness" },
			{ p = "`math.random(1, 6)` really is a dice roll -- both ends can come up. For smooth values, like a wait time or a speed, use the decimal version instead. Roll once and keep the result in a variable if you need to use it twice; rolling twice gives two different numbers." },
			{ h = "Blending" },
			{ p = "`blend` is the one people skip and then wish they had not. It gives you a value part way between two others: 0 gives the first, 1 gives the second, 0.35 gives just over a third of the way. Every smooth camera, health bar and colour fade is built on it." },
			{ code = 'local shown = shown + (target - shown) * 0.15' },
			{ p = "Run that every frame and `shown` chases `target` -- fast at first, slower as it arrives. Fifteen percent of the remaining distance, every frame." },
			{ h = "Measuring" },
			{ p = "Subtracting two positions gives the arrow between them, and `.Magnitude` is its length in studs. That is how you check whether a player is near enough to open a door." },
			{ code = 'local distance = (player.Character.PrimaryPart.Position - door.Position).Magnitude\n\nif distance < 10 then\n\tprint("close enough")\nend' },
			{ note = "Studs are Roblox's unit of length. A default character is about 5 studs tall, so 10 studs is roughly two body heights." },
			{ try = "Make a part that changes colour depending on how close the player is, using distance and blend together." },
		},
		example = [[
local score = 0

score += 10
score = math.clamp(score, 0, 999)

local roll = math.random(1, 6)

if roll >= 5 then
		score += 50
end

local shown = 0
local target = 100

shown = shown + (target - shown) * 0.15

print(score, roll, math.round(shown))
]],
}

T{
		id = "cat-text", kind = "category", cat = "text", minutes = 4,
		level = "build",
		title = "Text: words and strings",
		blurb = "Labels, messages, names, and the small art of gluing them together.",
		steps = {
			{ p = "A string is a run of characters in quotes. You will build them, cut them up, and search them -- mostly to put words on a screen." },
			{ blocks = "printText,joinText,formatText,containsText,splitText,toText" },
			{ h = "Joining" },
			{ p = "`..` glues two strings together. Numbers join fine on their own; anything else needs `tostring` first, which is what the `value to text` block is for." },
			{ code = 'print("Score: " .. score)' },
			{ h = "Formatting" },
			{ p = "Once you are joining three or four things, `string.format` reads better than a chain of dots. `%d` takes a whole number, `%s` a string, and `%.1f` a decimal rounded to one place." },
			{ code = 'local line = string.format("%s has %d coins (%.1f%% of the record)", player.Name, coins, share)' },
			{ note = "`%%` is how you write a literal percent sign inside a format string. A single `%` would be read as the start of another slot." },
			{ h = "Searching" },
			{ p = "`if {text} contains \"{word}\"` writes `string.find` with `plain` switched on. That last argument matters: without it, characters like `.` `-` `(` are read as pattern syntax rather than as themselves, and searching for \"3.5\" would also match \"345\"." },
			{ h = "Cutting up" },
			{ p = "`split` turns one string into a list of pieces, which is how you read comma-separated data. `part of text` takes a slice: counting starts at 1, and -1 means 'the last character'." },
			{ code = 'local parts = string.split("red,green,blue", ",")\nprint(parts[2])\n\nlocal last = string.sub(name, -1, -1)' },
			{ warn = "Text is compared exactly. \"Hello\" and \"hello\" are different strings. Put both sides through `in lower` before comparing player input." },
			{ try = "Take a player's name and print it back with the first letter alone: `string.sub(name, 1, 1)`." },
		},
		example = [[
local player = game.Players.LocalPlayer
local coins = 42

local line = string.format("%s has %d coins", player.Name, coins)

print(line)

local tags = string.split("fast,red,rare", ",")

for _, tag in ipairs(tags) do
		if string.find(tag, "red", 1, true) then
			print("found the colour tag")
		end
end
]],
}

T{
		id = "cat-vars", kind = "category", cat = "vars", minutes = 4,
		level = "start",
		title = "Variables: naming things",
		blurb = "A variable is a name you give a value so you can talk about it later.",
		steps = {
			{ p = "`make {name} = {value}` creates a name. `set {name} to {value}` changes one that already exists. Using `make` twice on the same name does not change the first one -- it creates a second, separate name that happens to look the same, and one of them will not be the one you meant." },
			{ blocks = "local,set,svc,scriptParent,setAttr,getAttr" },
			{ h = "Where a name lives" },
			{ p = "A name made inside a block only exists inside that block. Make it inside an `if` and it is gone at the `end`. This is called scope, and it is a feature: it stops the top of your script filling up with names that only mattered for three lines." },
			{ code = 'local total = 0\n\nfor i = 1, 10 do\n\tlocal double = i * 2\n\ttotal += double\nend\n\nprint(total)' },
			{ p = "`total` outlives the loop because it was made outside it. `double` does not. Move the `make` block inside or outside a loop and you change which of those two things you get." },
			{ h = "Services" },
			{ p = "`use the {name} service` writes `local Players = game:GetService(\"Players\")`. Services are the parts of Roblox that are not objects in your place -- the player list, the frame clock, the tween engine. Put these at the very top of the canvas, in their own stack." },
			{ note = "The code panel hoists services for you: if a block needs Players and you never added the service block, one appears at the top of the generated script anyway. Adding it yourself just means you can see it." },
			{ h = "Attributes" },
			{ p = "An attribute is a value stored on an object rather than in a script. Set `Speed` on a part and every script can read it, you can edit it in the Properties window while the game runs, and it survives being cloned. For anything a designer might want to tune, an attribute beats a variable." },
			{ code = 'door:SetAttribute("Locked", true)\n\nif door:GetAttribute("Locked") then\n\tprint("no entry")\nend' },
			{ warn = "Reading an attribute that was never set gives `nil`, not `false` and not `0`. Set a starting value somewhere, or check for nil before using it." },
			{ try = "Give a part an attribute called Speed, then read it in a script and print it. Change the value in Properties while the game runs and watch the print change." },
		},
		example = [[
local Players = game:GetService("Players")

local door = script.Parent
local openTime = 3

door:SetAttribute("Locked", false)

local total = 0

for i = 1, 10 do
		local double = i * 2
		total += double
end

print(total, openTime, door:GetAttribute("Locked"))
]],
}

T{
		id = "cat-funcs", kind = "category", cat = "funcs", minutes = 6,
		level = "build",
		title = "Functions: naming steps",
		blurb = "When the same five blocks show up in three places, they want a name.",
		steps = {
			{ p = "A function is a set of blocks with a name on it. Defining one does not run it -- it puts it on the shelf. Running it is a separate block." },
			{ blocks = "def,call,callSave,return,pcall,require" },
			{ code = 'local function heal(hum, amount)\n\thum.Health = math.min(hum.Health + amount, hum.MaxHealth)\nend\n\nheal(playerHum, 25)' },
			{ h = "Inputs" },
			{ p = "The names in the `with` field are parameters: fresh variables that exist only inside the function and get their values from whoever runs it. Naming them well is most of what makes a function readable." },
			{ h = "Outputs" },
			{ p = "`give back {value}` hands a value to whoever called the function and leaves immediately. Anything after it in the same branch never runs -- which is why `give back` doubles as an early exit." },
			{ code = 'local function biggest(a, b)\n\tif a > b then\n\t\treturn a\n\tend\n\treturn b\nend' },
			{ h = "Define before you use" },
			{ p = "Luau reads a script top to bottom. A function must be defined above the first line that calls it, or that line will find nothing there. If a call mysteriously reports 'attempt to call a nil value', check the order." },
			{ warn = "That is only true for `local function`. A function stored on a table -- like a module's -- is looked up when it runs, not when the script is read, so those can be defined in any order." },
			{ h = "Risky work" },
			{ p = "`try safely` wraps blocks in `pcall`. If anything inside errors, the script carries on and you get `false` plus the message instead of a dead script. Use it for data stores, HTTP, teleports -- anything that leaves your machine and might not come back." },
			{ code = 'local ok, err = pcall(function()\n\tstore:SetAsync(key, value)\nend)\n\nif not ok then\n\twarn("save failed: " .. tostring(err))\nend' },
			{ h = "Modules" },
			{ p = "A ModuleScript is a script that returns something -- usually a table of functions. `require` loads it once and hands the same result to everyone who asks. That is how you share code between scripts without copying it." },
			{ try = "Find something you have written twice with small changes. Turn it into one function with a parameter for the part that changed." },
		},
		example = [[
local Module = {}

local function heal(hum, amount)
		hum.Health = math.min(hum.Health + amount, hum.MaxHealth)
		return hum.Health
end

function Module:reset(player)
		local char = player.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			heal(hum, hum.MaxHealth)
		end
end

local ok, err = pcall(function()
		Module:reset(nil)
end)

if not ok then
		warn(err)
end

return Module
]],
}

T{
		id = "cat-inst", kind = "category", cat = "inst", minutes = 6,
		level = "build",
		title = "Instances: building the world",
		blurb = "Every part, model, sound and label in your place is an instance, and scripts can make more.",
		steps = {
			{ p = "The Explorer window is a tree of instances. Anything you can click there, a script can make, change, move or delete." },
			{ blocks = "create,setProp,setParent,clone,destroy,findChild,waitChild,tween" },
			{ h = "Making one" },
			{ p = "`Instance.new` builds an object in memory. It is not in the game yet -- it appears the moment you give it a parent. Set the other properties first and the parent last, so nobody sees a grey unanchored part flash into place before it is ready." },
			{ code = 'local part = Instance.new("Part")\npart.Size = Vector3.new(4, 1, 4)\npart.Position = Vector3.new(0, 10, 0)\npart.Anchored = true\npart.Color = Color3.fromRGB(255, 170, 60)\npart.Parent = workspace' },
			{ h = "Finding one" },
			{ p = "`FindFirstChild` returns the child or `nil`, so you can check. Indexing directly -- `workspace.Door` -- errors when it is missing. `WaitForChild` pauses until it turns up, which is what you want on the client where objects stream in over the network." },
			{ list = {
				"Server script, object placed in Studio: plain indexing is fine.",
				"LocalScript, anything: `WaitForChild`.",
				"Might not exist at all: `FindFirstChild` and check for nil.",
			} },
			{ h = "Copying" },
			{ p = "Keep a template in ServerStorage, clone it, set the copy's position, then parent the copy. The original stays untouched and out of the workspace, so nobody can walk into it." },
			{ code = 'local copy = template:Clone()\ncopy:PivotTo(CFrame.new(0, 5, 0))\ncopy.Parent = workspace' },
			{ note = "Use `PivotTo` for models and characters -- it moves every part together. Setting `.Position` works on a single part but tears a model apart." },
			{ h = "Smooth changes" },
			{ p = "The tween block hands a table of end values to TweenService and Roblox fills in every frame between. Anything numeric can be tweened: transparency, position, size, colour." },
			{ code = 'TweenService:Create(door, TweenInfo.new(0.6), { Transparency = 1 }):Play()' },
			{ warn = "`Destroy` is final. The object and everything inside it are gone and no variable pointing at it will work again. If you might want it back, set `Parent = nil` instead and keep hold of it." },
			{ try = "Build a tower of ten parts with a loop, each one two studs above the last, each a slightly different colour." },
		},
		example = [[
local TweenService = game:GetService("TweenService")

for i = 1, 10 do
		local part = Instance.new("Part")
		part.Size = Vector3.new(4, 1, 4)
		part.Position = Vector3.new(0, i * 2, 0)
		part.Anchored = true
		part.Color = Color3.fromRGB(255, 170, 60)
		part.Parent = workspace
end

local door = workspace:FindFirstChild("Door")

if door then
		TweenService:Create(door, TweenInfo.new(0.6), { Transparency = 1 }):Play()
end
]],
}

T{
		id = "cat-player", kind = "category", cat = "player", minutes = 5,
		level = "build",
		title = "Players: characters and humanoids",
		blurb = "A player, a character and a humanoid are three different things, and mixing them up is the usual bug.",
		steps = {
			{ p = "Three objects, three jobs:" },
			{ list = {
				"The Player -- their account. Name, UserId, leaderstats. Exists from join to leave.",
				"The Character -- the model in the workspace. Replaced on every respawn.",
				"The Humanoid -- inside the character. Health, WalkSpeed, jumping, dying.",
			} },
			{ blocks = "onPlayerAdded,charOf,humanoidOf,walkSpeed,damage,leaderstat,eachPlayer" },
			{ h = "Getting from one to the other" },
			{ code = 'local char = player.Character\nlocal hum = char:FindFirstChildOfClass("Humanoid")\nhum.WalkSpeed = 24' },
			{ p = "That code is right and it will still break, because `player.Character` is `nil` between the moment a player dies and the moment they respawn -- and it is nil for a second right after they join. This is the single most common Roblox error." },
			{ code = 'local char = player.Character\n\nif not char then return end\n\nlocal hum = char:FindFirstChildOfClass("Humanoid")\n\nif not hum then return end\n\nhum.WalkSpeed = 24' },
			{ p = "Better still, do not go looking for the character at all -- wait for it to arrive, with the `when {player} spawns as {char}` block. Then it is handed to you and cannot be nil." },
			{ h = "Leaderboards" },
			{ p = "The list on the right of the screen is not a feature you switch on. It appears when a player contains a Folder named exactly `leaderstats`, and it shows one column per value inside. The `give leaderboard stat` block builds that folder for you." },
			{ code = 'local folder = Instance.new("Folder")\nfolder.Name = "leaderstats"\nfolder.Parent = player\n\nlocal coins = Instance.new("IntValue")\ncoins.Name = "Coins"\ncoins.Value = 0\ncoins.Parent = folder' },
			{ warn = "`Players.LocalPlayer` only exists in LocalScripts. On the server there is no single player, because one server is running for everyone at once. If your script is in ServerScriptService, LocalPlayer is nil." },
			{ h = "Health" },
			{ p = "`TakeDamage` respects force fields; subtracting from `Health` directly does not. Use TakeDamage for hazards, and set Health directly only when you mean to override everything -- like healing." },
			{ try = "Give every player who joins a Coins stat, and add one coin every ten seconds while they are in the game." },
		},
		example = [[
local Players = game:GetService("Players")

Players.PlayerAdded:Connect(function(player)
		local folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		folder.Parent = player

		local coins = Instance.new("IntValue")
		coins.Name = "Coins"
		coins.Value = 0
		coins.Parent = folder

		player.CharacterAdded:Connect(function(char)
			local hum = char:FindFirstChildOfClass("Humanoid")
			hum.WalkSpeed = 20
			hum.Died:Connect(function()
				print(player.Name)
			end)
		end)
end)

while true do
		task.wait(10)
		for _, player in ipairs(Players:GetPlayers()) do
			local stat = player.leaderstats:FindFirstChild("Coins")
			if stat then
				stat.Value += 1
			end
		end
end
]],
}

T{
		id = "cat-data", kind = "category", cat = "data", minutes = 5,
		level = "build",
		title = "Data: lists and records",
		blurb = "One table type does both jobs. Which one you have depends only on the keys you use.",
		steps = {
			{ p = "Luau has a single container: the table. Use whole numbers as keys and it behaves like a list. Use strings and it behaves like a record. Nothing stops you doing both at once, though you rarely want to." },
			{ blocks = "newList,listOf,push,removeAt,setKey,getKey,containsValue,foripairs" },
			{ h = "Lists" },
			{ code = 'local coins = {}\n\ntable.insert(coins, "gold")\ntable.insert(coins, "silver")\n\nprint(#coins)\nprint(coins[1])' },
			{ p = "Lists count from 1, not 0. `#coins` is how many there are. `table.insert` puts one on the end; `table.remove` takes one out and closes the gap behind it." },
			{ h = "Records" },
			{ code = 'local settings = {\n\tspeed = 24,\n\tcolour = "red",\n\tlocked = false,\n}\n\nprint(settings.speed)\nprint(settings["speed"])' },
			{ p = "Those last two lines do the same thing. Dots are neater; brackets are what you need when the key is in a variable, or is not a plain word." },
			{ h = "Walking a table" },
			{ p = "`ipairs` walks a list in order, 1 upward, and stops at the first gap. `pairs` walks every key of a record, in no order you can rely on. Reach for ipairs when order matters, which for lists it usually does." },
			{ warn = "Removing items while looping forward skips things: take out item 3 and what was item 4 slides into slot 3, but the loop has already moved past. Count backwards with a negative step, or collect what to remove and do it afterwards." },
			{ code = 'for index = #coins, 1, -1 do\n\tif coins[index] == "silver" then\n\t\ttable.remove(coins, index)\n\tend\nend' },
			{ h = "Tables are shared, not copied" },
			{ p = "Passing a table to a function does not copy it. Both names point at the same table, and a change through one is visible through the other. That is efficient, and occasionally surprising. `table.clone` gives you a shallow copy when you want one." },
			{ try = "Keep a list of every part a player has touched, and refuse to score the same part twice." },
		},
		example = [[
local coins = {}

table.insert(coins, "gold")
table.insert(coins, "silver")
table.insert(coins, "bronze")

for index = #coins, 1, -1 do
		if coins[index] == "silver" then
			table.remove(coins, index)
		end
end

local settings = { speed = 24, colour = "red" }

settings["locked"] = false

for key, value in pairs(settings) do
		print(key, value)
end

if table.find(coins, "gold") then
		print("still have the gold one")
end
]],
}

--=============================================================================
-- tips and technique
--=============================================================================

T{
		id = "tip-snap", kind = "tip", minutes = 3, level = "start",
		title = "Dragging, dropping and snapping",
		blurb = "How blocks join up, and what the amber socket is telling you.",
		steps = {
			{ p = "Hold the left button down on a block -- anywhere on it that is not a field -- and after a moment it lifts, casts a shadow, and follows the mouse. A quick click does not move it, it selects it, so you can click your way down a stack reading the code without ever pulling it apart." },
			{ h = "Reading the socket" },
			{ p = "While you are carrying a block, an amber bar with a tab standing on it appears wherever the block would land. That is the socket the block will drop into. No socket means no join -- the block will sit loose on the canvas as a stack of its own, which is perfectly legal." },
			{ h = "You are always dragging a run" },
			{ p = "Picking up a block picks up everything below it in the same run. That is deliberate: the blocks under it are the rest of that thought. To move one block on its own, drag it out, drop it somewhere empty, then drag the others back." },
			{ h = "Dropping into a slot" },
			{ p = "Container blocks -- if, loops, events, functions -- have an indented slot. Drop near the top of the empty space inside one and the socket appears indented, inside the mouth of the C. Drop just below the block's last line and it appears at the outer level, meaning 'after'. Where the socket sits is the whole answer." },
			{ note = "A stack cannot be dropped inside itself. The editor refuses the drop rather than eating your program." },
			{ h = "Getting around" },
			{ list = {
				"Scroll to pan up and down; hold Shift to pan sideways.",
				"Ctrl and scroll to zoom. Ctrl+0 puts it back to 100%.",
				"Drag with the middle mouse button, or hold Space and drag, to pan anywhere.",
				"Ctrl+L tidies every stack into a column.",
			} },
			{ h = "Getting rid of things" },
			{ p = "Select a block and press Delete, or drag it onto the palette on the left -- the palette lights up to say it will take it. Ctrl+Z brings back anything you regret, and the history is fifty deep." },
			{ h = "How the blocks fit together" },
			{ p = "Look at where two blocks meet. The lower one has a notch bitten out of its top edge, and what fills that notch is the colour of the block above it -- so a joined run reads as one interlocked column, and a block sitting on its own shows the canvas through its notch instead. The bottom of every run carries the matching tab." },
			{ try = "Build a stack of four blocks, then drag the second one out and drop it inside an if block. Watch where the socket goes as you move." },
		},
}

T{
		id = "tip-code-panel", kind = "tip", minutes = 3, level = "start",
		title = "Reading the code panel",
		blurb = "The panel on the right is not decoration. It is the thing you are actually making.",
		steps = {
			{ p = "Every edit rewrites the panel on the right immediately. This is the fastest way to learn to read Luau there is: change one block, watch one line change." },
			{ h = "Hover to connect the two" },
			{ p = "Hover a block on the canvas and the lines it produced light up in the panel. Hover a line in the panel and the block that wrote it is outlined on the canvas. When you cannot find which block is causing something, this is how you find it." },
			{ h = "The header and the preamble" },
			{ p = "The first two lines are a banner with your project name. Below that, any services your blocks need appear as `local Players = game:GetService(\"Players\")` -- hoisted automatically, deduplicated, and skipped entirely if you added the service block yourself." },
			{ h = "Getting the code out" },
			{ list = {
				"The button along the bottom writes the code into the game, and registers a waypoint so Ctrl+Z in Studio undoes it.",
				"Where it goes depends on the kind: a Script to ServerScriptService, a LocalScript to StarterPlayerScripts, a ModuleScript to ReplicatedStorage.",
				"If the project was made by converting a script, that button says `Update` instead, and writes back into the very same script.",
				"`Copy` opens the script as selectable text, ready for Ctrl+C. Studio gives plugins no clipboard of their own, so nothing here pretends otherwise.",
				"The script it inserts is ordinary Luau with no dependency on this plugin.",
			} },
			{ warn = "Editing the inserted script does not edit your blocks. The arrow only points one way -- blocks to code. If you change the script and then insert again, your edits are overwritten. Edit the blocks, or move to text for good." },
			{ h = "Reading indentation" },
			{ p = "Indentation in the panel is exactly the nesting on your canvas. If a line is further right than you expected, the block is inside something you did not mean it to be inside. That is usually the bug." },
		},
}

T{
		id = "tip-import", kind = "tip", minutes = 4, level = "build",
		title = "Turning Luau into blocks",
		blurb = "Select a script in the Explorer and get a canvas back.",
		steps = {
			{ p = "Click a Script, LocalScript or ModuleScript in the Explorer, open the Import tab, and it is sitting there waiting -- name, path, kind and length. One button turns it into blocks. It handles the whole language, including types, string interpolation, `+=`, `continue`, and nested functions." },
			{ p = "The tab watches your selection, so you can leave it open and click around the Explorer to see what each script would convert into." },
			{ h = "What you get back" },
			{ list = {
				"Events, loops, branches and function definitions become the matching blocks.",
				"Expressions stay exactly as you wrote them, inside the fields.",
				"Comments become note blocks, in the same places.",
				"Anything else becomes a raw Luau block holding the original text.",
			} },
			{ h = "Nothing is thrown away" },
			{ p = "When a statement has no matching block, it becomes a `raw Luau` block holding the exact source text. Your program still works, still exports byte-for-byte, and you can edit the parts that did convert. A metatable or a coroutine will come through as raw; a touch event will come through as a touch block." },
			{ p = "The report under the button tells you how many statements were matched and how many landed in raw blocks, with the line numbers, so you can see at a glance how well it went." },
			{ h = "Blank lines become stacks" },
			{ p = "The importer treats a blank line at the top level as a break between stacks, so an imported script arrives as a column of separate groups rather than one enormous tower. That is usually the shape you wanted anyway." },
			{ h = "Round tripping" },
			{ p = "Import then export gives back the same code -- that is a rule the importer is built around. A pattern is only matched when the block writes exactly the same line back. `hum.WalkSpeed = 24` becomes a walk-speed block; `hum.JumpPower = 50` deliberately does not, because that block writes two lines." },
			{ note = "Comments survive. A line comment becomes a note block in the same place; a long comment stays raw." },
			{ warn = "Converting replaces the canvas. Save your project first if it has anything worth keeping -- though Ctrl+Z will also bring it back." },
			{ h = "It remembers where the script came from" },
			{ p = "Converting ties the project to that script. The button at the bottom of the window changes from `Insert` to `Update`, and writes the code back into the same script rather than making another one beside it. That is the loop worth knowing: select, convert, rearrange, update." },
			{ p = "Choosing a different script kind by hand unties it again, because a project cannot be both a ModuleScript and the Script it was read from." },
			{ note = "Studio asks permission the first time a plugin reads or writes script source. Allow it once and both directions work from then on." },
			{ p = "There is still a paste box further down the tab, for code that is not in your place yet -- something from a tutorial, a friend, or a forum post." },
			{ try = "Select a script you already have and see how much of it comes back as real blocks." },
		},
		example = [[
local Players = game:GetService("Players")

local COOLDOWN = 1.5
local lastHit = {}

Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(char)
			local hum = char:FindFirstChildOfClass("Humanoid")
			hum.WalkSpeed = 20
		end)
end)

script.Parent.Touched:Connect(function(hit)
		local hum = hit.Parent:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		hum:TakeDamage(10)
end)
]],
}

T{
		id = "tip-intellisense", kind = "tip", minutes = 4, level = "build",
		title = "Getting the most out of IntelliSense",
		blurb = "The completion list knows your document, not just Roblox.",
		steps = {
			{ p = "Click into any expression field and a list appears. It is not a fixed word list -- it works out what you are asking for from what you have typed and from what your blocks have already declared." },
			{ h = "Type less than you think" },
			{ p = "Matching is fuzzy and subsequence-based. `ffc` finds FindFirstChild. `gsv` finds GetService. `wsp` finds WalkSpeed. You almost never need more than three characters." },
			{ h = "Dots and colons ask different questions" },
			{ p = "After a dot you get properties, methods and events. After a colon you get only the things you can call -- properties are hidden, because `part:Anchored` is not a thing. The list is filtered by the type of what is on the left." },
			{ h = "It reads your canvas" },
			{ p = "A `make door = a new Part` block above teaches the completer that `door` is a Part, so `door.` offers Anchored, CanCollide and Transparency. A `use the TweenService service` block teaches it that TweenService has a Create method. Your own names appear at the top of the list, above the built-ins." },
			{ code = 'local door = Instance.new("Part")\ndoor.Anch', partial = true },
			{ h = "Strings get completed too" },
			{ p = "Inside the quotes of `Instance.new(\"` you get class names. Inside `game:GetService(\"` you get services. Fields that want a class, a property or a key name know what belongs there without you typing quotes at all." },
			{ h = "Signature help" },
			{ p = "Once the caret is inside a call's brackets, the line under the field shows what that function takes and highlights the argument you are on. It works for the Roblox API and for the standard libraries." },
			{ list = {
				"Up and Down move through the list.",
				"Tab or Enter accepts. Clicking works too.",
				"Escape dismisses it. Ctrl+Space brings it back.",
			} },
			{ note = "The completer knows a few conventional names as a last resort -- `hum` is probably a Humanoid, `plr` probably a Player. Declare the variable with a block and it stops guessing." },
		},
}

T{
		id = "tip-shortcuts", kind = "tip", minutes = 2, level = "start",
		title = "Keyboard shortcuts",
		blurb = "The dozen keys that make this feel like a tool rather than a toy.",
		steps = {
			{ p = "Everything here can be done with the mouse, and everything here is faster with the keyboard. These are worth learning in the order they appear -- undo first, because it makes everything else safe to try." },
			{ h = "Editing" },
			{ list = {
				"Ctrl+Z -- undo. Ctrl+Y or Ctrl+Shift+Z -- redo. Fifty steps of history.",
				"Delete or Backspace -- remove the selected block and everything under it.",
				"Ctrl+D -- duplicate the selected block, children and all.",
				"Escape -- dismiss the completion list, or clear the selection.",
			} },
			{ h = "Moving around" },
			{ list = {
				"Ctrl+F -- jump to the palette search box.",
				"Scroll -- pan. Shift+scroll -- pan sideways. Ctrl+scroll -- zoom.",
				"Ctrl+0 -- back to 100%. Ctrl+L -- tidy the stacks into a column.",
				"Hold the left button on a block -- pick it up. A click just selects.",
				"Middle-drag, or hold Space and drag -- pan freely.",
			} },
			{ h = "Getting work out" },
			{ list = {
				"Ctrl+S -- save the project.",
				"Ctrl+Enter -- insert the generated script into the game.",
				"Ctrl+Space -- force the completion list open in a field.",
			} },
			{ p = "The palette search box deserves a mention of its own. Ctrl+F, three letters, Enter -- the matching block lands on the canvas without your hands leaving the keyboard. Searching matches the block's wording, the Luau it writes, and its description, so `connect` finds the event blocks even though none of them say connect on the front." },
			{ note = "Shortcuts need the plugin window focused. Click once inside it after using Studio's viewport, or the keys go to Studio instead." },
		},
}

T{
		id = "tip-naming", kind = "tip", minutes = 3, level = "build",
		title = "Naming things so the code reads",
		blurb = "The generated script is only as clear as the names you typed into the fields.",
		steps = {
			{ p = "Blocks give you the structure for free. The names are still yours, and they are what somebody reads six months later -- including you." },
			{ h = "Say what it is, not what type it is" },
			{ p = "`part` tells you nothing you could not see. `door`, `checkpoint`, `killBrick` tell you why it is there. Reserve short names for short lives: `i` in a three-line loop is fine, `i` spanning forty lines is not." },
			{ h = "Booleans read as questions" },
			{ p = "Name a true-or-false value so that `if` plus the name is a sentence. `if isOpen`, `if hasKey`, `if canJump`. Then `if not isOpen` still reads properly, which `if not open` does not." },
			{ h = "Constants shout" },
			{ p = "A value fixed when the script starts and never changed is written in capitals with underscores -- `MAX_HEALTH`, `SPAWN_DELAY`. It is only a convention, but it tells a reader instantly that they will not find that name on the left of an assignment anywhere." },
			{ code = 'local MAX_HEALTH = 100\nlocal SPAWN_DELAY = 3\n\nlocal isOpen = false\nlocal checkpoint = workspace.Checkpoints.First' },
			{ h = "Match the language" },
			{ p = "Roblox properties are PascalCase -- `WalkSpeed`, `BrickColor`. Luau code conventionally uses camelCase for variables -- `walkSpeed`, `lastHit`. Following that split makes it obvious at a glance which is yours and which is Roblox's." },
			{ warn = "Do not name a variable after something built in. A variable called `print` or `workspace` will shadow the real one for the rest of that scope, and the error you get will not mention it." },
		},
}

T{
		id = "tip-loops", kind = "tip", minutes = 4, level = "build",
		title = "Loops that do not freeze the game",
		blurb = "Why your test hangs the moment you press Play, and the two-block fix.",
		steps = {
			{ p = "Luau runs your script on one thread. While a loop is going round, nothing else in that script happens -- and if the loop never pauses, Roblox never gets its turn back either." },
			{ code = 'while true do\n\tprint("hello")\nend' },
			{ p = "That runs millions of times a second, fills the output, and locks up the place. Studio will stop it after a few seconds and complain about a script timeout." },
			{ h = "The fix" },
			{ code = 'while true do\n\ttask.wait(1)\n\tprint("hello")\nend' },
			{ p = "`task.wait` pauses this thread and lets everything else run. One wait inside every `while` is the rule. Put it at the top rather than the bottom and the loop cannot race away even if a later block errors." },
			{ h = "Prefer an event to a loop" },
			{ p = "Loops that poll -- 'check every frame whether the player is near' -- are usually an event in disguise. Touched, ProximityPrompt.Triggered and GetPropertyChangedSignal all cost nothing while nothing is happening, whereas a loop costs the same whether anything happens or not." },
			{ h = "The frame loop is different" },
			{ p = "`every frame` is not a `while` loop -- it is an event that Roblox fires once per frame, and it never needs a wait. But whatever you put inside runs sixty times a second, so keep it small: move something, read something, and get out." },
			{ warn = "`task.wait(0)` does not mean 'no wait'. It means 'let everything else have a turn, then carry on next frame'. That is often exactly what you want, but it is not free." },
			{ try = "Take a while loop you have written and see whether an event could do the same job with no loop at all." },
		},
		example = [[
local RunService = game:GetService("RunService")

while true do
		task.wait(1)
		print("tick")
end

RunService.Heartbeat:Connect(function(dt)
		part.Position = part.Position + Vector3.new(0, dt, 0)
end)
]],
}

T{
		id = "tip-debug", kind = "tip", minutes = 4, level = "build",
		title = "When nothing happens",
		blurb = "A short list, in order, for the moment your blocks look right and do nothing.",
		steps = {
			{ p = "Nothing happening is more common than a crash, and it is worth having a routine rather than a stare." },
			{ h = "1. Open the Output window" },
			{ p = "View, then Output, in Studio. Almost every silent failure has already written you a message there. If the window is empty, your script may not be running at all -- which is its own answer." },
			{ h = "2. Print at the top" },
			{ p = "Put a `print` as the very first block. If it does not appear, the script never ran: wrong parent, wrong script kind, or disabled. If it does appear, the problem is further in." },
			{ h = "3. Print inside the event" },
			{ p = "Put a print as the first block inside the event. If the top one prints and this one does not, the event is not firing. Check the object it is connected to actually exists, and that you are on the right side -- a server script cannot hear a key press." },
			{ h = "4. Print the value you are testing" },
			{ code = 'print("hum is", hum)\nprint("health is", hum and hum.Health)' },
			{ p = "`print` takes as many values as you like and puts tabs between them. Printing the value next to a label tells you far more than printing the value alone. Nine times in ten the answer is that something is `nil`." },
			{ h = "5. Check where the script lives" },
			{ p = "A Script in ReplicatedStorage does not run. A LocalScript in ServerScriptService does not run. A Script inside a Tool runs only once the tool is in a character. Placement is behaviour." },
			{ note = "`warn` prints in orange, which makes your own messages easy to pick out of a busy output window. Use warn for the ones you are actively hunting." },
		},
}

T{
		id = "tip-where", kind = "tip", minutes = 4, level = "deep",
		title = "Server or client: where does this script go?",
		blurb = "Half of all Roblox bugs are a script in the wrong place.",
		steps = {
			{ p = "A Roblox game runs in two places at once. One server holds the truth about the world; every player's device runs its own copy for drawing and input. Code runs on one side or the other, never both, and they see different things." },
			{ h = "The short version" },
			{ list = {
				"Server (a Script in ServerScriptService): scores, damage, spawning, saving, anything cheatable.",
				"Client (a LocalScript in StarterPlayerScripts or StarterGui): key presses, the camera, interface, sounds only that player should hear.",
			} },
			{ h = "What only exists on one side" },
			{ p = "`Players.LocalPlayer` is a client thing -- on the server it is nil, because the server is not any one player. `UserInputService` and `RenderStepped` are client-only for the same reason: a server has no keyboard and draws no frames. Meanwhile DataStores and `player:Kick()` only work on the server." },
			{ warn = "A part created on the client exists only for that player. Nobody else sees it, and the server does not know about it. That is occasionally what you want, and usually the bug." },
			{ h = "Talking across the gap" },
			{ p = "The two sides talk through RemoteEvents and RemoteFunctions -- objects you put in ReplicatedStorage. The client fires, the server listens, or the other way round. Use a raw Luau block for these until you are comfortable; the pattern is short." },
			{ code = 'local remote = game.ReplicatedStorage.BuyItem\n\nremote.OnServerEvent:Connect(function(player, itemName)\n\tprint(player.Name, itemName)\nend)' },
			{ p = "Note the first argument: on the server, `OnServerEvent` always hands you the player who sent it, and Roblox fills that in -- the client cannot lie about who they are." },
			{ warn = "Never trust anything else the client sends. A client saying 'give me 500 coins' must be checked on the server, because a determined player can send whatever they like." },
			{ note = "In Studio, use Test then Start with two players to see both sides at once. The Client/Server dropdown in the toolbar switches which one your Output is showing." },
		},
}

T{
		id = "tip-perf", kind = "tip", minutes = 4, level = "deep",
		title = "Keeping every-frame code cheap",
		blurb = "Sixty times a second multiplies any mistake by sixty.",
		steps = {
			{ p = "Code in a frame event gets a budget of a few milliseconds. Everything you do in there is done again before the next frame is drawn, so small waste turns into stutter." },
			{ h = "Look things up once" },
			{ code = 'local hum = char:FindFirstChildOfClass("Humanoid")\n\nRunService.Heartbeat:Connect(function(dt)\n\thum.WalkSpeed = 16 + math.sin(os.clock()) * 4\nend)' },
			{ p = "Find the humanoid once, outside. A `FindFirstChild` inside a frame event searches the children of that object every single frame, for a result that has not changed." },
			{ h = "Multiply by delta time" },
			{ p = "The frame event hands you the seconds since the last frame. Multiply movement by it and your game runs at the same speed on a slow laptop and a fast desktop. Without it, everything is tied to frame rate." },
			{ code = 'part.Position = part.Position + Vector3.new(0, 5 * dt, 0)' },
			{ h = "Use a tween instead" },
			{ p = "Moving something from A to B over two seconds does not need a frame loop at all. TweenService does it in the engine, in C, without waking your script up at all. Reach for a frame event only when the value genuinely depends on something changing every frame." },
			{ h = "Disconnect what you are done with" },
			{ p = "A connection you never disconnect stays alive, holding on to everything it mentions. Connect something for each of a hundred parts and forget them and you have a hundred handlers running forever. Keep the connection in a variable and use `stop listening` when the work is over." },
			{ code = 'local connection\n\nconnection = RunService.Heartbeat:Connect(function(dt)\n\tif done then\n\t\tconnection:Disconnect()\n\tend\nend)' },
			{ note = "Studio's MicroProfiler (Ctrl+F6 while playing) shows which scripts are eating the frame. It is worth a look before optimising anything by guesswork." },
		},
}

T{
		id = "tip-raw", kind = "tip", minutes = 3, level = "deep",
		title = "The escape hatch",
		blurb = "One block that takes any Luau at all, for when the palette runs out.",
		steps = {
			{ p = "There are 680 blocks. There are considerably more than 680 things you might want to write. The `raw Luau` block takes whatever you type and puts it in the output untouched, at the right indentation." },
			{ p = "Before reaching for it twice, though, consider making a block of your own. A custom block is the same raw Luau with named holes in it, and it gets a name, a place in the palette and a tooltip. The second time you write something is the moment to turn it into a block." },
			{ blocks = "raw,comment" },
			{ h = "What it is for" },
			{ list = {
				"RemoteEvents and RemoteFunctions.",
				"DataStores, HTTP requests, anything asynchronous and fiddly.",
				"Metatables, coroutines, and other things that do not want to be a block.",
				"A line you already know how to write and do not want to assemble.",
			} },
			{ h = "It is a real editor" },
			{ p = "The raw block is multi-line and gets the same IntelliSense as every other expression field. Nesting still works: put a raw block inside a loop and it is indented by the loop, as you would expect." },
			{ h = "It is where imports land" },
			{ p = "Anything the importer does not recognise arrives as a raw block holding the exact original text. This is why importing a script never loses anything: the worst case is that your program is a stack of raw blocks that still runs perfectly." },
			{ warn = "The generated script is only checked by Luau when you insert it. A typo in a raw block will not stop the code panel from showing it -- but it will stop the script from running." },
			{ note = "Use the note block for comments. It writes `-- your text` and costs nothing at runtime. A canvas with a note above each stack is far easier to come back to." },
		},
}

T{
		id = "tip-organise", kind = "tip", minutes = 3, level = "build",
		title = "Organising a canvas you can still read",
		blurb = "Twenty blocks in one tower is a wall. The same twenty in five stacks is a program.",
		steps = {
			{ p = "A stack is a group. Use them: one stack for services, one per event, one per function. Ctrl+L tidies them into a single column in the order they will run." },
			{ h = "Top to bottom is the running order" },
			{ p = "Stacks are read top to bottom, then left to right, and that is the order they appear in the generated script. Moving a stack up the canvas genuinely moves it earlier in the script -- which matters, because a function must be defined above the first place it is used." },
			{ list = {
				"One stack for services, at the top left.",
				"One stack per event -- that is usually the natural unit of a Roblox script.",
				"One stack per function definition, above the first thing that calls it.",
				"Loose experiments off to the right, where they are obviously not part of the program.",
			} },
			{ h = "Label everything" },
			{ p = "Put a note block at the top of each stack saying what it does. It becomes a comment in the output, so the tidiness follows the code out of the plugin." },
			{ h = "Pull repeated work into a function" },
			{ p = "Three copies of the same four blocks is a function waiting to be named. Define it in its own stack near the top and call it from wherever. The canvas gets smaller and the intent gets clearer." },
			{ h = "Split the script itself" },
			{ p = "When a project grows past a screen or two, it probably wants to be two scripts rather than one. Save the project, start a new one, and let each handle one job -- one for the shop, one for the round timer. Small scripts are easier to fix." },
			{ note = "Zooming out with Ctrl+scroll is a good way to see the shape of a program. If it looks lopsided -- one enormous stack and four tiny ones -- it usually is." },
		},
}

T{
		id = "tip-save", kind = "tip", minutes = 3, level = "start",
		title = "Saving, sharing and keeping versions",
		blurb = "Where your blocks live, and how to get them onto someone else's machine.",
		steps = {
			{ p = "Your project is saved with the plugin, in Studio's plugin settings -- not inside the place file. It survives closing Studio and opening a different place." },
			{ h = "Saving" },
			{ p = "Ctrl+S, or the Save button. The canvas also saves itself when you close the window and when you switch tabs, so a crash costs you very little. The status bar shows when the last save happened." },
			{ h = "Several projects" },
			{ p = "The Setup tab lists every project you have saved, and lets you switch between them, start a new one, or copy the current one. The name at the top left of the window is editable in place; give a project the name of the thing it builds rather than 'test2'." },
			{ list = {
				"Ctrl+S saves. The status bar shows the time of the last save.",
				"Switching tabs or closing the window saves too.",
				"The project menu holds as many projects as you like.",
				"Export and import move a whole project as JSON text.",
			} },
			{ h = "Sharing" },
			{ p = "`Export as text` on the Setup tab shows the whole document as JSON, selected and ready to copy. Anyone with this plugin can paste it into `Import project` and get an identical canvas -- positions, fields, everything." },
			{ note = "The JSON is plain text, so it goes in a Discord message, a gist, or a version-controlled file just as well." },
			{ h = "Versions" },
			{ p = "Before a big change, copy the project and give the copy a new name. It costs one click and it is the cheapest insurance there is. Undo is fifty steps deep, but it does not survive closing the window." },
			{ warn = "Inserting the generated script into your place is what actually makes the game work. Saving the project saves the blocks, not the script." },
		},
}

T{
		id = "tip-errors", kind = "tip", minutes = 4, level = "build",
		title = "Error messages, translated",
		blurb = "The five you will actually meet, and what each one is really telling you.",
		steps = {
			{ h = "attempt to index nil with 'Something'" },
			{ p = "You asked for a property of something that does not exist. Read the name in quotes: whatever is on the left of it is nil. Usually a child that has not loaded, or a character that is between respawns. Check for nil first, or use `WaitForChild`." },
			{ code = 'local hum = char:FindFirstChildOfClass("Humanoid")\n\nif not hum then return end\n\nhum.WalkSpeed = 24' },
			{ h = "attempt to call a nil value" },
			{ p = "You ran something that is not a function. Either the name is misspelled, or the function is defined below the line that calls it, or you meant a dot and typed a colon. Colons are for methods -- `part:Destroy()` -- and dots for everything else." },
			{ h = "attempt to perform arithmetic on a string value" },
			{ p = "Something you thought was a number is text. Values from TextBoxes and attributes are a common source. `tonumber` converts, and gives nil when it cannot -- so check the result before using it." },
			{ h = "Script timeout: exhausted allowed execution time" },
			{ p = "A loop with no wait in it. See the loops lesson; the fix is one block." },
			{ h = "Unable to cast value to Object" },
			{ p = "You gave a property the wrong kind of value -- a number where a Vector3 was wanted, or a string where an Instance was. Look at the property in the Properties window to see what type it expects." },
			{ note = "Every error in the Output window is clickable. It takes you to the line in the script -- and with the code panel open you can find the block that wrote that line by hovering it." },
			{ h = "Warnings are worth reading" },
			{ p = "Orange lines are not errors, but they are Roblox telling you that something is deprecated or about to bite. `wait()` and `spawn()` are the usual culprits; `task.wait` and `task.spawn` are the modern replacements, and the blocks use those already." },
		},
}

T{
		id = "tip-tags", kind = "tip", minutes = 4, level = "deep",
		title = "Tags and attributes: one script for many objects",
		blurb = "Stop putting a copy of the same script inside forty coins.",
		steps = {
			{ p = "The beginner pattern is a script inside every coin. It works, and it means forty copies of the same code, forty chances to fix a bug in thirty-nine places. Tags fix this." },
			{ h = "Tagging" },
			{ p = "A tag is a label on an object. Add it in code, or with Studio's Tag Editor (View, then Tag Editor), select forty coins and tag them all at once. Then one script handles every object that carries the tag." },
			{ code = 'local CollectionService = game:GetService("CollectionService")\n\nfor _, coin in ipairs(CollectionService:GetTagged("Coin")) do\n\tsetUpCoin(coin)\nend\n\nCollectionService:GetInstanceAddedSignal("Coin"):Connect(setUpCoin)' },
			{ p = "The loop handles the coins already in the place; the signal handles every coin added later, including ones your own code clones. Between them they cover the whole lifetime of the game." },
			{ h = "Attributes carry the differences" },
			{ p = "Tags say what kind of thing it is. Attributes say what is different about this one. A `Coin` tag plus a `Value` attribute of 5 or 25 gives you one script and as many kinds of coin as you like -- and the values are editable in Properties without touching code." },
			{ code = 'local value = coin:GetAttribute("Value") or 1' },
			{ p = "That `or 1` is worth copying: attributes that were never set come back nil, and `or` supplies a default in one short line." },
			{ note = "Together, tags and attributes are how larger Roblox projects avoid script sprawl. It is worth learning early -- the habit scales, and copying scripts does not." },
			{ try = "Tag three parts as Hazard, give each a Damage attribute, and write one script that hurts anyone who touches any of them." },
		},
		example = [[
local CollectionService = game:GetService("CollectionService")

local function setUpHazard(part)
		local damage = part:GetAttribute("Damage") or 10
		part.Touched:Connect(function(hit)
			local hum = hit.Parent:FindFirstChildOfClass("Humanoid")
			if not hum then return end
			hum:TakeDamage(damage)
		end)
end

for _, part in ipairs(CollectionService:GetTagged("Hazard")) do
		setUpHazard(part)
end

CollectionService:GetInstanceAddedSignal("Hazard"):Connect(setUpHazard)
]],
}

T{
		id = "tip-graduate", kind = "tip", minutes = 4, level = "deep",
		title = "Growing out of blocks",
		blurb = "The point of this plugin is to become unnecessary. Here is how to tell when.",
		steps = {
			{ p = "Blocks are good at structure and bad at density. When you find yourself fighting the canvas rather than the problem, that is the signal -- and the way out is already in your hands." },
			{ h = "The signs" },
			{ list = {
				"You reach for raw Luau blocks more often than real ones.",
				"You know what to type and the dragging is just slower.",
				"You want two files that talk to each other.",
				"You want to search and replace across a program.",
			} },
			{ h = "The move" },
			{ p = "Press the button at the bottom of the window. That is a real Script, ordinary Luau, with no dependency on this plugin. Open it and keep going in text. Nothing is lost and nothing has to be rewritten." },
			{ h = "What carries over" },
			{ p = "Everything you learned here is Luau, not block-speak. `if`, `for`, `local`, events, functions, tables -- the blocks were labels on the real thing the whole time. The code panel has been showing you the destination since the first block you dragged." },
			{ h = "What to learn next" },
			{ list = {
				"ModuleScripts, properly -- how to split a project across files.",
				"RemoteEvents -- the client and server talking safely.",
				"Types -- `local x: number` and what Studio does with it.",
				"The Roblox Creator Documentation, which is genuinely good and searchable.",
			} },
			{ note = "You can come back. Select the script, convert it, rearrange it visually, and press Update to write it straight back. The round trip is stable, so a script can go through the blocks and come out as the same script." },
		},
}

--=============================================================================
-- lessons for the bigger systems
--
-- The ten teaching categories each get a lesson because they are the grammar.
-- These five are the systems people reach for next, and each has a trap in it
-- that costs a weekend to find on your own.
--=============================================================================

T{
		id = "cat-ui", kind = "category", cat = "ui", minutes = 6,
		level = "build",
		title = "Interface: screens, buttons and text",
		blurb = "Everything a player reads or clicks lives in their own copy of the screen, which changes where the code goes.",
		steps = {
			{ p = "A ScreenGui is a container Roblox draws flat on top of the 3D view. It goes in the player's PlayerGui, which belongs to that one player: change something in there and nobody else sees it. That single fact decides almost everything about interface code -- it runs on the player's own machine, in a LocalScript, and the server never sees the result." },
			{ h = "Where the interface lives" },
			{ p = "A ScreenGui holds frames, labels, buttons and images. Each of those is a GuiObject, and every GuiObject has a Position and a Size. Put the ScreenGui in StarterGui and Roblox copies it into each player as they arrive, or build it from a LocalScript and parent it to PlayerGui yourself." },
			{ blocks = "uiScreen,uiLabel,uiButton,uiOnClick,uiPos,uiSize" },
			{ code = 'local player = game:GetService("Players").LocalPlayer\nlocal gui = Instance.new("ScreenGui")\ngui.Parent = player:WaitForChild("PlayerGui")' },
			{ h = "Scale and offset, and why both exist" },
			{ p = "A UDim2 has two numbers per axis: a scale, which is a fraction of the parent, and an offset, which is a count of pixels. Scale keeps a layout looking the same on a phone and on a monitor. Offset keeps a border exactly two pixels thick no matter the screen. Most things want scale for position and size, and offset only for padding and outlines." },
			{ code = 'label.Size = UDim2.fromScale(0.25, 0.08)\nlabel.Position = UDim2.fromScale(0.02, 0.02)\nlabel.BackgroundTransparency = 0.3' },
			{ note = "The blocks come in pairs for this reason: `set {gui} size to {x} by {y}` takes fractions, and `set {gui} size to {w} by {h} pixels` takes pixels. Pick whichever the thing you are sizing actually cares about." },
			{ h = "Reacting to a click" },
			{ p = "A TextButton or ImageButton fires Activated when it is pressed, and that covers mouse, touch and gamepad in one event. There is also MouseButton1Click, which only covers the mouse -- prefer Activated unless you specifically want to exclude a phone." },
			{ code = 'button.Activated:Connect(function()\n\tscore += 1\n\tlabel.Text = tostring(score)\nend)' },
			{ warn = "A button on a player's screen is not proof of anything. If clicking it should cost coins or give an item, the click has to travel to the server through a RemoteEvent and be checked there. Anything decided only on the player's machine can be decided differently by a player who is cheating." },
			{ try = "Build a score counter: a label, a button that adds one, and a second button that resets it. Then look at the Luau panel and notice that none of it touches the server." },
		},
		example = [[
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "Score"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local label = Instance.new("TextLabel")
label.Size = UDim2.fromScale(0.25, 0.08)
label.Position = UDim2.fromScale(0.02, 0.02)
label.BackgroundTransparency = 0.3
label.Text = "0"
label.Parent = gui

local button = Instance.new("TextButton")
button.Size = UDim2.fromOffset(120, 36)
button.Position = UDim2.fromScale(0.02, 0.12)
button.Text = "add one"
button.Parent = gui

local score = 0

button.Activated:Connect(function()
		score += 1
		label.Text = tostring(score)
end)
]],
}

T{
		id = "cat-save", kind = "category", cat = "save", minutes = 6,
		level = "deep",
		title = "Saving: data that outlives the round",
		blurb = "A DataStore is the only place a number survives a player leaving, and it is the one place that is allowed to fail.",
		steps = {
			{ p = "Everything in a running Roblox place disappears when the server shuts down. A DataStore is a small key-value store that does not: you hand it a key and a value, and hours later on another server the same key gives the value back. It is the only Roblox feature that talks to a machine you do not control, and that changes how you have to write against it." },
			{ h = "Get the store once, use the key every time" },
			{ p = "GetDataStore names a store; the key names one player's slot inside it. Almost everyone uses the player's UserId in the key, because names change and UserIds do not. Build the key in one small function so every read and write agrees on its shape." },
			{ blocks = "saveStore,saveKeyFor,saveLoad,saveSet,saveOnJoin,saveOnLeave" },
			{ code = 'local store = DataStoreService:GetDataStore("Coins")\n\nlocal function keyFor(player)\n\treturn "player_" .. player.UserId\nend' },
			{ h = "Every call can fail" },
			{ p = "GetAsync and SetAsync go over the network. They can time out, they can be throttled, and they throw when they do. A DataStore call that is not wrapped in pcall will one day take your whole PlayerAdded handler down with it, and every player after that point joins with nothing." },
			{ code = 'local ok, saved = pcall(function()\n\treturn store:GetAsync(keyFor(player))\nend)\nif not ok then\n\twarn("could not load")\nend' },
			{ note = "`saved` is nil for a brand new player, and that is not an error -- it means there is nothing stored yet. Treat nil as your starting value rather than as a failure, and keep the two cases apart, because saving over a failed load is how progress gets erased." },
			{ h = "Save on the way out, and on the way down" },
			{ p = "PlayerRemoving fires when someone leaves. BindToClose fires when the whole server is shutting down, and it is your last chance to write anything -- Roblox waits a few seconds for it and then stops caring. A game that only saves on PlayerRemoving loses the last session of everyone who was still online at shutdown." },
			{ warn = "There is a request budget, and it is smaller than it looks: roughly one write per key every six seconds. Saving on every coin pickup will be throttled and then dropped. Keep the value in memory, and write it on a timer and on the way out." },
			{ try = "Give a player a Coins value that loads when they join and saves when they leave, then rejoin and check the number came back. Test it in Studio with Game Settings, Security, Enable Studio Access to API Services turned on." },
		},
		example = [[
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local store = DataStoreService:GetDataStore("Coins")

local function keyFor(player)
		return "player_" .. player.UserId
end

Players.PlayerAdded:Connect(function(player)
		local ok, saved = pcall(function()
			return store:GetAsync(keyFor(player))
		end)

		local coins = Instance.new("IntValue")
		coins.Name = "Coins"
		coins.Value = 0
		coins.Parent = player

		if ok and saved then
			coins.Value = saved
		end
end)

Players.PlayerRemoving:Connect(function(player)
		local coins = player:FindFirstChild("Coins")
		if coins then
			pcall(function()
				store:SetAsync(keyFor(player), coins.Value)
			end)
		end
end)
]],
}

T{
		id = "cat-net", kind = "category", cat = "net", minutes = 6,
		level = "deep",
		title = "Networking: the server and the player",
		blurb = "Two machines, one game. A RemoteEvent is the only door between them, and it does not lock itself.",
		steps = {
			{ p = "A Roblox game runs in two places at once. The server holds the truth: who has what, where everything is, what counts as a score. Each player's own machine runs a copy that draws the world and reads their keyboard. Neither can see the other's variables. A RemoteEvent is the door between them." },
			{ h = "Which way the message goes" },
			{ p = "The same RemoteEvent object is used from both sides, but the calls have different names depending on which way you are shouting. From a LocalScript you FireServer, and the server hears OnServerEvent. From the server you FireClient at one player or FireAllClients at everybody, and their LocalScripts hear OnClientEvent." },
			{ blocks = "netMakeEvent,netToServer,netOnServerMessage,netToOne,netToAll,netOnClientMessage" },
			{ code = 'remote.OnServerEvent:Connect(function(player, itemName)\n\tprint(player.Name .. " wants " .. itemName)\nend)' },
			{ note = "The server always gets the player as the first argument, and it is added by Roblox rather than by the sender. That one argument is the only thing in the whole message you can trust, because a cheating player cannot forge it." },
			{ h = "Everything else is a lie until you check it" },
			{ p = "The arguments after that player came from someone else's machine, and a modified client can send anything at all: a number where you expected a string, a table a thousand entries deep, the name of an item that costs nothing. Check the type, check the value is one you actually sell, and check they can afford it -- on the server, every time." },
			{ code = 'if typeof(itemName) ~= "string" then\n\treturn\nend\nif not SHOP[itemName] then\n\treturn\nend' },
			{ warn = "A RemoteEvent can also be fired as fast as a script can loop. If yours does anything expensive, keep the time of each player's last call and drop anything that arrives too soon after it. Without that, one player can spend your whole server." },
			{ h = "When you need an answer back" },
			{ p = "A RemoteFunction waits for a reply, which is occasionally what you want and usually a trap: if the far side is slow, your code is stopped until it answers, and a client that never answers stops a server thread for good. Prefer two RemoteEvents -- one asking, one telling -- unless the reply is genuinely immediate." },
			{ try = "Make a shop: a LocalScript that fires the server with an item name, and a server script that checks the name is one of three real items before printing the sale. Then try firing it with a number and watch your check catch it." },
		},
		example = [[
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remote = Instance.new("RemoteEvent")
remote.Name = "BuyItem"
remote.Parent = ReplicatedStorage

local lastCall = {}

remote.OnServerEvent:Connect(function(player, itemName)
		if typeof(itemName) ~= "string" then
			return
		end

		local now = os.clock()
		local previous = lastCall[player.UserId]
		if previous and now - previous < 0.5 then
			return
		end

		lastCall[player.UserId] = now
		print(player.Name .. " asked to buy " .. itemName)
end)
]],
}

T{
		id = "cat-phys", kind = "category", cat = "phys", minutes = 6,
		level = "build",
		title = "Physics: pushing things about",
		blurb = "Anchored parts sit still and unanchored parts fall. Everything else is a question of which force you reach for.",
		steps = {
			{ p = "A part is either anchored, in which case it stays exactly where you put it and nothing can move it, or it is not, in which case Roblox works out where it should be sixty times a second. Almost every physics problem starts with a part being in the wrong one of those two states." },
			{ h = "Forces, not positions" },
			{ p = "You can set a part's Position directly, but on an unanchored part that fights the simulation and looks like it. To move something physically you apply a force and let Roblox do the rest: an impulse for a single shove, a LinearVelocity for a steady push, an AlignPosition to drag something towards a point." },
			{ blocks = "physPush,physKeepMoving,physHoldAt,physSpin,physStop" },
			{ code = 'local push = Instance.new("LinearVelocity")\npush.VectorVelocity = Vector3.new(0, 0, -40)\npush.MaxForce = 20000\npush.Parent = part' },
			{ note = "These movers attach to the part through an Attachment rather than to the part itself, which is why the blocks make one for you. The older BodyVelocity and BodyPosition still work but are deprecated, so the blocks here write the modern ones." },
			{ h = "Asking what is there" },
			{ p = "A raycast is a straight line thrown into the world that reports the first thing it hits. It is how a gun knows what it shot, how a foot knows what it is standing on, and how a camera knows a wall is in the way. You give it a start, a direction whose length is the range, and a list of things to ignore." },
			{ code = 'local params = RaycastParams.new()\nparams.FilterDescendantsInstances = { character }\nlocal hit = workspace:Raycast(origin, Vector3.new(0, -5, 0), params)' },
			{ p = "The result is nil when the ray hit nothing, so every raycast is followed by a check. When it did hit, the result carries the Instance, the Position where it landed and the Normal of the surface -- enough to place a bullet hole facing the right way." },
			{ warn = "Collision groups are the quiet fix for most physics annoyances. If players are catching on scenery, or bullets are stopping on the shooter, the answer is usually two groups told to ignore each other rather than more code." },
			{ try = "Make a launch pad: a part that, when touched, throws whatever touched it upwards with an impulse. Then add a check so it only launches characters." },
		},
		example = [[
local part = script.Parent

part.Anchored = false
part.CanCollide = true

local attachment = Instance.new("Attachment")
attachment.Parent = part

local push = Instance.new("LinearVelocity")
push.Attachment0 = attachment
push.VectorVelocity = Vector3.new(0, 0, -40)
push.MaxForce = 20000
push.Parent = part

part.Touched:Connect(function(hit)
		local humanoid = hit.Parent:FindFirstChildOfClass("Humanoid")
		if humanoid then
			local root = humanoid.RootPart
			root:ApplyImpulse(Vector3.new(0, 600, 0))
		end
end)
]],
}

T{
		id = "cat-anim", kind = "category", cat = "anim", minutes = 6,
		level = "build",
		title = "Animation: making a character move",
		blurb = "An Animation is an asset, a track is a copy of it playing on one character, and mixing those two up is the usual bug.",
		steps = {
			{ p = "An Animation instance is not a moving thing. It is a pointer at an asset you uploaded, and on its own it does nothing at all. To see movement you load it onto a particular character's Animator, which hands back an AnimationTrack: that track is the copy that is actually playing, and it is the thing you play, stop and speed up." },
			{ h = "Load once, keep the track" },
			{ p = "LoadAnimation is not free, and loading the same animation twice gives you two tracks that will fight each other. Load each animation once when the character appears, keep the track in a variable, and play that same track every time you need it." },
			{ blocks = "animLoad,animPlay,animStop,animSpeed,animLoop" },
			{ code = 'local animator = humanoid:WaitForChild("Animator")\nlocal track = animator:LoadAnimation(wave)\ntrack:Play()' },
			{ note = "Load onto the Animator, not onto the Humanoid. Humanoid:LoadAnimation still works and is deprecated; the Animator is the object that actually owns playback, and on the client it is the only one that replicates properly." },
			{ h = "Priority decides who wins" },
			{ p = "Several tracks can play on one character at once, and priority settles what happens when they disagree about an arm. Idle loses to Movement, which loses to Action, which loses to Action4. A wave that plays but cannot be seen is nearly always a wave sitting at Idle underneath the walk cycle." },
			{ code = 'track.Priority = Enum.AnimationPriority.Action\ntrack.Looped = false' },
			{ h = "Characters come and go" },
			{ p = "Every respawn is a brand new character model with a brand new Humanoid and Animator, and every track you loaded onto the old one is gone. Anything that sets up animations has to hang off CharacterAdded, and it has to run for the character that is already there when the script starts." },
			{ warn = "An animation only plays if you own the asset or it belongs to the group the game belongs to. An animation that works in Studio and does nothing in a live game is almost always this, not your code." },
			{ try = "Load a wave animation on spawn, play it when the player presses a key, and stop it when they move. You will need one track kept in a variable and two events." },
		},
		example = [[
local Players = game:GetService("Players")

local function setUp(character)
		local humanoid = character:WaitForChild("Humanoid")
		local animator = humanoid:WaitForChild("Animator")

		local wave = Instance.new("Animation")
		wave.AnimationId = "rbxassetid://507770239"

		local track = animator:LoadAnimation(wave)
		track.Priority = Enum.AnimationPriority.Action
		track.Looped = false

		humanoid.Died:Connect(function()
			track:Stop()
		end)

		track:Play()
end

Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(setUp)
end)
]],
}

T{
		id = "tip-custom", kind = "tip", minutes = 5, level = "build",
		title = "Blocks of your own",
		blurb = "When you have written the same four blocks three times, turn them into one block and stop writing them.",
		steps = {
			{ p = "The palette covers the language and most of the Roblox API, but it does not cover your game. The bit you write over and over -- award coins, respawn at a checkpoint, fade a label out and back -- is yours, and you can make it a block." },
			{ h = "What a block of yours actually is" },
			{ p = "One thing: Luau with holes in it. Anywhere you write a name in curly brackets, you get a field on the block to fill in. That is the whole idea, and it is why there is no separate language to learn for making blocks." },
			{ code = '{who}.Humanoid.Health += {amount}', partial = true },
			{ p = "That becomes a block reading `Heal someone {who} {amount}` with two boxes on it. Type a character into one and a number into the other and it writes the line back out with your text in the holes." },
			{ h = "A hole on its own line is a place for blocks" },
			{ p = "There is one exception to the rule above, and it earns its keep. If a placeholder sits alone on a line with nothing else, it becomes a slot -- a mouth the block opens so you can drop other blocks inside it, the same way an if block does." },
			{ code = 'if {who}:GetAttribute("Admin") then\n\t{body}\nend', partial = true },
			{ h = "Four ways to get one" },
			{ list = {
				"Write the Luau yourself, with New block in the palette.",
				"Select a stack on the canvas and choose Make into a block; the code it writes becomes the block.",
				"Point at a define block and get a block that calls that function.",
				"Point at a ModuleScript and get one block per function it exports.",
			} },
			{ p = "Whichever route you take, you land in the same editor, with the Luau in front of you and a live preview of what the block will read like on the canvas." },
			{ h = "What it does to the generated script" },
			{ p = "A block with no slots is written into your script once, as a real local function, no matter how many times you use it -- so ten uses cost you one function and ten short calls. A block with slots has to be written out in full at each use, because the blocks you dropped inside it are different every time." },
			{ note = "You can open one of your blocks as a canvas and edit its insides with blocks, then save it back. The placeholders come along as ordinary names while you are in there, so they survive the trip." },
			{ warn = "Your blocks live in your Studio, not in the place file. When one is worth keeping, use Save to a ModuleScript in setup: that writes the whole library into a script you can commit, share, or drop into another game." },
			{ try = "Find something you have built twice. Select it, make it into a block, and use it in both places. Then look at the Luau and count how many times the body appears." },
		},
		example = [[
local function healSomeone(who, amount)
		who.Humanoid.Health += amount
end

local part = script.Parent

part.Touched:Connect(function(hit)
		local character = hit.Parent
		local humanoid = character:FindFirstChild("Humanoid")
		if humanoid then
			healSomeone(character, 10)
		end
end)
]],
}

--=============================================================================
-- lookups
--=============================================================================

j.byId = {}
for index, entry in ipairs(j.tutorials) do
		entry.index = index
		j.byId[entry.id] = entry
end

function j.count()
		return #j.tutorials
end

function j.categories()
		local list = {}
		for _, entry in ipairs(j.tutorials) do
			if entry.kind == "category" then list[#list + 1] = entry end
		end
		return list
end

function j.tips()
		local list = {}
		for _, entry in ipairs(j.tutorials) do
			if entry.kind == "tip" then list[#list + 1] = entry end
		end
		return list
end

function j.forCategory(catId)
		for _, entry in ipairs(j.tutorials) do
			if entry.cat == catId then return entry end
		end
		return nil
end

-- Plain-text haystack for the search box, built once.
local haystacks = {}
for _, entry in ipairs(j.tutorials) do
		local parts = { entry.title, entry.blurb, entry.level, entry.kind }
		for _, step in ipairs(entry.steps) do
			parts[#parts + 1] = step.p or step.h or step.note or step.warn
				or step.try or step.blocks or ""
			for _, line in ipairs(step.list or {}) do parts[#parts + 1] = line end
		end
		haystacks[entry.id] = string.lower(table.concat(parts, " "))
end

function j.search(query)
		query = string.lower(string.match(query or "", "^%s*(.-)%s*$"))
		if query == "" then return j.tutorials end
		local hits = {}
		for _, entry in ipairs(j.tutorials) do
			local haystack = haystacks[entry.id]
			local score = nil
			if string.find(string.lower(entry.title), query, 1, true) then
				score = 3
			elseif string.find(string.lower(entry.blurb), query, 1, true) then
				score = 2
			elseif string.find(haystack, query, 1, true) then
				score = 1
			end
			if score then hits[#hits + 1] = { entry = entry, score = score } end
		end
		table.sort(hits, function(x, y)
			if x.score ~= y.score then return x.score > y.score end
			return x.entry.index < y.entry.index
		end)
		local out = {}
		for _, hit in ipairs(hits) do out[#out + 1] = hit.entry end
		return out
end

-- Rough reading time, so the listed minutes stay honest as text is edited.
function j.words(entry)
		local total = 0
		for _, step in ipairs(entry.steps) do
			for _, key in ipairs({ "p", "h", "note", "warn", "try" }) do
				for _ in string.gmatch(step[key] or "", "%S+") do total = total + 1 end
			end
			for _, line in ipairs(step.list or {}) do
				for _ in string.gmatch(line, "%S+") do total = total + 1 end
			end
		end
		return total
end

return j
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX11">
			<Properties>
				<string name="Name">k</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- k  ·  the tutorials tab
--
-- A contents list on the left, the lesson on the right.  Two things make this
-- more than a help file: the block names in a lesson are live -- click one and
-- it lands on your canvas -- and lessons that carry an example can rebuild that
-- example as blocks, through the same importer the Import tab uses.

local a = require(script.Parent.a)
local b = require(script.Parent.b)
local c = require(script.Parent.c)
local d = require(script.Parent.d)
local h = require(script.Parent.h)
local j = require(script.Parent.j)
local n = require(script.Parent.n)

local k = {}

local LEVELS = {
		start = { label = "first steps", token = "ok" },
		build = { label = "building", token = "accent" },
		deep = { label = "going deeper", token = "cats.vars" },
}

local View = {}
View.__index = View

--=============================================================================
-- inline formatting: `code` spans become accent-coloured
--=============================================================================

local function escape(text)
		text = string.gsub(text, "&", "&amp;")
		text = string.gsub(text, "<", "&lt;")
		text = string.gsub(text, ">", "&gt;")
		return text
end

local function hex(colour)
		return string.format("#%02X%02X%02X",
			math.floor(colour.R * 255 + 0.5),
			math.floor(colour.G * 255 + 0.5),
			math.floor(colour.B * 255 + 0.5))
end

local function inline(text)
		local out = escape(text)
		out = string.gsub(out, "`([^`]+)`", function(code)
			return string.format('<font color="%s">%s</font>', hex(a.c.accent), code)
		end)
		return out
end

--=============================================================================
-- step renderers
--=============================================================================

function View:paragraph(text, order, parent)
		return b.text({
			Text = inline(text),
			RichText = true,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextSize = 13,
			LineHeight = 1.35,
			fg = "text2",
			LayoutOrder = order,
			Parent = parent,
		})
end

function View:heading(text, order, parent)
		local frame = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 30),
			LayoutOrder = order,
			Parent = parent,
		})
		b.text({
			Text = text,
			Size = UDim2.new(1, 0, 0, 20),
			Position = UDim2.fromOffset(0, 8),
			Font = a.font.uiBold,
			TextSize = 13,
			fg = "text",
			Parent = frame,
		})
		return frame
end

function View:codeBlock(code, order, parent)
		local frame = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			bg = "sunken",
			stroke = { color = "lineSoft" },
			radius = a.metric.radius,
			LayoutOrder = order,
			layout = { dir = "y", gap = 0 },
			Parent = parent,
		})
		b.new("UIPadding", {
			PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
			PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
			Parent = frame,
		})
		for index, line in ipairs(n.highlight(code)) do
			b.mono({
				Text = line == "" and " " or line,
				RichText = true,
				Size = UDim2.new(1, 0, 0, 17),
				TextSize = 12,
				LayoutOrder = index,
				Parent = frame,
			})
		end
		return frame
end

function View:calloutBlock(text, order, parent, token, label)
		-- The coloured rule is the frame's own background showing through on the
		-- left; a child sized to the parent's height would hold an auto-sizing
		-- parent open.
		local frame = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order,
			bg = token,
			Parent = parent,
		})
		local column = b.new("Frame", {
			Size = UDim2.new(1, -14, 0, 0),
			Position = UDim2.fromOffset(14, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			layout = { dir = "y", gap = 3 },
			bg = "bg",
			Parent = frame,
		})
		b.micro(label, {
			Size = UDim2.new(1, 0, 0, 14),
			fg = token,
			LayoutOrder = 1,
			Parent = column,
		})
		b.text({
			Text = inline(text),
			RichText = true,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextSize = 12,
			LineHeight = 1.3,
			fg = "text2",
			LayoutOrder = 2,
			Parent = column,
		})
		return frame
end

function View:numbered(lines, order, parent)
		local frame = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order,
			layout = { dir = "y", gap = 6 },
			Parent = parent,
		})
		for index, line in ipairs(lines) do
			local row = b.new("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = index,
				Parent = frame,
			})
			b.mono({
				Text = string.format("%02d", index),
				Size = UDim2.fromOffset(24, 18),
				TextSize = 11,
				fg = "text3",
				Parent = row,
			})
			b.text({
				Text = inline(line),
				RichText = true,
				Size = UDim2.new(1, -30, 0, 0),
				Position = UDim2.fromOffset(30, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextSize = 13,
				LineHeight = 1.3,
				fg = "text2",
				Parent = row,
			})
		end
		return frame
end

-- The blocks a lesson mentions, as chips you can click to place.
function View:blockChips(spec, order, parent)
		local frame = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order,
			Parent = parent,
		})
		b.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(150, 24),
			CellPadding = UDim2.fromOffset(6, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = frame,
		})

		local index = 0
		for id in string.gmatch(spec, "[^,]+") do
			local def = c.get(id)
			if def then
				index = index + 1
				-- the same small block the palette shows, so a lesson names a
				-- block by showing you the thing you will be looking for
				local paint = function() return a.blockColor(def.cat) end
				local chip = b.new("TextButton", {
					Size = UDim2.fromOffset(154, 24),
					LayoutOrder = index,
					bg = paint,
					radius = 5,
					Parent = frame,
				})
				b.new("Frame", {
					Size = UDim2.fromOffset(14, 3),
					Position = UDim2.fromOffset(9, 0),
					bg = "bg",
					radius = 1,
					Parent = chip,
				})
				b.text({
					Text = def.label,
					Size = UDim2.new(1, -20, 1, -3),
					Position = UDim2.fromOffset(10, 3),
					Font = a.font.uiMedium,
					TextSize = 11,
					fg = function() return a.inkOn(a.blockColor(def.cat)) end,
					TextTruncate = Enum.TextTruncate.AtEnd,
					Parent = chip,
				})
				b.tip(chip, def.doc .. "\n\nClick to put this block on the canvas.")
				chip.MouseButton1Click:Connect(function()
					if self.app.canvas then self.app.canvas:addBlock(def.id) end
					if self.app.showTab then self.app.showTab("build") end
					self.app:setStatus("added " .. def.label)
				end)
			end
		end

		return frame
end

--=============================================================================
-- the lesson pane
--=============================================================================

function View:showTutorial(entry)
		self.current = entry
		b.clear(self.reader)
		self.readerScroll.CanvasPosition = Vector2.new(0, 0)

		local order = 1
		local function step() order = order + 1 return order - 1 end

		-- header ------------------------------------------------------------------
		local header = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = step(),
			layout = { dir = "y", gap = 8 },
			Parent = self.reader,
		})

		local meta = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 16),
			LayoutOrder = 1,
			layout = { dir = "x", gap = 10, align = "middle" },
			Parent = header,
		})
		b.mono({
			Text = string.format("%02d", entry.index),
			Size = UDim2.fromOffset(22, 16),
			TextSize = 11,
			fg = "accent",
			LayoutOrder = 1,
			Parent = meta,
		})
		local level = LEVELS[entry.level] or LEVELS.start
		b.micro(level.label, {
			Size = UDim2.fromOffset(80, 16),
			fg = level.token,
			LayoutOrder = 2,
			Parent = meta,
		})
		b.micro(entry.minutes .. " min read", {
			Size = UDim2.fromOffset(90, 16),
			fg = "text3",
			LayoutOrder = 3,
			Parent = meta,
		})
		if entry.cat then
			local cat = c.catById[entry.cat]
			if cat then
				b.micro(cat.name .. " blocks", {
					Size = UDim2.fromOffset(140, 16),
					fg = function(theme) return theme.cats[cat.id] or theme.text2 end,
					LayoutOrder = 4,
					Parent = meta,
				})
			end
		end

		b.text({
			Text = entry.title,
			Size = UDim2.new(1, 0, 0, 30),
			Font = a.font.uiBold,
			TextSize = 20,
			fg = "text",
			LayoutOrder = 2,
			Parent = header,
		})
		b.text({
			Text = entry.blurb,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextSize = 14,
			LineHeight = 1.3,
			fg = "text3",
			LayoutOrder = 3,
			Parent = header,
		})
		b.rule({ LayoutOrder = 4, parent = header, bg = "line" })

		-- body ---------------------------------------------------------------------
		for _, entryStep in ipairs(entry.steps) do
			if entryStep.h then
				self:heading(entryStep.h, step(), self.reader)
			elseif entryStep.p then
				self:paragraph(entryStep.p, step(), self.reader)
			elseif entryStep.code then
				self:codeBlock(entryStep.code, step(), self.reader)
			elseif entryStep.blocks then
				self:blockChips(entryStep.blocks, step(), self.reader)
			elseif entryStep.note then
				self:calloutBlock(entryStep.note, step(), self.reader, "accent", "worth knowing")
			elseif entryStep.warn then
				self:calloutBlock(entryStep.warn, step(), self.reader, "err", "watch out")
			elseif entryStep.list then
				self:numbered(entryStep.list, step(), self.reader)
			elseif entryStep.try then
				self:calloutBlock(entryStep.try, step(), self.reader, "ok", "try it")
			end
		end

		-- footer --------------------------------------------------------------------
		b.spacer(10, step()).Parent = self.reader
		b.rule({ LayoutOrder = step(), parent = self.reader, bg = "lineSoft" })

		local footer = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 34),
			LayoutOrder = step(),
			layout = { dir = "x", gap = 8 },
			Parent = self.reader,
		})

		if entry.example then
			local load = b.button({
				label = "Build this example",
				Size = UDim2.fromOffset(150, 28),
				bg = "accent",
				labelColor = "accentInk",
				LayoutOrder = 1,
				Parent = footer,
			})
			b.tip(load, "Replaces the canvas with this lesson's example.\nCtrl+Z brings your own work back.")
			load.MouseButton1Click:Connect(function()
				local doc, report, err = h.fromCode(entry.example, entry.title)
				if not doc then
					self.app:setStatus("that example did not convert: " .. err.msg)
					return
				end
				self.app:setDoc(doc, "load example")
				if self.app.showTab then self.app.showTab("build") end
				self.app:setStatus("built " .. d.count(doc) .. " blocks from " .. entry.title)
			end)
		end

		local previous = j.tutorials[entry.index - 1]
		local following = j.tutorials[entry.index + 1]

		if previous then
			local button = b.button({
				label = "< " .. b.truncate(previous.title, 22),
				Size = UDim2.fromOffset(170, 28),
				LayoutOrder = 2,
				Parent = footer,
			})
			button.MouseButton1Click:Connect(function() self:open(previous) end)
		end
		if following then
			local button = b.button({
				label = b.truncate(following.title, 22) .. " >",
				Size = UDim2.fromOffset(170, 28),
				LayoutOrder = 3,
				Parent = footer,
			})
			button.MouseButton1Click:Connect(function() self:open(following) end)
		end

		b.spacer(30, step()).Parent = self.reader
end

function View:open(entry)
		local read = self.app.settings.read
		if type(read) ~= "table" then read = {} end
		read[entry.id] = true
		self.app:setSetting("read", read)
		self:showTutorial(entry)
		self:refreshList()
end

--=============================================================================
-- contents list
--=============================================================================

function View:listRow(entry, order)
		local read = type(self.app.settings.read) == "table" and self.app.settings.read or {}
		local isCurrent = self.current and self.current.id == entry.id

		local row = b.new("TextButton", {
			Size = UDim2.new(1, 0, 0, 40),
			LayoutOrder = order,
			bg = isCurrent and "raised" or "panel",
			Parent = self.list,
		})

		b.mono({
			Text = string.format("%02d", entry.index),
			Size = UDim2.fromOffset(24, 18),
			Position = UDim2.fromOffset(8, 5),
			TextSize = 10,
			fg = isCurrent and "accent" or "text3",
			Parent = row,
		})

		b.text({
			Text = entry.title,
			Size = UDim2.new(1, -50, 0, 18),
			Position = UDim2.fromOffset(34, 4),
			TextSize = 12,
			Font = isCurrent and a.font.uiBold or a.font.ui,
			fg = isCurrent and "text" or "text2",
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = row,
		})

		b.text({
			Text = b.truncate(entry.blurb, 46),
			Size = UDim2.new(1, -50, 0, 14),
			Position = UDim2.fromOffset(34, 20),
			TextSize = 10,
			fg = "text3",
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = row,
		})

		if read[entry.id] then
			b.new("Frame", {
				Size = UDim2.fromOffset(4, 4),
				Position = UDim2.new(1, -14, 0, 8),
				bg = "ok",
				radius = 2,
				Parent = row,
			})
		end

		local level = LEVELS[entry.level] or LEVELS.start
		b.new("Frame", {
			Size = UDim2.fromOffset(2, 40),
			bg = isCurrent and "accent" or (entry.kind == "category" and level.token or "lineSoft"),
			BackgroundTransparency = isCurrent and 0 or 0.4,
			Parent = row,
		})

		b.hover(row, function()
			if not isCurrent then row.BackgroundColor3 = a.c.raised end
		end, function()
			if not isCurrent then row.BackgroundColor3 = a.c.panel end
		end)
		row.MouseButton1Click:Connect(function() self:open(entry) end)
		return row
end

function View:refreshList()
		b.clear(self.list)
		local entries = j.search(self.query or "")
		local order = 1
		local shown = 0

		local function heading(text)
			b.micro(text, {
				Size = UDim2.new(1, 0, 0, 22),
				LayoutOrder = order,
				fg = "text3",
				Parent = self.list,
			})
			order = order + 1
		end

		local wantCategories = self.filter ~= "tips"
		local wantTips = self.filter ~= "categories"

		local categories, tips = {}, {}
		for _, entry in ipairs(entries) do
			if entry.kind == "category" then
				categories[#categories + 1] = entry
			else
				tips[#tips + 1] = entry
			end
		end

		if wantCategories and #categories > 0 then
			heading("one per block category")
			for _, entry in ipairs(categories) do
				self:listRow(entry, order)
				order = order + 1
				shown = shown + 1
			end
		end
		if wantTips and #tips > 0 then
			b.spacer(10, order).Parent = self.list
			order = order + 1
			heading("tips and technique")
			for _, entry in ipairs(tips) do
				self:listRow(entry, order)
				order = order + 1
				shown = shown + 1
			end
		end

		if shown == 0 then
			b.text({
				Text = "No lesson mentions that.",
				Size = UDim2.new(1, 0, 0, 40),
				fg = "text3",
				LayoutOrder = order,
				Parent = self.list,
			})
		end

		local read = type(self.app.settings.read) == "table" and self.app.settings.read or {}
		local done = 0
		for _, entry in ipairs(j.tutorials) do
			if read[entry.id] then done = done + 1 end
		end
		self.progress.Text = done .. " of " .. j.count() .. " read"
end

--=============================================================================
-- assembly
--=============================================================================

function k.mount(app, parent)
		local view = setmetatable({ app = app, query = "", filter = "all" }, View)

		view.frame = b.new("Frame", {
			Name = "Tutorials",
			Size = UDim2.fromScale(1, 1),
			Visible = false,
			bg = "bg",
			Parent = parent,
		})

		-- contents -----------------------------------------------------------------
		local side = b.new("Frame", {
			Size = UDim2.new(0, 300, 1, 0),
			bg = "panel",
			Parent = view.frame,
		})
		b.rule({ Position = UDim2.new(1, -1, 0, 0), parent = side })

		local searchRow = b.new("Frame", {
			Size = UDim2.new(1, -24, 0, 26),
			Position = UDim2.fromOffset(12, 12),
			bg = "field",
			stroke = { color = "fieldLine" },
			radius = a.metric.radius,
			Parent = side,
		})
		local search = b.new("TextBox", {
			Text = "",
			PlaceholderText = "search " .. j.count() .. " lessons",
			ClearTextOnFocus = false,
			Size = UDim2.new(1, -16, 1, 0),
			Position = UDim2.fromOffset(8, 0),
			Font = a.font.mono,
			TextSize = 12,
			fg = "text",
			ph = "text3",
			Parent = searchRow,
		})
		search:GetPropertyChangedSignal("Text"):Connect(function()
			view.query = search.Text
			view:refreshList()
		end)

		local filters = b.new("Frame", {
			Size = UDim2.new(1, -24, 0, 22),
			Position = UDim2.fromOffset(12, 46),
			layout = { dir = "x", gap = 6 },
			Parent = side,
		})
		for index, option in ipairs({ { "all", "all" }, { "categories", "blocks" },
			{ "tips", "technique" } }) do
			local button = b.button({
				label = option[2],
				Size = UDim2.fromOffset(80, 20),
				LayoutOrder = index,
				bg = view.filter == option[1] and "accentSoft" or "raised",
				Parent = filters,
			})
			button.MouseButton1Click:Connect(function()
				view.filter = option[1]
				for _, other in ipairs(filters:GetChildren()) do
					if other:IsA("TextButton") then
						local isChosen = other == button
						b.states(other, isChosen and "accentSoft" or "raised")
					end
				end
				view:refreshList()
			end)
		end

		view.progress = b.mono({
			Text = "",
			Size = UDim2.new(1, -24, 0, 16),
			Position = UDim2.fromOffset(12, 72),
			TextSize = 10,
			fg = "text3",
			Parent = side,
		})

		local listScroll = b.new("ScrollingFrame", {
			Size = UDim2.new(1, -6, 1, -96),
			Position = UDim2.fromOffset(0, 94),
			Parent = side,
		})
		view.list = listScroll
		local listLayout = b.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 1),
			Parent = listScroll,
		})
		b.new("UIPadding", {
			PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
			PaddingBottom = UDim.new(0, 20), Parent = listScroll })
		b.autoCanvas(listScroll, listLayout, 24)

		-- reader --------------------------------------------------------------------
		view.readerScroll = b.new("ScrollingFrame", {
			Size = UDim2.new(1, -300, 1, 0),
			Position = UDim2.fromOffset(300, 0),
			bg = "bg",
			Parent = view.frame,
		})
		view.reader = b.new("Frame", {
			Size = UDim2.new(1, -80, 0, 0),
			Position = UDim2.fromOffset(40, 24),
			AutomaticSize = Enum.AutomaticSize.Y,
			layout = { dir = "y", gap = 12 },
			Parent = view.readerScroll,
		})
		b.new("UISizeConstraint", {
			MaxSize = Vector2.new(720, math.huge), Parent = view.reader })
		local readerLayout = view.reader:FindFirstChildWhichIsA("UIListLayout")
		readerLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			view.readerScroll.CanvasSize =
				UDim2.new(0, 0, 0, readerLayout.AbsoluteContentSize.Y + 80)
		end)

		a.onChange(function()
			view:refreshList()
			if view.current then view:showTutorial(view.current) end
		end)

		-- opening the tab is not the same as reading a lesson, so this one does not
		-- count towards progress until it is chosen from the list
		view:showTutorial(j.tutorials[1])
		view:refreshList()
		return view
end

return k
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX12">
			<Properties>
				<string name="Name">l</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- l  ·  the palette
--
-- Seven hundred blocks need more than one long list, so this has four things
-- the old palette did not: subgroups inside each category, a strip of recent
-- and starred blocks at the top, search results grouped by category, and a
-- filter that hides server-only blocks while you are building a LocalScript.
--
-- A row can be clicked (drops the block on the canvas near your selection) or
-- dragged straight onto it.  Your own blocks live in their own category, with
-- the group names you gave them.

local a = require(script.Parent.a)
local b = require(script.Parent.b)
local c = require(script.Parent.c)
local i = require(script.Parent.i)
local q = require(script.Parent.q)

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local l = {}

local RECENT_LIMIT = 6

local View = {}
View.__index = View

--=============================================================================
-- search
--=============================================================================

local function rank(query, def)
		local best = i.score(query, def.label)
		local byId = i.score(query, def.id)
		if byId and (not best or byId > best) then best = byId end
		if string.find(def.searchText, query, 1, true) then
			best = math.max(best or 0, 24)
		end
		local firstWord = string.match(def.label, "^%S+")
		if firstWord and string.sub(string.lower(firstWord), 1, #query) == query then
			best = (best or 0) + 30
		end
		return best
end

function l.search(query, allowed)
		query = string.lower(string.match(query or "", "^%s*(.-)%s*$"))
		if query == "" then return nil end
		local hits = {}
		for _, def in ipairs(c.order) do
			if not allowed or allowed(def) then
				local score = rank(query, def)
				if score then hits[#hits + 1] = { def = def, score = score } end
			end
		end
		table.sort(hits, function(x, y)
			if x.score ~= y.score then return x.score > y.score end
			return x.def.label < y.def.label
		end)
		local out = {}
		for _, hit in ipairs(hits) do out[#out + 1] = hit.def end
		return out
end

--=============================================================================
-- what belongs in this project
--=============================================================================

function View:allows(def)
		if not self.app.settings.filterBySide then return true end
		if not def.side then return true end
		local kind = self.app:scriptKind()
		if kind == "LocalScript" then return def.side ~= "server" end
		if kind == "Script" then return def.side ~= "client" end
		return true
end

--=============================================================================
-- rows
--=============================================================================

-- A palette entry is a small version of the block it places, notch and all, so
-- that what you pick up looks like what you dropped.
function View:blockRow(def, order)
		local row = b.new("TextButton", {
			Size = UDim2.new(1, 0, 0, 30),
			LayoutOrder = order,
			bg = "panel",
		})

		local paint = function() return a.blockColor(def.cat) end
		local chip = b.new("Frame", {
			Size = UDim2.new(1, -52, 0, 24),
			Position = UDim2.fromOffset(4, 3),
			bg = paint,
			radius = 5,
			Parent = row,
		})
		-- the notch, filled with the palette behind it, so it reads as a cut
		b.new("Frame", {
			Size = UDim2.fromOffset(14, 3),
			Position = UDim2.fromOffset(9, 0),
			bg = "panel",
			radius = 1,
			Parent = chip,
		})
		-- and the tab underneath, half out of the bottom edge
		b.new("Frame", {
			Size = UDim2.fromOffset(14, 3),
			Position = UDim2.fromOffset(9, 24),
			bg = paint,
			radius = 1,
			Parent = row,
		})

		b.text({
			Text = def.label,
			Size = UDim2.new(1, -22, 1, -4),
			Position = UDim2.fromOffset(10, 3),
			Font = a.font.uiMedium,
			TextSize = 12,
			fg = function() return a.inkOn(a.blockColor(def.cat)) end,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = chip,
		})

		-- starring keeps a block at the top of the palette
		local favourites = self.app.settings.favourites or {}
		local star = b.new("TextButton", {
			Size = UDim2.fromOffset(18, 30),
			Position = UDim2.new(1, -40, 0, 0),
			bg = "panel",
			BackgroundTransparency = 1,
			Parent = row,
		})
		local starMark = b.mono({
			Text = "+",
			Size = UDim2.fromScale(1, 1),
			TextSize = 13,
			fg = favourites[def.id] and "accent" or "text3",
			TextTransparency = favourites[def.id] and 0 or 1,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = star,
		})
		b.tip(star, favourites[def.id] and "Remove from your starred blocks."
			or "Keep this block at the top of the palette.")
		star.MouseButton1Click:Connect(function()
			self:toggleFavourite(def.id)
		end)

		local plus = b.mono({
			Text = ">",
			Size = UDim2.fromOffset(16, 30),
			Position = UDim2.new(1, -18, 0, 0),
			TextSize = 12,
			fg = "text3",
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTransparency = 1,
			Parent = row,
		})

		b.hover(row, function()
			row.BackgroundColor3 = a.c.raised
			plus.TextTransparency = 0
			if not favourites[def.id] then starMark.TextTransparency = 0.45 end
		end, function()
			row.BackgroundColor3 = a.c.panel
			plus.TextTransparency = 1
			if not favourites[def.id] then starMark.TextTransparency = 1 end
		end)

		b.tip(row, function()
			local parts = { def.doc }
			if def.side then
				parts[#parts + 1] = "\nOnly works on the " .. def.side .. "."
			end
			parts[#parts + 1] = "\n" .. def.sample
			return table.concat(parts, "")
		end)

		-- click to place, drag to carry
		row.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
			local canvas = self.app.canvas
			if not canvas then return end
			local gui = self.frame:FindFirstAncestorWhichIsA("PluginGui")
			if not gui then return end

			local start = gui:GetRelativeMousePosition()
			task.spawn(function()
				local carried = false
				while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
					local now = gui:GetRelativeMousePosition()
					if not carried and (now - start).Magnitude > 6 then
						carried = true
						b.hideTip()
						self:remember(def.id)
						canvas:spawnAndDrag(def.id, now)
						return
					end
					RunService.Heartbeat:Wait()
				end
				if not carried then
					self:remember(def.id)
					canvas:addBlock(def.id)
					self.app:setStatus("added " .. def.label)
				end
			end)
		end)

		return row
end

function View:heading(text, order, token)
		return b.micro(text, {
			Size = UDim2.new(1, 0, 0, 18),
			LayoutOrder = order,
			fg = token or "text3",
			Parent = self.scroll,
		})
end

function View:categoryHeader(cat, order, open, count)
		local header = b.new("TextButton", {
			Size = UDim2.new(1, 0, 0, 28),
			LayoutOrder = order,
			bg = "panel",
		})

		local chip = b.chip(cat.glyph, a.catColor(cat.id), 14)
		chip.Position = UDim2.fromOffset(0, 7)
		chip.Parent = header

		b.text({
			Text = cat.name,
			Size = UDim2.new(1, -70, 1, 0),
			Position = UDim2.fromOffset(22, 0),
			Font = open and a.font.uiBold or a.font.uiMedium,
			fg = open and "text" or "text2",
			Parent = header,
		})

		b.mono({
			Text = tostring(count),
			Size = UDim2.fromOffset(24, 28),
			Position = UDim2.new(1, -40, 0, 0),
			TextSize = 10,
			fg = "text3",
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = header,
		})

		local chevron = b.chevron(8, open and "accent" or "text3")
		chevron.Position = UDim2.new(1, -14, 0, 12)
		chevron.Rotation = open and 0 or -90
		chevron.Parent = header

		b.hover(header, function() header.BackgroundColor3 = a.c.raised end,
			function() header.BackgroundColor3 = a.c.panel end)

		header.MouseButton1Click:Connect(function()
			self.openCat = (self.openCat == cat.id) and nil or cat.id
			self:refresh()
		end)

		b.tip(header, cat.blurb)
		return header
end

--=============================================================================
-- state
--=============================================================================

function View:toggleFavourite(defId)
		local favourites = {}
		for key, value in pairs(self.app.settings.favourites or {}) do
			favourites[key] = value
		end
		favourites[defId] = (not favourites[defId]) or nil
		self.app:setSetting("favourites", favourites)
		self:refresh()
end

function View:remember(defId)
		local recents = {}
		for _, id in ipairs(self.app.settings.recents or {}) do
			if id ~= defId then recents[#recents + 1] = id end
		end
		table.insert(recents, 1, defId)
		while #recents > RECENT_LIMIT do
			recents[#recents] = nil
		end
		self.app:setSetting("recents", recents)
		self:refresh()
end

function View:focusSearch()
		self.search:CaptureFocus()
end

--=============================================================================
-- assembly
--=============================================================================

function l.mount(app, parent)
		local view = setmetatable({ app = app, openCat = "events", query = "" }, View)

		view.frame = b.new("Frame", {
			Name = "Palette",
			Size = UDim2.new(0, 236, 1, 0),
			bg = "panel",
			Parent = parent,
		})
		app.paletteFrame = view.frame

		b.rule({ Position = UDim2.new(1, -1, 0, 0), parent = view.frame })

		-- search ------------------------------------------------------------------
		local searchRow = b.new("Frame", {
			Size = UDim2.new(1, -20, 0, 26),
			Position = UDim2.fromOffset(10, 10),
			bg = "field",
			stroke = { color = "fieldLine" },
			radius = a.metric.radius,
			Parent = view.frame,
		})

		b.mono({
			Text = "/",
			Size = UDim2.fromOffset(16, 26),
			Position = UDim2.fromOffset(8, 0),
			fg = "text3",
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = searchRow,
		})

		view.search = b.new("TextBox", {
			Text = "",
			PlaceholderText = "search " .. c.count() .. " blocks",
			ClearTextOnFocus = false,
			Size = UDim2.new(1, -34, 1, 0),
			Position = UDim2.fromOffset(26, 0),
			Font = a.font.mono,
			TextSize = 12,
			fg = "text",
			ph = "text3",
			Parent = searchRow,
		})
		view.search:GetPropertyChangedSignal("Text"):Connect(function()
			view.query = view.search.Text
			view:refresh()
		end)
		view.search.FocusLost:Connect(function(enterPressed)
			if not enterPressed or not view.topHit then return end
			if app.canvas then
				view:remember(view.topHit.id)
				app.canvas:addBlock(view.topHit.id)
				app:setStatus("added " .. view.topHit.label)
			end
		end)

		-- the side filter ------------------------------------------------------------
		local filterRow = b.new("Frame", {
			Size = UDim2.new(1, -20, 0, 20),
			Position = UDim2.fromOffset(10, 42),
			Parent = view.frame,
		})
		view.filterLabel = b.mono({
			Text = "",
			Size = UDim2.new(1, -60, 1, 0),
			TextSize = 10,
			fg = "text3",
			Parent = filterRow,
		})
		local filterButton = b.button({
			label = "all",
			Size = UDim2.fromOffset(54, 18),
			Position = UDim2.new(1, -54, 0, 1),
			Parent = filterRow,
		})
		local filterText = filterButton:FindFirstChildWhichIsA("TextLabel")
		b.tip(filterButton, "Show every block, or only the ones that work in the\n" ..
			"kind of script this project is heading for.")
		filterButton.MouseButton1Click:Connect(function()
			app:setSetting("filterBySide", not app.settings.filterBySide)
			filterText.Text = app.settings.filterBySide and "fits" or "all"
			view:refresh()
		end)
		filterText.Text = app.settings.filterBySide and "fits" or "all"

		-- list --------------------------------------------------------------------
		view.scroll = b.new("ScrollingFrame", {
			Size = UDim2.new(1, -6, 1, -70),
			Position = UDim2.fromOffset(0, 68),
			Parent = view.frame,
		})
		view.layout = b.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 0),
			Parent = view.scroll,
		})
		b.new("UIPadding", {
			PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 12), Parent = view.scroll })
		b.autoCanvas(view.scroll, view.layout, 16)

		-- dropping a block back onto the palette throws it away
		app:on("dragOverPalette", function(over)
			view.frame.BackgroundColor3 = over and a.c.err:Lerp(a.c.panel, 0.75) or a.c.panel
			if over then app:setStatus("release to delete") end
		end)

		app:on("customs", function() view:refresh() end)
		app:on("doc", function() view:refreshIfKindChanged() end)
		a.onChange(function() view:refresh() end)
		view:refresh()
		return view
end

-- The side filter depends on the script kind, so the palette follows it.
function View:refreshIfKindChanged()
		local kind = self.app:scriptKind()
		if kind ~= self.lastKind then
			self.lastKind = kind
			self:refresh()
		end
end

--=============================================================================
-- drawing
--=============================================================================

function View:refresh()
		b.clear(self.scroll)
		local order = 0
		local function next_() order = order + 1 return order end

		local allowed = function(def) return self:allows(def) end
		local kind = self.app:scriptKind()
		self.lastKind = kind
		self.filterLabel.Text = self.app.settings.filterBySide
			and ("showing what fits a " .. kind) or "showing every block"

		-- search results, grouped by category ---------------------------------------
		local hits = l.search(self.query, allowed)
		self.topHit = hits and hits[1] or nil
		if hits then
			if #hits == 0 then
				b.text({
					Text = "Nothing matches. Try a word from the Luau you want,\nsuch as 'clone' or 'tween'.",
					Size = UDim2.new(1, 0, 0, 44),
					TextWrapped = true,
					fg = "text3",
					LayoutOrder = next_(),
					Parent = self.scroll,
				})
				return
			end

			local byCat, catOrder = {}, {}
			for _, def in ipairs(hits) do
				if not byCat[def.cat] then
					byCat[def.cat] = {}
					catOrder[#catOrder + 1] = def.cat
				end
				table.insert(byCat[def.cat], def)
			end

			self:heading(#hits .. " matching", next_(), "accent")
			for _, catId in ipairs(catOrder) do
				local cat = c.catById[catId]
				self:heading(cat.name .. "  " .. #byCat[catId], next_())
				for _, def in ipairs(byCat[catId]) do
					self:blockRow(def, next_()).Parent = self.scroll
				end
			end
			return
		end

		-- starred and recent ----------------------------------------------------------
		local favourites = self.app.settings.favourites or {}
		local starred = {}
		for defId in pairs(favourites) do
			local def = c.get(defId)
			if def then starred[#starred + 1] = def end
		end
		table.sort(starred, function(x, y) return x.label < y.label end)
		if #starred > 0 then
			self:heading("starred", next_(), "accent")
			for _, def in ipairs(starred) do
				self:blockRow(def, next_()).Parent = self.scroll
			end
			b.spacer(8, next_()).Parent = self.scroll
		end

		local recents = {}
		for _, defId in ipairs(self.app.settings.recents or {}) do
			local def = c.get(defId)
			if def and not favourites[defId] then recents[#recents + 1] = def end
		end
		if #recents > 0 then
			self:heading("recent", next_())
			for _, def in ipairs(recents) do
				self:blockRow(def, next_()).Parent = self.scroll
			end
			b.spacer(8, next_()).Parent = self.scroll
		end

		-- categories -------------------------------------------------------------------
		for _, cat in ipairs(c.cats) do
			local blocks = {}
			for _, def in ipairs(c.byCat(cat.id)) do
				if allowed(def) then blocks[#blocks + 1] = def end
			end

			local open = self.openCat == cat.id
			self:categoryHeader(cat, next_(), open, #blocks).Parent = self.scroll

			if open then
				b.rule({ LayoutOrder = next_(), parent = self.scroll, bg = "lineSoft" })
				b.text({
					Text = cat.blurb,
					Size = UDim2.new(1, 0, 0, 30),
					TextWrapped = true,
					TextSize = 11,
					fg = "text3",
					LayoutOrder = next_(),
					Parent = self.scroll,
				})

				if cat.id == "custom" then
					self:customControls(next_)
				end

				-- subgroups keep a category of seventy readable
				local groups, byGroup = {}, {}
				for _, def in ipairs(blocks) do
					local group = def.group or "General"
					if not byGroup[group] then
						byGroup[group] = {}
						groups[#groups + 1] = group
					end
					table.insert(byGroup[group], def)
				end

				for _, group in ipairs(groups) do
					if #groups > 1 then
						self:heading(group, next_())
					end
					for _, def in ipairs(byGroup[group]) do
						self:blockRow(def, next_()).Parent = self.scroll
					end
				end

				if #blocks == 0 then
					b.text({
						Text = cat.id == "custom"
							and "You have not made any blocks yet."
							or "Nothing here fits a " .. kind .. ". Switch the filter to see them.",
						Size = UDim2.new(1, 0, 0, 30),
						TextWrapped = true,
						TextSize = 11,
						fg = "text3",
						LayoutOrder = next_(),
						Parent = self.scroll,
					})
				end
				b.spacer(10, next_()).Parent = self.scroll
			end
		end
end

-- The buttons at the top of your own category.
function View:customControls(next_)
		local row = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 28),
			LayoutOrder = next_(),
			layout = { dir = "x", gap = 6 },
			Parent = self.scroll,
		})

		local make = b.button({
			label = "New block",
			Size = UDim2.fromOffset(96, 24),
			LayoutOrder = 1,
			bg = "accent",
			labelColor = "accentInk",
			Parent = row,
		})
		b.tip(make, "Write a block of your own, out of Luau with {holes} in it.")
		make.MouseButton1Click:Connect(function()
			if self.app.openBlockEditor then self.app.openBlockEditor(nil) end
		end)

		local fromCanvas = b.button({
			label = "From selection",
			Size = UDim2.fromOffset(110, 24),
			LayoutOrder = 2,
			Parent = row,
		})
		b.tip(fromCanvas, "Turn the selected block, and everything under it,\ninto a block of your own.")
		fromCanvas.MouseButton1Click:Connect(function()
			if self.app.makeBlockFromSelection then self.app.makeBlockFromSelection() end
		end)

		-- one edit row per block you have made
		for _, custom in ipairs(q.list()) do
			local editRow = b.new("Frame", {
				Size = UDim2.new(1, 0, 0, 20),
				LayoutOrder = next_(),
				Parent = self.scroll,
			})
			b.mono({
				Text = custom.label,
				Size = UDim2.new(1, -60, 1, 0),
				Position = UDim2.fromOffset(12, 0),
				TextSize = 11,
				fg = "text3",
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = editRow,
			})
			local edit = b.button({
				label = "edit",
				Size = UDim2.fromOffset(46, 18),
				Position = UDim2.new(1, -48, 0, 1),
				Parent = editRow,
			})
			edit.MouseButton1Click:Connect(function()
				if self.app.openBlockEditor then self.app.openBlockEditor(custom.id) end
			end)
		end
end

return l
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX13">
			<Properties>
				<string name="Name">m</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- m  ·  the canvas
--
-- Draws the document, and handles everything you do with a mouse: dragging
-- stacks about, snapping them together, editing fields, panning and zooming.
--
-- Layout is left to Roblox.  Every block is an auto-sizing frame with a list
-- layout inside it, so a field growing as you type widens its block, which
-- widens its parent, with no measuring code anywhere.  What this module does
-- own is where the drop indicator goes, which is the one thing the engine
-- cannot work out for us.

local a = require(script.Parent.a)
local b = require(script.Parent.b)
local c = require(script.Parent.c)
local d = require(script.Parent.d)
local i = require(script.Parent.i)

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local m = {}

local GRID = 20
local SNAP_RADIUS = 96
local LIFT_SECONDS = 0.16
local MIN_ZOOM, MAX_ZOOM = 0.5, 2

--=============================================================================
-- completion popup
--
-- One popup, reused by whichever field has focus.
--=============================================================================

local KIND_GLYPH = {
		property = "p", method = "m", event = "e", variable = "v", parameter = "a",
		["function"] = "f", service = "s", class = "c", enum = "u", snippet = "n",
		keyword = "k", global = "g", library = "l", choice = "o",
}

local function kindColor(kind)
		local map = {
			property = "cats.inst", method = "cats.funcs", event = "cats.events",
			variable = "cats.vars", parameter = "cats.vars", ["function"] = "cats.funcs",
			service = "cats.player", class = "cats.data", enum = "cats.logic",
			snippet = "accent", keyword = "cats.control", global = "cats.math",
			library = "cats.math", choice = "cats.text",
		}
		local token = map[kind] or "text3"
		local group, key = string.match(token, "^(%w+)%.(%w+)$")
		if group then return a.c[group][key] end
		return a.c[token]
end

local Popup = {}
Popup.__index = Popup

local function newPopup()
		local self = setmetatable({ open = false, items = {}, index = 1 }, Popup)

		self.frame = b.new("Frame", {
			Visible = false,
			Size = UDim2.fromOffset(340, 10),
			AutomaticSize = Enum.AutomaticSize.Y,
			bg = "raised",
			stroke = { color = "line" },
			ZIndex = 800,
			layout = { dir = "y", gap = 0 },
		})

		self.signature = b.mono({
			Name = "Signature",
			Size = UDim2.new(1, 0, 0, 18),
			TextSize = 11,
			fg = "accent",
			Visible = false,
			LayoutOrder = 1,
			ZIndex = 801,
			Parent = self.frame,
		})
		b.new("UIPadding", { PaddingLeft = UDim.new(0, 8), Parent = self.signature })

		self.list = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 2,
			layout = { dir = "y", gap = 0 },
			ZIndex = 801,
		})
		self.list.Parent = self.frame

		self.docPane = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 3,
			bg = "panel",
			pad = { x = 8, y = 6 },
			ZIndex = 801,
			Visible = false,
		})
		self.docPane.Parent = self.frame
		self.docText = b.text({
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextSize = 11,
			fg = "text2",
			ZIndex = 802,
			Parent = self.docPane,
		})

		-- Clicking a row takes focus off the field, and the field's FocusLost would
		-- otherwise close the list before the click was delivered.  This flag lets
		-- the field tell "clicked the list" apart from "clicked away".
		self.frame.MouseEnter:Connect(function() self.hovering = true end)
		self.frame.MouseLeave:Connect(function() self.hovering = false end)

		return self
end

function Popup:hide()
		self.open = false
		self.frame.Visible = false
		self.textBox = nil
end

function Popup:rowFor(index, item)
		local row = b.new("TextButton", {
			Size = UDim2.new(1, 0, 0, 20),
			LayoutOrder = index,
			bg = "raised",
			ZIndex = 802,
			layout = { dir = "x", gap = 6, align = "middle" },
		})
		b.new("UIPadding", {
			PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = row })

		local chip = b.new("Frame", {
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = kindColor(item.kind),
			BackgroundTransparency = 0,
			LayoutOrder = 1,
			ZIndex = 803,
			Parent = row,
		})
		b.new("TextLabel", {
			Text = KIND_GLYPH[item.kind] or "?",
			Size = UDim2.fromScale(1, 1),
			Font = a.font.uiBold,
			TextSize = 9,
			TextColor3 = Color3.fromRGB(255, 255, 255),
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 804,
			Parent = chip,
		})

		b.mono({
			Text = item.name,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 20),
			TextSize = 12,
			fg = "text",
			LayoutOrder = 2,
			ZIndex = 803,
			Parent = row,
		})

		if item.detail then
			b.mono({
				Text = b.truncate(item.detail, 34),
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromOffset(0, 20),
				TextSize = 11,
				fg = "text3",
				LayoutOrder = 3,
				ZIndex = 803,
				Parent = row,
			})
		end

		row.MouseButton1Click:Connect(function()
			self:accept(index)
		end)
		row.MouseEnter:Connect(function()
			self:setIndex(index)
		end)
		return row
end

function Popup:setIndex(index)
		if #self.items == 0 then return end
		self.index = math.clamp(index, 1, #self.items)
		for order, row in ipairs(self.rows or {}) do
			local chosen = order == self.index
			row.BackgroundColor3 = chosen and a.c.select or a.c.raised
		end
		local item = self.items[self.index]
		local text = item and (item.doc or item.detail)
		self.docPane.Visible = text ~= nil
		if text then self.docText.Text = text end
end

function Popup:move(delta)
		if not self.open then return false end
		self:setIndex(self.index + delta)
		return true
end

function Popup:accept(index)
		if not self.open or not self.textBox then return false end
		local item = self.items[index or self.index]
		if not item then return false end

		local box = self.textBox
		local text = box.Text
		local cursor = self.cursor
		local head = string.sub(text, 1, self.from - 1)
		local tail = string.sub(text, cursor)
		local insert = item.insert or item.name

		box.Text = head .. insert .. tail
		local caret = self.from + (item.caret or #insert)
		box.CursorPosition = caret

		-- Offering the list again here would just propose the word that was
		-- accepted, so it stays shut until the text changes again.
		self.suppressText = box.Text

		local callback = self.onAccept
		self:hide()
		if callback then callback(box) end
		if not box:IsFocused() then
			task.defer(function() box:CaptureFocus() end)
		end
		return true
end

function Popup:show(textBox, result, signature, anchor)
		local overlay = b.overlay()
		if not overlay then return end
		self.frame.Parent = overlay

		b.clear(self.list)
		self.rows = {}
		self.items = {}
		for index = 1, math.min(#result.items, 9) do
			local item = result.items[index]
			self.items[index] = item
			self.rows[index] = self:rowFor(index, item)
			self.rows[index].Parent = self.list
		end

		self.signature.Visible = signature ~= nil
		if signature then
			self.signature.Text = signature.label ..
				(signature.argument and ("   arg " .. signature.argument) or "")
		end

		if #self.items == 0 and not signature then
			self:hide()
			return
		end

		self.textBox = textBox
		self.from = result.from
		self.cursor = result.cursor
		self.open = #self.items > 0
		self.index = 1
		self:setIndex(1)

		local at = anchor.AbsolutePosition
		local size = anchor.AbsoluteSize
		local origin = overlay.AbsolutePosition
		local x = at.X - origin.X
		local y = at.Y - origin.Y + size.Y + 2
		local maxX = overlay.AbsoluteSize.X - 344
		local frameHeight = 22 * #self.items + 46
		if y + frameHeight > overlay.AbsoluteSize.Y and y > frameHeight then
			y = at.Y - origin.Y - frameHeight - 2
		end
		self.frame.Position = UDim2.fromOffset(math.clamp(x, 4, math.max(4, maxX)), math.max(4, y))
		self.frame.Visible = true
end

local popup = nil
local function getPopup()
		if not popup then popup = newPopup() end
		return popup
end

m.popup = getPopup

--=============================================================================
-- fields
--=============================================================================

-- A field sits on a coloured block, so it is a pale pill rather than a sunken
-- well: the block is the surface, and the pill is the hole cut in it.  Pills
-- are fully rounded; a multi-line field is a panel and keeps square-ish corners
-- because an oval that tall reads as a mistake.
local FIELD_H = 22

-- A text field inside a block: monospace, because a field is Luau.
local function makeTextField(view, block, def, field, value)
		local app = view.app
		local multiline = field.kind == "multiline"

		local box = b.new("TextBox", {
			Text = value,
			PlaceholderText = field.placeholder,
			ClearTextOnFocus = false,
			MultiLine = multiline,
			TextWrapped = false,
			Font = a.font.mono,
			TextSize = a.metric.blockText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
			AutomaticSize = multiline and Enum.AutomaticSize.XY or Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(multiline and 220 or 0, multiline and 44 or FIELD_H),
			bg = "well",
			fg = "wellInk",
			ph = "wellHint",
			radius = multiline and 4 or a.metric.wellRadius,
		})
		b.new("UIPadding", {
			PaddingLeft = UDim.new(0, multiline and 6 or 8),
			PaddingRight = UDim.new(0, multiline and 6 or 8),
			PaddingTop = UDim.new(0, multiline and 5 or 0),
			PaddingBottom = UDim.new(0, multiline and 5 or 0),
			Parent = box,
		})
		b.new("UISizeConstraint", {
			MinSize = Vector2.new(multiline and 220 or 30, multiline and 44 or FIELD_H),
			MaxSize = Vector2.new(multiline and 620 or 460, math.huge),
			Parent = box,
		})

		local pop = getPopup()
		local before = nil

		-- Keyed on which field has focus rather than on which one the popup last
		-- belonged to, so accepting a completion does not stop the list coming back.
		local function refreshCompletion()
			if view.editing ~= box then return end
			local cursor = box.CursorPosition or -1
			if cursor < 0 then return end

			local signature = nil
			if field.kind == "expr" or field.kind == "multiline" then
				signature = i.signature(box.Text, cursor, app.doc)
			end

			-- Straight after an accept, show the signature and nothing else; the
			-- next keystroke changes the text and brings the list back.
			if pop.suppressText == box.Text then
				if signature then
					pop:show(box, { items = {}, from = cursor, cursor = cursor },
						signature, box)
				else
					pop:hide()
				end
				return
			end

			local result = i.complete({
				text = box.Text, cursor = cursor, doc = app.doc, field = field,
			})
			result.cursor = cursor
			pop:show(box, result, signature, box)
		end

		box.Focused:Connect(function()
			-- One editing session is one undo step, even if focus bounces to the
			-- completion list and back in the middle of it.
			if not before then before = app:mark() end
			view.editing = box
			view.refreshCompletion = refreshCompletion
			-- the popup is shared, so it learns who it is serving on focus
			pop.onAccept = function(target)
				if target ~= box then return end
				block.f[field.key] = box.Text
				app:emit("codeDirty")
				task.defer(refreshCompletion)
			end
			app:select(block.id)
			refreshCompletion()
		end)

		box:GetPropertyChangedSignal("Text"):Connect(function()
			block.f[field.key] = box.Text
			app:emit("codeDirty")
			refreshCompletion()
		end)

		box:GetPropertyChangedSignal("CursorPosition"):Connect(refreshCompletion)

		box.FocusLost:Connect(function(enterPressed)
			-- The click landed on the completion list, not away from the field:
			-- leave everything as it is and take focus back.
			if pop.textBox == box and pop.hovering then
				task.defer(function()
					if view.editing == box and not box:IsFocused() then
						box:CaptureFocus()
					end
				end)
				return
			end

			if enterPressed and pop.open and pop.textBox == box then
				pop:accept()
				block.f[field.key] = box.Text
				app:commit("edit " .. field.key, before)
				before = nil
				task.defer(function() box:CaptureFocus() end)
				return
			end
			if pop.textBox == box then pop:hide() end
			view.editing = nil
			view.refreshCompletion = nil
			block.f[field.key] = box.Text
			if before then
				app:commit("edit " .. field.key, before)
				before = nil
			end
			view:render()
		end)

		return box
end

-- A dropdown field: the value, a chevron, and a list on click.
local function makeChoiceField(view, block, def, field, value)
		local app = view.app
		local button = b.new("TextButton", {
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, FIELD_H),
			bg = "well",
			radius = a.metric.wellRadius,
			layout = { dir = "x", gap = 5, align = "middle" },
		})
		b.new("UIPadding", {
			PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 7), Parent = button })

		local label = b.mono({
			Text = value,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, FIELD_H),
			LayoutOrder = 1,
			fg = "wellInk",
			Parent = button,
		})
		local chevron = b.chevron(7, "wellHint")
		chevron.LayoutOrder = 2
		chevron.Parent = button

		button.MouseButton1Click:Connect(function()
			local overlay = b.overlay()
			if not overlay then return end
			if view.menu then view.menu:Destroy() end

			local menu = b.new("Frame", {
				Size = UDim2.fromOffset(math.max(120, button.AbsoluteSize.X + 24), 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				bg = "raised",
				stroke = { color = "line" },
				layout = { dir = "y", gap = 0 },
				ZIndex = 820,
				Parent = overlay,
			})
			view.menu = menu
			local origin = overlay.AbsolutePosition
			menu.Position = UDim2.fromOffset(
				button.AbsolutePosition.X - origin.X,
				button.AbsolutePosition.Y - origin.Y + button.AbsoluteSize.Y + 2)

			for index, option in ipairs(field.options or {}) do
				local row = b.new("TextButton", {
					Size = UDim2.new(1, 0, 0, 20),
					LayoutOrder = index,
					bg = option == value and "select" or "raised",
					ZIndex = 821,
					Parent = menu,
				})
				b.mono({
					Text = option,
					Size = UDim2.new(1, -16, 1, 0),
					Position = UDim2.fromOffset(8, 0),
					TextSize = 12,
					ZIndex = 822,
					Parent = row,
				})
				b.states(row, option == value and "select" or "raised", 0.2)
				row.MouseButton1Click:Connect(function()
					menu:Destroy()
					view.menu = nil
					app:mutate("choose " .. field.key, function()
						block.f[field.key] = option
					end)
				end)
			end
		end)

		return button
end

--=============================================================================
-- block rendering
--=============================================================================

-- The wording on a block is prose, not code, so it is set in the interface
-- face; only the fields are monospace, because only the fields are Luau.
local function textRun(text, ink)
		local trimmed = string.match(text, "^%s*(.-)%s*$")
		if trimmed == "" then return nil end
		return b.text({
			Text = trimmed,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 20),
			Font = a.font.uiMedium,
			fg = ink,
			TextSize = a.metric.blockText,
		})
end

-- One line of a block: alternating words and fields.
local function renderRow(view, block, def, template, order, indentLeft, ink)
		local row = b.new("Frame", {
			Size = UDim2.fromOffset(0, 0),
			AutomaticSize = Enum.AutomaticSize.XY,
			LayoutOrder = order,
			layout = { dir = "x", gap = 6, align = "middle" },
		})
		b.new("UIPadding", {
			PaddingLeft = UDim.new(0, indentLeft or 12),
			PaddingRight = UDim.new(0, 12),
			PaddingTop = UDim.new(0, 3),
			PaddingBottom = UDim.new(0, 3),
			Parent = row,
		})

		local slot = 1
		for _, part in ipairs(template) do
			local child = nil
			if part.t == "text" then
				child = textRun(part.v, ink)
			else
				local field = def.fields[part.k]
				local value = c.fieldValue(def, block, part.k)
				if field and field.kind == "choice" then
					child = makeChoiceField(view, block, def, field, value)
				elseif field then
					child = makeTextField(view, block, def, field, value)
				end
			end
			if child then
				child.LayoutOrder = slot
				slot = slot + 1
				child.Parent = row
			end
		end
		return row
end

--=============================================================================
-- the interlock
--
-- A block has a notch bitten out of its top edge.  What fills that notch is
-- whatever is above the block: the block before it in the run, or the surface
-- the run is sitting on.  So a joint between two blocks shows the upper
-- block's colour carrying on down into the lower one, which is what makes a
-- run read as interlocked rather than as a pile of separate cards.  The last
-- block of a run is followed by a matching tab, so the bottom of a stack has
-- the piece that would fit into whatever came next.
--
-- Nothing here measures anything.  Both pieces are fixed-size rows in the same
-- list layout as everything else, so no child is ever sized from its parent.
--=============================================================================

local function joint(fill, order, name)
		local strip = b.new("Frame", {
			Name = name,
			Size = UDim2.fromOffset(a.metric.notchX + a.metric.notchW + 8, a.metric.notchH),
			LayoutOrder = order,
		})
		b.new("Frame", {
			Size = UDim2.fromOffset(a.metric.notchW, a.metric.notchH),
			Position = UDim2.fromOffset(a.metric.notchX, 0),
			bg = fill,
			radius = 2,
			Parent = strip,
		})
		return strip
end

-- What a notch is filled with, as a theme token so switching themes repaints
-- it: the category above, or the surface the run sits on.
local function fillOf(aboveCat, surface)
		if aboveCat then
			return function() return a.blockColor(aboveCat) end
		end
		return surface
end

local renderList

-- Returns the frame and the category it was painted with, so the next block in
-- the run knows what to fill its notch with.
local function renderBlock(view, block, order, aboveCat, surface)
		local def = c.get(block.k)
		local cat = def and def.cat or "special"
		local paint = function() return a.blockColor(cat) end
		local ink = function() return a.inkOn(a.blockColor(cat)) end

		local frame = b.new("Frame", {
			Name = block.id,
			Size = UDim2.fromOffset(0, 0),
			AutomaticSize = Enum.AutomaticSize.XY,
			LayoutOrder = order,
			bg = paint,
			radius = a.metric.blockRadius,
			layout = { dir = "y", gap = 0 },
		})
		b.new("UIPadding", {
			PaddingBottom = UDim.new(0, a.metric.notchH),
			Parent = frame,
		})
		joint(fillOf(aboveCat, surface), 0, "Notch").Parent = frame

		if not def then
			b.mono({
				Text = "unknown block: " .. tostring(block.k),
				Size = UDim2.fromOffset(240, 22),
				LayoutOrder = 1,
				fg = "err",
				Parent = frame,
			})
			view.frames[block.id] = frame
			return frame, cat
		end

		local order2 = 1
		for _, template in ipairs(def.headTpl) do
			renderRow(view, block, def, template, order2, 12, ink).Parent = frame
			order2 = order2 + 1
		end

		-- A block with slots is a C: the arm runs down the left of the mouth, and
		-- the tail row closes it off underneath.
		for _, slot in ipairs(def.slots) do
			if slot.preTpl then
				renderRow(view, block, def, slot.preTpl, order2, 12, ink).Parent = frame
				order2 = order2 + 1
			end
			local wrap = b.new("Frame", {
				Name = "slot_" .. slot.key,
				Size = UDim2.fromOffset(0, 0),
				AutomaticSize = Enum.AutomaticSize.XY,
				LayoutOrder = order2,
				layout = { dir = "y", gap = 0 },
				Parent = frame,
			})
			b.new("UIPadding", {
				PaddingLeft = UDim.new(0, a.metric.arm),
				PaddingRight = UDim.new(0, 5),
				PaddingBottom = UDim.new(0, 4),
				Parent = wrap,
			})
			-- the mouth is the workspace showing through the C, the way it does in
			-- every block editor worth copying
			local mouth = b.new("Frame", {
				Name = "mouth",
				Size = UDim2.fromOffset(0, 0),
				AutomaticSize = Enum.AutomaticSize.XY,
				bg = "bg",
				radius = 4,
				layout = { dir = "y", gap = a.metric.rowGap },
				Parent = wrap,
			})
			b.new("UIPadding", {
				PaddingLeft = UDim.new(0, a.metric.mouthPad),
				PaddingRight = UDim.new(0, a.metric.mouthPad),
				PaddingTop = UDim.new(0, a.metric.mouthPad),
				PaddingBottom = UDim.new(0, a.metric.mouthPad),
				Parent = mouth,
			})
			order2 = order2 + 1
			renderList(view, d.children(view.app.doc, block, slot.key), mouth, {
				kind = "slot", parent = block, slotKey = slot.key, frame = mouth,
			}, "bg")
		end

		if def.tailTpl then
			renderRow(view, block, def, def.tailTpl, order2, 12, ink).Parent = frame
		end

		-- Selection and hover live on a stroke so nothing shifts when they change.
		-- At rest it is a darker edge of the block's own colour, which is what
		-- keeps two blocks of the same category from merging into one slab.
		local stroke = b.new("UIStroke", {
			Thickness = 2,
			Transparency = 0,
			Parent = frame,
		})
		a.bind(stroke, "Color", function() return a.blockEdge(cat) end)
		view.strokes[block.id] = { stroke = stroke, cat = cat }

		frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				view:beginPress(block, input)
			elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
				view.app:select(block.id)
				view:contextMenu(block)
			end
		end)
		frame.MouseEnter:Connect(function()
			view.app.hover = block.id
			view.app:emit("hover", block.id)
		end)
		frame.MouseLeave:Connect(function()
			if view.app.hover == block.id then
				view.app.hover = nil
				view.app:emit("hover", nil)
			end
		end)

		if def.doc then
			b.tip(frame, function()
				if view.dragging then return nil end
				return def.label .. "  --  " .. def.doc ..
					"\nHold the left button on it to pick it up."
			end)
		end

		view.frames[block.id] = frame
		return frame, cat
end

-- Draws a run of blocks into `container` and registers it as a drop target.
-- `surface` is the theme token of whatever the run is sitting on, which is
-- what the first block's notch is filled with.
function renderList(view, blocks, container, info, surface)
		local items = {}
		local above = nil
		for index, block in ipairs(blocks) do
			local frame, cat = renderBlock(view, block, index, above, surface)
			frame.Parent = container
			items[#items + 1] = { block = block, frame = frame }
			above = cat
		end

		if #blocks == 0 then
			-- an empty mouth: a notch with nothing in it, so it reads as a socket
			local empty = b.new("Frame", {
				Name = "Empty",
				Size = UDim2.fromOffset(58, 16),
				LayoutOrder = 1,
				Parent = container,
			})
			b.new("Frame", {
				Size = UDim2.fromOffset(a.metric.notchW, a.metric.notchH),
				Position = UDim2.fromOffset(a.metric.notchX, 0),
				bg = "line",
				BackgroundTransparency = 0.55,
				radius = 2,
				Parent = empty,
			})
		else
			joint(fillOf(above, surface), #blocks + 1, "Tab").Parent = container
		end

		info.items = items
		view.lists[#view.lists + 1] = info
		return items
end

--=============================================================================
-- the view
--=============================================================================

local View = {}
View.__index = View

function m.mount(app, parent)
		local view = setmetatable({
			app = app,
			zoom = app.settings.zoom or 1,
			pan = Vector2.new(0, 0),
			frames = {},
			strokes = {},
			lists = {},
		}, View)

		view.root = b.new("Frame", {
			Name = "Canvas",
			Size = UDim2.fromScale(1, 1),
			ClipsDescendants = true,
			bg = "bg",
			Parent = parent,
		})

		view.gridLayer = b.new("Frame", {
			Name = "Grid",
			Size = UDim2.fromScale(1, 1),
			ZIndex = 1,
			Parent = view.root,
		})

		view.content = b.new("Frame", {
			Name = "Content",
			Size = UDim2.fromOffset(0, 0),
			ZIndex = 2,
			Parent = view.root,
		})
		view.scale = b.new("UIScale", { Scale = view.zoom, Parent = view.content })

		-- Where the block will land, drawn as the silhouette of a block's top edge:
		-- a bar with the tab standing on it.  A plain line says "somewhere here";
		-- this says "this is the socket it goes into".
		view.indicator = b.new("Frame", {
			Name = "Drop",
			Size = UDim2.fromOffset(80, 6),
			Visible = false,
			bg = "accent",
			radius = 3,
			ZIndex = 60,
			Parent = view.root,
		})
		b.new("Frame", {
			Size = UDim2.fromOffset(a.metric.notchW, a.metric.notchH),
			Position = UDim2.fromOffset(a.metric.notchX, -a.metric.notchH + 2),
			bg = "accent",
			radius = 2,
			ZIndex = 60,
			Parent = view.indicator,
		})


		view:makeLift()
		view:buildGrid()
		view:wireInput()

		app:on("doc", function() view:render() end)
		app:on("select", function() view:paintStates() end)
		app:on("hover", function() view:paintStates() end)
		a.onChange(function() view:render() end)

		view:render()
		return view
end

--=============================================================================
-- grid
--=============================================================================

-- The shadow a lifted stack casts, so a picked-up block reads as picked up
-- rather than merely selected.  It sits on the content layer so it pans and
-- zooms with the canvas, which means it is rebuilt with everything else.
function View:makeLift()
		self.lift = b.new("Frame", {
			Name = "Lift",
			Size = UDim2.fromOffset(0, 0),
			Visible = false,
			bg = "shadow",
			BackgroundTransparency = 0.72,
			radius = a.metric.blockRadius,
			ZIndex = 45,
			Parent = self.content,
		})
		return self.lift
end

function View:buildGrid()
		self.gridLines = { vertical = {}, horizontal = {} }
		for index = 1, 90 do
			self.gridLines.vertical[index] = b.new("Frame", {
				Size = UDim2.new(0, 1, 1, 0),
				bg = "grid",
				Visible = false,
				Parent = self.gridLayer,
			})
		end
		for index = 1, 70 do
			self.gridLines.horizontal[index] = b.new("Frame", {
				Size = UDim2.new(1, 0, 0, 1),
				bg = "grid",
				Visible = false,
				Parent = self.gridLayer,
			})
		end
		self.root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			self:layoutGrid()
		end)
		self:layoutGrid()
end

function View:layoutGrid()
		local spacing = GRID * self.zoom
		if spacing < 8 then spacing = spacing * 2 end
		local size = self.root.AbsoluteSize
		local startX = self.pan.X % spacing
		local startY = self.pan.Y % spacing

		local majorEvery = 5
		local firstIndexX = math.floor(-self.pan.X / spacing)
		for index, line in ipairs(self.gridLines.vertical) do
			local x = startX + (index - 1) * spacing
			if x > size.X + spacing then
				line.Visible = false
			else
				line.Visible = true
				line.Position = UDim2.fromOffset(math.floor(x), 0)
				local major = (firstIndexX + index - 1) % majorEvery == 0
				line.BackgroundColor3 = major and a.c.gridMajor or a.c.grid
			end
		end

		local firstIndexY = math.floor(-self.pan.Y / spacing)
		for index, line in ipairs(self.gridLines.horizontal) do
			local y = startY + (index - 1) * spacing
			if y > size.Y + spacing then
				line.Visible = false
			else
				line.Visible = true
				line.Position = UDim2.fromOffset(0, math.floor(y))
				local major = (firstIndexY + index - 1) % majorEvery == 0
				line.BackgroundColor3 = major and a.c.gridMajor or a.c.grid
			end
		end
end

--=============================================================================
-- rendering
--=============================================================================

function View:render()
		if self.rendering then return end
		self.rendering = true

		b.clear(self.content)
		-- the shadow lives on the content layer, so it goes with everything else
		self:makeLift()
		if self.empty then
			self.empty:Destroy()
			self.empty = nil
		end
		self.frames = {}
		self.strokes = {}
		self.lists = {}
		self.stackFrames = {}

		for _, stack in ipairs(self.app.doc.stacks) do
			local frame = b.new("Frame", {
				Name = stack.id,
				Position = UDim2.fromOffset(stack.x or 0, stack.y or 0),
				Size = UDim2.fromOffset(0, 0),
				AutomaticSize = Enum.AutomaticSize.XY,
				layout = { dir = "y", gap = a.metric.rowGap },
				Parent = self.content,
			})
			self.stackFrames[stack.id] = frame
			renderList(self, d.stackBlocks(self.app.doc, stack), frame, {
				kind = "stack", stack = stack, frame = frame,
			}, "bg")
		end

		if #self.app.doc.stacks == 0 then
			self.empty = b.new("Frame", {
				Size = UDim2.fromOffset(340, 60),
				Position = UDim2.fromScale(0.5, 0.42),
				AnchorPoint = Vector2.new(0.5, 0.5),
				ZIndex = 3,
				Parent = self.root,
			})
			b.text({
				Text = "Nothing here yet",
				Size = UDim2.new(1, 0, 0, 20),
				Font = a.font.uiBold,
				TextSize = 14,
				fg = "text3",
				TextXAlignment = Enum.TextXAlignment.Center,
				ZIndex = 4,
				Parent = self.empty,
			})
			b.text({
				Text = "Click a block in the palette to place it, or drag it out here.\n" ..
					"Once it is on the canvas, hold the left button on it to move it.",
				Size = UDim2.new(1, 0, 0, 34),
				Position = UDim2.fromOffset(0, 22),
				TextWrapped = true,
				TextSize = 12,
				fg = "text3",
				TextXAlignment = Enum.TextXAlignment.Center,
				ZIndex = 4,
				Parent = self.empty,
			})
		elseif self.empty then
			self.empty:Destroy()
			self.empty = nil
		end

		self.content.Position = UDim2.fromOffset(self.pan.X, self.pan.Y)
		self.scale.Scale = self.zoom
		self:paintStates()
		self:layoutGrid()
		self.rendering = false
end

function View:paintStates()
		for id, entry in pairs(self.strokes) do
			local stroke = entry.stroke
			if stroke.Parent then
				if self.app.selection == id then
					stroke.Color = a.c.accent
					stroke.Thickness = 2
				elseif self.app.hover == id then
					stroke.Color = a.inkOn(a.blockColor(entry.cat))
					stroke.Thickness = 2
				else
					stroke.Color = a.blockEdge(entry.cat)
					stroke.Thickness = 2
				end
			end
		end
end

--=============================================================================
-- coordinates
--=============================================================================

function View:pluginGui()
		return self.root:FindFirstAncestorWhichIsA("PluginGui")
end

function View:mouse()
		local gui = self:pluginGui()
		if not gui then return Vector2.new(0, 0) end
		return gui:GetRelativeMousePosition()
end

-- Widget coordinates -> canvas coordinates.  `GetRelativeMousePosition` and
-- `AbsolutePosition` are both measured from the top left of the plugin window,
-- so no further translation is needed.
function View:toCanvas(point)
		return (point - self.content.AbsolutePosition) / self.zoom
end

function View:viewCentre()
		local size = self.root.AbsoluteSize
		return Vector2.new(
			(size.X / 2 - self.pan.X) / self.zoom,
			(size.Y / 2 - self.pan.Y) / self.zoom)
end

--=============================================================================
-- panning and zoom
--=============================================================================

function View:setPan(x, y)
		self.pan = Vector2.new(math.floor(x), math.floor(y))
		self.content.Position = UDim2.fromOffset(self.pan.X, self.pan.Y)
		self:layoutGrid()
end

function View:setZoom(zoom, focus)
		local wanted = math.clamp(zoom, MIN_ZOOM, MAX_ZOOM)
		if math.abs(wanted - self.zoom) < 0.001 then return end
		focus = focus or (self.root.AbsoluteSize / 2)
		-- keep whatever is under `focus` where it is
		local before = (focus - self.pan) / self.zoom
		self.zoom = wanted
		self.scale.Scale = wanted
		local after = before * wanted
		self:setPan(focus.X - after.X, focus.Y - after.Y)
		self.app:setSetting("zoom", wanted)
		self.app:setStatus(string.format("zoom %d%%", math.floor(wanted * 100 + 0.5)))
end

function View:resetZoom()
		self:setZoom(1, self.root.AbsoluteSize / 2)
end

function View:wireInput()
		local root = self.root

		root.InputChanged:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
			local delta = input.Position.Z
			local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
				or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
			if ctrl then
				local gui = self:pluginGui()
				local at = gui and (gui:GetRelativeMousePosition() - root.AbsolutePosition) or nil
				self:setZoom(self.zoom * (delta > 0 and 1.1 or 0.9), at)
			elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				self:setPan(self.pan.X + delta * 48, self.pan.Y)
			else
				self:setPan(self.pan.X, self.pan.Y + delta * 48)
			end
		end)

		root.InputBegan:Connect(function(input)
			local middle = input.UserInputType == Enum.UserInputType.MouseButton3
			local left = input.UserInputType == Enum.UserInputType.MouseButton1
			if not (middle or left) then return end

			if left then
				self.app:select(nil)
				if self.menu then
					self.menu:Destroy()
					self.menu = nil
				end
				getPopup():hide()
			end

			local gui = self:pluginGui()
			if not gui then return end
			local start = gui:GetRelativeMousePosition()
			local startPan = self.pan
			local button = middle and Enum.UserInputType.MouseButton3
				or Enum.UserInputType.MouseButton1
			local spaceHeld = UserInputService:IsKeyDown(Enum.KeyCode.Space)
			if left and not spaceHeld then
				-- plain left-drag on empty canvas still pans; a click alone deselects
			end

			task.spawn(function()
				while UserInputService:IsMouseButtonPressed(button) do
					local now = gui:GetRelativeMousePosition()
					local delta = now - start
					if delta.Magnitude > 2 then
						self:setPan(startPan.X + delta.X, startPan.Y + delta.Y)
					end
					RunService.Heartbeat:Wait()
				end
			end)
		end)
end

--=============================================================================
-- dragging
--=============================================================================

local function listIsInside(view, info, draggedBlock)
		if info.stack and view.drag and info.stack.id == view.drag.stack.id then
			return true
		end
		if info.parent then
			return d.isAncestor(view.app.doc, draggedBlock, info.parent)
		end
		return false
end

-- Every place the dragged stack could be dropped, in widget coordinates.
function View:dropPoints(draggedBlock)
		local points = {}
		for _, info in ipairs(self.lists) do
			if not listIsInside(self, info, draggedBlock) then
				local items = info.items or {}
				if #items == 0 then
					local at = info.frame.AbsolutePosition
					points[#points + 1] = {
						at = at + Vector2.new(4, info.frame.AbsoluteSize.Y / 2),
						info = info, index = 1,
						width = math.max(60, info.frame.AbsoluteSize.X),
					}
				else
					for index, item in ipairs(items) do
						points[#points + 1] = {
							at = item.frame.AbsolutePosition,
							info = info, index = index,
							width = item.frame.AbsoluteSize.X,
						}
					end
					local last = items[#items]
					points[#points + 1] = {
						at = last.frame.AbsolutePosition +
							Vector2.new(0, last.frame.AbsoluteSize.Y + a.metric.rowGap),
						info = info, index = #items + 1,
						width = last.frame.AbsoluteSize.X,
					}
				end
			end
		end
		return points
end

function View:beginDrag(block, mouse)
		local gui = self:pluginGui()
		local frame = self.frames[block.id]
		if not frame or not gui then return end

		b.hideTip()
		getPopup():hide()

		local canvasPos = (frame.AbsolutePosition - self.content.AbsolutePosition) / self.zoom
		self.dragBefore = self.app:mark()
		local stack = d.detach(self.app.doc, block, canvasPos.X, canvasPos.Y)
		self.drag = { block = block, stack = stack }
		self:render()

		local stackFrame = self.stackFrames[stack.id]
		if not stackFrame then
			self.drag = nil
			return
		end
		self.drag.frame = stackFrame
		self.drag.grab = mouse - stackFrame.AbsolutePosition
		self.drag.points = self:dropPoints(block)
		self.dragging = true

		stackFrame.ZIndex = 50
		for _, descendant in ipairs(stackFrame:GetDescendants()) do
			if descendant:IsA("GuiObject") then
				descendant.ZIndex = descendant.ZIndex + 50
			end
		end
end

function View:updateDrag(mouse)
		local drag = self.drag
		if not drag or not drag.frame then return end
		local gui = self:pluginGui()
		if not gui then return end

		local wanted = mouse - drag.grab
		local canvas = (wanted - self.content.AbsolutePosition) / self.zoom
		drag.stack.x, drag.stack.y = canvas.X, canvas.Y
		drag.frame.Position = UDim2.fromOffset(canvas.X, canvas.Y)

		local origin = drag.frame.AbsolutePosition
		local best, bestScore = nil, SNAP_RADIUS
		for _, point in ipairs(drag.points) do
			local delta = point.at - origin
			local score = math.abs(delta.Y) + math.abs(delta.X) * 0.55
			if score < bestScore then
				best, bestScore = point, score
			end
		end

		-- dragging back over the palette throws the block away
		local palette = self.app.paletteFrame
		local overPalette = false
		if palette and palette.Visible then
			local at = palette.AbsolutePosition
			local size = palette.AbsoluteSize
			overPalette = mouse.X >= at.X and mouse.X <= at.X + size.X
				and mouse.Y >= at.Y and mouse.Y <= at.Y + size.Y
		end
		if overPalette ~= drag.overPalette then
			drag.overPalette = overPalette
			self.app:emit("dragOverPalette", overPalette)
		end
		if overPalette then
			best = nil
			self.indicator.Visible = false
		end

		drag.target = best
		if best then
			local at = best.at - self.root.AbsolutePosition
			self.indicator.Visible = true
			self.indicator.Position = UDim2.fromOffset(at.X, at.Y - 3)
			self.indicator.Size = UDim2.fromOffset(math.max(60, best.width), 6)
		else
			self.indicator.Visible = false
		end

		-- the shadow follows the stack, one block's corner behind it
		if self.lift then
			local size = drag.frame.AbsoluteSize / self.zoom
			self.lift.Visible = true
			self.lift.Position = UDim2.fromOffset(canvas.X + 5, canvas.Y + 6)
			self.lift.Size = UDim2.fromOffset(size.X, size.Y)
		end
end

function View:endDrag()
		local drag = self.drag
		self.dragging = false
		self.indicator.Visible = false
		if self.lift then self.lift.Visible = false end
		if not drag then return end

		local doc = self.app.doc
		local target = drag.target

		if drag.overPalette then
			self.app:emit("dragOverPalette", false)
			d.remove(doc, drag.block)
			self.app:select(nil)
			self.drag = nil
			self.app:commit("delete block", self.dragBefore)
			self.dragBefore = nil
			self.app:setStatus("deleted")
			return
		end

		if target then
			local info = target.info
			if info.kind == "slot" then
				d.attachToSlot(doc, drag.block, info.parent, info.slotKey, target.index)
			else
				d.attachToStack(doc, drag.block, info.stack, target.index)
			end
		else
			-- left loose: line it up with the grid so the canvas stays tidy
			drag.stack.x = math.floor((drag.stack.x or 0) / GRID + 0.5) * GRID
			drag.stack.y = math.floor((drag.stack.y or 0) / GRID + 0.5) * GRID
		end

		self.drag = nil
		self.app:commit(target and "move block" or "drag block", self.dragBefore)
		self.dragBefore = nil
end

-- Input bubbles up from a block's fields to the block itself, so dragging has
-- to ask whether the press actually landed on a field first -- otherwise
-- selecting text in a field would pick the whole stack up.
function View:overField(block)
		local frame = self.frames[block.id]
		if not frame then return false end
		local gui = self:pluginGui()
		if not gui then return false end
		local mouse = gui:GetRelativeMousePosition()
		for _, node in ipairs(frame:GetDescendants()) do
			if node:IsA("TextBox") or node:IsA("TextButton") then
				local at, size = node.AbsolutePosition, node.AbsoluteSize
				if mouse.X >= at.X and mouse.X <= at.X + size.X
					and mouse.Y >= at.Y and mouse.Y <= at.Y + size.Y then
					return true
				end
			end
		end
		return false
end

function View:beginPress(block, input)
		if self.dragging then return end
		local gui = self:pluginGui()
		if not gui then return end
		if input and self:overField(block) then
			self.app:select(block.id)
			return
		end

		-- Space turns the whole canvas into a hand tool, blocks included.
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			local start = gui:GetRelativeMousePosition()
			local startPan = self.pan
			task.spawn(function()
				while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
					local delta = gui:GetRelativeMousePosition() - start
					self:setPan(startPan.X + delta.X, startPan.Y + delta.Y)
					RunService.Heartbeat:Wait()
				end
			end)
			return
		end

		self.app:select(block.id)
		local held = os.clock()

		task.spawn(function()
			local lifted = false
			while UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
				local now = gui:GetRelativeMousePosition()
				if not lifted then
					if self:shouldLift(os.clock() - held) then
						lifted = true
						self:beginDrag(block, now)
					end
				else
					self:updateDrag(now)
				end
				RunService.Heartbeat:Wait()
			end
			if lifted then self:endDrag() end
		end)
end

-- A block is picked up by holding the button on it, not by clicking and
-- dragging.  A quick click therefore selects it and nothing else, which is
-- what makes it safe to click a block in a stack to read the code it wrote,
-- and what stops a stack coming apart under a slightly wobbly hand.
function View:shouldLift(heldFor)
		return heldFor >= (self.liftAfter or LIFT_SECONDS)
end

--=============================================================================
-- adding, removing, arranging
--=============================================================================

function View:addBlock(defId, canvasPosition)
		local app = self.app
		local selected = app:selected()
		local position = canvasPosition

		return app:mutate("add " .. defId, function(doc)
			local block = d.create(doc, defId)
			if not position and selected then
				-- drop it straight after whatever is selected, where a person
				-- would expect the next line to go
				local def = c.get(selected.k)
				if def and #def.slots > 0 and #d.children(doc, selected, def.slots[1].key) == 0 then
					d.attachToSlot(doc, block, selected, def.slots[1].key, 1, {})
					app:select(block.id)
					return block
				end
				local list, owner = d.listOf(doc, selected)
				local index = (d.indexOf(doc, selected) or 0) + 1
				if selected.p then
					d.attachToSlot(doc, block, doc.blocks[selected.p], selected.ps, index, {})
				else
					d.attachToStack(doc, block, owner, index, {})
				end
				app:select(block.id)
				return block
			end

			local at = position or self:viewCentre()
			local stack = d.newStack(doc,
				math.floor(at.X / GRID + 0.5) * GRID,
				math.floor(at.Y / GRID + 0.5) * GRID)
			d.attachToStack(doc, block, stack, 1, {})
			app:select(block.id)
			return block
		end)
end

-- Used by the palette: make the block, then pick it straight up.
function View:spawnAndDrag(defId, mouse)
		if not self:pluginGui() then return end
		local block = self:addBlock(defId, self:toCanvas(mouse))
		if not block then return end
		task.defer(function()
			local frame = self.frames[block.id]
			if frame then self:beginPress(block, nil) end
		end)
		return block
end

function View:deleteSelected()
		local block = self.app:selected()
		if not block then
			self.app:setStatus("nothing selected")
			return
		end
		local def = c.get(block.k)
		self.app:mutate("delete " .. (def and def.label or "block"), function(doc)
			d.remove(doc, block)
		end)
		self.app:select(nil)
end

function View:duplicateSelected()
		local block = self.app:selected()
		if not block then return end
		self.app:mutate("duplicate", function(doc)
			local list, owner = d.listOf(doc, block)
			local copy = d.duplicate(doc, block, 0, 0)
			-- put the copy right under the original rather than loose on the canvas
			if block.p then
				d.attachToSlot(doc, copy, doc.blocks[block.p], block.ps,
					(d.indexOf(doc, block) or 0) + 1, {})
			elseif owner then
				d.attachToStack(doc, copy, owner, (d.indexOf(doc, block) or 0) + 1, {})
			end
			self.app:select(copy.id)
		end)
end

-- Lays every stack out in one column, in the order they will run.
function View:tidy()
		self.app:mutate("tidy canvas", function(doc)
			local sorted = d.sortedStacks(doc)
			local y = 24
			for _, stack in ipairs(sorted) do
				stack.x = 24
				stack.y = y
				local frame = self.stackFrames[stack.id]
				local height = frame and (frame.AbsoluteSize.Y / self.zoom) or 60
				y = y + height + 28
			end
			doc.stacks = sorted
		end)
		self:setPan(0, 0)
		self.app:setStatus("tidied " .. #self.app.doc.stacks .. " stacks")
end

function View:focusBlock(blockId)
		local frame = self.frames[blockId]
		if not frame then return end
		local at = (frame.AbsolutePosition - self.content.AbsolutePosition) / self.zoom
		local size = self.root.AbsoluteSize
		self:setPan(size.X / 3 - at.X * self.zoom, size.Y / 3 - at.Y * self.zoom)
end

--=============================================================================
-- context menu
--=============================================================================

function View:contextMenu(block)
		local overlay = b.overlay()
		if not overlay then return end
		if self.menu then self.menu:Destroy() end

		local def = c.get(block.k)
		local menu = b.new("Frame", {
			Size = UDim2.fromOffset(190, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			bg = "raised",
			stroke = { color = "line" },
			layout = { dir = "y", gap = 0 },
			ZIndex = 830,
			Parent = overlay,
		})
		self.menu = menu

		local gui = self:pluginGui()
		local at = gui and gui:GetRelativeMousePosition() or Vector2.new(0, 0)
		menu.Position = UDim2.fromOffset(at.X, at.Y)

		b.micro(def and def.label or "block", {
			Size = UDim2.new(1, -16, 0, 20),
			Position = UDim2.fromOffset(8, 0),
			LayoutOrder = 0,
			ZIndex = 831,
			Parent = menu,
		})

		local actions = {
			{ "Duplicate", "Ctrl+D", function() self:duplicateSelected() end },
			{ "Pull out to canvas", "", function()
				self.app:mutate("detach", function(doc)
					local centre = self:viewCentre()
					d.detach(doc, block, centre.X, centre.Y)
				end)
			end },
			{ "Make into a block", "", function()
				self.app:select(block.id)
				if self.app.makeBlockFromSelection then
					self.app.makeBlockFromSelection()
				end
			end },
			{ "Delete", "Del", function() self:deleteSelected() end },
		}

		for index, action in ipairs(actions) do
			local row = b.new("TextButton", {
				Size = UDim2.new(1, 0, 0, 24),
				LayoutOrder = index,
				bg = "raised",
				ZIndex = 831,
				Parent = menu,
			})
			b.text({
				Text = action[1],
				Size = UDim2.new(1, -70, 1, 0),
				Position = UDim2.fromOffset(10, 0),
				ZIndex = 832,
				Parent = row,
			})
			b.mono({
				Text = action[2],
				Size = UDim2.fromOffset(60, 24),
				Position = UDim2.new(1, -66, 0, 0),
				TextSize = 10,
				fg = "text3",
				ZIndex = 832,
				Parent = row,
			})
			b.states(row, "raised", 0.2)
			row.MouseButton1Click:Connect(function()
				menu:Destroy()
				self.menu = nil
				action[3]()
			end)
		end

		menu.MouseLeave:Connect(function()
			task.delay(0.35, function()
				if self.menu == menu then
					menu:Destroy()
					self.menu = nil
				end
			end)
		end)
end

return m
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX14">
			<Properties>
				<string name="Name">n</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- n  ·  text panels: generated code, import, settings
--
-- The code panel is the point of the whole plugin, so it is not a preview
-- tucked in a drawer: it sits open beside the canvas, updates on every
-- keystroke, and is wired both ways -- hover a block to light up its lines,
-- hover a line to outline the block that wrote it.
--
-- Studio gives plugins no clipboard API, so "copy" opens the text selected and
-- ready for Ctrl+C rather than pretending.

local a = require(script.Parent.a)
local b = require(script.Parent.b)
local d = require(script.Parent.d)
local e = require(script.Parent.e)
local f = require(script.Parent.f)
local h = require(script.Parent.h)
local o = require(script.Parent.o)
local q = require(script.Parent.q)

local ChangeHistoryService = game:GetService("ChangeHistoryService")
local Selection = game:GetService("Selection")

local n = {}

--=============================================================================
-- syntax highlighting
--=============================================================================

local function escape(text)
		text = string.gsub(text, "&", "&amp;")
		text = string.gsub(text, "<", "&lt;")
		text = string.gsub(text, ">", "&gt;")
		text = string.gsub(text, '"', "&quot;")
		return text
end

local function hex(colour)
		return string.format("#%02X%02X%02X",
			math.floor(colour.R * 255 + 0.5),
			math.floor(colour.G * 255 + 0.5),
			math.floor(colour.B * 255 + 0.5))
end

local function tokenColour(token, nextToken)
		local syntax = a.c.syntax
		if token.t == "comment" then return syntax.comment end
		if token.t == "kw" then return syntax.kw end
		if token.t == "string" then return syntax.str end
		if token.t == "number" then return syntax.num end
		if token.t == "name" then
			if nextToken and nextToken.t == "sym" and nextToken.v == "(" then
				return syntax.call
			end
			return syntax.name
		end
		return syntax.sym
end

-- One RichText string per line, coloured by the same lexer the parser uses.
function n.highlight(code)
		local tokens = f.scan(code)
		local lines = {}
		local starts = { 1 }
		for position in string.gmatch(code, "()\n") do
			starts[#starts + 1] = position + 1
		end

		local cursor = 1
		for index, lineStart in ipairs(starts) do
			local lineEnd = (starts[index + 1] and starts[index + 1] - 2) or #code
			local pieces = {}
			local at = lineStart

			-- rewind to the first token that could touch this line
			while cursor > 1 and tokens[cursor - 1] and tokens[cursor - 1].e >= lineStart do
				cursor = cursor - 1
			end
			local scan = cursor
			while tokens[scan] and tokens[scan].s <= lineEnd do
				local token = tokens[scan]
				if token.e >= lineStart then
					local from = math.max(token.s, lineStart)
					local to = math.min(token.e, lineEnd)
					if from > at then
						pieces[#pieces + 1] = escape(string.sub(code, at, from - 1))
					end
					if to >= from then
						pieces[#pieces + 1] = string.format('<font color="%s">%s</font>',
							hex(tokenColour(token, tokens[scan + 1])),
							escape(string.sub(code, from, to)))
						at = to + 1
					end
				end
				if token.e < lineStart then cursor = scan + 1 end
				scan = scan + 1
			end
			if at <= lineEnd then
				pieces[#pieces + 1] = escape(string.sub(code, at, lineEnd))
			end
			lines[index] = table.concat(pieces)
		end
		return lines
end

--=============================================================================
-- a modal of selectable text, standing in for a clipboard
--=============================================================================

function n.textModal(title, body, hint)
		local overlay = b.overlay()
		if not overlay then return end

		local shade = b.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			bg = "bg",
			BackgroundTransparency = 0.35,
			ZIndex = 900,
			Parent = overlay,
		})

		local panel = b.new("Frame", {
			Size = UDim2.new(0, 520, 0, 400),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			bg = "panel",
			stroke = { color = "line" },
			ZIndex = 901,
			Parent = shade,
		})

		b.micro(title, {
			Size = UDim2.new(1, -24, 0, 24),
			Position = UDim2.fromOffset(12, 8),
			fg = "accent",
			ZIndex = 902,
			Parent = panel,
		})

		b.text({
			Text = hint or "Select all with Ctrl+A, then copy with Ctrl+C.",
			Size = UDim2.new(1, -24, 0, 16),
			Position = UDim2.fromOffset(12, 28),
			fg = "text3",
			TextSize = 11,
			ZIndex = 902,
			Parent = panel,
		})

		local scroll = b.new("ScrollingFrame", {
			Size = UDim2.new(1, -24, 1, -92),
			Position = UDim2.fromOffset(12, 50),
			bg = "field",
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ZIndex = 902,
			Parent = panel,
		})

		local box = b.new("TextBox", {
			Text = body,
			MultiLine = true,
			ClearTextOnFocus = false,
			TextEditable = false,
			Size = UDim2.new(1, -8, 0, 0),
			Position = UDim2.fromOffset(4, 4),
			AutomaticSize = Enum.AutomaticSize.Y,
			Font = a.font.mono,
			TextSize = 12,
			fg = "text",
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			ZIndex = 903,
			Parent = scroll,
		})

		local close = b.button({
			label = "Close",
			Size = UDim2.fromOffset(90, 26),
			Position = UDim2.new(1, -102, 1, -34),
			bg = "raised",
			ZIndex = 902,
			Parent = panel,
		})
		close.MouseButton1Click:Connect(function() shade:Destroy() end)

		task.defer(function()
			box:CaptureFocus()
			box.CursorPosition = #body + 1
			box.SelectionStart = 1
		end)
		return shade
end

--=============================================================================
-- code panel
--=============================================================================

local Code = {}
Code.__index = Code

function n.codePanel(app, parent)
		local view = setmetatable({ app = app, lineFrames = {} }, Code)

		view.frame = b.new("Frame", {
			Name = "Code",
			Size = UDim2.new(0, 400, 1, 0),
			bg = "panel",
			Parent = parent,
		})
		b.rule({ parent = view.frame })

		local head = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 34),
			Parent = view.frame,
		})
		b.micro("generated luau", {
			Size = UDim2.new(0, 140, 1, 0),
			Position = UDim2.fromOffset(12, 0),
			fg = "text2",
			Parent = head,
		})
		view.count = b.mono({
			Text = "",
			Size = UDim2.new(0, 160, 1, 0),
			Position = UDim2.new(1, -172, 0, 0),
			TextSize = 10,
			fg = "text3",
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = head,
		})
		b.rule({ Position = UDim2.new(0, 0, 1, 0), parent = head })

		-- Advice about the script kind this is headed for sits between the header
		-- and the code, where it is impossible to miss and costs no space when
		-- there is nothing to say.
		view.advice = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			Position = UDim2.fromOffset(0, 34),
			AutomaticSize = Enum.AutomaticSize.Y,
			bg = "err",
			Visible = false,
			Parent = view.frame,
		})
		view.adviceText = b.text({
			Text = "",
			Size = UDim2.new(1, -16, 0, 0),
			Position = UDim2.fromOffset(14, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextSize = 11,
			LineHeight = 1.25,
			fg = "text2",
			bg = "panel",
			Parent = view.advice,
		})
		b.new("UIPadding", {
			PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
			PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
			Parent = view.adviceText })

		view.scroll = b.new("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, -34),
			Position = UDim2.fromOffset(0, 34),
			bg = "sunken",
			AutomaticCanvasSize = Enum.AutomaticSize.XY,
			Parent = view.frame,
		})
		view.layout = b.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 0),
			Parent = view.scroll,
		})
		b.new("UIPadding", {
			PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 16),
			Parent = view.scroll })

		app:on("doc", function() view:refresh() end)
		app:on("codeDirty", function() view:queueRefresh() end)
		app:on("hover", function(blockId) view:highlightBlock(blockId) end)
		a.onChange(function() view:refresh() end)

		view:refresh()
		return view
end

local MAX_INTERACTIVE_LINES = 700

-- Typing fires per keystroke; rebuilding a few hundred labels that often is
-- wasteful, so redraws are coalesced into roughly ten a second.
function Code:queueRefresh()
		self.refreshToken = (self.refreshToken or 0) + 1
		local token = self.refreshToken
		task.delay(0.1, function()
			if token == self.refreshToken then self:refresh() end
		end)
end

function Code:refresh()
		self.refreshToken = (self.refreshToken or 0) + 1
		local app = self.app
		local code, meta = e.generate(app.doc, { header = app.settings.banner })
		local kindNow = app:scriptKind()
		self.code = code
		self.meta = meta
		self.count.Text = kindNow .. "   " .. meta.lineCount .. " lines"

		b.clear(self.scroll)
		self.lineFrames = {}

		if meta.lineCount > MAX_INTERACTIVE_LINES then
			b.mono({
				Text = code,
				Size = UDim2.new(1, -16, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Position = UDim2.fromOffset(8, 0),
				TextYAlignment = Enum.TextYAlignment.Top,
				TextSize = 12,
				Parent = self.scroll,
			})
			return
		end

		self:showAdvice(e.advise(code, kindNow))

		local lines = n.highlight(code)
		for index, rich in ipairs(lines) do
			local blockId = meta.blockOfLine[index]
			local row = b.new("Frame", {
				Size = UDim2.new(0, 0, 0, 16),
				AutomaticSize = Enum.AutomaticSize.X,
				LayoutOrder = index,
				bg = "sunken",
				Parent = self.scroll,
			})

			b.mono({
				Text = string.format("%3d", index),
				Size = UDim2.fromOffset(30, 16),
				TextSize = 10,
				fg = "text3",
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = row,
			})

			b.mono({
				Text = rich,
				RichText = true,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromOffset(0, 16),
				Position = UDim2.fromOffset(40, 0),
				TextSize = 12,
				Parent = row,
			})

			if blockId then
				self.lineFrames[index] = { frame = row, blockId = blockId }
				row.MouseEnter:Connect(function()
					self.app.hover = blockId
					self.app:emit("hover", blockId)
				end)
				row.MouseLeave:Connect(function()
					if self.app.hover == blockId then
						self.app.hover = nil
						self.app:emit("hover", nil)
					end
				end)
				row.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						self.app:select(blockId)
						if self.app.canvas then self.app.canvas:focusBlock(blockId) end
					end
				end)
			end
		end

		self:highlightBlock(self.app.hover)
end

-- Shows the strip only when there is something to say.
function Code:showAdvice(notes)
		if #notes == 0 then
			self.advice.Visible = false
			self.scroll.Position = UDim2.fromOffset(0, 34)
			self.scroll.Size = UDim2.new(1, 0, 1, -34)
			return
		end

		local lines = {}
		for _, note in ipairs(notes) do
			lines[#lines + 1] = note.text
		end
		self.adviceText.Text = table.concat(lines, "\n")
		self.advice.Visible = true

		-- The strip auto-sizes, so the code area is repositioned once it has.
		task.defer(function()
			if not self.advice.Visible then return end
			local height = self.advice.AbsoluteSize.Y
			self.scroll.Position = UDim2.fromOffset(0, 34 + height)
			self.scroll.Size = UDim2.new(1, 0, 1, -34 - height)
		end)
end

function Code:highlightBlock(blockId)
		for _, entry in pairs(self.lineFrames) do
			if entry.frame.Parent then
				entry.frame.BackgroundColor3 =
					(blockId and entry.blockId == blockId) and a.c.select or a.c.sunken
			end
		end
end

--=============================================================================
-- writing the script out
--
-- Where the code goes is decided by what kind of script it is, and whether
-- this project was read out of a script that is still there.  Reading a
-- script's Source and writing it back both need Studio's script-injection
-- permission, so both are wrapped and explained rather than left to fail
-- silently.
--=============================================================================

-- Writes back into the script this project came from, when it still exists;
-- otherwise makes a new one where that kind of script belongs.
function Code:insertScript()
		local app = self.app
		local kind = app:scriptKind()
		local existing = app:originInstance()

		local recording = ChangeHistoryService:TryBeginRecording(
			existing and "ABlocks update" or "ABlocks insert")

		local ok, err = pcall(function()
			if existing then
				existing.Source = self.code
				Selection:Set({ existing })
				return existing
			end

			local parentPath = app:destinationFor(kind)
			local parent = o.resolvePath(parentPath)
			if not parent then
				error("could not find " .. parentPath, 0)
			end

			local made = Instance.new(kind)
			made.Name = app.doc.name
			made.Source = self.code
			made.Parent = parent
			Selection:Set({ made })
			app:setOrigin(made)
			return made
		end)

		if recording then
			ChangeHistoryService:FinishRecording(recording,
				ok and Enum.FinishRecordingOperation.Commit
				or Enum.FinishRecordingOperation.Cancel)
		end

		if ok then
			if existing then
				app:setStatus("updated " .. existing:GetFullName())
			else
				app:setStatus("inserted a " .. kind .. " into " .. app:destinationFor(kind))
			end
			app:emit("doc")
			return true
		end

		app:setStatus("Studio would not let the plugin write that script")
		n.textModal("could not write the script", tostring(err),
			"Studio asks permission before a plugin may read or write script " ..
			"source.\nLook for the prompt, or allow it in Plugins -> Manage " ..
			"Plugins, then try again.")
		return false
end

-- What the button should say and do next, for the window's bottom bar.
function Code:insertLabel()
		local existing = self.app:originInstance()
		if existing then
			return "Update " .. b.truncate(existing.Name, 18),
				"Writes this code back into " .. existing:GetFullName() .. "."
		end
		local kind = self.app:scriptKind()
		return "Insert " .. kind,
			"Creates a new " .. kind .. " in " .. self.app:destinationFor(kind) .. "."
end

--=============================================================================
-- import
--=============================================================================

local KIND_MARK = {
		Script = { letter = "S", token = "data", note = "runs on the server" },
		LocalScript = { letter = "L", token = "text", note = "runs on one player's device" },
		ModuleScript = { letter = "M", token = "funcs", note = "loaded by other scripts" },
}

-- The first script among whatever is selected in the Explorer.
local function selectedScript()
		local chosen, total = nil, 0
		for _, instance in ipairs(Selection:Get()) do
			if instance:IsA("LuaSourceContainer") then
				total = total + 1
				chosen = chosen or instance
			end
		end
		return chosen, total
end

-- Reading Source needs Studio's permission, which is only prompted on a real
-- attempt, so a failure here is expected rather than exceptional.
local function readSource(instance)
		local ok, source = pcall(function() return instance.Source end)
		if ok then return source end
		return nil
end

function n.importView(app, parent)
		local view = { app = app }

		view.frame = b.new("Frame", {
			Name = "Import",
			Size = UDim2.fromScale(1, 1),
			Visible = false,
			bg = "bg",
			Parent = parent,
		})

		local scroll = b.new("ScrollingFrame", {
			Size = UDim2.new(1, -40, 1, -20),
			Position = UDim2.fromOffset(20, 10),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Parent = view.frame,
		})
		local column = b.new("Frame", {
			Size = UDim2.new(1, -24, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			layout = { dir = "y", gap = 10 },
			Parent = scroll,
		})
		b.new("UISizeConstraint", {
			MaxSize = Vector2.new(760, math.huge), Parent = column })
		b.new("UIPadding", { PaddingBottom = UDim.new(0, 40), Parent = column })

		b.micro("turn a script into blocks", {
			Size = UDim2.new(1, 0, 0, 18),
			fg = "accent",
			LayoutOrder = 1,
			Parent = column,
		})
		b.text({
			Text = "Select a Script, LocalScript or ModuleScript in the Explorer and it " ..
				"shows up here. Converting replaces the canvas, and the code can be " ..
				"written straight back into that same script afterwards.",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			fg = "text2",
			LayoutOrder = 2,
			Parent = column,
		})

		-- the selection card -------------------------------------------------------
		local card = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 74),
			bg = "panel",
			stroke = { color = "line" },
			LayoutOrder = 3,
			Parent = column,
		})
		view.card = card

		local chipHolder = b.new("Frame", {
			Size = UDim2.fromOffset(28, 28),
			Position = UDim2.fromOffset(14, 14),
			Parent = card,
		})
		view.chipHolder = chipHolder

		view.cardName = b.text({
			Text = "Nothing selected",
			Size = UDim2.new(1, -180, 0, 20),
			Position = UDim2.fromOffset(54, 12),
			Font = a.font.uiBold,
			TextSize = 14,
			fg = "text2",
			Parent = card,
		})
		view.cardPath = b.mono({
			Text = "select a script in the Explorer",
			Size = UDim2.new(1, -180, 0, 16),
			Position = UDim2.fromOffset(54, 32),
			TextSize = 11,
			fg = "text3",
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = card,
		})
		view.cardFacts = b.mono({
			Text = "",
			Size = UDim2.new(1, -70, 0, 14),
			Position = UDim2.fromOffset(54, 50),
			TextSize = 10,
			fg = "text3",
			Parent = card,
		})

		local convert = b.button({
			label = "Convert",
			Size = UDim2.fromOffset(150, 30),
			Position = UDim2.new(1, -164, 0, 22),
			bg = "accent",
			labelColor = "accentInk",
			Parent = card,
		})
		view.convert = convert
		local convertLabel = convert:FindFirstChildWhichIsA("TextLabel")

		view.report = b.text({
			Text = "",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			fg = "text2",
			TextSize = 11,
			LayoutOrder = 4,
			Parent = column,
		})

		--------------------------------------------------------------------------
		local function describe()
			local instance, total = selectedScript()
			view.target = instance

			b.clear(chipHolder)
			if not instance then
				view.cardName.Text = "Nothing selected"
				view.cardName.TextColor3 = a.c.text3
				view.cardPath.Text = "select a script in the Explorer"
				view.cardFacts.Text = ""
				convert:SetAttribute("disabled", true)
				convertLabel.Text = "Convert"
				convertLabel.TextTransparency = 0.55
				local blank = b.chip("?", a.c.text3, 28)
				blank.Parent = chipHolder
				return
			end

			local mark = KIND_MARK[instance.ClassName] or KIND_MARK.Script
			local chip = b.chip(mark.letter, a.c.cats[mark.token], 28)
			chip.Parent = chipHolder

			view.cardName.Text = instance.Name
			view.cardName.TextColor3 = a.c.text
			view.cardPath.Text = instance:GetFullName()

			local source = readSource(instance)
			local facts = instance.ClassName .. " -- " .. mark.note
			if source then
				local lines = 1
				for _ in string.gmatch(source, "\n") do lines = lines + 1 end
				facts = facts .. "   " .. lines .. " lines"
			else
				facts = facts .. "   (Studio will ask permission to read it)"
			end
			if total > 1 then
				facts = facts .. "   " .. total .. " scripts selected, this is the first"
			end
			view.cardFacts.Text = facts

			convert:SetAttribute("disabled", false)
			convertLabel.Text = "Convert " .. b.truncate(instance.Name, 14)
			convertLabel.TextTransparency = 0
		end
		view.describe = describe

		--------------------------------------------------------------------------
		local function convertSource(source, name, instance)
			if not source or string.match(source, "^%s*$") then
				view.report.TextColor3 = a.c.text3
				view.report.Text = "That script is empty."
				return false
			end

			local doc, reportData, err = h.fromCode(source, name)
			if not doc then
				view.report.TextColor3 = a.c.err
				view.report.Text = string.format(
					"Line %d, column %d: %s\n\nThe whole script is read before anything " ..
					"is built, so the canvas is untouched.", err.line, err.col, err.msg)
				app:setStatus("could not read that script -- line " .. err.line)
				return false
			end

			app:setDoc(doc, "convert " .. name)
			app:setOrigin(instance)
			view.report.TextColor3 = a.c.text2

			local lines = {
				string.format("%d statements became %d blocks across %d stacks.",
					reportData.total, d.count(doc), reportData.stacks),
			}
			if instance then
				lines[#lines + 1] = "Insert will write back into " ..
					instance:GetFullName() .. "."
			end
			if reportData.raw > 0 then
				local where = {}
				for index, note in ipairs(reportData.notes) do
					if index <= 6 then
						where[#where + 1] = "line " .. note.line .. " (" .. note.text .. ")"
					end
				end
				lines[#lines + 1] = string.format(
					"%d kept as raw Luau: %s.", reportData.raw, table.concat(where, ", "))
			else
				lines[#lines + 1] = "Every statement matched a block."
			end
			view.report.Text = table.concat(lines, "\n")
			app:setStatus("converted " .. name)
			if app.showTab then app.showTab("build") end
			return true
		end
		view.convertSource = convertSource

		convert.MouseButton1Click:Connect(function()
			local instance = view.target
			if not instance then
				app:setStatus("select a script in the Explorer first")
				return
			end
			local source = readSource(instance)
			if not source then
				view.report.TextColor3 = a.c.err
				view.report.Text = "Studio would not let the plugin read that script. " ..
					"Look for the permission prompt, or allow script access in " ..
					"Plugins -> Manage Plugins, then try again."
				return
			end
			convertSource(source, instance.Name, instance)
		end)

		Selection.SelectionChanged:Connect(describe)
		describe()

		-- pasting, for code that is not in the place yet -----------------------------
		b.spacer(6, 5).Parent = column
		b.rule({ LayoutOrder = 6, parent = column, bg = "lineSoft" })
		b.micro("or paste code", {
			Size = UDim2.new(1, 0, 0, 16),
			fg = "text3",
			LayoutOrder = 7,
			Parent = column,
		})

		local editor = b.new("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, 220),
			bg = "sunken",
			stroke = { color = "line" },
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			LayoutOrder = 8,
			Parent = column,
		})
		view.input = b.new("TextBox", {
			Text = "",
			PlaceholderText = "-- paste Luau here if it is not in the place yet",
			MultiLine = true,
			ClearTextOnFocus = false,
			Size = UDim2.new(1, -16, 0, 0),
			Position = UDim2.fromOffset(8, 8),
			AutomaticSize = Enum.AutomaticSize.Y,
			Font = a.font.mono,
			TextSize = 13,
			fg = "text",
			ph = "text3",
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = editor,
		})
		b.new("UISizeConstraint", { MinSize = Vector2.new(0, 200), Parent = view.input })

		local pasteRow = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 30),
			layout = { dir = "x", gap = 8 },
			LayoutOrder = 9,
			Parent = column,
		})
		local convertPasted = b.button({
			label = "Convert pasted code",
			Size = UDim2.fromOffset(170, 28),
			LayoutOrder = 1,
			Parent = pasteRow,
		})
		view.convertPasted = convertPasted
		convertPasted.MouseButton1Click:Connect(function()
			convertSource(view.input.Text, "Pasted", nil)
		end)

		local sample = b.button({
			label = "Use a sample",
			Size = UDim2.fromOffset(120, 28),
			LayoutOrder = 2,
			Parent = pasteRow,
		})
		sample.MouseButton1Click:Connect(function()
			view.input.Text = [[
local Players = game:GetService("Players")

local COOLDOWN = 3
local trap = script.Parent

trap.Touched:Connect(function(hit)
		local hum = hit.Parent:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		hum:TakeDamage(20)
		trap.Transparency = 0.7
		task.wait(COOLDOWN)
		trap.Transparency = 0
end)

Players.PlayerAdded:Connect(function(player)
		print(player.Name .. " joined")
end)
]]
		end)

		a.onChange(describe)
		return view
end

--=============================================================================
-- settings
--=============================================================================

local function section(parent, order, title)
		local frame = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order,
			layout = { dir = "y", gap = 6 },
			Parent = parent,
		})
		b.micro(title, {
			Size = UDim2.new(1, 0, 0, 16),
			LayoutOrder = 0,
			fg = "accent",
			Parent = frame,
		})
		b.rule({ LayoutOrder = 1, parent = frame, bg = "lineSoft" })
		return frame
end

local function row(parent, order, label, help)
		local frame = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, help and 40 or 28),
			LayoutOrder = order,
			Parent = parent,
		})
		b.text({
			Text = label,
			Size = UDim2.new(0, 210, 0, 20),
			Parent = frame,
		})
		if help then
			b.text({
				Text = help,
				Size = UDim2.new(1, -240, 0, 18),
				Position = UDim2.fromOffset(0, 18),
				fg = "text3",
				TextSize = 11,
				TextWrapped = true,
				Parent = frame,
			})
		end
		return frame
end

local function toggle(parent, value, onChange)
		local button = b.button({
			label = value and "on" or "off",
			Size = UDim2.fromOffset(56, 22),
			Position = UDim2.new(1, -60, 0, 0),
			bg = value and "accentSoft" or "raised",
			Parent = parent,
		})
		local label = button:FindFirstChildWhichIsA("TextLabel")
		button.MouseButton1Click:Connect(function()
			value = not value
			label.Text = value and "on" or "off"
			b.states(button, value and "accentSoft" or "raised")
			onChange(value)
		end)
		return button
end

function n.settingsView(app, parent)
		local view = { app = app }

		view.frame = b.new("Frame", {
			Name = "Settings",
			Size = UDim2.fromScale(1, 1),
			Visible = false,
			bg = "bg",
			Parent = parent,
		})

		local scroll = b.new("ScrollingFrame", {
			Size = UDim2.new(1, -40, 1, -20),
			Position = UDim2.fromOffset(20, 10),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Parent = view.frame,
		})
		local column = b.new("Frame", {
			Size = UDim2.new(1, -20, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			layout = { dir = "y", gap = 18 },
			Parent = scroll,
		})
		b.new("UIPadding", { PaddingBottom = UDim.new(0, 40), Parent = column })

		-- projects -----------------------------------------------------------------
		local projects = section(column, 1, "projects")
		view.projectList = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 2,
			layout = { dir = "y", gap = 2 },
			Parent = projects,
		})

		local function paintProjects()
			b.clear(view.projectList)
			for index, project in ipairs(app.projects) do
				local isOpen = project.id == app.projectId
				local entry = b.new("Frame", {
					Size = UDim2.new(1, 0, 0, 26),
					LayoutOrder = index,
					bg = isOpen and "raised" or "panel",
					Parent = view.projectList,
				})
				b.text({
					Text = project.name or "Untitled",
					Size = UDim2.new(1, -220, 1, 0),
					Position = UDim2.fromOffset(8, 0),
					fg = isOpen and "text" or "text2",
					Font = isOpen and a.font.uiBold or a.font.ui,
					Parent = entry,
				})
				b.mono({
					Text = (project.blocks or 0) .. " blocks",
					Size = UDim2.fromOffset(90, 26),
					Position = UDim2.new(1, -190, 0, 0),
					TextSize = 10,
					fg = "text3",
					Parent = entry,
				})
				local open = b.button({
					label = isOpen and "open" or "switch to",
					Size = UDim2.fromOffset(84, 20),
					Position = UDim2.new(1, -96, 0, 3),
					Parent = entry,
				})
				open:SetAttribute("disabled", isOpen)
				open.MouseButton1Click:Connect(function()
					if isOpen then return end
					app:openProject(project.id)
				end)
				local remove = b.button({
					label = "delete",
					Size = UDim2.fromOffset(56, 20),
					Position = UDim2.new(1, -58, 0, 3),
					Parent = entry,
				})
				remove.MouseButton1Click:Connect(function()
					app:deleteProject(project.id)
				end)
			end
		end

		local buttons = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 30),
			LayoutOrder = 3,
			layout = { dir = "x", gap = 8 },
			Parent = projects,
		})
		local newButton = b.button({ label = "New project", Size = UDim2.fromOffset(110, 26),
			LayoutOrder = 1, Parent = buttons })
		newButton.MouseButton1Click:Connect(function()
			app:newProject("Untitled " .. (#app.projects + 1))
		end)
		local copyButton = b.button({ label = "Duplicate", Size = UDim2.fromOffset(96, 26),
			LayoutOrder = 2, Parent = buttons })
		copyButton.MouseButton1Click:Connect(function() app:duplicateProject() end)

		local exportButton = b.button({ label = "Export as text", Size = UDim2.fromOffset(116, 26),
			LayoutOrder = 3, Parent = buttons })
		exportButton.MouseButton1Click:Connect(function()
			local raw, err = app:exportProject()
			if not raw then
				app:setStatus(err or "could not export")
				return
			end
			n.textModal("project as json", raw,
				"Select all with Ctrl+A, copy with Ctrl+C, and paste it into Import project.")
		end)

		local importButton = b.button({ label = "Import project", Size = UDim2.fromOffset(116, 26),
			LayoutOrder = 4, Parent = buttons })
		importButton.MouseButton1Click:Connect(function()
			local shade = n.textModal("paste a project", "",
				"Paste exported project JSON here, then press Load.")
			local panel = shade:FindFirstChildWhichIsA("Frame")
			local box = panel:FindFirstChildWhichIsA("ScrollingFrame"):FindFirstChildWhichIsA("TextBox")
			box.TextEditable = true
			box.Text = ""
			local load = b.button({
				label = "Load",
				Size = UDim2.fromOffset(90, 26),
				Position = UDim2.new(1, -200, 1, -34),
				bg = "accent",
				labelColor = "accentInk",
				ZIndex = 902,
				Parent = panel,
			})
			load.MouseButton1Click:Connect(function()
				local ok, err = app:importProject(box.Text)
				app:setStatus(ok and "project loaded" or (err or "could not load that"))
				if ok then shade:Destroy() end
			end)
		end)

		app:on("projects", paintProjects)
		app:on("doc", paintProjects)
		paintProjects()

		-- look ----------------------------------------------------------------------
		local look = section(column, 2, "look")
		local themeRow = row(look, 2, "Theme", "Ink is the dark drafting board; paper is the light one.")
		local themeButtons = b.new("Frame", {
			Size = UDim2.fromOffset(130, 22),
			Position = UDim2.new(1, -134, 0, 0),
			layout = { dir = "x", gap = 6 },
			Parent = themeRow,
		})
		for index, name in ipairs({ "ink", "paper" }) do
			local button = b.button({
				label = name,
				Size = UDim2.fromOffset(60, 22),
				LayoutOrder = index,
				bg = a.c.name == name and "accentSoft" or "raised",
				Parent = themeButtons,
			})
			button.MouseButton1Click:Connect(function()
				a.setTheme(name)
				app:setSetting("theme", name)
			end)
		end

		local bannerRow = row(look, 3, "Banner comment",
			"Two lines at the top of the generated script naming the project.")
		toggle(bannerRow, app.settings.banner, function(value)
			app:setSetting("banner", value)
			app:emit("codeDirty")
		end)

		-- behaviour -------------------------------------------------------------------
		local behaviour = section(column, 3, "behaviour")
		local saveRow = row(behaviour, 2, "Autosave",
			"Saves a couple of seconds after you stop editing.")
		toggle(saveRow, app.settings.autoSave, function(value)
			app:setSetting("autoSave", value)
		end)

		-- where each kind of script goes ------------------------------------------
		local places = section(column, 4, "where scripts go")
		b.text({
			Text = "A new script is put where that kind of script belongs. Click to " ..
				"cycle through the sensible alternatives.",
			Size = UDim2.new(1, 0, 0, 28),
			TextWrapped = true,
			TextSize = 11,
			fg = "text3",
			LayoutOrder = 2,
			Parent = places,
		})

		for index, kind in ipairs(o.KINDS) do
			local mark = KIND_MARK[kind]
			local placeRow = row(places, index + 2, kind, mark and mark.note or nil)
			local button = b.button({
				label = app:destinationFor(kind),
				Size = UDim2.fromOffset(240, 22),
				Position = UDim2.new(1, -244, 0, 0),
				Parent = placeRow,
			})
			local label = button:FindFirstChildWhichIsA("TextLabel")
			button.MouseButton1Click:Connect(function()
				local options = o.DESTINATIONS[kind]
				local at = table.find(options, app:destinationFor(kind)) or 0
				local nextPlace = options[(at % #options) + 1]
				app:setDestination(kind, nextPlace)
				label.Text = nextPlace
				app:setStatus(kind .. " goes to " .. nextPlace)
			end)
		end

		-- your own blocks ---------------------------------------------------------
		-- Plugin settings live in one Studio install, so a library that is worth
		-- keeping wants to be a ModuleScript: committed, dragged into a model, or
		-- handed over in a place file.
		local mine = section(column, 5, "your blocks")
		local mineNote = b.text({
			Text = "",
			Size = UDim2.new(1, 0, 0, 30),
			TextWrapped = true,
			TextSize = 11,
			fg = "text3",
			LayoutOrder = 2,
			Parent = mine,
		})

		local mineButtons = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 26),
			LayoutOrder = 3,
			layout = { dir = "x", gap = 6 },
			Parent = mine,
		})

		local function paintMine()
			local count = #q.list()
			mineNote.Text = count == 0
				and ("You have not made any blocks yet. The palette has a \"your " ..
					"blocks\" section at the bottom with a New block button, and " ..
					"right-clicking anything on the canvas offers Make into a block.")
				or (count .. (count == 1 and " block" or " blocks") ..
					" of your own. Saving writes them into a ModuleScript you can " ..
					"commit or share; loading reads one back.")
		end
		app:on("customs", paintMine)
		app:on("doc", paintMine)
		paintMine()

		local newBlock = b.button({
			label = "New block",
			Size = UDim2.fromOffset(104, 26),
			LayoutOrder = 1,
			Parent = mineButtons,
		})
		newBlock.MouseButton1Click:Connect(function()
			if app.openBlockEditor then app.openBlockEditor(nil) end
		end)

		local saveLibrary = b.button({
			label = "Save to a ModuleScript",
			Size = UDim2.fromOffset(172, 26),
			LayoutOrder = 2,
			Parent = mineButtons,
		})
		b.tip(saveLibrary, "Writes every block you have made into one ModuleScript.")
		saveLibrary.MouseButton1Click:Connect(function()
			local list = q.list()
			if #list == 0 then
				app:setStatus("no blocks of your own to save yet")
				return
			end
			local source = q.toModuleSource(list, app.doc.name)
			local recording = ChangeHistoryService:TryBeginRecording("ABlocks block library")
			local ok, err = pcall(function()
				local parentPath = app:destinationFor("ModuleScript")
				local parent = o.resolvePath(parentPath)
				if not parent then error("could not find " .. parentPath, 0) end
				local made = Instance.new("ModuleScript")
				made.Name = "ABlocksBlocks"
				made.Source = source
				made.Parent = parent
				Selection:Set({ made })
				return made
			end)
			if recording then
				ChangeHistoryService:FinishRecording(recording,
					ok and Enum.FinishRecordingOperation.Commit
					or Enum.FinishRecordingOperation.Cancel)
			end
			if ok then
				app:setStatus(string.format("saved %d blocks into ABlocksBlocks in %s",
					#list, app:destinationFor("ModuleScript")))
			else
				n.textModal("could not save the library", tostring(err),
					"Studio asks permission before a plugin may write script source.")
			end
		end)

		local loadLibrary = b.button({
			label = "Load from a ModuleScript",
			Size = UDim2.fromOffset(186, 26),
			LayoutOrder = 3,
			Parent = mineButtons,
		})
		b.tip(loadLibrary, "Select a saved library in the Explorer first.\n" ..
			"Loaded blocks are added, never overwritten.")
		loadLibrary.MouseButton1Click:Connect(function()
			local instance = Selection:Get()[1]
			if not instance or not instance:IsA("ModuleScript") then
				app:setStatus("select the ModuleScript in the Explorer first")
				return
			end
			local source, readErr = readSource(instance)
			if not source then
				app:setStatus(readErr or "could not read that script")
				return
			end
			local made, err = q.fromModuleSource(source)
			if not made then
				-- Not a saved library, then. A module of ordinary functions is
				-- still useful: offer one block for each function it exports.
				if app.makeBlocksFromModule and app.makeBlocksFromModule(instance) then
					return
				end
				app:setStatus(tostring(err))
				return
			end
			local added = 0
			for _, custom in ipairs(made) do
				if app:putCustom(custom) then added += 1 end
			end
			app:setStatus(string.format("added %d blocks from %s", added, instance.Name))
		end)

		-- shortcuts ---------------------------------------------------------------------
		local keys = section(column, 6, "keyboard")
		local list = {
			{ "hold left button", "pick a block up off the canvas" },
			{ "Ctrl+Z / Ctrl+Y", "undo, redo" },
			{ "Delete", "remove the selected block and what follows it" },
			{ "Ctrl+D", "duplicate the selection" },
			{ "Ctrl+F", "search the palette" },
			{ "Ctrl+S", "save the project" },
			{ "Ctrl+Enter", "write the script into the game" },
			{ "Ctrl+L", "tidy the canvas" },
			{ "Ctrl+0", "zoom back to 100%" },
			{ "Ctrl+Space", "open the completion list in a field" },
			{ "Escape", "dismiss the completion list, or deselect" },
		}
		for index, entry in ipairs(list) do
			local line = b.new("Frame", {
				Size = UDim2.new(1, 0, 0, 20),
				LayoutOrder = index + 1,
				Parent = keys,
			})
			b.mono({
				Text = entry[1],
				Size = UDim2.fromOffset(150, 20),
				TextSize = 11,
				fg = "text",
				Parent = line,
			})
			b.text({
				Text = entry[2],
				Size = UDim2.new(1, -160, 1, 0),
				Position = UDim2.fromOffset(160, 0),
				fg = "text2",
				TextSize = 11,
				Parent = line,
			})
		end

		return view
end

return n
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX15">
			<Properties>
				<string name="Name">o</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- o  ·  application state, history and storage
--
-- One object holds the open document, the selection, the undo stack and the
-- saved projects.  Views never edit the document directly -- they go through
-- `app:mutate`, which snapshots for undo and tells everyone to redraw.  That is
-- the whole reason undo, autosave and the live code panel are not each other's
-- problem.

local d = require(script.Parent.d)
local c = require(script.Parent.c)
local q = require(script.Parent.q)

local HttpService = game:GetService("HttpService")

local o = {}

local KEY_CUSTOMS = "ablocks.customs.v1"
local KEY_PROJECTS = "ablocks.projects.v1"
local KEY_SETTINGS = "ablocks.settings.v1"
local KEY_CURRENT = "ablocks.current.v1"
local HISTORY_LIMIT = 50

-- Where each kind of script belongs.  The first entry is the default, and the
-- rest are what the Setup tab offers as alternatives.
o.DESTINATIONS = {
		Script = { "ServerScriptService", "Workspace", "ServerStorage" },
		LocalScript = { "StarterPlayer.StarterPlayerScripts", "StarterGui", "ReplicatedFirst" },
		ModuleScript = { "ReplicatedStorage", "ServerScriptService", "ServerStorage" },
}

o.KINDS = { "Script", "LocalScript", "ModuleScript" }

local DEFAULT_SETTINGS = {
		theme = "ink",
		zoom = 1,
		autoSave = true,
		scriptKind = "Script",
		destinations = {
			Script = "ServerScriptService",
			LocalScript = "StarterPlayer.StarterPlayerScripts",
			ModuleScript = "ReplicatedStorage",
		},
		showCode = true,
		banner = true,
		read = {},
		favourites = {},
		recents = {},
		filterBySide = false,
}

local App = {}
App.__index = App

--=============================================================================
-- signals
--=============================================================================

function App:on(name, callback)
		local list = self.listeners[name]
		if not list then
			list = {}
			self.listeners[name] = list
		end
		list[#list + 1] = callback
		return function()
			for index, entry in ipairs(list) do
				if entry == callback then
					table.remove(list, index)
					return
				end
			end
		end
end

function App:emit(name, ...)
		for _, callback in ipairs(self.listeners[name] or {}) do
			local ok, err = pcall(callback, ...)
			if not ok then
				warn("[ABlocks] listener for '" .. name .. "' failed: " .. tostring(err))
			end
		end
end

--=============================================================================
-- storage helpers
--=============================================================================

local function readJson(plugin, key, fallback)
		local raw = plugin:GetSetting(key)
		if type(raw) ~= "string" or raw == "" then return fallback end
		local ok, value = pcall(HttpService.JSONDecode, HttpService, raw)
		if not ok then return fallback end
		return value
end

local function writeJson(plugin, key, value)
		local ok, raw = pcall(HttpService.JSONEncode, HttpService, value)
		if ok then plugin:SetSetting(key, raw) end
		return ok
end

--=============================================================================
-- construction
--=============================================================================

-- A canvas that shows what the thing does, for a first run.
local function starterDoc()
		local doc = d.newDoc("First project")
		local stack = d.newStack(doc, 32, 32)

		local note = d.create(doc, "comment")
		note.f.text = "touch this part to be sent back to the start"
		d.attachToStack(doc, note, stack, nil, {})

		local event = d.create(doc, "onTouch")
		event.f.part, event.f.hit = "script.Parent", "hit"
		d.attachToStack(doc, event, stack, nil, {})

		local find = d.create(doc, "humanoidOf")
		find.f.name, find.f.char = "hum", "hit.Parent"
		d.attachToSlot(doc, find, event, "body", nil, {})

		local guard = d.create(doc, "guard")
		guard.f.cond = "hum"
		d.attachToSlot(doc, guard, event, "body", nil, {})

		local move = d.create(doc, "teleportChar")
		move.f.char, move.f.x, move.f.y, move.f.z = "hit.Parent", "0", "10", "0"
		d.attachToSlot(doc, move, event, "body", nil, {})

		return doc
end

o.starterDoc = starterDoc

function o.newApp(plugin, widget)
		local app = setmetatable({
			plugin = plugin,
			widget = widget,
			listeners = {},
			undoStack = {},
			redoStack = {},
			selection = nil,
			hover = nil,
			tab = "build",
			dirty = false,
			lastSaved = nil,
			status = "",
		}, App)

		app.settings = {}
		local saved = readJson(plugin, KEY_SETTINGS, {})
		for key, value in pairs(DEFAULT_SETTINGS) do
			local stored = saved[key]
			if stored ~= nil and type(stored) == type(value) then
				app.settings[key] = stored
			else
				app.settings[key] = value
			end
		end

		app.projects = readJson(plugin, KEY_PROJECTS, nil)
		if type(app.projects) ~= "table" then app.projects = {} end

		local currentId = plugin:GetSetting(KEY_CURRENT)
		local project = nil
		for _, entry in ipairs(app.projects) do
			if entry.id == currentId then project = entry end
		end
		project = project or app.projects[1]

		app:loadCustoms()

		if project then
			local restored = d.fromSave(project.doc)
			app.doc = restored or starterDoc()
			if app.doc.customs then q.adopt(app.doc.customs) end
			app.projectId = project.id
		else
			app.doc = starterDoc()
			app.projectId = nil
		end

		return app
end

--=============================================================================
-- editing
--=============================================================================

local function snapshot(app)
		app.doc.customs = q.embed(app.doc)
		return d.toSave(app.doc)
end

--=============================================================================
-- the custom block library
--=============================================================================

function App:loadCustoms()
		local saved = readJson(self.plugin, KEY_CUSTOMS, nil)
		if type(saved) ~= "table" then return 0 end
		return q.adopt(saved)
end

function App:saveCustoms()
		local out = {}
		for _, custom in ipairs(q.list()) do
			if custom.shared ~= false then out[#out + 1] = q.toSave(custom) end
		end
		writeJson(self.plugin, KEY_CUSTOMS, out)
		self:emit("customs")
end

-- Adds or replaces one of your own blocks and tells everything to redraw.
function App:putCustom(custom)
		local ok, err = q.register(custom)
		if not ok then
			self:setStatus("that block would not build: " .. tostring(err))
			return false, err
		end
		self:saveCustoms()
		self:emit("doc")
		self:setStatus("saved the block " .. custom.label)
		return true
end

function App:dropCustom(id)
		local custom = q.get(id)
		q.unregister(id)
		self:saveCustoms()
		self:emit("doc")
		if custom then self:setStatus("deleted the block " .. custom.label) end
end

-- Runs `edit`, having first stored a snapshot for undo.  Returns whatever the
-- edit returned, so callers can chain.
function App:mutate(label, edit)
		local before = snapshot(self)
		local ok, result = pcall(edit, self.doc)
		if not ok then
			warn("[ABlocks] edit '" .. tostring(label) .. "' failed: " .. tostring(result))
			local restored = d.fromSave(before)
			if restored then self.doc = restored end
			self:emit("doc")
			return nil
		end

		self.undoStack[#self.undoStack + 1] = { label = label, save = before }
		if #self.undoStack > HISTORY_LIMIT then table.remove(self.undoStack, 1) end
		self.redoStack = {}
		self.dirty = true
		self:emit("doc")
		self:scheduleSave()
		return result
end

local function swapTo(app, save, otherStack, label)
		local current = snapshot(app)
		local restored = d.fromSave(save)
		if not restored then return false end
		restored.name = app.doc.name
		app.doc = restored
		otherStack[#otherStack + 1] = { label = label, save = current }
		if app.selection and not app.doc.blocks[app.selection] then
			app.selection = nil
			app:emit("select")
		end
		app.dirty = true
		app:emit("doc")
		app:scheduleSave()
		return true
end

function App:undo()
		local entry = table.remove(self.undoStack)
		if not entry then
			self:setStatus("nothing to undo")
			return false
		end
		swapTo(self, entry.save, self.redoStack, entry.label)
		self:setStatus("undid " .. (entry.label or "that"))
		return true
end

function App:redo()
		local entry = table.remove(self.redoStack)
		if not entry then
			self:setStatus("nothing to redo")
			return false
		end
		swapTo(self, entry.save, self.undoStack, entry.label)
		self:setStatus("redid " .. (entry.label or "that"))
		return true
end

-- For edits that have already happened -- typing in a field, dragging a block --
-- where the snapshot was taken before the interaction began.
function App:commit(label, beforeSave)
		if not beforeSave then return end
		self.undoStack[#self.undoStack + 1] = { label = label, save = beforeSave }
		if #self.undoStack > HISTORY_LIMIT then table.remove(self.undoStack, 1) end
		self.redoStack = {}
		self.dirty = true
		self:emit("doc")
		self:scheduleSave()
end

-- A snapshot to hand back to `commit` later.
function App:mark()
		return snapshot(self)
end

function App:canUndo() return #self.undoStack > 0 end
function App:canRedo() return #self.redoStack > 0 end

function App:select(blockId)
		if self.selection == blockId then return end
		self.selection = blockId
		self:emit("select", blockId)
end

function App:selected()
		return self.selection and self.doc.blocks[self.selection] or nil
end

function App:setStatus(text)
		self.status = text or ""
		self:emit("status", self.status)
end

--=============================================================================
-- documents
--=============================================================================

function App:setDoc(doc, label)
		if doc.customs then q.adopt(doc.customs) end
		self.undoStack[#self.undoStack + 1] = { label = label or "replace", save = snapshot(self) }
		if #self.undoStack > HISTORY_LIMIT then table.remove(self.undoStack, 1) end
		self.redoStack = {}
		self.doc = doc
		self.selection = nil
		self.dirty = true
		self:emit("select")
		self:emit("doc")
		self:scheduleSave()
end

function App:rename(name)
		self.doc.name = name
		self.dirty = true
		self:emit("doc")
		self:save()
end

--=============================================================================
-- projects
--=============================================================================

local function newId()
		return string.format("p%d", math.floor(os.clock() * 1000) % 100000000)
end

function App:save()
		local entry = nil
		for _, project in ipairs(self.projects) do
			if project.id == self.projectId then entry = project end
		end
		if not entry then
			entry = { id = self.projectId or newId() }
			self.projects[#self.projects + 1] = entry
			self.projectId = entry.id
		end
		entry.name = self.doc.name
		entry.doc = snapshot(self)
		entry.savedAt = os.time()
		entry.blocks = d.count(self.doc)

		writeJson(self.plugin, KEY_PROJECTS, self.projects)
		self.plugin:SetSetting(KEY_CURRENT, self.projectId)
		self.dirty = false
		self.lastSaved = os.time()
		self:emit("projects")
		self:setStatus("saved " .. self.doc.name)
		return true
end

-- Debounced autosave, so a drag does not write settings sixty times.
function App:scheduleSave()
		if not self.settings.autoSave then return end
		self.saveToken = (self.saveToken or 0) + 1
		local token = self.saveToken
		task.delay(2.5, function()
			if token == self.saveToken and self.dirty then self:save() end
		end)
end

function App:newProject(name)
		if self.dirty then self:save() end
		local doc = d.newDoc(name or "Untitled")
		self.projectId = newId()
		self.undoStack, self.redoStack = {}, {}
		self.doc = doc
		self.selection = nil
		self:emit("select")
		self:emit("doc")
		self:save()
		return doc
end

function App:openProject(id)
		if self.dirty then self:save() end
		for _, project in ipairs(self.projects) do
			if project.id == id then
				local restored = d.fromSave(project.doc)
				if restored and restored.customs then q.adopt(restored.customs) end
				if not restored then
					self:setStatus("could not open " .. tostring(project.name))
					return false
				end
				self.projectId = id
				self.doc = restored
				self.undoStack, self.redoStack = {}, {}
				self.selection = nil
				self.dirty = false
				self.plugin:SetSetting(KEY_CURRENT, id)
				self:emit("select")
				self:emit("doc")
				self:setStatus("opened " .. self.doc.name)
				return true
			end
		end
		return false
end

function App:duplicateProject()
		local copy = d.fromSave(snapshot(self))
		copy.name = self.doc.name .. " copy"
		if self.dirty then self:save() end
		self.projectId = newId()
		self.doc = copy
		self.undoStack, self.redoStack = {}, {}
		self:emit("doc")
		self:save()
		return copy
end

function App:deleteProject(id)
		for index, project in ipairs(self.projects) do
			if project.id == id then
				table.remove(self.projects, index)
				writeJson(self.plugin, KEY_PROJECTS, self.projects)
				if self.projectId == id then
					local next_ = self.projects[1]
					if next_ then
						self:openProject(next_.id)
					else
						self:newProject("Untitled")
					end
				end
				self:emit("projects")
				return true
			end
		end
		return false
end

function App:exportProject()
		local ok, raw = pcall(HttpService.JSONEncode, HttpService, snapshot(self))
		if not ok then return nil, "could not encode this project" end
		return raw
end

function App:importProject(raw)
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		if not ok then return false, "that is not valid JSON" end
		local doc, err = d.fromSave(decoded)
		if not doc then return false, err or "that is not a ABlocks project" end
		self:setDoc(doc, "import project")
		return true
end

--=============================================================================
-- settings
--=============================================================================

function App:setSetting(key, value)
		self.settings[key] = value
		writeJson(self.plugin, KEY_SETTINGS, self.settings)
		self:emit("settings", key, value)
end

--=============================================================================
-- the script this project belongs to
--=============================================================================

-- "ServerScriptService.Main" -> the instance, or nil if it has gone.
function o.resolvePath(path)
		if type(path) ~= "string" or path == "" then return nil end
		local target = game
		for piece in string.gmatch(path, "[^%.]+") do
			if piece ~= "game" then
				local ok, child = pcall(function()
					if target == game then
						return game:FindFirstChild(piece) or game:GetService(piece)
					end
					return target:FindFirstChild(piece)
				end)
				if not ok or not child then return nil end
				target = child
			end
		end
		return target ~= game and target or nil
end

-- The other direction: what a generated script should write to reach this
-- instance.  `GetFullName` starts at `game`, which is not spelt that way in
-- code, so the first step becomes a GetService call.
function o.pathTo(instance)
		if not instance then return nil end
		local pieces = {}
		local at = instance
		while at and at ~= game do
			table.insert(pieces, 1, at.Name)
			at = at.Parent
		end
		if #pieces == 0 then return nil end
		local service = table.remove(pieces, 1)
		local path = string.format("game:GetService(%q)", service)
		for _, piece in ipairs(pieces) do
			if string.match(piece, "^[%a_][%w_]*$") then
				path ..= "." .. piece
			else
				path ..= string.format("[%q]", piece)
			end
		end
		return path
end

-- Remembers which script in the place this project was read out of, so the
-- code can be written back to it instead of piling up new copies.
function App:setOrigin(instance)
		if not instance then
			self.doc.origin = nil
			self:emit("doc")
			return
		end
		self.doc.origin = {
			kind = instance.ClassName,
			path = instance:GetFullName(),
			name = instance.Name,
		}
		self.dirty = true
		-- the window's write-out button reads this, so it has to hear about it
		self:emit("doc")
end

-- The originating script, if it still exists and is still a script.
function App:originInstance()
		local origin = self.doc.origin
		if not origin then return nil end
		local instance = o.resolvePath(origin.path)
		if instance and instance:IsA("LuaSourceContainer") then return instance end
		return nil
end

-- What kind of script this project is heading for: whatever it came from, or
-- whatever was chosen by hand.
function App:scriptKind()
		local origin = self.doc.origin
		if origin and origin.kind then return origin.kind end
		return self.settings.scriptKind or "Script"
end

function App:setScriptKind(kind)
		-- Choosing a kind by hand means this is no longer tied to the script it was
		-- read from, so the two cannot disagree.
		if self.doc.origin and self.doc.origin.kind ~= kind then
			self.doc.origin = nil
		end
		self:setSetting("scriptKind", kind)
		self:emit("doc")
end

-- Where a script of this kind should be put.
function App:destinationFor(kind)
		kind = kind or self:scriptKind()
		local chosen = self.settings.destinations and self.settings.destinations[kind]
		local options = o.DESTINATIONS[kind] or o.DESTINATIONS.Script
		for _, option in ipairs(options) do
			if option == chosen then return chosen end
		end
		return options[1]
end

function App:setDestination(kind, path)
		local destinations = {}
		for key, value in pairs(self.settings.destinations or {}) do
			destinations[key] = value
		end
		destinations[kind] = path
		self:setSetting("destinations", destinations)
end

--=============================================================================
-- facts about the document, for the status bar
--=============================================================================

function App:stats()
		local blocks, stacks, raw = 0, #self.doc.stacks, 0
		local byCat = {}
		d.walk(self.doc, function(block)
			blocks = blocks + 1
			local def = c.get(block.k)
			if def then
				byCat[def.cat] = (byCat[def.cat] or 0) + 1
				if def.raw then raw = raw + 1 end
			end
		end)
		return { blocks = blocks, stacks = stacks, raw = raw, byCat = byCat }
end

return o
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX16">
			<Properties>
				<string name="Name">p</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- p  ·  the window
--
-- Tabs across the top, work in the middle, actions along the bottom.  The
-- bottom bar is where the plugin's two real verbs live -- write the script out,
-- and undo -- so they sit in the same place whichever tab you are on.
--
-- Keyboard handling lives here too, because shortcuts belong to the window
-- rather than to any one view.

local a = require(script.Parent.a)
local b = require(script.Parent.b)
local c = require(script.Parent.c)
local j = require(script.Parent.j)
local k = require(script.Parent.k)
local l = require(script.Parent.l)
local m = require(script.Parent.m)
local n = require(script.Parent.n)
local o = require(script.Parent.o)
local q = require(script.Parent.q)
local r = require(script.Parent.r)

local UserInputService = game:GetService("UserInputService")

local p = {}

local TABS = {
		{ id = "build", label = "build", hint = "The canvas, the palette and the generated Luau." },
		{ id = "learn", label = "learn", hint = "Thirty-two lessons, from first block to first script." },
		{ id = "import", label = "import", hint = "Turn a script you have selected into blocks." },
		{ id = "setup", label = "setup", hint = "Projects, where scripts go, theme, shortcuts." },
}

--=============================================================================
-- top bar: wordmark, tabs, project name
--=============================================================================

local function topBar(app, parent, shell)
		local bar = b.new("Frame", {
			Name = "TopBar",
			Size = UDim2.new(1, 0, 0, a.metric.topBar),
			bg = "panel",
			Parent = parent,
		})
		b.rule({ Position = UDim2.new(0, 0, 1, -1), parent = bar })

		-- a drawn mark rather than an image asset
		local mark = b.new("Frame", {
			Size = UDim2.fromOffset(18, a.metric.topBar),
			Position = UDim2.fromOffset(14, 0),
			Parent = bar,
		})
		for index = 1, 3 do
			b.new("Frame", {
				Size = UDim2.fromOffset(14 - (index - 1) * 4, 2),
				Position = UDim2.fromOffset(0, 15 + (index - 1) * 5),
				bg = index == 1 and "accent" or "text3",
				BackgroundTransparency = index == 1 and 0 or 0.4,
				Parent = mark,
			})
		end

		b.text({
			Text = "ABlocks",
			Size = UDim2.fromOffset(70, a.metric.topBar),
			Position = UDim2.fromOffset(38, 0),
			Font = a.font.uiBold,
			TextSize = 13,
			fg = "text2",
			Parent = bar,
		})
		b.tip(mark, "ABlocks -- blocks in, Luau out.")

		local tabs = {}
		local tabStrip = b.new("Frame", {
			Size = UDim2.new(0, #TABS * 84, 1, 0),
			Position = UDim2.fromOffset(124, 0),
			layout = { dir = "x", gap = 0 },
			Parent = bar,
		})

		for index, tab in ipairs(TABS) do
			local button = b.new("TextButton", {
				Size = UDim2.fromOffset(84, a.metric.topBar),
				LayoutOrder = index,
				bg = "panel",
				Parent = tabStrip,
			})

			local label = b.text({
				Text = string.upper(tab.label),
				Size = UDim2.fromScale(1, 1),
				Font = a.font.uiBold,
				TextSize = 11,
				fg = "text3",
				TextXAlignment = Enum.TextXAlignment.Center,
				Parent = button,
			})

			-- the active tab is marked by a rule under it, not by a filled shape
			local marker = b.new("Frame", {
				Size = UDim2.new(1, 0, 0, 2),
				Position = UDim2.new(0, 0, 1, -2),
				bg = "accent",
				Visible = false,
				ZIndex = 3,
				Parent = button,
			})

			b.tip(button, tab.hint)
			button.MouseButton1Click:Connect(function() shell.showTab(tab.id) end)
			b.hover(button, function()
				if shell.tab ~= tab.id then label.TextColor3 = a.c.text2 end
			end, function()
				if shell.tab ~= tab.id then label.TextColor3 = a.c.text3 end
			end)

			tabs[tab.id] = { button = button, label = label, marker = marker }
		end

		-- project name, editable in place
		local nameBox = b.new("TextBox", {
			Text = app.doc.name,
			PlaceholderText = "project name",
			ClearTextOnFocus = false,
			Size = UDim2.fromOffset(220, 24),
			Position = UDim2.new(1, -276, 0, 10),
			Font = a.font.uiBold,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Right,
			fg = "text",
			ph = "text3",
			Parent = bar,
		})
		nameBox.FocusLost:Connect(function()
			local name = string.match(nameBox.Text, "^%s*(.-)%s*$")
			if name == "" then name = "Untitled" end
			nameBox.Text = name
			app:rename(name)
		end)
		app:on("doc", function()
			if not nameBox:IsFocused() then nameBox.Text = app.doc.name end
		end)

		local themeButton = b.new("TextButton", {
			Size = UDim2.fromOffset(34, a.metric.topBar),
			Position = UDim2.new(1, -44, 0, 0),
			bg = "panel",
			Parent = bar,
		})
		local themeMark = b.new("Frame", {
			Size = UDim2.fromOffset(12, 12),
			Position = UDim2.fromOffset(11, 16),
			bg = "text2",
			radius = 6,
			Parent = themeButton,
		})
		b.new("Frame", {
			Size = UDim2.fromOffset(6, 12),
			bg = "panel",
			Parent = themeMark,
		})
		b.tip(themeButton, "Switch between the ink and paper themes.")
		themeButton.MouseButton1Click:Connect(function()
			local name = a.toggleTheme()
			app:setSetting("theme", name)
			app:setStatus(name .. " theme")
		end)

		return bar, tabs
end

--=============================================================================
-- bottom: actions, then a thin status strip
--=============================================================================

local function actionBar(app, parent, shell)
		local bar = b.new("Frame", {
			Name = "ActionBar",
			Size = UDim2.new(1, 0, 0, a.metric.actionBar),
			Position = UDim2.new(0, 0, 1, -a.metric.actionBar - a.metric.statusBar),
			bg = "panel",
			Parent = parent,
		})
		b.rule({ parent = bar })

		local left = b.new("Frame", {
			Size = UDim2.new(0.5, 0, 1, 0),
			Position = UDim2.fromOffset(12, 0),
			layout = { dir = "x", gap = 6, align = "middle" },
			Parent = bar,
		})

		local function action(parentFrame, label, hint, order, onClick, accent)
			local button = b.button({
				label = label,
				Size = UDim2.fromOffset(#label * 8 + 24, 26),
				LayoutOrder = order,
				bg = accent and "accent" or "raised",
				labelColor = accent and "accentInk" or "text",
				Parent = parentFrame,
			})
			b.tip(button, hint)
			button.MouseButton1Click:Connect(onClick)
			return button
		end

		local undo = action(left, "undo", "Ctrl+Z", 1, function() app:undo() end)
		local redo = action(left, "redo", "Ctrl+Y", 2, function() app:redo() end)
		action(left, "tidy", "Line every stack up in a column.  Ctrl+L", 3, function()
			if app.canvas then app.canvas:tidy() end
		end)
		action(left, "100%", "Zoom back to 100%.  Ctrl+0", 4, function()
			if app.canvas then app.canvas:resetZoom() end
		end)
		action(left, "save", "Save this project.  Ctrl+S", 5, function() app:save() end)

		local function paintHistory()
			undo:SetAttribute("disabled", not app:canUndo())
			redo:SetAttribute("disabled", not app:canRedo())
			undo:FindFirstChildWhichIsA("TextLabel").TextTransparency = app:canUndo() and 0 or 0.55
			redo:FindFirstChildWhichIsA("TextLabel").TextTransparency = app:canRedo() and 0 or 0.55
		end
		app:on("doc", paintHistory)
		paintHistory()

		-- right hand side: what kind of script, and writing it out
		local right = b.new("Frame", {
			Size = UDim2.new(0, 420, 1, 0),
			Position = UDim2.new(1, -432, 0, 0),
			Parent = bar,
		})
		b.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = right,
		})

		local kindButton = b.button({
			label = app:scriptKind(),
			Size = UDim2.fromOffset(110, 26),
			LayoutOrder = 1,
			Parent = right,
		})
		local kindLabel = kindButton:FindFirstChildWhichIsA("TextLabel")
		kindButton.MouseButton1Click:Connect(function()
			local at = table.find(o.KINDS, app:scriptKind()) or 0
			app:setScriptKind(o.KINDS[(at % #o.KINDS) + 1])
		end)

		local copy = b.button({
			label = "copy",
			Size = UDim2.fromOffset(64, 26),
			LayoutOrder = 2,
			Parent = right,
		})
		b.tip(copy, "Studio gives plugins no clipboard, so this opens the code\n" ..
			"selected and ready for Ctrl+C.")
		copy.MouseButton1Click:Connect(function()
			n.textModal("generated luau", shell.code and shell.code.code or "")
		end)

		local insert = b.button({
			label = "Insert script",
			Size = UDim2.fromOffset(170, 26),
			LayoutOrder = 3,
			bg = "accent",
			labelColor = "accentInk",
			Parent = right,
		})
		local insertLabel = insert:FindFirstChildWhichIsA("TextLabel")
		insert.MouseButton1Click:Connect(function()
			if shell.code then shell.code:insertScript() end
		end)

		-- Both the kind and the button follow the document: converting a script
		-- ties the project to it, and the button then offers to update it.
		local function paintTarget()
			kindLabel.Text = app:scriptKind()
			local tied = app.doc.origin ~= nil
			b.tip(kindButton, tied
				and ("This project came from a " .. app:scriptKind() ..
					".\nChanging it here unties it from that script.")
				or ("Which kind of script to write.\nA " .. app:scriptKind() ..
					" goes to " .. app:destinationFor() .. "."))
			if shell.code then
				local label, hint = shell.code:insertLabel()
				insertLabel.Text = label
				b.tip(insert, hint .. "   Ctrl+Enter")
			end
		end
		app:on("doc", paintTarget)
		app:on("settings", paintTarget)
		shell.paintTarget = paintTarget

		return bar
end

local function statusStrip(app, parent)
		local strip = b.new("Frame", {
			Name = "StatusStrip",
			Size = UDim2.new(1, 0, 0, a.metric.statusBar),
			Position = UDim2.new(0, 0, 1, -a.metric.statusBar),
			bg = "panel",
			Parent = parent,
		})
		b.rule({ parent = strip })

		local message = b.mono({
			Text = "ready",
			Size = UDim2.new(1, -320, 1, 0),
			Position = UDim2.fromOffset(12, 0),
			TextSize = 10,
			fg = "text3",
			Parent = strip,
		})

		local stats = b.mono({
			Text = "",
			Size = UDim2.fromOffset(300, a.metric.statusBar),
			Position = UDim2.new(1, -312, 0, 0),
			TextSize = 10,
			fg = "text3",
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = strip,
		})

		local function paint()
			local counts = app:stats()
			local saved = "unsaved"
			if not app.dirty then
				saved = app.lastSaved
					and ("saved " .. os.date("%H:%M", app.lastSaved))
					or "saved"
			end
			stats.Text = string.format("%d blocks   %d stacks   %s",
				counts.blocks, counts.stacks, saved)
		end
		app:on("doc", paint)
		app:on("status", paint)
		app:on("status", function(text)
			message.Text = text == "" and "ready" or text
		end)
		paint()
		return strip
end

--=============================================================================
-- keyboard
--=============================================================================

local function keyboard(app, shell)
		local focused = true
		local widget = app.widget

		widget.WindowFocused:Connect(function() focused = true end)
		widget.WindowFocusReleased:Connect(function() focused = false end)

		-- Any focused text box counts, not just a block field: Delete while typing
		-- in the palette search must delete a letter, not the selected block.
		local function typing()
			local ok, box = pcall(function()
				return UserInputService:GetFocusedTextBox()
			end)
			if ok and box then return true end
			local canvas = app.canvas
			return canvas and canvas.editing ~= nil
		end

		UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if not focused or not widget.Enabled then return end
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

			local key = input.KeyCode
			local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
				or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
			local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
				or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
			local popup = m.popup()

			-- the completion list gets first refusal on the navigation keys
			if popup.open then
				if key == Enum.KeyCode.Down then
					popup:move(1)
					return
				elseif key == Enum.KeyCode.Up then
					popup:move(-1)
					return
				elseif key == Enum.KeyCode.Tab then
					popup:accept()
					return
				elseif key == Enum.KeyCode.Escape then
					popup:hide()
					return
				end
			end

			-- Ctrl+Space reopens the completion list in whichever field has focus
			if ctrl and key == Enum.KeyCode.Space then
				local canvas = app.canvas
				if canvas and canvas.refreshCompletion then canvas.refreshCompletion() end
				return
			end

			if typing() then return end

			if ctrl then
				if key == Enum.KeyCode.Z then
					if shift then app:redo() else app:undo() end
				elseif key == Enum.KeyCode.Y then
					app:redo()
				elseif key == Enum.KeyCode.D then
					if app.canvas then app.canvas:duplicateSelected() end
				elseif key == Enum.KeyCode.S then
					app:save()
				elseif key == Enum.KeyCode.F then
					shell.showTab("build")
					if shell.palette then shell.palette:focusSearch() end
				elseif key == Enum.KeyCode.L then
					if app.canvas then app.canvas:tidy() end
				elseif key == Enum.KeyCode.Zero then
					if app.canvas then app.canvas:resetZoom() end
				elseif key == Enum.KeyCode.Return then
					if shell.code then shell.code:insertScript() end
				end
				return
			end

			if key == Enum.KeyCode.Delete or key == Enum.KeyCode.Backspace then
				if app.canvas then app.canvas:deleteSelected() end
			elseif key == Enum.KeyCode.Escape then
				app:select(nil)
			end
		end)
end

--=============================================================================
-- assembly
--=============================================================================

function p.mount(app, widget)
		a.setTheme(app.settings.theme or "ink")

		local shell = { tab = "build" }

		local rootFrame = b.new("Frame", {
			Name = "ABlocks",
			Size = UDim2.fromScale(1, 1),
			bg = "bg",
			Parent = widget,
		})

		local overlay = b.new("Frame", {
			Name = "Overlay",
			Size = UDim2.fromScale(1, 1),
			ZIndex = 500,
			Parent = rootFrame,
		})
		b.setOverlay(overlay)

		local _, tabs = topBar(app, rootFrame, shell)

		local chrome = a.metric.topBar + a.metric.actionBar + a.metric.statusBar
		local pages = b.new("Frame", {
			Name = "Pages",
			Size = UDim2.new(1, 0, 1, -chrome),
			Position = UDim2.fromOffset(0, a.metric.topBar),
			Parent = rootFrame,
		})

		-- build ---------------------------------------------------------------------
		local buildPage = b.new("Frame", {
			Name = "Build",
			Size = UDim2.fromScale(1, 1),
			Parent = pages,
		})

		-- While a custom block is open as a canvas a strip sits above everything
		-- saying so; the rest of the page slides down to make room for it.
		local editBanner = r.banner(app, buildPage)

		local buildBody = b.new("Frame", {
			Name = "Body",
			Size = UDim2.fromScale(1, 1),
			Parent = buildPage,
		})
		app:on("editingCustom", function()
			local shown = editBanner.Visible
			buildBody.Position = shown and UDim2.fromOffset(0, 30) or UDim2.fromOffset(0, 0)
			buildBody.Size = shown and UDim2.new(1, 0, 1, -30) or UDim2.fromScale(1, 1)
		end)

		shell.palette = l.mount(app, buildBody)

		local middle = b.new("Frame", {
			Name = "Middle",
			Size = UDim2.new(1, -236, 1, 0),
			Position = UDim2.fromOffset(236, 0),
			Parent = buildBody,
		})

		local canvasHolder = b.new("Frame", {
			Size = UDim2.new(1, -400, 1, 0),
			Parent = middle,
		})
		app.canvas = m.mount(app, canvasHolder)

		local codeHolder = b.new("Frame", {
			Size = UDim2.new(0, 400, 1, 0),
			Position = UDim2.new(1, -400, 0, 0),
			Parent = middle,
		})
		shell.code = n.codePanel(app, codeHolder)

		-- the code panel can be folded away when the canvas needs the room
		local function applyCodeVisibility()
			local shown = app.settings.showCode
			codeHolder.Visible = shown
			canvasHolder.Size = shown and UDim2.new(1, -400, 1, 0) or UDim2.fromScale(1, 1)
		end
		app:on("settings", function(key)
			if key == "showCode" then applyCodeVisibility() end
		end)
		applyCodeVisibility()

		local fold = b.button({
			Size = UDim2.fromOffset(18, 34),
			Position = UDim2.new(1, -418, 0, 8),
			bg = "panel",
			ZIndex = 30,
			Parent = middle,
		})
		local foldMark = b.chevron(9, "text3")
		foldMark.Position = UDim2.fromOffset(4, 12)
		foldMark.Rotation = app.settings.showCode and -90 or 90
		foldMark.Parent = fold
		b.tip(fold, "Show or hide the generated Luau.")
		fold.MouseButton1Click:Connect(function()
			app:setSetting("showCode", not app.settings.showCode)
			fold.Position = app.settings.showCode
				and UDim2.new(1, -418, 0, 8) or UDim2.new(1, -26, 0, 8)
			foldMark.Rotation = app.settings.showCode and -90 or 90
		end)

		-- your own blocks ------------------------------------------------------------
		-- The palette and the canvas menu both reach the editor through the app, so
		-- neither of them has to know that r exists.
		app.openBlockEditor = function(customId, seed)
			r.open(app, customId, seed)
		end

		app.makeBlockFromSelection = function()
			local block = app:selected()
			if not block then
				app:setStatus("select a block on the canvas first, then try again")
				shell.showTab("build")
				return
			end
			local custom
			if block.k == "def" then
				-- a define block becomes a block that *calls* the function, which is
				-- almost always what someone means by "make this into a block"
				custom = q.fromFunctionBlock(app.doc, block)
			end
			custom = custom or q.fromBlocks(app.doc, block)
			shell.showTab("build")
			r.open(app, nil, custom)
		end
		-- One block per function a ModuleScript exports.  Returns whether it found
		-- anything, so the caller can fall back to its own message.
		app.makeBlocksFromModule = function(instance)
			local path = o.pathTo(instance)
			if not path then
				app:setStatus("that module is not in the game tree")
				return false
			end
			local made = q.fromModule(instance, path)
			if not made then return false end
			if #made == 1 then
				-- one function is worth looking at before it is saved
				r.open(app, nil, made[1])
				return true
			end
			local added = 0
			for _, custom in ipairs(made) do
				if app:putCustom(custom) then added = added + 1 end
			end
			app:setStatus(string.format("made %d blocks from the functions in %s",
				added, instance.Name))
			return true
		end

		-- other tabs -------------------------------------------------------------------
		shell.learn = k.mount(app, pages)
		shell.import = n.importView(app, pages)
		shell.setup = n.settingsView(app, pages)

		actionBar(app, rootFrame, shell)
		statusStrip(app, rootFrame)

		local pageFor = {
			build = buildPage,
			learn = shell.learn.frame,
			import = shell.import.frame,
			setup = shell.setup.frame,
		}

		function shell.showTab(id)
			if not pageFor[id] then return end
			shell.tab = id
			for tabId, page in pairs(pageFor) do
				page.Visible = tabId == id
			end
			for tabId, parts in pairs(tabs) do
				local chosen = tabId == id
				parts.marker.Visible = chosen
				parts.label.TextColor3 = chosen and a.c.text or a.c.text3
				parts.button.BackgroundColor3 = chosen and a.c.raised or a.c.panel
			end
			-- the import tab is only truthful if it re-reads the selection on the
			-- way in, since the Explorer may have changed while it was hidden
			if id == "import" and shell.import and shell.import.describe then
				shell.import.describe()
			end
			if id ~= "build" and app.dirty then app:save() end
		end
		app.showTab = shell.showTab

		shell.paintTarget()
		-- First run has no saved project: open on the lessons rather than dropping
		-- someone straight onto a canvas they have no vocabulary for yet.
		shell.showTab(app.projectId and "build" or "learn")

		keyboard(app, shell)

		a.onChange(function()
			shell.showTab(shell.tab)
			shell.paintTarget()
		end)

		app:setStatus(string.format("%d blocks, %d lessons -- press learn if this is new",
			c.count(), j.count()))

		return shell
end

return p
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX17">
			<Properties>
				<string name="Name">q</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- q  ·  custom blocks
--
-- A custom block is stored as Luau with placeholders:
--
--     {player}.leaderstats.Coins.Value += {amount}
--
-- A placeholder written inline is an input field.  A placeholder alone on its
-- own line is a slot you can drop blocks into:
--
--     if {player}.Team == teamA then
--         {body}
--     end
--
-- Everything reduces to that one shape, which is what lets all four ways of
-- making a block -- from the canvas, from typed Luau, from a function block,
-- from a ModuleScript -- share a single code path, and lets the same block be
-- edited as text or reopened as a canvas.
--
-- How it compiles is decided here rather than by the author: a block with no
-- slots becomes one `local function` at the top and a call at each use, the
-- way you would factor it by hand.  A block with slots has to be inlined,
-- because what goes inside changes from use to use.

local c = require(script.Parent.c)
local d = require(script.Parent.d)
local e = require(script.Parent.e)
local g = require(script.Parent.g)
local h = require(script.Parent.h)

local q = {}

q.FORMAT = 1

-- every custom block currently registered, by id
q.all = {}

--=============================================================================
-- helpers
--=============================================================================

local function trim(text)
		return (string.gsub(text, "^%s*(.-)%s*$", "%1"))
end

local function lines(text)
		local out = {}
		for line in string.gmatch(text .. "\n", "([^\n]*)\n") do
			out[#out + 1] = line
		end
		while #out > 0 and trim(out[#out]) == "" do
			out[#out] = nil
		end
		return out
end

-- "Give a coin" -> "giveACoin", always a legal identifier
function q.functionName(label, taken)
		local pieces = {}
		for word in string.gmatch(label, "[%a%d]+") do
			pieces[#pieces + 1] = word
		end
		if #pieces == 0 then pieces = { "block" } end
		local name = string.lower(string.sub(pieces[1], 1, 1)) .. string.sub(pieces[1], 2)
		for index = 2, #pieces do
			name = name .. string.upper(string.sub(pieces[index], 1, 1)) ..
				string.sub(pieces[index], 2)
		end
		if string.match(name, "^%d") then name = "block" .. name end

		if taken then
			local base, suffix = name, 2
			while taken[name] do
				name = base .. suffix
				suffix = suffix + 1
			end
		end
		return name
end

-- Reads the placeholders out of the Luau: inline ones are fields, ones alone on
-- a line are slots.
function q.readShape(luau)
		local fields, slots = {}, {}
		local seenField, seenSlot = {}, {}

		for _, line in ipairs(lines(luau)) do
			local bare = string.match(trim(line), "^{([%a_][%w_]*)}$")
			if bare then
				if not seenSlot[bare] then
					seenSlot[bare] = true
					slots[#slots + 1] = bare
				end
			else
				for key in string.gmatch(line, "{([%a_][%w_]*)}") do
					if not seenField[key] then
						seenField[key] = true
						fields[#fields + 1] = key
					end
				end
			end
		end

		return fields, slots
end

--=============================================================================
-- making one
--=============================================================================

local nextId = 1

local function freshId()
		local id = "cb" .. nextId .. "_" .. (math.floor(os.clock() * 1000) % 100000)
		nextId = nextId + 1
		return id
end

-- The blank a new custom block starts from.
function q.new(label, luau)
		label = label or "My block"
		luau = luau or "-- what this block should do"
		local fieldKeys, slotKeys = q.readShape(luau)

		local fields = {}
		for _, key in ipairs(fieldKeys) do
			fields[#fields + 1] = { key = key, kind = "expr", default = "", label = key }
		end
		local slots = {}
		for _, key in ipairs(slotKeys) do
			slots[#slots + 1] = { key = key, label = key }
		end

		return {
			id = freshId(),
			label = label,
			group = "Mine",
			colour = "vars",
			doc = "",
			wording = nil,       -- nil means build one from the label and fields
			luau = luau,
			fields = fields,
			slots = slots,
			returns = false,
			shared = true,
		}
end

-- Wording defaults to the label followed by each field, which reads acceptably
-- and can be replaced with anything using the same placeholders.
function q.wordingOf(custom)
		if custom.wording and trim(custom.wording) ~= "" then return custom.wording end
		local parts = { custom.label }
		for _, field in ipairs(custom.fields) do
			parts[#parts + 1] = "{" .. field.key .. "}"
		end
		return table.concat(parts, " ")
end

-- Keeps fields and slots in step with the Luau after it has been edited.
function q.refresh(custom)
		local fieldKeys, slotKeys = q.readShape(custom.luau)

		local existing = {}
		for _, field in ipairs(custom.fields) do existing[field.key] = field end
		local fields = {}
		for _, key in ipairs(fieldKeys) do
			fields[#fields + 1] = existing[key]
				or { key = key, kind = "expr", default = "", label = key }
		end
		custom.fields = fields

		local hadSlot = {}
		for _, slot in ipairs(custom.slots) do hadSlot[slot.key] = slot end
		local slots = {}
		for _, key in ipairs(slotKeys) do
			slots[#slots + 1] = hadSlot[key] or { key = key, label = key }
		end
		custom.slots = slots
		return custom
end

--=============================================================================
-- compiling into a real block
--=============================================================================

local OUT_FIELD = "out"

-- Splits the Luau around its slot markers into head lines, the lead-in lines
-- for each slot, and tail lines -- the shape the registry wants.
local function split(custom)
		local head, slots = {}, {}
		local collected = {}
		local seenMarker = false

		for _, line in ipairs(lines(custom.luau)) do
			local bare = string.match(trim(line), "^{([%a_][%w_]*)}$")
			if bare then
				-- whatever was gathered since the last marker leads into this one
				slots[#slots + 1] = { key = bare, pre = seenMarker and collected or nil }
				collected = {}
				seenMarker = true
			elseif seenMarker then
				collected[#collected + 1] = line
			else
				head[#head + 1] = line
			end
		end

		return { head = head, slots = slots, tail = collected }
end

-- A block with no slots compiles to a function; one with slots must inline.
function q.isHelper(custom)
		return #custom.slots == 0
end

-- Turns a custom block into a registry definition.
function q.compile(custom)
		local parts = split(custom)
		local wording = q.wordingOf(custom)

		local fields = {}
		for _, field in ipairs(custom.fields) do
			fields[field.key] = {
				key = field.key,
				kind = field.kind or "expr",
				default = field.default or "",
				placeholder = field.label or field.key,
				options = field.options,
			}
		end

		local head, code, tail, codeTail
		local slots = {}

		if custom.returns then
			-- a value-producing block reads as "make x = ..." and assigns
			fields[OUT_FIELD] = { key = OUT_FIELD, kind = "name", default = "value",
				placeholder = "name" }
			head = "make {" .. OUT_FIELD .. "} = " .. wording
			code = "local {" .. OUT_FIELD .. "} = " .. trim(table.concat(parts.head, " "))
		else
			head = wording
			code = parts.head
			if #code == 0 then code = { "-- " .. custom.label } end
			if #parts.slots > 0 then
				for index, slot in ipairs(parts.slots) do
					slots[index] = {
						key = slot.key,
						label = slot.label or slot.key,
						codePreLines = index > 1 and slot.pre or nil,
					}
				end
				tail = "end"
				codeTail = parts.tail
				if #codeTail == 0 then codeTail = nil end
			end
		end

		local def = c.define{
			id = "custom_" .. custom.id,
			cat = "custom",
			group = custom.group or "Mine",
			label = custom.label,
			head = head,
			code = code,
			tail = tail,
			codeTail = codeTail,
			fields = fields,
			slots = slots,
			doc = (custom.doc and trim(custom.doc) ~= "" and custom.doc)
				or ("One of your own blocks. It writes the Luau you gave it, with " ..
					"whatever you type in its fields."),
			tags = "custom mine " .. string.lower(custom.label),
		}

		-- What the code writer needs, without it having to know about this module.
		local params = {}
		for _, field in ipairs(custom.fields) do
			params[#params + 1] = field.key
		end
		def.custom = {
			cid = custom.id,
			helper = q.isHelper(custom) and not custom.returns,
			returnsHelper = q.isHelper(custom) and custom.returns,
			fn = custom.fn,
			params = params,
			body = parts.head,
			returns = custom.returns,
			out = OUT_FIELD,
		}
		return def
end

--=============================================================================
-- the library
--=============================================================================

local function reserveNames()
		local taken = {}
		for _, custom in pairs(q.all) do
			if custom.fn then taken[custom.fn] = true end
		end
		return taken
end

function q.register(custom)
		q.unregister(custom.id)
		custom.fn = custom.fn or q.functionName(custom.label, reserveNames())
		q.all[custom.id] = custom
		local ok, err = pcall(q.compile, custom)
		if not ok then
			q.all[custom.id] = nil
			return nil, tostring(err)
		end
		return custom
end

function q.unregister(id)
		if not id then return end
		q.all[id] = nil
		c.undefine("custom_" .. id)
end

function q.get(id)
		return q.all[id]
end

function q.list()
		local out = {}
		for _, custom in pairs(q.all) do
			out[#out + 1] = custom
		end
		table.sort(out, function(a, b)
			if a.group ~= b.group then return a.group < b.group end
			return a.label < b.label
		end)
		return out
end

function q.groups()
		local seen, out = {}, {}
		for _, custom in pairs(q.all) do
			local group = custom.group or "Mine"
			if not seen[group] then
				seen[group] = true
				out[#out + 1] = group
			end
		end
		table.sort(out)
		return out
end

-- Plain tables in, plain tables out, so the whole library fits in one setting.
function q.toSave(custom)
		return {
			id = custom.id, label = custom.label, group = custom.group,
			colour = custom.colour, doc = custom.doc, wording = custom.wording,
			luau = custom.luau, returns = custom.returns, fn = custom.fn,
			shared = custom.shared, fields = custom.fields, slots = custom.slots,
		}
end

function q.fromSave(saved)
		if type(saved) ~= "table" or type(saved.luau) ~= "string" then return nil end
		local custom = {
			id = saved.id or freshId(),
			label = saved.label or "My block",
			group = saved.group or "Mine",
			colour = saved.colour or "vars",
			doc = saved.doc or "",
			wording = saved.wording,
			luau = saved.luau,
			returns = saved.returns == true,
			fn = saved.fn,
			shared = saved.shared ~= false,
			fields = saved.fields or {},
			slots = saved.slots or {},
		}
		return q.refresh(custom)
end

--=============================================================================
-- the four ways of making one
--=============================================================================

-- 1. from typed Luau
function q.fromLuau(label, luau)
		return q.new(label, luau)
end

-- 2. from a stack of blocks on the canvas: the block and everything under it
function q.fromBlocks(doc, block)
		local pieces = {}
		local list = d.listOf(doc, block)
		local reached = false
		for _, id in ipairs(list or {}) do
			if id == block.id then reached = true end
			if reached then
				local sibling = doc.blocks[id]
				if sibling then pieces[#pieces + 1] = e.snippet(doc, sibling) end
			end
		end
		if #pieces == 0 then pieces[1] = e.snippet(doc, block) end

		local custom = q.new("My block", table.concat(pieces, "\n"))
		custom.doc = "Built from blocks on the canvas."
		return custom
end

-- 3. from a `define` block already in the project
function q.fromFunctionBlock(doc, block)
		local def = c.get(block.k)
		if not def then return nil, "that is not a block" end
		local name = c.fieldValue(def, block, "name")
		local params = c.fieldValue(def, block, "params")

		local holes = {}
		for word in string.gmatch(params, "[%a_][%w_]*") do
			holes[#holes + 1] = "{" .. word .. "}"
		end
		local call = name .. "(" .. table.concat(holes, ", ") .. ")"
		local custom = q.new(name, call)
		custom.doc = "Runs the `" .. name .. "` function defined in this project."
		return custom
end

-- 4. from a ModuleScript in the place: one block per function it defines
function q.fromModule(instance, path)
		local ok, source = pcall(function() return instance.Source end)
		if not ok or not source then
			return nil, "Studio would not let the plugin read that script"
		end
		local chunk, err = g.parse(source)
		if not chunk then
			return nil, string.format("line %d: %s", err.line, err.msg)
		end

		local made = {}
		for _, statement in ipairs(chunk.body) do
			if statement.k == "func" and not statement.isMethod then
				local owner, name = string.match(statement.name, "^([%a_][%w_]*)%.([%a_][%w_]*)$")
				if owner and name then
					local holes = {}
					for _, param in ipairs(statement.fn.params) do
						if not param.vararg then
							holes[#holes + 1] = "{" .. param.name .. "}"
						end
					end
					local call = string.format("require(%s).%s(%s)", path, name,
						table.concat(holes, ", "))
					local custom = q.new(name, call)
					custom.group = instance.Name
					custom.doc = "Calls `" .. name .. "` from the " .. instance.Name ..
						" module."
					made[#made + 1] = custom
				end
			end
		end

		if #made == 0 then
			return nil, "no module functions found in " .. instance.Name
		end
		return made
end

--=============================================================================
-- editing one as a canvas
--=============================================================================

-- Turns the stored Luau into blocks, with the placeholders standing in as
-- ordinary names so they survive the round trip.
function q.toCanvas(custom)
		local readable = string.gsub(custom.luau, "{([%a_][%w_]*)}", "__%1")
		local doc, report, err = h.fromCode(readable, custom.label)
		if not doc then return nil, err end
		doc.customEdit = custom.id
		return doc, report
end

-- And back again after editing.
function q.fromCanvas(custom, doc)
		local code = e.generate(doc, { header = false })
		custom.luau = (string.gsub(code, "__([%a_][%w_]*)", "{%1}"))
		return q.refresh(custom)
end

--=============================================================================
-- the library as a ModuleScript
--
-- Sharing a library by hand is the one thing plugin settings cannot do: they
-- live in one person's Studio.  A ModuleScript can be committed, dragged into
-- a model, or handed to someone in a place file, so that is what the library
-- saves to.  It is written as a plain Luau table and read back with the same
-- parser the importer uses -- no loadstring, no JSON blob, and you can edit
-- the file by hand without breaking it.
--=============================================================================

local function quote(text)
		return (string.format("%q", tostring(text)):gsub("\\\n", "\\n"))
end

-- Long-bracket form for the code itself, choosing a level of `=` no closing
-- bracket in the body can collide with.
local function longString(text)
		local level = 0
		while string.find(text, "]" .. string.rep("=", level) .. "]", 1, true)
			or string.find(text, "[" .. string.rep("=", level) .. "[", 1, true) do
			level += 1
		end
		local pad = string.rep("=", level)
		return "[" .. pad .. "[\n" .. text .. "\n]" .. pad .. "]"
end

local function writeEntry(custom, indent)
		local out = {}
		local pad = string.rep("\t", indent)
		local inner = string.rep("\t", indent + 1)
		out[#out + 1] = pad .. "{"
		out[#out + 1] = inner .. "label = " .. quote(custom.label) .. ","
		out[#out + 1] = inner .. "group = " .. quote(custom.group or "Mine") .. ","
		if custom.doc and trim(custom.doc) ~= "" then
			out[#out + 1] = inner .. "doc = " .. quote(custom.doc) .. ","
		end
		if custom.wording and trim(custom.wording) ~= "" then
			out[#out + 1] = inner .. "wording = " .. quote(custom.wording) .. ","
		end
		if custom.returns then out[#out + 1] = inner .. "returns = true," end
		out[#out + 1] = inner .. "luau = " ..
			longString((string.gsub(custom.luau, "%s+$", ""))) .. ","

		if #custom.fields > 0 then
			out[#out + 1] = inner .. "fields = {"
			for _, field in ipairs(custom.fields) do
				local parts = {
					"key = " .. quote(field.key),
					"kind = " .. quote(field.kind or "expr"),
					"default = " .. quote(field.default or ""),
					"label = " .. quote(field.label or field.key),
				}
				if field.options then
					parts[#parts + 1] = "options = " .. quote(field.options)
				end
				out[#out + 1] = inner .. "\t{ " .. table.concat(parts, ", ") .. " },"
			end
			out[#out + 1] = inner .. "},"
		end

		if #custom.slots > 0 then
			out[#out + 1] = inner .. "slots = {"
			for _, slot in ipairs(custom.slots) do
				out[#out + 1] = inner .. "\t{ key = " .. quote(slot.key) ..
					", label = " .. quote(slot.label or slot.key) .. " },"
			end
			out[#out + 1] = inner .. "},"
		end

		out[#out + 1] = pad .. "},"
		return table.concat(out, "\n")
end

-- `list` defaults to the whole library.
function q.toModuleSource(list, projectName)
		list = list or q.list()
		local out = {
			"-- Blocks made in ABlocks.",
			"--",
			"-- Every entry below is one block: `luau` is what it writes, and each",
			"-- {placeholder} in it becomes a field you fill in on the block.  Edit",
			"-- this file by hand if you like -- ABlocks reads it back the same way.",
			"--",
			"-- To use these: open ABlocks, go to setup, select this ModuleScript in",
			"-- the Explorer and press \"Load from a ModuleScript\".",
		}
		if projectName then
			out[#out + 1] = "-- Saved from the project " .. projectName .. "."
		end
		out[#out + 1] = ""
		out[#out + 1] = "return {"
		for _, custom in ipairs(list) do
			out[#out + 1] = writeEntry(custom, 1)
		end
		out[#out + 1] = "}"
		out[#out + 1] = ""
		return table.concat(out, "\n")
end

-- The lexer keeps strings as written, delimiters and all, because everything
-- else in the plugin copies source text around rather than reading it.  Here
-- the actual text is wanted, so this is the one place that decodes one.
local ESCAPES = {
		n = "\n", t = "\t", r = "\r", a = "\a", b = "\b", f = "\f", v = "\v",
		["\\"] = "\\", ["\""] = "\"", ["'"] = "'", ["\n"] = "\n",
}

local function decodeString(raw)
		if type(raw) ~= "string" then return nil end

		local pad = string.match(raw, "^%[(=*)%[")
		if pad then
			local body = string.sub(raw, #pad + 3, -(#pad + 3))
			-- Luau drops a newline that comes straight after the opening bracket
			return (string.gsub(body, "^\n", ""))
		end

		local quoteChar = string.sub(raw, 1, 1)
		if quoteChar ~= "\"" and quoteChar ~= "'" then return nil end

		local body = string.sub(raw, 2, -2)
		local out, i = {}, 1
		while i <= #body do
			local ch = string.sub(body, i, i)
			if ch == "\\" then
				local nextCh = string.sub(body, i + 1, i + 1)
				local digits = string.match(body, "^%d%d?%d?", i + 1)
				local hex = string.match(body, "^x(%x%x)", i + 1)
				if hex then
					out[#out + 1] = string.char(tonumber(hex, 16))
					i += 4
				elseif digits then
					out[#out + 1] = string.char(tonumber(digits))
					i += 1 + #digits
				elseif nextCh == "z" then
					-- \z eats the whitespace that follows it
					local _, stop = string.find(body, "^%s*", i + 2)
					i = (stop or i + 1) + 1
				else
					out[#out + 1] = ESCAPES[nextCh] or nextCh
					i += 2
				end
			else
				out[#out + 1] = ch
				i += 1
			end
		end
		return table.concat(out)
end

-- Reads a constant expression out of the parsed module: strings, numbers,
-- booleans and tables of them.  Anything cleverer is refused rather than
-- guessed at, because a library file should not be able to run code.
local function constant(node)
		if not node then return nil end
		if node.k == "str" then return decodeString(node.value) end
		if node.k == "num" then return tonumber(node.value) end
		if node.k == "bool" then return node.value end
		if node.k == "nil" then return nil end
		if node.k == "table" then
			local out = {}
			for _, field in ipairs(node.fields) do
				if field.kind == "array" then
					out[#out + 1] = constant(field.value)
				elseif field.kind == "named" then
					out[field.name] = constant(field.value)
				elseif field.kind == "index" then
					local key = constant(field.key)
					if type(key) == "string" or type(key) == "number" then
						out[key] = constant(field.value)
					end
				end
			end
			return out
		end
		return nil, "only plain values belong in a block library"
end

function q.fromModuleSource(source)
		local chunk, err = g.parse(source)
		if not chunk then
			return nil, string.format("line %d: %s", err.line, err.msg)
		end

		local returned
		for _, statement in ipairs(chunk.body) do
			if statement.k == "return" then returned = statement.exprs[1] end
		end
		if not returned then
			return nil, "that module does not return anything"
		end

		local value = constant(returned)
		if type(value) ~= "table" then
			return nil, "that module does not return a list of blocks"
		end

		local made, skipped = {}, 0
		for _, entry in ipairs(value) do
			if type(entry) == "table" and type(entry.luau) == "string" then
				entry.luau = (string.gsub(entry.luau, "%s+$", ""))
			end
			local custom = type(entry) == "table" and type(entry.luau) == "string"
				and q.fromSave(entry) or nil
			if custom then
				-- names and ids are earned on the way in, so loading someone
				-- else's library never collides with a block you already have
				custom.id = freshId()
				custom.fn = nil
				made[#made + 1] = custom
			else
				skipped += 1
			end
		end

		if #made == 0 then
			return nil, "no blocks in that module"
		end
		return made, skipped
end

--=============================================================================
-- which ones a document uses
--=============================================================================

function q.usedIn(doc)
		local used = {}
		d.walk(doc, function(block)
			local def = c.get(block.k)
			if def and def.custom then
				local custom = q.all[def.custom.cid]
				if custom then used[custom.id] = custom end
			end
		end)
		local out = {}
		for _, custom in pairs(used) do out[#out + 1] = custom end
		table.sort(out, function(a, b) return a.id < b.id end)
		return out
end

-- Projects carry a copy of every custom block they use, so opening someone
-- else's project adds their blocks rather than breaking.
function q.embed(doc)
		local saved = {}
		for _, custom in ipairs(q.usedIn(doc)) do
			saved[#saved + 1] = q.toSave(custom)
		end
		return saved
end

function q.adopt(list)
		local added = 0
		for _, saved in ipairs(list or {}) do
			local custom = q.fromSave(saved)
			if custom and not q.all[custom.id] then
				if q.register(custom) then added = added + 1 end
			end
		end
		return added
end

return q
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX18">
			<Properties>
				<string name="Name">r</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- r  ·  the block editor
--
-- Where a custom block is written.  Two ways in and out of the same thing:
-- the panel here edits the Luau directly, and `open as canvas` turns that Luau
-- into blocks, drops them on the canvas, and turns them back when you save.
-- The placeholders survive the trip because the importer round-trips.

local a = require(script.Parent.a)
local b = require(script.Parent.b)
local c = require(script.Parent.c)
local d = require(script.Parent.d)
local e = require(script.Parent.e)
local q = require(script.Parent.q)

local r = {}

local KINDS = { "expr", "name", "str", "num", "multiline" }

--=============================================================================
-- the panel
--=============================================================================

local function labelled(parent, order, text, help)
		local row = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, help and 38 or 24),
			LayoutOrder = order,
			Parent = parent,
		})
		b.text({
			Text = text,
			Size = UDim2.fromOffset(96, 22),
			fg = "text2",
			Parent = row,
		})
		if help then
			b.text({
				Text = help,
				Size = UDim2.new(1, -100, 0, 14),
				Position = UDim2.fromOffset(100, 22),
				TextSize = 10,
				fg = "text3",
				Parent = row,
			})
		end
		return row
end

local function textField(parent, value, placeholder, onChange, multiline)
		local holder = b.new("Frame", {
			Size = multiline and UDim2.new(1, -100, 0, 150) or UDim2.new(1, -100, 0, 22),
			Position = UDim2.fromOffset(100, 0),
			bg = "field",
			stroke = { color = "fieldLine" },
			radius = a.metric.radius,
			Parent = parent,
		})
		local box = b.new("TextBox", {
			Text = value or "",
			PlaceholderText = placeholder or "",
			ClearTextOnFocus = false,
			MultiLine = multiline == true,
			Size = UDim2.new(1, -12, 1, 0),
			Position = UDim2.fromOffset(6, 0),
			Font = a.font.mono,
			TextSize = 12,
			fg = "text",
			ph = "text3",
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
			Parent = holder,
		})
		box:GetPropertyChangedSignal("Text"):Connect(function()
			onChange(box.Text)
		end)
		return box
end

-- Opens the editor for an existing block, or a blank one when id is nil.
-- `customId` opens one you already have; `seed` opens the editor on a block
-- that has been built but not saved yet, which is how "from selection" and
-- "from a module" arrive here.
function r.open(app, customId, seed)
		local overlay = b.overlay()
		if not overlay then return end
		if app.blockEditor then app.blockEditor:Destroy() end

		local existing = customId and q.get(customId) or nil
		local custom
		if existing then
			custom = q.fromSave(q.toSave(existing))
			custom.id = existing.id
			custom.fn = existing.fn
		elseif seed then
			custom = seed
		else
			custom = q.new("My block", "-- what this block should do")
		end

		local shade = b.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			bg = "bg",
			BackgroundTransparency = 0.4,
			ZIndex = 940,
			Parent = overlay,
		})
		app.blockEditor = shade

		local panel = b.new("Frame", {
			Size = UDim2.new(0, 620, 0, 560),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			bg = "panel",
			stroke = { color = "line" },
			ZIndex = 941,
			Parent = shade,
		})

		b.micro(existing and "edit a block" or "make a block", {
			Size = UDim2.new(1, -24, 0, 22),
			Position = UDim2.fromOffset(14, 10),
			fg = "accent",
			ZIndex = 942,
			Parent = panel,
		})

		local scroll = b.new("ScrollingFrame", {
			Size = UDim2.new(1, -24, 1, -86),
			Position = UDim2.fromOffset(12, 34),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ZIndex = 942,
			Parent = panel,
		})
		local column = b.new("Frame", {
			Size = UDim2.new(1, -14, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			layout = { dir = "y", gap = 8 },
			ZIndex = 942,
			Parent = scroll,
		})

		local order = 0
		local function next_() order = order + 1 return order end

		-- Declared up front because the fields below all want to redraw the preview
		-- as they are typed into, and the preview is built further down.
		local redraw

		-- name and group ------------------------------------------------------------
		local nameRow = labelled(column, next_(), "Name")
		textField(nameRow, custom.label, "Give a coin", function(text)
			custom.label = text
			if redraw then redraw() end
		end)

		local groupRow = labelled(column, next_(), "Group",
			"The heading it appears under in your category.")
		textField(groupRow, custom.group, "Mine", function(text)
			custom.group = text
		end)

		local wordingRow = labelled(column, next_(), "Wording",
			"How it reads on the canvas. Use the same {holes} as the Luau.")
		local wordingBox = textField(wordingRow, custom.wording or "", q.wordingOf(custom),
			function(text)
				custom.wording = text
				if redraw then redraw() end
			end)

		local docRow = labelled(column, next_(), "Description",
			"Shown in the tooltip, like every other block.")
		textField(docRow, custom.doc, "What it does, and the catch.", function(text)
			custom.doc = text
		end)

		-- the luau -------------------------------------------------------------------
		local luauRow = labelled(column, next_(), "Luau",
			"A {hole} inline is an input. A {hole} alone on a line is a slot.")
		luauRow.Size = UDim2.new(1, 0, 0, 172)
		local preview, inputList
		textField(luauRow, custom.luau, "", function(text)
			custom.luau = text
			q.refresh(custom)
			if redraw then redraw() end
		end, true)

		-- inputs and slots --------------------------------------------------------------
		inputList = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = next_(),
			layout = { dir = "y", gap = 4 },
			ZIndex = 942,
			Parent = column,
		})

		local returnsRow = b.new("Frame", {
			Size = UDim2.new(1, 0, 0, 26),
			LayoutOrder = next_(),
			ZIndex = 942,
			Parent = column,
		})
		b.text({
			Text = "Gives a value back",
			Size = UDim2.fromOffset(200, 22),
			fg = "text2",
			ZIndex = 943,
			Parent = returnsRow,
		})
		local returnsButton = b.button({
			label = custom.returns and "yes" or "no",
			Size = UDim2.fromOffset(56, 22),
			Position = UDim2.fromOffset(200, 0),
			bg = custom.returns and "accentSoft" or "raised",
			ZIndex = 943,
			Parent = returnsRow,
		})
		b.tip(returnsButton, "A block that gives a value back reads as\n" ..
			"`make x = ...` and can be used in any field.")

		-- preview --------------------------------------------------------------------------
		b.rule({ LayoutOrder = next_(), parent = column, bg = "lineSoft" })
		b.micro("what it will write", {
			Size = UDim2.new(1, 0, 0, 16),
			LayoutOrder = next_(),
			fg = "text3",
			ZIndex = 942,
			Parent = column,
		})
		preview = b.mono({
			Text = "",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextSize = 11,
			fg = "text2",
			TextYAlignment = Enum.TextYAlignment.Top,
			LayoutOrder = next_(),
			ZIndex = 942,
			Parent = column,
		})

		-- keeps the inputs list and the preview in step with the Luau -------------------------
		function redraw()
			b.clear(inputList)
			-- the placeholder shows the wording you would get for free, so it has to
			-- follow the name and the holes
			wordingBox.PlaceholderText = q.wordingOf(custom)
			for index, field in ipairs(custom.fields) do
				local row = b.new("Frame", {
					Size = UDim2.new(1, 0, 0, 24),
					LayoutOrder = index,
					ZIndex = 942,
					Parent = inputList,
				})
				b.mono({
					Text = "{" .. field.key .. "}",
					Size = UDim2.fromOffset(120, 22),
					TextSize = 12,
					fg = "accent",
					ZIndex = 943,
					Parent = row,
				})

				local kindButton = b.button({
					label = field.kind,
					Size = UDim2.fromOffset(80, 20),
					Position = UDim2.fromOffset(124, 1),
					ZIndex = 943,
					Parent = row,
				})
				local kindText = kindButton:FindFirstChildWhichIsA("TextLabel")
				b.tip(kindButton, "What sort of value belongs here. Expression fields\n" ..
					"get the full completion list.")
				kindButton.MouseButton1Click:Connect(function()
					local at = table.find(KINDS, field.kind) or 1
					field.kind = KINDS[(at % #KINDS) + 1]
					kindText.Text = field.kind
				end)

				local holder = b.new("Frame", {
					Size = UDim2.new(1, -212, 0, 22),
					Position = UDim2.fromOffset(208, 0),
					bg = "field",
					stroke = { color = "fieldLine" },
					radius = a.metric.radius,
					ZIndex = 943,
					Parent = row,
				})
				local defaultBox = b.new("TextBox", {
					Text = field.default or "",
					PlaceholderText = "default",
					ClearTextOnFocus = false,
					Size = UDim2.new(1, -12, 1, 0),
					Position = UDim2.fromOffset(6, 0),
					Font = a.font.mono,
					TextSize = 11,
					fg = "text",
					ph = "text3",
					ZIndex = 944,
					Parent = holder,
				})
				defaultBox:GetPropertyChangedSignal("Text"):Connect(function()
					field.default = defaultBox.Text
				end)
			end

			if #custom.slots > 0 then
				local names = {}
				for _, slot in ipairs(custom.slots) do names[#names + 1] = slot.key end
				b.text({
					Text = "Slots: " .. table.concat(names, ", ") ..
						"   (blocks with slots are written out in place, not as a function)",
					Size = UDim2.new(1, 0, 0, 18),
					TextSize = 10,
					fg = "text3",
					LayoutOrder = 900,
					ZIndex = 942,
					Parent = inputList,
				})
			end

			-- preview: compile a throwaway copy and generate a single use
			local trial = q.fromSave(q.toSave(custom))
			trial.id = "preview"
			trial.fn = custom.fn or q.functionName(custom.label)
			q.unregister("preview")
			local ok = q.register(trial)
			if ok then
				local def = c.get("custom_preview")
				local doc = d.newDoc("preview")
				local stack = d.newStack(doc, 0, 0)
				local block = d.create(doc, def.id)
				d.attachToStack(doc, block, stack, nil, {})
				if #def.slots > 0 then
					local inner = d.create(doc, "printText")
					inner.f.msg = "your blocks here"
					d.attachToSlot(doc, inner, block, def.slots[1].key, nil, {})
				end
				preview.Text = e.generate(doc, { header = false })
				q.unregister("preview")
			else
				preview.Text = "-- this block does not compile yet"
			end
		end
		returnsButton.MouseButton1Click:Connect(function()
			custom.returns = not custom.returns
			returnsButton:FindFirstChildWhichIsA("TextLabel").Text =
				custom.returns and "yes" or "no"
			b.states(returnsButton, custom.returns and "accentSoft" or "raised")
			redraw()
		end)

		redraw()

		-- buttons along the bottom ------------------------------------------------------------
		local bar = b.new("Frame", {
			Size = UDim2.new(1, -24, 0, 34),
			Position = UDim2.new(0, 12, 1, -44),
			layout = { dir = "x", gap = 6 },
			ZIndex = 942,
			Parent = panel,
		})

		local function close()
			shade:Destroy()
			app.blockEditor = nil
		end

		local canvasButton = b.button({
			label = "Open as canvas",
			Size = UDim2.fromOffset(126, 26),
			LayoutOrder = 1,
			ZIndex = 943,
			Parent = bar,
		})
		b.tip(canvasButton, "Edit the inside as blocks. Your project is put back\n" ..
			"when you finish.")
		canvasButton.MouseButton1Click:Connect(function()
			local doc, err = q.toCanvas(custom)
			if not doc then
				app:setStatus("that Luau does not parse: " ..
					(err and err.msg or "unknown"))
				return
			end
			app.customDraft = custom
			app.customReturnTo = app.doc
			app:setDoc(doc, "edit block")
			app.editingCustom = custom.id
			app:emit("editingCustom")
			if app.showTab then app.showTab("build") end
			app:setStatus("editing the block " .. custom.label)
			close()
		end)

		if existing then
			local copyButton = b.button({
				label = "Duplicate",
				Size = UDim2.fromOffset(90, 26),
				LayoutOrder = 2,
				ZIndex = 943,
				Parent = bar,
			})
			copyButton.MouseButton1Click:Connect(function()
				local copy = q.fromSave(q.toSave(custom))
				copy.id = nil
				copy = q.new(custom.label .. " copy", custom.luau)
				copy.group, copy.doc, copy.wording = custom.group, custom.doc, custom.wording
				copy.returns = custom.returns
				app:putCustom(copy)
				close()
				r.open(app, copy.id)
			end)

			local deleteButton = b.button({
				label = "Delete",
				Size = UDim2.fromOffset(80, 26),
				LayoutOrder = 3,
				ZIndex = 943,
				Parent = bar,
			})
			deleteButton.MouseButton1Click:Connect(function()
				app:dropCustom(custom.id)
				close()
			end)
		end

		local cancel = b.button({
			label = "Cancel",
			Size = UDim2.fromOffset(80, 26),
			Position = UDim2.new(1, -186, 0, 0),
			ZIndex = 943,
			Parent = bar,
		})
		cancel.MouseButton1Click:Connect(close)

		local save = b.button({
			label = "Save block",
			Size = UDim2.fromOffset(100, 26),
			Position = UDim2.new(1, -100, 0, 0),
			bg = "accent",
			labelColor = "accentInk",
			ZIndex = 943,
			Parent = bar,
		})
		save.MouseButton1Click:Connect(function()
			q.refresh(custom)
			if app:putCustom(custom) then close() end
		end)

		return shade
end

--=============================================================================
-- editing one as a canvas
--=============================================================================

-- The strip that appears across the canvas while a block is open as blocks.
function r.banner(app, parent)
		local strip = b.new("Frame", {
			Name = "EditingBlock",
			Size = UDim2.new(1, 0, 0, 30),
			bg = "accentSoft",
			Visible = false,
			ZIndex = 40,
			Parent = parent,
		})

		local label = b.text({
			Text = "",
			Size = UDim2.new(1, -240, 1, 0),
			Position = UDim2.fromOffset(14, 0),
			Font = a.font.uiMedium,
			fg = "text",
			ZIndex = 41,
			Parent = strip,
		})

		local saveButton = b.button({
			label = "Save block",
			Size = UDim2.fromOffset(100, 22),
			Position = UDim2.new(1, -212, 0, 4),
			bg = "accent",
			labelColor = "accentInk",
			ZIndex = 41,
			Parent = strip,
		})

		local cancelButton = b.button({
			label = "Cancel",
			Size = UDim2.fromOffset(80, 22),
			Position = UDim2.new(1, -100, 0, 4),
			ZIndex = 41,
			Parent = strip,
		})

		local function finish()
			app.editingCustom = nil
			app.customDraft = nil
			if app.customReturnTo then
				app:setDoc(app.customReturnTo, "back to the project")
				app.customReturnTo = nil
			end
			app:emit("editingCustom")
		end

		saveButton.MouseButton1Click:Connect(function()
			local custom = app.customDraft
			if not custom then return end
			q.fromCanvas(custom, app.doc)
			app:putCustom(custom)
			finish()
		end)
		cancelButton.MouseButton1Click:Connect(function()
			app:setStatus("left the block as it was")
			finish()
		end)

		local function paint()
			local custom = app.customDraft
			strip.Visible = app.editingCustom ~= nil and custom ~= nil
			if custom then
				label.Text = "Editing the block \"" .. custom.label ..
					"\" -- the blocks below are its insides"
			end
		end
		app:on("editingCustom", paint)
		paint()

		return strip
end

return r
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX19">
			<Properties>
				<string name="Name">s</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- s  ·  block definitions: interface, camera and light, sound
--
-- Returns a function taking the registry's define helper, so this file never
-- has to require `c` back.  See the bottom of c.luau for the loader.

return function(D)

--=============================================================================
-- INTERFACE
--=============================================================================

-- screens ---------------------------------------------------------------------
D{ id = "uiScreen", cat = "ui", group = "Screens", label = "make a screen",
		head = "make {name} = a screen inside {parent}",
		code = {
			'local {name} = Instance.new("ScreenGui")',
			"{name}.ResetOnSpawn = false",
			"{name}.Parent = {parent}",
		},
		fields = { name = "name|screen|name", parent = "expr|player.PlayerGui|parent" },
		side = "client",
		doc = "A ScreenGui is the sheet everything else is drawn on. Keeping " ..
			"ResetOnSpawn off means it survives the player dying.",
		tags = "screengui gui interface hud screen" }

D{ id = "uiPlayerGui", cat = "ui", group = "Screens", label = "the player's screen holder",
		head = "make {name} = the screen holder of {player}",
		code = 'local {name} = {player}:WaitForChild("PlayerGui")',
		fields = { name = "name|gui|name", player = "expr|player|player" },
		doc = "Everything a player sees lives inside their PlayerGui. Waiting for " ..
			"it matters, because it arrives a moment after they do.",
		tags = "playergui screen holder wait" }

D{ id = "uiShow", cat = "ui", group = "Screens", label = "show or hide a screen",
		head = "set the screen {gui} showing to {value}",
		code = "{gui}.Enabled = {value}",
		fields = { gui = "expr|screen|screen", value = "choice|true|value|true,false" },
		doc = "Turns a whole screen on or off in one line, leaving everything " ..
			"inside it as it was.",
		tags = "enabled show hide screen visible" }

D{ id = "uiTopOfScreen", cat = "ui", group = "Screens", label = "use the very top",
		head = "let {gui} use the very top of the screen",
		code = "{gui}.IgnoreGuiInset = true",
		fields = { gui = "expr|screen|screen" },
		doc = "By default Roblox keeps a strip clear at the top for its own bar. " ..
			"This lets your screen draw there too.",
		tags = "inset topbar fullscreen offset" }

D{ id = "uiDrawOrder", cat = "ui", group = "Screens", label = "draw a screen in front",
		head = "draw {gui} in front of other screens, at level {order}",
		code = "{gui}.DisplayOrder = {order}",
		fields = { gui = "expr|screen|screen", order = "num|10|level" },
		doc = "Higher numbers are drawn later, so they sit on top. Use it to keep " ..
			"a pause menu above the rest of the interface.",
		tags = "displayorder layer front above" }

D{ id = "uiKeepOnRespawn", cat = "ui", group = "Screens", label = "keep on respawn",
		head = "keep {gui} when the player respawns",
		code = "{gui}.ResetOnSpawn = false",
		fields = { gui = "expr|screen|screen" },
		doc = "Screens are thrown away and rebuilt on every respawn unless you say " ..
			"otherwise. Anything holding state wants this.",
		tags = "resetonspawn respawn keep persist" }

D{ id = "uiBillboard", cat = "ui", group = "Screens", label = "floating label",
		head = "make {name} = a label floating over {adornee}",
		code = {
			'local {name} = Instance.new("BillboardGui")',
			"{name}.Size = UDim2.fromOffset(200, 50)",
			"{name}.StudsOffset = Vector3.new(0, {height}, 0)",
			"{name}.AlwaysOnTop = true",
			"{name}.Adornee = {adornee}",
			"{name}.Parent = {adornee}",
		},
		fields = { name = "name|tag|name", adornee = "expr|part|object",
			height = "num|3|studs above" },
		doc = "A BillboardGui hangs in the world but always faces the camera. " ..
			"Name tags and damage numbers are made of these.",
		tags = "billboard floating nametag world label" }

D{ id = "uiSurface", cat = "ui", group = "Screens", label = "screen on a part",
		head = "make {name} = a screen on the {face} face of {part}",
		code = {
			'local {name} = Instance.new("SurfaceGui")',
			"{name}.Face = Enum.NormalId.{face}",
			"{name}.Adornee = {part}",
			"{name}.Parent = {part}",
		},
		fields = { name = "name|sign|name", part = "expr|part|part",
			face = "choice|Front|face|Front,Back,Top,Bottom,Left,Right" },
		doc = "Draws interface flat onto a part, which is how signs, screens and " ..
			"arcade cabinets are made.",
		tags = "surfacegui sign screen part face" }

-- boxes -----------------------------------------------------------------------
D{ id = "uiBox", cat = "ui", group = "Boxes", label = "make a box",
		head = "make {name} = a box inside {parent}",
		code = {
			'local {name} = Instance.new("Frame")',
			"{name}.Size = UDim2.fromScale({w}, {h})",
			"{name}.Position = UDim2.fromScale({x}, {y})",
			"{name}.BackgroundColor3 = Color3.fromRGB(30, 32, 40)",
			"{name}.Parent = {parent}",
		},
		fields = { name = "name|panel|name", parent = "expr|screen|parent",
			w = "num|0.3|width", h = "num|0.2|height", x = "num|0.35|x", y = "num|0.4|y" },
		doc = "A Frame is a plain rectangle. Everything else is built by putting " ..
			"things inside one. Sizes are fractions of the parent.",
		tags = "frame box panel rectangle container" }

D{ id = "uiScrollBox", cat = "ui", group = "Boxes", label = "make a scrolling box",
		head = "make {name} = a scrolling box inside {parent}",
		code = {
			'local {name} = Instance.new("ScrollingFrame")',
			"{name}.Size = UDim2.fromScale({w}, {h})",
			"{name}.BackgroundTransparency = 1",
			"{name}.AutomaticCanvasSize = Enum.AutomaticSize.Y",
			"{name}.CanvasSize = UDim2.new()",
			"{name}.ScrollBarThickness = 6",
			"{name}.Parent = {parent}",
		},
		fields = { name = "name|list|name", parent = "expr|screen|parent",
			w = "num|0.4|width", h = "num|0.6|height" },
		doc = "Automatic canvas size means the scrollable area grows to fit " ..
			"whatever you put inside, so you never set it by hand.",
		tags = "scrollingframe scroll list inventory" }

D{ id = "uiSize", cat = "ui", group = "Boxes", label = "set size in fractions",
		head = "set the size of {gui} to {w} by {h} of its parent",
		code = "{gui}.Size = UDim2.fromScale({w}, {h})",
		fields = { gui = "expr|panel|object", w = "num|0.5|width", h = "num|0.25|height" },
		doc = "Fractions keep the interface the same shape on a phone and a " ..
			"monitor. 1 means the full width of the parent.",
		tags = "size scale fraction udim2 resize" }

D{ id = "uiSizePixels", cat = "ui", group = "Boxes", label = "set size in pixels",
		head = "set the size of {gui} to {w} by {h} pixels",
		code = "{gui}.Size = UDim2.fromOffset({w}, {h})",
		fields = { gui = "expr|panel|object", w = "num|200|width", h = "num|50|height" },
		doc = "Pixels stay the same size whatever the screen, which is right for " ..
			"icons and borders and wrong for whole panels.",
		tags = "size pixels offset udim2" }

D{ id = "uiPos", cat = "ui", group = "Boxes", label = "put at fractions",
		head = "put {gui} at {x}, {y} of its parent",
		code = "{gui}.Position = UDim2.fromScale({x}, {y})",
		fields = { gui = "expr|panel|object", x = "num|0.5|x", y = "num|0.5|y" },
		doc = "0, 0 is the top left and 1, 1 is the bottom right. Pair it with an " ..
			"anchor point of 0.5, 0.5 to centre something properly.",
		tags = "position place scale move udim2" }

D{ id = "uiPosPixels", cat = "ui", group = "Boxes", label = "put at pixels",
		head = "put {gui} at {x}, {y} pixels",
		code = "{gui}.Position = UDim2.fromOffset({x}, {y})",
		fields = { gui = "expr|panel|object", x = "num|20|x", y = "num|20|y" },
		doc = "Measured from the top left corner of the parent, in screen pixels.",
		tags = "position pixels offset move" }

D{ id = "uiAnchor", cat = "ui", group = "Boxes", label = "set the anchor point",
		head = "measure {gui} from the point {x}, {y} of itself",
		code = "{gui}.AnchorPoint = Vector2.new({x}, {y})",
		fields = { gui = "expr|panel|object", x = "num|0.5|x", y = "num|0.5|y" },
		doc = "The anchor point says which part of the object its position refers " ..
			"to. 0.5, 0.5 means the middle, which is what centring needs.",
		tags = "anchorpoint centre middle align pivot" }

D{ id = "uiPaint", cat = "ui", group = "Boxes", label = "paint",
		head = "paint {gui} red {r} green {g} blue {b}",
		code = "{gui}.BackgroundColor3 = Color3.fromRGB({r}, {g}, {b})",
		fields = { gui = "expr|panel|object", r = "num|40|red", g = "num|44|green",
			b = "num|56|blue" },
		doc = "Each channel runs 0 to 255, the same numbers the colour picker shows.",
		tags = "colour color background paint rgb" }

D{ id = "uiSeeThrough", cat = "ui", group = "Boxes", label = "set see-through",
		head = "set how see-through {gui} is to {value}",
		code = "{gui}.BackgroundTransparency = {value}",
		fields = { gui = "expr|panel|object", value = "num|0.5|amount" },
		doc = "0 is solid and 1 is invisible. The things inside stay visible " ..
			"either way -- only the background fades.",
		tags = "transparency alpha fade background" }

D{ id = "uiVisible", cat = "ui", group = "Boxes", label = "show or hide",
		head = "set {gui} showing to {value}",
		code = "{gui}.Visible = {value}",
		fields = { gui = "expr|panel|object", value = "choice|true|value|true,false" },
		doc = "Hiding an object hides everything inside it, and hidden things " ..
			"stop receiving clicks.",
		tags = "visible show hide toggle" }

D{ id = "uiRoundCorners", cat = "ui", group = "Boxes", label = "round the corners",
		head = "round the corners of {gui} by {radius} pixels",
		code = {
			"do",
			'\tlocal corner = Instance.new("UICorner")',
			"\tcorner.CornerRadius = UDim.new(0, {radius})",
			"\tcorner.Parent = {gui}",
			"end",
		},
		fields = { gui = "expr|panel|object", radius = "num|8|radius" },
		doc = "Adds a UICorner. One per object -- adding a second does nothing.",
		tags = "uicorner rounded radius corners" }

D{ id = "uiOutline", cat = "ui", group = "Boxes", label = "outline",
		head = "outline {gui} with a {thickness} pixel line, red {r} green {g} blue {b}",
		code = {
			"do",
			'\tlocal stroke = Instance.new("UIStroke")',
			"\tstroke.Thickness = {thickness}",
			"\tstroke.Color = Color3.fromRGB({r}, {g}, {b})",
			"\tstroke.Parent = {gui}",
			"end",
		},
		fields = { gui = "expr|panel|object", thickness = "num|2|thickness",
			r = "num|255|red", g = "num|255|green", b = "num|255|blue" },
		doc = "A UIStroke draws a border that follows rounded corners properly, " ..
			"which the old BorderSizePixel never did.",
		tags = "uistroke border outline edge" }

D{ id = "uiPadding", cat = "ui", group = "Boxes", label = "add padding",
		head = "leave {n} pixels of space inside the edges of {gui}",
		code = {
			"do",
			'\tlocal padding = Instance.new("UIPadding")',
			"\tpadding.PaddingLeft = UDim.new(0, {n})",
			"\tpadding.PaddingRight = UDim.new(0, {n})",
			"\tpadding.PaddingTop = UDim.new(0, {n})",
			"\tpadding.PaddingBottom = UDim.new(0, {n})",
			"\tpadding.Parent = {gui}",
			"end",
		},
		fields = { gui = "expr|panel|object", n = "num|8|pixels" },
		doc = "Padding pushes the contents inward without changing the size of " ..
			"the object itself.",
		tags = "uipadding padding margin space inset" }

D{ id = "uiKeepShape", cat = "ui", group = "Boxes", label = "keep a shape",
		head = "keep {gui} {ratio} times as wide as it is tall",
		code = {
			"do",
			'\tlocal shape = Instance.new("UIAspectRatioConstraint")',
			"\tshape.AspectRatio = {ratio}",
			"\tshape.Parent = {gui}",
			"end",
		},
		fields = { gui = "expr|panel|object", ratio = "num|1|ratio" },
		doc = "Stops an object stretching oddly on wide or tall screens. 1 keeps " ..
			"it square.",
		tags = "aspect ratio square shape constraint" }

D{ id = "uiInFront", cat = "ui", group = "Boxes", label = "draw in front",
		head = "draw {gui} in front of its neighbours, at level {order}",
		code = "{gui}.ZIndex = {order}",
		fields = { gui = "expr|panel|object", order = "num|2|level" },
		doc = "Among things in the same screen, higher numbers are drawn on top.",
		tags = "zindex layer front behind order" }

D{ id = "uiClip", cat = "ui", group = "Boxes", label = "clip the overflow",
		head = "hide anything sticking out of {gui}",
		code = "{gui}.ClipsDescendants = true",
		fields = { gui = "expr|panel|object" },
		doc = "Anything inside that reaches past the edges is cut off. How " ..
			"progress bars and masked images are made.",
		tags = "clip overflow mask crop" }

D{ id = "uiGradient", cat = "ui", group = "Boxes", label = "add a gradient",
		head = "fade {gui} from red {r1} green {g1} blue {b1} to red {r2} green {g2} blue {b2}",
		code = {
			"do",
			'\tlocal gradient = Instance.new("UIGradient")',
			"\tgradient.Color = ColorSequence.new(",
			"\t\tColor3.fromRGB({r1}, {g1}, {b1}), Color3.fromRGB({r2}, {g2}, {b2}))",
			"\tgradient.Rotation = {angle}",
			"\tgradient.Parent = {gui}",
			"end",
		},
		fields = { gui = "expr|panel|object", r1 = "num|60|from red", g1 = "num|70|from green",
			b1 = "num|110|from blue", r2 = "num|20|to red", g2 = "num|24|to green",
			b2 = "num|36|to blue", angle = "num|90|angle" },
		doc = "A UIGradient tints whatever is behind it. An angle of 90 runs top " ..
			"to bottom, 0 runs left to right.",
		tags = "uigradient gradient fade colour sequence" }

-- words -----------------------------------------------------------------------
D{ id = "uiLabel", cat = "ui", group = "Words", label = "make a label",
		head = 'make {name} = a label saying "{text}" inside {parent}',
		code = {
			'local {name} = Instance.new("TextLabel")',
			"{name}.Size = UDim2.fromScale(1, 0.2)",
			"{name}.BackgroundTransparency = 1",
			'{name}.Text = "{text}"',
			"{name}.TextColor3 = Color3.fromRGB(255, 255, 255)",
			"{name}.TextScaled = true",
			"{name}.Parent = {parent}",
		},
		fields = { name = "name|label|name", text = "str|Hello|words",
			parent = "expr|panel|parent" },
		doc = "A TextLabel shows words and nothing else. Scaled text grows and " ..
			"shrinks to fill the label, which is usually what you want.",
		tags = "textlabel label text words caption" }

D{ id = "uiSetWords", cat = "ui", group = "Words", label = "set the words",
		head = "set the words of {gui} to {value}",
		code = "{gui}.Text = {value}",
		fields = { gui = "expr|label|label", value = "expr|score|value" },
		doc = "Anything can go in as long as it is text. Numbers convert on their " ..
			"own; other values need `value to text` first.",
		tags = "text set words change label" }

D{ id = "uiSetWordsText", cat = "ui", group = "Words", label = "set the words to",
		head = 'set the words of {gui} to "{text}"',
		code = '{gui}.Text = "{text}"',
		fields = { gui = "expr|label|label", text = "str|Ready|words" },
		doc = "For fixed wording, with no quotes to type in the field.",
		tags = "text set words literal" }

D{ id = "uiCountUp", cat = "ui", group = "Words", label = "show a number",
		head = "show {value} in {gui} with {places} decimal places",
		code = '{gui}.Text = string.format("%.{places}f", {value})',
		fields = { gui = "expr|label|label", value = "expr|health|value",
			places = "num|0|places" },
		doc = "Rounds a number for display without changing the number itself. " ..
			"Zero places gives a whole number.",
		tags = "format number decimal round display" }

D{ id = "uiWordColour", cat = "ui", group = "Words", label = "colour the words",
		head = "colour the words in {gui} red {r} green {g} blue {b}",
		code = "{gui}.TextColor3 = Color3.fromRGB({r}, {g}, {b})",
		fields = { gui = "expr|label|label", r = "num|255|red", g = "num|255|green",
			b = "num|255|blue" },
		doc = "Only the letters change colour. The background is separate.",
		tags = "textcolor colour words text" }

D{ id = "uiWordSize", cat = "ui", group = "Words", label = "set letter height",
		head = "set the letter height in {gui} to {size} pixels",
		code = { "{gui}.TextScaled = false", "{gui}.TextSize = {size}" },
		fields = { gui = "expr|label|label", size = "num|18|height" },
		doc = "A fixed height, which needs scaling switched off first or it will " ..
			"be ignored.",
		tags = "textsize letter height font size" }

D{ id = "uiWordsFit", cat = "ui", group = "Words", label = "let the words fit",
		head = "let the words in {gui} shrink to fit",
		code = "{gui}.TextScaled = true",
		fields = { gui = "expr|label|label" },
		doc = "The text grows or shrinks so it always fills the label. Simplest " ..
			"way to make an interface work on every screen.",
		tags = "textscaled fit shrink responsive" }

D{ id = "uiWordsWrap", cat = "ui", group = "Words", label = "wrap long words",
		head = "let long text in {gui} wrap onto the next line",
		code = "{gui}.TextWrapped = true",
		fields = { gui = "expr|label|label" },
		doc = "Without this, a long sentence runs off the side and is cut off.",
		tags = "textwrapped wrap lines multiline" }

D{ id = "uiTypeface", cat = "ui", group = "Words", label = "set the typeface",
		head = "set the typeface of {gui} to {font}",
		code = "{gui}.FontFace = Font.fromEnum(Enum.Font.{font})",
		fields = { gui = "expr|label|label",
			font = "choice|GothamMedium|typeface|Gotham,GothamMedium,GothamBold,SourceSans,SourceSansBold,Code,Fantasy,Cartoon,Arcade" },
		doc = "FontFace is the current way to set a typeface, and it accepts " ..
			"weights the old Font property could not.",
		tags = "font typeface fontface style" }

D{ id = "uiAlignWords", cat = "ui", group = "Words", label = "line the words up",
		head = "line the words in {gui} up to the {side}",
		code = "{gui}.TextXAlignment = Enum.TextXAlignment.{side}",
		fields = { gui = "expr|label|label", side = "choice|Center|side|Left,Center,Right" },
		doc = "Where the text sits inside its label, left to right.",
		tags = "alignment align left right centre" }

D{ id = "uiTags", cat = "ui", group = "Words", label = "allow bold and colour tags",
		head = "let {gui} use bold and colour tags",
		code = "{gui}.RichText = true",
		fields = { gui = "expr|label|label" },
		doc = "Turns on tags inside the text itself, so `<b>go</b>` renders bold " ..
			"and `<font color='#ff0000'>` colours part of a line.",
		tags = "richtext bold italic colour markup" }

D{ id = "uiWordOutline", cat = "ui", group = "Words", label = "outline the words",
		head = "outline the words in {gui} in black",
		code = {
			"{gui}.TextStrokeTransparency = 0",
			"{gui}.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)",
		},
		fields = { gui = "expr|label|label" },
		doc = "A dark edge round the letters, which keeps text readable over a " ..
			"busy background.",
		tags = "textstroke outline readable shadow" }

-- buttons ---------------------------------------------------------------------
D{ id = "uiButton", cat = "ui", group = "Buttons", label = "make a button",
		head = 'make {name} = a button saying "{text}" inside {parent}',
		code = {
			'local {name} = Instance.new("TextButton")',
			"{name}.Size = UDim2.fromScale({w}, {h})",
			"{name}.BackgroundColor3 = Color3.fromRGB(70, 90, 140)",
			'{name}.Text = "{text}"',
			"{name}.TextColor3 = Color3.fromRGB(255, 255, 255)",
			"{name}.TextScaled = true",
			"{name}.Parent = {parent}",
		},
		fields = { name = "name|button|name", text = "str|Play|words",
			parent = "expr|panel|parent", w = "num|0.4|width", h = "num|0.15|height" },
		doc = "A TextButton is a label that can be clicked. Everything a label " ..
			"can do, it can do too.",
		tags = "textbutton button click press" }

D{ id = "uiImageButton", cat = "ui", group = "Buttons", label = "make a picture button",
		head = "make {name} = a button showing {asset} inside {parent}",
		code = {
			'local {name} = Instance.new("ImageButton")',
			"{name}.Size = UDim2.fromOffset(64, 64)",
			"{name}.BackgroundTransparency = 1",
			"{name}.Image = {asset}",
			"{name}.Parent = {parent}",
		},
		fields = { name = "name|button|name", asset = "expr|\"rbxassetid://0\"|image id",
			parent = "expr|panel|parent" },
		doc = "A clickable picture. Asset ids look like `rbxassetid://123456`.",
		tags = "imagebutton icon picture button" }

D{ id = "uiOnClick", cat = "ui", group = "Buttons", label = "on button clicked",
		head = "when {button} is clicked",
		code = "{button}.Activated:Connect(function()", tail = "end)",
		fields = { button = "expr|button|button" },
		slots = { { key = "body" } },
		doc = "Activated covers mouse, touch and gamepad in one event, which is " ..
			"why it is better than MouseButton1Click.",
		tags = "activated click press button tap" }

D{ id = "uiOnHover", cat = "ui", group = "Buttons", label = "on pointer over",
		head = "when the pointer moves onto {button}",
		code = "{button}.MouseEnter:Connect(function()", tail = "end)",
		fields = { button = "expr|button|button" },
		slots = { { key = "body" } },
		side = "client",
		doc = "Hover effects only make sense on a mouse, so give touch players a " ..
			"different clue as well.",
		tags = "mouseenter hover over highlight" }

D{ id = "uiOnLeave", cat = "ui", group = "Buttons", label = "on pointer away",
		head = "when the pointer leaves {button}",
		code = "{button}.MouseLeave:Connect(function()", tail = "end)",
		fields = { button = "expr|button|button" },
		slots = { { key = "body" } },
		side = "client",
		doc = "Pairs with `on pointer over` to put a hover effect back how it was.",
		tags = "mouseleave hover out reset" }

D{ id = "uiClickable", cat = "ui", group = "Buttons", label = "set clickable",
		head = "set {button} clickable to {value}",
		code = { "{button}.Active = {value}", "{button}.AutoButtonColor = {value}" },
		fields = { button = "expr|button|button", value = "choice|true|value|true,false" },
		doc = "Switches a button off without hiding it, and stops it lighting up " ..
			"when the pointer is over it.",
		tags = "active disable enable clickable" }

D{ id = "uiHideOnClick", cat = "ui", group = "Buttons", label = "close on click",
		head = "hide {gui} when {button} is clicked",
		code = {
			"{button}.Activated:Connect(function()",
			"\t{gui}.Visible = false",
			"end)",
		},
		fields = { button = "expr|closeButton|button", gui = "expr|panel|what to hide" },
		doc = "The whole of a close button, in one block.",
		tags = "close hide button dismiss" }

D{ id = "uiToggleOnClick", cat = "ui", group = "Buttons", label = "toggle on click",
		head = "show or hide {gui} when {button} is clicked",
		code = {
			"{button}.Activated:Connect(function()",
			"\t{gui}.Visible = not {gui}.Visible",
			"end)",
		},
		fields = { button = "expr|menuButton|button", gui = "expr|panel|what to toggle" },
		doc = "Opens a panel if it is shut and shuts it if it is open.",
		tags = "toggle open close menu button" }

-- pictures ---------------------------------------------------------------------
D{ id = "uiImage", cat = "ui", group = "Pictures", label = "make a picture",
		head = "make {name} = a picture of {asset} inside {parent}",
		code = {
			'local {name} = Instance.new("ImageLabel")',
			"{name}.Size = UDim2.fromOffset(64, 64)",
			"{name}.BackgroundTransparency = 1",
			"{name}.Image = {asset}",
			"{name}.Parent = {parent}",
		},
		fields = { name = "name|icon|name", asset = "expr|\"rbxassetid://0\"|image id",
			parent = "expr|panel|parent" },
		doc = "Shows an uploaded image. Upload yours in the Asset Manager to get " ..
			"an id.",
		tags = "imagelabel picture icon image" }

D{ id = "uiSetImage", cat = "ui", group = "Pictures", label = "change the picture",
		head = "set the picture in {gui} to {asset}",
		code = "{gui}.Image = {asset}",
		fields = { gui = "expr|icon|picture", asset = "expr|\"rbxassetid://0\"|image id" },
		doc = "Swapping the id swaps the picture, which is how icons change state.",
		tags = "image change swap icon" }

D{ id = "uiTintImage", cat = "ui", group = "Pictures", label = "tint the picture",
		head = "tint the picture in {gui} red {r} green {g} blue {b}",
		code = "{gui}.ImageColor3 = Color3.fromRGB({r}, {g}, {b})",
		fields = { gui = "expr|icon|picture", r = "num|255|red", g = "num|255|green",
			b = "num|255|blue" },
		doc = "Multiplies the picture by a colour, so a white icon can be any " ..
			"colour without uploading it again.",
		tags = "imagecolor tint colour icon" }

D{ id = "uiFadeImage", cat = "ui", group = "Pictures", label = "fade the picture",
		head = "set how see-through the picture in {gui} is to {value}",
		code = "{gui}.ImageTransparency = {value}",
		fields = { gui = "expr|icon|picture", value = "num|0.5|amount" },
		doc = "Separate from the background transparency, so a picture can fade " ..
			"while its panel stays.",
		tags = "imagetransparency fade alpha picture" }

D{ id = "uiImageFit", cat = "ui", group = "Pictures", label = "set how it fits",
		head = "make the picture in {gui} {mode}",
		code = "{gui}.ScaleType = Enum.ScaleType.{mode}",
		fields = { gui = "expr|icon|picture",
			mode = "choice|Fit|fit|Fit,Stretch,Crop,Tile,Slice" },
		doc = "Fit keeps the shape and leaves gaps, Stretch distorts, Crop fills " ..
			"and cuts. Slice is for stretchy panel borders.",
		tags = "scaletype fit stretch crop tile" }

-- layout ------------------------------------------------------------------------
D{ id = "uiStack", cat = "ui", group = "Layout", label = "stack the contents",
		head = "stack everything inside {gui} {dir}, {gap} pixels apart",
		code = {
			"do",
			'\tlocal layout = Instance.new("UIListLayout")',
			"\tlayout.FillDirection = Enum.FillDirection.{dir}",
			"\tlayout.Padding = UDim.new(0, {gap})",
			"\tlayout.SortOrder = Enum.SortOrder.LayoutOrder",
			"\tlayout.Parent = {gui}",
			"end",
		},
		fields = { gui = "expr|panel|object", dir = "choice|Vertical|direction|Vertical,Horizontal",
			gap = "num|6|gap" },
		doc = "A UIListLayout puts children in a row or a column automatically, " ..
			"so you never set their positions by hand again.",
		tags = "uilistlayout stack list row column layout" }

D{ id = "uiGrid", cat = "ui", group = "Layout", label = "arrange in a grid",
		head = "arrange everything inside {gui} in a grid of {w} by {h} pixel cells",
		code = {
			"do",
			'\tlocal grid = Instance.new("UIGridLayout")',
			"\tgrid.CellSize = UDim2.fromOffset({w}, {h})",
			"\tgrid.CellPadding = UDim2.fromOffset({gap}, {gap})",
			"\tgrid.SortOrder = Enum.SortOrder.LayoutOrder",
			"\tgrid.Parent = {gui}",
			"end",
		},
		fields = { gui = "expr|panel|object", w = "num|80|cell width",
			h = "num|80|cell height", gap = "num|6|gap" },
		doc = "Inventories and shop windows are grids. Cells wrap onto the next " ..
			"row on their own.",
		tags = "uigridlayout grid inventory cells" }

D{ id = "uiOrder", cat = "ui", group = "Layout", label = "set the order in a layout",
		head = "put {gui} at position {order} in its layout",
		code = "{gui}.LayoutOrder = {order}",
		fields = { gui = "expr|panel|object", order = "num|1|position" },
		doc = "Lower numbers come first. Only matters inside a list or grid " ..
			"layout that is sorting by order.",
		tags = "layoutorder order sort position" }

D{ id = "uiCentreContents", cat = "ui", group = "Layout", label = "centre the contents",
		head = "centre everything inside {gui}",
		code = {
			"do",
			'\tlocal layout = {gui}:FindFirstChildOfClass("UIListLayout")',
			"\tif layout then",
			"\t\tlayout.HorizontalAlignment = Enum.HorizontalAlignment.Center",
			"\t\tlayout.VerticalAlignment = Enum.VerticalAlignment.Center",
			"\tend",
			"end",
		},
		fields = { gui = "expr|panel|object" },
		doc = "Centres the children of an object that already has a list layout, " ..
			"and quietly does nothing if it has not.",
		tags = "centre align middle layout" }

D{ id = "uiSizeLimit", cat = "ui", group = "Layout", label = "limit the size",
		head = "keep {gui} between {min} and {max} pixels wide",
		code = {
			"do",
			'\tlocal limit = Instance.new("UISizeConstraint")',
			"\tlimit.MinSize = Vector2.new({min}, 0)",
			"\tlimit.MaxSize = Vector2.new({max}, math.huge)",
			"\tlimit.Parent = {gui}",
			"end",
		},
		fields = { gui = "expr|panel|object", min = "num|120|smallest", max = "num|480|largest" },
		doc = "Stops a fraction-sized panel becoming unreadably small on a phone " ..
			"or absurdly wide on a monitor.",
		tags = "uisizeconstraint min max width limit" }

D{ id = "uiScaleContents", cat = "ui", group = "Layout", label = "scale the contents",
		head = "scale everything inside {gui} by {factor}",
		code = {
			"do",
			'\tlocal scale = Instance.new("UIScale")',
			"\tscale.Scale = {factor}",
			"\tscale.Parent = {gui}",
			"end",
		},
		fields = { gui = "expr|panel|object", factor = "num|1|factor" },
		doc = "Multiplies the size of everything inside at once. Useful for a " ..
			"whole-interface zoom or a press-down effect.",
		tags = "uiscale zoom scale shrink grow" }

-- motion --------------------------------------------------------------------------
D{ id = "uiSlideTo", cat = "ui", group = "Motion", label = "slide to",
		head = "slide {gui} to {x}, {y} over {time} seconds",
		code = "TweenService:Create({gui}, TweenInfo.new({time}), " ..
			"{ Position = UDim2.fromScale({x}, {y}) }):Play()",
		fields = { gui = "expr|panel|object", x = "num|0.5|x", y = "num|0.5|y",
			time = "num|0.3|seconds" },
		needs = { "TweenService" },
		doc = "Roblox fills in every frame between. Sliding a menu in beats " ..
			"making it appear.",
		tags = "tween slide move animate position" }

D{ id = "uiGrowTo", cat = "ui", group = "Motion", label = "grow to",
		head = "grow {gui} to {w} by {h} over {time} seconds",
		code = "TweenService:Create({gui}, TweenInfo.new({time}), " ..
			"{ Size = UDim2.fromScale({w}, {h}) }):Play()",
		fields = { gui = "expr|panel|object", w = "num|0.5|width", h = "num|0.3|height",
			time = "num|0.3|seconds" },
		needs = { "TweenService" },
		doc = "Animates a size change rather than snapping to it.",
		tags = "tween size grow shrink animate" }

D{ id = "uiFadeOut", cat = "ui", group = "Motion", label = "fade out",
		head = "fade {gui} out over {time} seconds",
		code = "TweenService:Create({gui}, TweenInfo.new({time}), " ..
			"{ BackgroundTransparency = 1 }):Play()",
		fields = { gui = "expr|panel|object", time = "num|0.4|seconds" },
		needs = { "TweenService" },
		doc = "Fades the background only. Text and pictures have their own " ..
			"transparency, so fade those too if you want the whole thing gone.",
		tags = "tween fade out transparency hide" }

D{ id = "uiFadeIn", cat = "ui", group = "Motion", label = "fade in",
		head = "fade {gui} in over {time} seconds",
		code = {
			"{gui}.BackgroundTransparency = 1",
			"{gui}.Visible = true",
			"TweenService:Create({gui}, TweenInfo.new({time}), " ..
				"{ BackgroundTransparency = {to} }):Play()",
		},
		fields = { gui = "expr|panel|object", time = "num|0.4|seconds", to = "num|0|end amount" },
		needs = { "TweenService" },
		doc = "Makes it visible first, then fades it up from nothing.",
		tags = "tween fade in appear show" }

D{ id = "uiPopIn", cat = "ui", group = "Motion", label = "pop in",
		head = "pop {gui} in over {time} seconds",
		code = {
			"{gui}.Size = UDim2.fromScale(0, 0)",
			"{gui}.Visible = true",
			"TweenService:Create({gui}, TweenInfo.new({time}, Enum.EasingStyle.Back, " ..
				"Enum.EasingDirection.Out), { Size = UDim2.fromScale({w}, {h}) }):Play()",
		},
		fields = { gui = "expr|panel|object", time = "num|0.35|seconds",
			w = "num|0.4|width", h = "num|0.3|height" },
		needs = { "TweenService" },
		doc = "Grows from nothing with a slight overshoot. The Back easing style " ..
			"is what makes it feel springy.",
		tags = "tween pop scale bounce appear" }

D{ id = "uiSetBar", cat = "ui", group = "Motion", label = "set a bar",
		head = "fill the bar {gui} to {fraction} of the way",
		code = "{gui}.Size = UDim2.fromScale(math.clamp({fraction}, 0, 1), 1)",
		fields = { gui = "expr|fill|bar", fraction = "expr|health / maxHealth|fraction" },
		doc = "A bar is one box inside another with the outer one clipping. The " ..
			"clamp keeps it from overshooting when health goes past its maximum.",
		tags = "bar progress health fill meter" }

D{ id = "uiSlideBar", cat = "ui", group = "Motion", label = "slide a bar",
		head = "slide the bar {gui} to {fraction} over {time} seconds",
		code = "TweenService:Create({gui}, TweenInfo.new({time}), " ..
			"{ Size = UDim2.fromScale(math.clamp({fraction}, 0, 1), 1) }):Play()",
		fields = { gui = "expr|fill|bar", fraction = "expr|health / maxHealth|fraction",
			time = "num|0.25|seconds" },
		needs = { "TweenService" },
		doc = "The same as setting a bar, but it slides. Damage feels heavier " ..
			"when the bar catches up a moment later.",
		tags = "bar progress tween health smooth" }

-- typing --------------------------------------------------------------------------
D{ id = "uiTextBox", cat = "ui", group = "Typing", label = "make a typing box",
		head = 'make {name} = a typing box inside {parent}, showing "{hint}" when empty',
		code = {
			'local {name} = Instance.new("TextBox")',
			"{name}.Size = UDim2.fromScale(0.6, 0.1)",
			"{name}.ClearTextOnFocus = false",
			'{name}.PlaceholderText = "{hint}"',
			'{name}.Text = ""',
			"{name}.Parent = {parent}",
		},
		fields = { name = "name|box|name", parent = "expr|panel|parent",
			hint = "str|type here|hint" },
		doc = "A TextBox is a label the player can type into. Clearing on focus " ..
			"is usually annoying, so it is off here.",
		tags = "textbox input typing entry field" }

D{ id = "uiOnTyped", cat = "ui", group = "Typing", label = "on finished typing",
		head = "when the player finishes typing in {box}, with {entered}",
		code = "{box}.FocusLost:Connect(function({entered})", tail = "end)",
		fields = { box = "expr|box|box", entered = "name|enterPressed|entered" },
		slots = { { key = "body" } },
		doc = "Fires when they click away or press Enter. The value tells you " ..
			"which of the two it was, so you can ignore a stray click.",
		tags = "focuslost typing enter submit input" }

D{ id = "uiGetTyped", cat = "ui", group = "Typing", label = "what was typed",
		head = "make {name} = what was typed in {box}",
		code = "local {name} = {box}.Text",
		fields = { name = "name|typed|name", box = "expr|box|box" },
		doc = "Always text, even when it looks like a number -- put it through " ..
			"`text to number` before doing maths with it.",
		tags = "text read input typed value" }

D{ id = "uiClearBox", cat = "ui", group = "Typing", label = "empty a typing box",
		head = "empty the typing box {box}",
		code = '{box}.Text = ""',
		fields = { box = "expr|box|box" },
		doc = "Clears whatever was typed, usually just after you have read it.",
		tags = "clear empty reset input" }

-- roblox's own interface -------------------------------------------------------------
D{ id = "uiHideCore", cat = "ui", group = "Roblox's own", label = "hide part of Roblox's interface",
		head = "hide the {part} that Roblox draws",
		code = "StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.{part}, false)",
		fields = { part = "choice|PlayerList|part|PlayerList,Backpack,Chat,Health,EmotesMenu,All" },
		needs = { "StarterGui" },
		side = "client",
		doc = "Turns off the built-in player list, backpack, chat or health bar " ..
			"so your own interface can take over.",
		tags = "coregui hide playerlist backpack chat health" }

D{ id = "uiNotify", cat = "ui", group = "Roblox's own", label = "send a notification",
		head = 'show a notification titled "{title}" saying "{text}"',
		code = {
			'StarterGui:SetCore("SendNotification", {',
			'\tTitle = "{title}",',
			'\tText = "{text}",',
			"\tDuration = {seconds},",
			"})",
		},
		fields = { title = "str|Well done|title", text = "str|You found a coin|message",
			seconds = "num|4|seconds" },
		needs = { "StarterGui" },
		side = "client",
		doc = "Uses Roblox's own notification popup, which needs no interface of " ..
			"your own at all.",
		tags = "notification popup message toast alert" }

--=============================================================================
-- CAMERA AND LIGHT
--=============================================================================

D{ id = "camGet", cat = "camera", group = "The camera", label = "the camera",
		head = "make {name} = the camera",
		code = "local {name} = workspace.CurrentCamera",
		fields = { name = "name|camera|name" },
		side = "client",
		doc = "Every player has their own camera, so this only means anything in " ..
			"a LocalScript.",
		tags = "camera currentcamera view" }

D{ id = "camTakeOver", cat = "camera", group = "The camera", label = "take control",
		head = "take control of the camera",
		code = "workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable",
		side = "client",
		doc = "Stops Roblox moving the camera so your own code can. Nothing else " ..
			"you do to the camera sticks until you have done this.",
		tags = "scriptable camera control cutscene" }

D{ id = "camGiveBack", cat = "camera", group = "The camera", label = "give the camera back",
		head = "give the camera back to the player",
		code = "workspace.CurrentCamera.CameraType = Enum.CameraType.Custom",
		side = "client",
		doc = "Returns to the normal follow-the-character camera. Always do this " ..
			"at the end of a cutscene.",
		tags = "camera custom restore normal" }

D{ id = "camPutAt", cat = "camera", group = "The camera", label = "put the camera at",
		head = "put the camera at ({x}, {y}, {z})",
		code = "workspace.CurrentCamera.CFrame = CFrame.new({x}, {y}, {z})",
		fields = { x = "expr|0|x", y = "expr|20|y", z = "expr|0|z" },
		side = "client",
		doc = "Moves the camera without turning it. Needs control taken first.",
		tags = "camera position move place" }

D{ id = "camLookAt", cat = "camera", group = "The camera", label = "look at",
		head = "put the camera at ({x}, {y}, {z}) looking at {target}",
		code = "workspace.CurrentCamera.CFrame = CFrame.lookAt(Vector3.new({x}, {y}, {z}), {target})",
		fields = { x = "expr|0|x", y = "expr|20|y", z = "expr|20|z",
			target = "expr|part.Position|target position" },
		side = "client",
		doc = "`CFrame.lookAt` builds a position and a facing in one go, which is " ..
			"far easier than working out the angles.",
		tags = "camera lookat aim face target" }

D{ id = "camFollow", cat = "camera", group = "The camera", label = "follow something",
		head = "make the camera follow {subject}",
		code = "workspace.CurrentCamera.CameraSubject = {subject}",
		fields = { subject = "expr|humanoid|subject" },
		side = "client",
		doc = "Normally the player's own Humanoid. Point it at another one to " ..
			"watch someone else, or at a part for a fixed view.",
		tags = "camerasubject follow spectate watch" }

D{ id = "camWideness", cat = "camera", group = "The camera", label = "set how wide it sees",
		head = "set how wide the camera sees to {n} degrees",
		code = "workspace.CurrentCamera.FieldOfView = {n}",
		fields = { n = "num|70|degrees" },
		side = "client",
		doc = "70 is normal. Higher feels fast and fish-eyed; lower feels zoomed " ..
			"in and tense.",
		tags = "fieldofview fov zoom wide" }

D{ id = "camZoomLimits", cat = "camera", group = "The camera", label = "limit the zoom",
		head = "keep the camera between {min} and {max} studs from {player}",
		code = {
			"{player}.CameraMinZoomDistance = {min}",
			"{player}.CameraMaxZoomDistance = {max}",
		},
		fields = { player = "expr|player|player", min = "num|8|closest", max = "num|30|furthest" },
		doc = "Setting both to the same number locks the zoom exactly there.",
		tags = "zoom distance camera limit" }

D{ id = "camFirstPerson", cat = "camera", group = "The camera", label = "lock to first person",
		head = "lock {player} into first person",
		code = "{player}.CameraMode = Enum.CameraMode.LockFirstPerson",
		fields = { player = "expr|player|player" },
		doc = "The player can no longer zoom out. Pair it with hiding their own " ..
			"body parts if you do not want to see them.",
		tags = "firstperson camera mode lock" }

D{ id = "camThirdPerson", cat = "camera", group = "The camera", label = "allow third person",
		head = "let {player} zoom out again",
		code = "{player}.CameraMode = Enum.CameraMode.Classic",
		fields = { player = "expr|player|player" },
		doc = "Undoes a first person lock.",
		tags = "thirdperson camera classic zoom" }

D{ id = "camGlideTo", cat = "camera", group = "Camera motion", label = "glide the camera",
		head = "glide the camera to ({x}, {y}, {z}) over {time} seconds",
		code = "TweenService:Create(workspace.CurrentCamera, TweenInfo.new({time}, " ..
			"Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), " ..
			"{ CFrame = CFrame.new({x}, {y}, {z}) }):Play()",
		fields = { x = "expr|0|x", y = "expr|20|y", z = "expr|0|z", time = "num|2|seconds" },
		needs = { "TweenService" },
		side = "client",
		doc = "The backbone of a cutscene: take control, glide somewhere, wait, " ..
			"glide back, give the camera back.",
		tags = "camera tween cutscene glide smooth" }

D{ id = "camShake", cat = "camera", group = "Camera motion", label = "shake the camera",
		head = "shake the camera for {time} seconds, {strength} strong",
		code = {
			"do",
			"\tlocal camera = workspace.CurrentCamera",
			"\tlocal until_ = os.clock() + {time}",
			"\twhile os.clock() < until_ do",
			"\t\tlocal nudge = Vector3.new(",
			"\t\t\t(math.random() - 0.5) * {strength},",
			"\t\t\t(math.random() - 0.5) * {strength}, 0)",
			"\t\tcamera.CFrame = camera.CFrame * CFrame.new(nudge)",
			"\t\ttask.wait()",
			"\tend",
			"end",
		},
		fields = { time = "num|0.4|seconds", strength = "num|0.5|strength" },
		side = "client",
		doc = "Nudges the camera about for a moment. Small numbers go a long way " ..
			"-- 0.5 is already a hard hit.",
		tags = "shake camera impact explosion feedback" }

-- lighting ---------------------------------------------------------------------
D{ id = "lightBright", cat = "camera", group = "Lighting", label = "set the brightness",
		head = "set how bright the sun is to {n}",
		code = "Lighting.Brightness = {n}",
		fields = { n = "num|2|brightness" },
		needs = { "Lighting" },
		doc = "How strong direct sunlight is. 2 is the default; 0 leaves only " ..
			"ambient light.",
		tags = "brightness sun light lighting" }

D{ id = "lightTime", cat = "camera", group = "Lighting", label = "set the time of day",
		head = "set the time of day to {n} o'clock",
		code = "Lighting.ClockTime = {n}",
		fields = { n = "num|14|hour" },
		needs = { "Lighting" },
		doc = "0 to 24, and decimals work -- 6.5 is half past six. 12 is noon, " ..
			"0 is midnight.",
		tags = "clocktime day night time sun" }

D{ id = "lightShadowColour", cat = "camera", group = "Lighting", label = "set the shadow colour",
		head = "set the colour of shadows to red {r} green {g} blue {b}",
		code = "Lighting.Ambient = Color3.fromRGB({r}, {g}, {b})",
		fields = { r = "num|60|red", g = "num|60|green", b = "num|80|blue" },
		needs = { "Lighting" },
		doc = "Ambient is the light that reaches places the sun does not. Cool " ..
			"blues read as night, warm browns as indoors.",
		tags = "ambient shadow colour mood lighting" }

D{ id = "lightOutdoor", cat = "camera", group = "Lighting", label = "set the outdoor light",
		head = "set the outdoor light to red {r} green {g} blue {b}",
		code = "Lighting.OutdoorAmbient = Color3.fromRGB({r}, {g}, {b})",
		fields = { r = "num|130|red", g = "num|140|green", b = "num|160|blue" },
		needs = { "Lighting" },
		doc = "The same idea as ambient, but only where the sky can be seen.",
		tags = "outdoorambient sky ambient lighting" }

D{ id = "lightFog", cat = "camera", group = "Lighting", label = "set the fog",
		head = "make fog start {a} studs away and be solid by {b}",
		code = { "Lighting.FogStart = {a}", "Lighting.FogEnd = {b}" },
		fields = { a = "num|50|start", b = "num|300|end" },
		needs = { "Lighting" },
		doc = "Hides distance, which sets a mood and can help a big place run " ..
			"faster.",
		tags = "fog distance mist atmosphere" }

D{ id = "lightFogColour", cat = "camera", group = "Lighting", label = "set the fog colour",
		head = "colour the fog red {r} green {g} blue {b}",
		code = "Lighting.FogColor = Color3.fromRGB({r}, {g}, {b})",
		fields = { r = "num|200|red", g = "num|205|green", b = "num|215|blue" },
		needs = { "Lighting" },
		doc = "Match it roughly to the sky, or the horizon will look like a wall.",
		tags = "fogcolor fog colour horizon" }

D{ id = "lightShadows", cat = "camera", group = "Lighting", label = "turn shadows on or off",
		head = "set shadows to {value}",
		code = "Lighting.GlobalShadows = {value}",
		fields = { value = "choice|true|value|true,false" },
		needs = { "Lighting" },
		doc = "Shadows cost performance. Turning them off is a blunt but " ..
			"effective way to help weaker devices.",
		tags = "shadows globalshadows performance lighting" }

D{ id = "lightExposure", cat = "camera", group = "Lighting", label = "set the exposure",
		head = "set the exposure to {n}",
		code = "Lighting.ExposureCompensation = {n}",
		fields = { n = "num|0|exposure" },
		needs = { "Lighting" },
		doc = "Brightens or darkens the whole picture after everything else is " ..
			"drawn, the way a camera's exposure does.",
		tags = "exposure brightness tone lighting" }

D{ id = "lightDayCycle", cat = "camera", group = "Lighting", label = "run a day cycle",
		head = "run a day and night cycle taking {minutes} minutes",
		code = {
			"task.spawn(function()",
			"\twhile true do",
			"\t\ttask.wait(1)",
			"\t\tLighting.ClockTime = (Lighting.ClockTime + 24 / ({minutes} * 60)) % 24",
			"\tend",
			"end)",
		},
		fields = { minutes = "num|10|minutes" },
		needs = { "Lighting" },
		doc = "Advances the clock a little every second, wrapping round at " ..
			"midnight. Run it on the server so everyone sees the same sky.",
		tags = "day night cycle time lighting loop" }

-- effects -----------------------------------------------------------------------
D{ id = "fxBlur", cat = "camera", group = "Effects", label = "blur the screen",
		head = "blur the screen by {n}",
		code = {
			"do",
			'\tlocal blur = Lighting:FindFirstChild("ScreenBlur") or Instance.new("BlurEffect")',
			'\tblur.Name = "ScreenBlur"',
			"\tblur.Size = {n}",
			"\tblur.Parent = Lighting",
			"end",
		},
		fields = { n = "num|12|amount" },
		needs = { "Lighting" },
		doc = "Finds the blur if it is already there and makes one if it is not, " ..
			"so calling it twice does not stack up effects. 0 turns it off.",
		tags = "blur effect pause menu focus" }

D{ id = "fxGlow", cat = "camera", group = "Effects", label = "make bright things glow",
		head = "make bright things glow, {n} strong",
		code = {
			"do",
			'\tlocal bloom = Lighting:FindFirstChild("ScreenBloom") or Instance.new("BloomEffect")',
			'\tbloom.Name = "ScreenBloom"',
			"\tbloom.Intensity = {n}",
			"\tbloom.Threshold = {threshold}",
			"\tbloom.Parent = Lighting",
			"end",
		},
		fields = { n = "num|1|strength", threshold = "num|0.9|threshold" },
		needs = { "Lighting" },
		doc = "Bloom spills light out of bright areas. The threshold decides how " ..
			"bright something has to be before it glows.",
		tags = "bloom glow bright effect neon" }

D{ id = "fxTint", cat = "camera", group = "Effects", label = "tint the screen",
		head = "tint the whole screen red {r} green {g} blue {b}",
		code = {
			"do",
			'\tlocal tint = Lighting:FindFirstChild("ScreenTint") or Instance.new("ColorCorrectionEffect")',
			'\ttint.Name = "ScreenTint"',
			"\ttint.TintColor = Color3.fromRGB({r}, {g}, {b})",
			"\ttint.Parent = Lighting",
			"end",
		},
		fields = { r = "num|255|red", g = "num|230|green", b = "num|210|blue" },
		needs = { "Lighting" },
		doc = "Colours everything on screen. A red tint for damage and a green " ..
			"one for poison cost nothing to add.",
		tags = "colorcorrection tint screen damage effect" }

D{ id = "fxSaturation", cat = "camera", group = "Effects", label = "set the colourfulness",
		head = "set how colourful the screen is to {n}",
		code = {
			"do",
			'\tlocal grade = Lighting:FindFirstChild("ScreenTint") or Instance.new("ColorCorrectionEffect")',
			'\tgrade.Name = "ScreenTint"',
			"\tgrade.Saturation = {n}",
			"\tgrade.Parent = Lighting",
			"end",
		},
		fields = { n = "num|0|amount" },
		needs = { "Lighting" },
		doc = "0 leaves it alone, -1 is black and white, 1 is garish. Draining " ..
			"the colour is a cheap way to show a player is hurt.",
		tags = "saturation colour grade greyscale effect" }

D{ id = "fxSunRays", cat = "camera", group = "Effects", label = "add sun rays",
		head = "add sun rays, {n} strong",
		code = {
			"do",
			'\tlocal rays = Lighting:FindFirstChild("SunRays") or Instance.new("SunRaysEffect")',
			'\trays.Name = "SunRays"',
			"\trays.Intensity = {n}",
			"\trays.Parent = Lighting",
			"end",
		},
		fields = { n = "num|0.25|strength" },
		needs = { "Lighting" },
		doc = "Light shafts spilling from the sun when you look towards it.",
		tags = "sunrays godrays light shafts effect" }

D{ id = "fxDepthOfField", cat = "camera", group = "Effects", label = "blur the distance",
		head = "blur anything past {distance} studs",
		code = {
			"do",
			'\tlocal dof = Lighting:FindFirstChild("Distance") or Instance.new("DepthOfFieldEffect")',
			'\tdof.Name = "Distance"',
			"\tdof.FarIntensity = {n}",
			"\tdof.FocusDistance = {distance}",
			"\tdof.Parent = Lighting",
			"end",
		},
		fields = { distance = "num|60|studs", n = "num|0.5|strength" },
		needs = { "Lighting" },
		doc = "Keeps what is near sharp and softens the rest, the way a real " ..
			"lens does.",
		tags = "depthoffield blur distance focus effect" }

D{ id = "fxHaze", cat = "camera", group = "Effects", label = "set the haze",
		head = "set the air haze to {n}",
		code = {
			"do",
			'\tlocal air = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")',
			"\tair.Haze = {n}",
			"\tair.Density = {density}",
			"\tair.Parent = Lighting",
			"end",
		},
		fields = { n = "num|1|haze", density = "num|0.35|density" },
		needs = { "Lighting" },
		doc = "Atmosphere is the modern replacement for fog and looks far better " ..
			"at a distance. Haze is how milky the air is.",
		tags = "atmosphere haze density air fog" }

-- glow ---------------------------------------------------------------------------
D{ id = "glowOutline", cat = "camera", group = "Glow", label = "outline an object",
		head = "outline {obj} in red {r} green {g} blue {b}",
		code = {
			"do",
			'\tlocal glow = Instance.new("Highlight")',
			"\t\tglow.FillColor = Color3.fromRGB({r}, {g}, {b})",
			"\tglow.OutlineColor = Color3.fromRGB({r}, {g}, {b})",
			"\tglow.FillTransparency = {fill}",
			"\tglow.Adornee = {obj}",
			"\tglow.Parent = {obj}",
			"end",
		},
		fields = { obj = "expr|part|object", r = "num|255|red", g = "num|200|green",
			b = "num|80|blue", fill = "num|0.7|fill see-through" },
		doc = "A Highlight draws through walls, which makes it the right way to " ..
			"show a quest target or a held object.",
		tags = "highlight outline glow selection through walls" }

D{ id = "glowRemove", cat = "camera", group = "Glow", label = "remove an outline",
		head = "remove any outline from {obj}",
		code = {
			"do",
			'\tlocal glow = {obj}:FindFirstChildOfClass("Highlight")',
			"\tif glow then",
			"\t\tglow:Destroy()",
			"\tend",
			"end",
		},
		fields = { obj = "expr|part|object" },
		doc = "Takes the highlight off again, and shrugs if there was not one.",
		tags = "highlight remove clear outline" }

D{ id = "glowLight", cat = "camera", group = "Glow", label = "put a light inside",
		head = "put a light inside {obj}, {range} studs of red {r} green {g} blue {b}",
		code = {
			"do",
			'\tlocal light = Instance.new("PointLight")',
			"\tlight.Range = {range}",
			"\tlight.Brightness = {brightness}",
			"\tlight.Color = Color3.fromRGB({r}, {g}, {b})",
			"\tlight.Parent = {obj}",
			"end",
		},
		fields = { obj = "expr|part|object", range = "num|16|range", brightness = "num|2|brightness",
			r = "num|255|red", g = "num|220|green", b = "num|170|blue" },
		doc = "A PointLight shines in every direction from the middle of the part.",
		tags = "pointlight lamp light glow torch" }

D{ id = "glowSpot", cat = "camera", group = "Glow", label = "put a spotlight inside",
		head = "put a spotlight inside {obj}, {range} studs at {angle} degrees",
		code = {
			"do",
			'\tlocal light = Instance.new("SpotLight")',
			"\tlight.Range = {range}",
			"\tlight.Angle = {angle}",
			"\tlight.Face = Enum.NormalId.{face}",
			"\tlight.Parent = {obj}",
			"end",
		},
		fields = { obj = "expr|part|object", range = "num|24|range", angle = "num|60|angle",
			face = "choice|Front|face|Front,Back,Top,Bottom,Left,Right" },
		doc = "A cone of light pointing out of one face. Torches and street " ..
			"lamps are spotlights.",
		tags = "spotlight cone torch lamp light" }

D{ id = "glowNeon", cat = "camera", group = "Glow", label = "make it glow",
		head = "make {obj} glow",
		code = "{obj}.Material = Enum.Material.Neon",
		fields = { obj = "expr|part|object" },
		doc = "Neon parts light themselves up. Combined with bloom they are how " ..
			"most glowing things in Roblox are made.",
		tags = "neon material glow bright" }

D{ id = "particleMake", cat = "camera", group = "Glow", label = "add particles",
		head = "make {name} = particles on {obj}, {rate} a second",
		code = {
			'local {name} = Instance.new("ParticleEmitter")',
			"{name}.Rate = {rate}",
			"{name}.Lifetime = NumberRange.new(0.4, 1)",
			"{name}.Speed = NumberRange.new(3, 6)",
			"{name}.Parent = {obj}",
		},
		fields = { name = "name|sparks|name", obj = "expr|part|object", rate = "num|20|per second" },
		doc = "Particles pour out of the part they are inside. A rate of 0 means " ..
			"none until you ask for a burst.",
		tags = "particleemitter particles sparks effect" }

D{ id = "particleBurst", cat = "camera", group = "Glow", label = "burst particles",
		head = "fire {n} particles from {emitter} right now",
		code = "{emitter}:Emit({n})",
		fields = { emitter = "expr|sparks|emitter", n = "num|30|how many" },
		doc = "One burst, whatever the rate is set to. Perfect for an impact or " ..
			"a pickup.",
		tags = "emit burst particles impact" }

D{ id = "particleSwitch", cat = "camera", group = "Glow", label = "turn particles on or off",
		head = "set {emitter} running to {value}",
		code = "{emitter}.Enabled = {value}",
		fields = { emitter = "expr|sparks|emitter", value = "choice|true|value|true,false" },
		doc = "Stops new particles without removing the ones already in the air.",
		tags = "enabled particles stop start" }

D{ id = "beamBetween", cat = "camera", group = "Glow", label = "draw a beam",
		head = "draw a beam from {a} to {b}",
		code = {
			"do",
			'\tlocal from = Instance.new("Attachment")',
			"\tfrom.Parent = {a}",
			'\tlocal to = Instance.new("Attachment")',
			"\tto.Parent = {b}",
			'\tlocal beam = Instance.new("Beam")',
			"\tbeam.Attachment0 = from",
			"\tbeam.Attachment1 = to",
			"\tbeam.Width0 = {width}",
			"\tbeam.Width1 = {width}",
			"\tbeam.Parent = {a}",
			"end",
		},
		fields = { a = "expr|partA|from", b = "expr|partB|to", width = "num|0.4|width" },
		doc = "Beams stretch between two attachments, so both parts get one. " ..
			"Lasers, ziplines and tethers are all beams.",
		tags = "beam laser link attachment line" }

D{ id = "trailBehind", cat = "camera", group = "Glow", label = "leave a trail",
		head = "leave a trail behind {obj} lasting {time} seconds",
		code = {
			"do",
			'\tlocal top = Instance.new("Attachment")',
			"\ttop.Position = Vector3.new(0, {spread}, 0)",
			"\ttop.Parent = {obj}",
			'\tlocal bottom = Instance.new("Attachment")',
			"\tbottom.Position = Vector3.new(0, -{spread}, 0)",
			"\tbottom.Parent = {obj}",
			'\tlocal trail = Instance.new("Trail")',
			"\ttrail.Attachment0 = top",
			"\ttrail.Attachment1 = bottom",
			"\ttrail.Lifetime = {time}",
			"\ttrail.Parent = {obj}",
			"end",
		},
		fields = { obj = "expr|part|object", time = "num|0.5|seconds", spread = "num|1|width" },
		doc = "A Trail needs two attachments to know how wide the ribbon is. " ..
			"Swords and fast-moving parts wear these.",
		tags = "trail ribbon motion streak attachment" }

--=============================================================================
-- SOUND
--=============================================================================

D{ id = "soundMake", cat = "sound", group = "Playing", label = "make a sound",
		head = "make {name} = a sound of {asset} inside {parent}",
		code = {
			'local {name} = Instance.new("Sound")',
			"{name}.SoundId = {asset}",
			"{name}.Volume = {volume}",
			"{name}.Parent = {parent}",
		},
		fields = { name = "name|sound|name", asset = "expr|\"rbxassetid://0\"|sound id",
			parent = "expr|script.Parent|parent", volume = "num|0.5|volume" },
		doc = "Where a sound lives decides who hears it: inside a part it comes " ..
			"from that place in the world, inside SoundService everyone hears it flat.",
		tags = "sound audio make new soundid" }

D{ id = "soundPlay", cat = "sound", group = "Playing", label = "play",
		head = "play {sound}",
		code = "{sound}:Play()",
		fields = { sound = "expr|sound|sound" },
		doc = "Starts from the beginning, or from wherever you left it if it was " ..
			"paused.",
		tags = "play start sound audio" }

D{ id = "soundStop", cat = "sound", group = "Playing", label = "stop",
		head = "stop {sound}",
		code = "{sound}:Stop()",
		fields = { sound = "expr|sound|sound" },
		doc = "Stops and rewinds to the start.",
		tags = "stop end sound audio" }

D{ id = "soundPause", cat = "sound", group = "Playing", label = "pause",
		head = "pause {sound}",
		code = "{sound}:Pause()",
		fields = { sound = "expr|sound|sound" },
		doc = "Holds it where it is, so playing again carries on from there.",
		tags = "pause hold sound audio" }

D{ id = "soundResume", cat = "sound", group = "Playing", label = "carry on",
		head = "carry on playing {sound}",
		code = "{sound}:Resume()",
		fields = { sound = "expr|sound|sound" },
		doc = "Continues a paused sound without starting it over.",
		tags = "resume continue sound audio" }

D{ id = "soundOneShot", cat = "sound", group = "Playing", label = "play once and tidy up",
		head = "play {asset} once from {parent}",
		code = {
			"do",
			'\tlocal sound = Instance.new("Sound")',
			"\tsound.SoundId = {asset}",
			"\tsound.Volume = {volume}",
			"\tsound.Parent = {parent}",
			"\tsound:Play()",
			"\tsound.Ended:Connect(function()",
			"\t\tsound:Destroy()",
			"\tend)",
			"end",
		},
		fields = { asset = "expr|\"rbxassetid://0\"|sound id", parent = "expr|script.Parent|parent",
			volume = "num|0.5|volume" },
		doc = "Makes the sound, plays it, and removes it when it finishes. The " ..
			"right way to do hit noises and pickups without littering.",
		tags = "oneshot play once destroy cleanup sound" }

D{ id = "soundRandom", cat = "sound", group = "Playing", label = "play a random one",
		head = "play a random sound from {list} on {parent}",
		code = {
			"do",
			'\tlocal sound = Instance.new("Sound")',
			"\tsound.SoundId = {list}[math.random(1, #{list})]",
			"\tsound.Parent = {parent}",
			"\tsound:Play()",
			"\tsound.Ended:Connect(function()",
			"\t\tsound:Destroy()",
			"\tend)",
			"end",
		},
		fields = { list = "expr|footsteps|list of ids", parent = "expr|script.Parent|parent" },
		doc = "Picking from a handful of takes stops a repeated noise sounding " ..
			"mechanical. Footsteps and hits want this.",
		tags = "random variation sound list footsteps" }

D{ id = "soundOnEnded", cat = "sound", group = "Playing", label = "on sound finished",
		head = "when {sound} finishes",
		code = "{sound}.Ended:Connect(function()", tail = "end)",
		fields = { sound = "expr|sound|sound" },
		slots = { { key = "body" } },
		doc = "Only fires when it reaches the end on its own, not when you stop " ..
			"it yourself.",
		tags = "ended finished sound event" }

D{ id = "soundWaitEnd", cat = "sound", group = "Playing", label = "wait for the end",
		head = "wait until {sound} finishes",
		code = "{sound}.Ended:Wait()",
		fields = { sound = "expr|sound|sound" },
		doc = "Pauses this script until the sound is done, which is how you play " ..
			"a queue of them in order.",
		tags = "wait ended sequence sound" }

D{ id = "soundIfPlaying", cat = "sound", group = "Playing", label = "if it is playing",
		head = "if {sound} is playing then",
		code = "if {sound}.IsPlaying then", tail = "end",
		fields = { sound = "expr|sound|sound" },
		slots = { { key = "body" } },
		doc = "Stops you starting a sound that is already going, which would cut " ..
			"it off and restart it.",
		tags = "isplaying check sound condition" }

-- adjusting ----------------------------------------------------------------------
D{ id = "soundVolume", cat = "sound", group = "Adjusting", label = "set the volume",
		head = "set the volume of {sound} to {n}",
		code = "{sound}.Volume = {n}",
		fields = { sound = "expr|sound|sound", n = "num|0.5|volume" },
		doc = "0.5 is a sensible full volume. Anything above 1 tends to distort.",
		tags = "volume loud quiet sound" }

D{ id = "soundSpeed", cat = "sound", group = "Adjusting", label = "set the speed",
		head = "set the speed of {sound} to {n}",
		code = "{sound}.PlaybackSpeed = {n}",
		fields = { sound = "expr|sound|sound", n = "num|1|speed" },
		doc = "1 is normal. Higher is faster and higher pitched -- a cheap way to " ..
			"make one sound into several.",
		tags = "playbackspeed pitch speed sound" }

D{ id = "soundLoop", cat = "sound", group = "Adjusting", label = "set repeating",
		head = "set {sound} to repeat: {value}",
		code = "{sound}.Looped = {value}",
		fields = { sound = "expr|sound|sound", value = "choice|true|value|true,false" },
		doc = "Looped sounds start again the moment they end. Music and engines " ..
			"want this; gunshots do not.",
		tags = "looped repeat music loop" }

D{ id = "soundSkipTo", cat = "sound", group = "Adjusting", label = "skip to",
		head = "skip {sound} to {n} seconds in",
		code = "{sound}.TimePosition = {n}",
		fields = { sound = "expr|sound|sound", n = "num|0|seconds" },
		doc = "Jumps to a point in the sound. Works while it plays or before you " ..
			"start it.",
		tags = "timeposition skip seek scrub" }

D{ id = "soundLeft", cat = "sound", group = "Adjusting", label = "how much is left",
		head = "make {name} = how many seconds of {sound} are left",
		code = "local {name} = {sound}.TimeLength - {sound}.TimePosition",
		fields = { name = "name|remaining|name", sound = "expr|sound|sound" },
		doc = "TimeLength is zero until the sound has loaded, so this can read " ..
			"oddly on the very first frame.",
		tags = "timelength remaining duration sound" }

D{ id = "soundFadeOut", cat = "sound", group = "Adjusting", label = "fade out",
		head = "fade {sound} out over {time} seconds",
		code = "TweenService:Create({sound}, TweenInfo.new({time}), { Volume = 0 }):Play()",
		fields = { sound = "expr|music|sound", time = "num|2|seconds" },
		needs = { "TweenService" },
		doc = "Slides the volume down to nothing. Stop it afterwards if you want " ..
			"it to actually end.",
		tags = "fade out volume tween music" }

D{ id = "soundFadeIn", cat = "sound", group = "Adjusting", label = "fade in",
		head = "fade {sound} in to {n} over {time} seconds",
		code = {
			"{sound}.Volume = 0",
			"{sound}:Play()",
			"TweenService:Create({sound}, TweenInfo.new({time}), { Volume = {n} }):Play()",
		},
		fields = { sound = "expr|music|sound", n = "num|0.5|volume", time = "num|2|seconds" },
		needs = { "TweenService" },
		doc = "Starts silent and rises. Much kinder than music appearing at full " ..
			"volume.",
		tags = "fade in volume tween music" }

-- where it comes from ---------------------------------------------------------------
D{ id = "soundRange", cat = "sound", group = "Where from", label = "set how far it carries",
		head = "let {sound} be heard up to {n} studs away",
		code = { "{sound}.RollOffMaxDistance = {n}", "{sound}.RollOffMinDistance = {near}" },
		fields = { sound = "expr|sound|sound", n = "num|60|studs", near = "num|10|full volume within" },
		doc = "A sound inside a part fades with distance. These two say where it " ..
			"is at full volume and where it disappears.",
		tags = "rolloff distance 3d spatial range" }

D{ id = "soundLocal", cat = "sound", group = "Where from", label = "play for this player only",
		head = "play {sound} for this player only",
		code = "SoundService:PlayLocalSound({sound})",
		fields = { sound = "expr|sound|sound" },
		needs = { "SoundService" },
		side = "client",
		doc = "Ignores where the sound is in the world and plays it flat, for " ..
			"this client alone. Interface noises want this.",
		tags = "playlocalsound client ui local sound" }

D{ id = "soundGroup", cat = "sound", group = "Where from", label = "make a sound group",
		head = 'make {name} = a sound group called "{label}"',
		code = {
			'local {name} = Instance.new("SoundGroup")',
			'{name}.Name = "{label}"',
			"{name}.Volume = {volume}",
			"{name}.Parent = SoundService",
		},
		fields = { name = "name|musicGroup|name", label = "str|Music|group name",
			volume = "num|1|volume" },
		needs = { "SoundService" },
		doc = "Groups let one slider control every sound in a category, which is " ..
			"how music and effects volumes are done properly.",
		tags = "soundgroup mixer volume category" }

D{ id = "soundJoinGroup", cat = "sound", group = "Where from", label = "put a sound in a group",
		head = "put {sound} in the group {group}",
		code = "{sound}.SoundGroup = {group}",
		fields = { sound = "expr|sound|sound", group = "expr|musicGroup|group" },
		doc = "The sound's own volume is multiplied by the group's, so both still " ..
			"work.",
		tags = "soundgroup assign mixer volume" }

D{ id = "soundGroupVolume", cat = "sound", group = "Where from", label = "set a group's volume",
		head = "set the volume of the group {group} to {n}",
		code = "{group}.Volume = {n}",
		fields = { group = "expr|musicGroup|group", n = "num|0.5|volume" },
		doc = "One line behind a whole volume slider.",
		tags = "soundgroup volume slider settings" }

D{ id = "soundEcho", cat = "sound", group = "Where from", label = "set the echo",
		head = "make the world sound like {place}",
		code = "SoundService.AmbientReverb = Enum.ReverbType.{place}",
		fields = { place = "choice|Cave|place|NoReverb,Room,Cave,Arena,Hangar,Forest,Underwater,Sewer,Mountains" },
		needs = { "SoundService" },
		doc = "Adds echo to everything at once. Switching it as a player walks " ..
			"into a cave costs nothing and sells the space.",
		tags = "reverb echo ambience cave underwater" }

D{ id = "soundStopAll", cat = "sound", group = "Where from", label = "stop every sound",
		head = "stop every sound inside {parent}",
		code = {
			"for _, sound in ipairs({parent}:GetDescendants()) do",
			'\tif sound:IsA("Sound") then',
			"\t\tsound:Stop()",
			"\tend",
			"end",
		},
		fields = { parent = "expr|workspace|where to look" },
		doc = "Walks everything below and silences any sound it finds. Handy " ..
			"between rounds.",
		tags = "stop all silence sounds descendants" }

D{ id = "soundPreload", cat = "sound", group = "Where from", label = "load before playing",
		head = "wait until {asset} has loaded",
		code = "ContentProvider:PreloadAsync({ {asset} })",
		fields = { asset = "expr|sound|what to load" },
		needs = { "ContentProvider" },
		doc = "Sounds and images stutter the first time they are used. Loading " ..
			"them during a loading screen avoids that.",
		tags = "preload contentprovider loading stutter" }

D{ id = "soundPlaylist", cat = "sound", group = "Where from", label = "play a playlist",
		head = "play the songs in {list} one after another on {sound}",
		code = {
			"task.spawn(function()",
			"\twhile true do",
			"\t\tfor _, id in ipairs({list}) do",
			"\t\t\t{sound}.SoundId = id",
			"\t\t\t{sound}:Play()",
			"\t\t\t{sound}.Ended:Wait()",
			"\t\tend",
			"\tend",
			"end)",
		},
		fields = { list = "expr|songs|list of ids", sound = "expr|music|sound to use" },
		doc = "Runs on its own thread so the rest of the script carries on, and " ..
			"starts the list again when it reaches the end.",
		tags = "playlist music queue loop songs" }

end
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX20">
			<Properties>
				<string name="Name">t</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- t  ·  block definitions: saving, networking, shop, places
--
-- Everything here happens on one side of the client/server line and not the
-- other, so most of these blocks carry a `side`.

return function(D)

--=============================================================================
-- SAVING
--=============================================================================

D{ id = "saveStore", cat = "save", group = "Opening a store", label = "open a save file",
		head = 'make {name} = the save file called "{store}"',
		code = 'local {name} = DataStoreService:GetDataStore("{store}")',
		fields = { name = "name|store|name", store = "str|PlayerData|file name" },
		needs = { "DataStoreService" }, side = "server",
		doc = "A data store is a filing cabinet that survives the server closing. " ..
			"Open it once at the top of your script, not every time you save.",
		tags = "datastore getdatastore save open store" }

D{ id = "saveOrderedStore", cat = "save", group = "Opening a store", label = "open a leaderboard file",
		head = 'make {name} = the leaderboard file called "{store}"',
		code = 'local {name} = DataStoreService:GetOrderedDataStore("{store}")',
		fields = { name = "name|board|name", store = "str|HighScores|file name" },
		needs = { "DataStoreService" }, side = "server",
		doc = "An ordered store only holds numbers, but it can hand back the top " ..
			"ten in order, which a normal store cannot.",
		tags = "ordereddatastore leaderboard high scores ranking" }

D{ id = "saveKeyFor", cat = "save", group = "Opening a store", label = "the key for a player",
		head = "make {name} = the save key for {player}",
		code = 'local {name} = "player_" .. {player}.UserId',
		fields = { name = "name|key|name", player = "expr|player|player" },
		doc = "Keys have to be text and have to be unique. A UserId never changes " ..
			"and is never reused, which a username cannot promise.",
		tags = "key userid player unique save" }

D{ id = "saveEnabled", cat = "save", group = "Opening a store", label = "if saving is available",
		head = "if saving is switched on then",
		code = "if not game:GetService(\"RunService\"):IsStudio() then", tail = "end",
		slots = { { key = "body" } },
		side = "server",
		doc = "Data stores do not work in Studio unless you switch on API access " ..
			"in Game Settings. This lets a script skip saving while you test.",
		tags = "studio api access enabled check save" }

-- reading ------------------------------------------------------------------------
D{ id = "saveLoad", cat = "save", group = "Reading", label = "load a value",
		head = "make {name} = what {store} saved for {key}",
		code = {
			"local {name} = nil",
			"do",
			"\tlocal ok, saved = pcall(function()",
			"\t\treturn {store}:GetAsync({key})",
			"\tend)",
			"\tif ok then",
			"\t\t{name} = saved",
			"\telse",
			'\t\twarn("could not load: " .. tostring(saved))',
			"\tend",
			"end",
		},
		fields = { name = "name|saved|name", store = "expr|store|store", key = "expr|key|key" },
		side = "server",
		doc = "Loading talks to Roblox's servers and can fail, so it is wrapped " ..
			"in a pcall. A player who has never played gets nil, not an error.",
		tags = "getasync load read pcall datastore" }

D{ id = "saveLoadOr", cat = "save", group = "Reading", label = "load with a fallback",
		head = "make {name} = what {store} saved for {key}, or {fallback}",
		code = {
			"local {name} = {fallback}",
			"do",
			"\tlocal ok, saved = pcall(function()",
			"\t\treturn {store}:GetAsync({key})",
			"\tend)",
			"\tif ok and saved ~= nil then",
			"\t\t{name} = saved",
			"\tend",
			"end",
		},
		fields = { name = "name|coins|name", store = "expr|store|store", key = "expr|key|key",
			fallback = "expr|0|starting value" },
		side = "server",
		doc = "The usual shape: new players start at the fallback, and a failed " ..
			"load leaves them there rather than at nil.",
		tags = "getasync default fallback new player load" }

D{ id = "saveFillDefaults", cat = "save", group = "Reading", label = "fill in missing settings",
		head = "give {data} anything missing from {defaults}",
		code = {
			"for key, value in pairs({defaults}) do",
			"\tif {data}[key] == nil then",
			"\t\t{data}[key] = value",
			"\tend",
			"end",
		},
		fields = { data = "expr|saved|loaded data", defaults = "expr|DEFAULTS|defaults" },
		doc = "When you add a new setting, old saves will not have it. This fills " ..
			"the gaps without touching what players already had.",
		tags = "defaults migration missing merge save" }

D{ id = "saveBudget", cat = "save", group = "Reading", label = "how many requests are left",
		head = "make {name} = how many saves are left this minute",
		code = "local {name} = DataStoreService:GetRequestBudgetForRequestType(" ..
			"Enum.DataStoreRequestType.SetIncrementAsync)",
		fields = { name = "name|budget|name" },
		needs = { "DataStoreService" }, side = "server",
		doc = "Roblox limits how often you may save. Checking the budget before " ..
			"a burst of saves avoids being throttled.",
		tags = "budget throttle limit requests datastore" }

-- writing ---------------------------------------------------------------------------
D{ id = "saveSet", cat = "save", group = "Writing", label = "save a value",
		head = "save {value} in {store} under {key}",
		code = {
			"do",
			"\tlocal ok, err = pcall(function()",
			"\t\t{store}:SetAsync({key}, {value})",
			"\tend)",
			"\tif not ok then",
			'\t\twarn("could not save: " .. tostring(err))',
			"\tend",
			"end",
		},
		fields = { store = "expr|store|store", key = "expr|key|key", value = "expr|coins|value" },
		side = "server",
		doc = "Overwrites whatever was there. Saving can fail, so it is wrapped " ..
			"and complains rather than killing the script.",
		tags = "setasync save write pcall datastore" }

D{ id = "saveChange", cat = "save", group = "Writing", label = "change a saved number",
		head = "change what {store} saved for {key} by {amount}",
		code = {
			"{store}:UpdateAsync({key}, function(old)",
			"\treturn (old or 0) + {amount}",
			"end)",
		},
		fields = { store = "expr|store|store", key = "expr|key|key", amount = "expr|1|amount" },
		side = "server",
		doc = "UpdateAsync reads and writes as one step, so two servers changing " ..
			"the same value cannot lose each other's work. Safer than load-then-save.",
		tags = "updateasync increment safe concurrent save" }

D{ id = "saveWipe", cat = "save", group = "Writing", label = "delete a save",
		head = "delete what {store} saved for {key}",
		code = {
			"pcall(function()",
			"\t{store}:RemoveAsync({key})",
			"end)",
		},
		fields = { store = "expr|store|store", key = "expr|key|key" },
		side = "server",
		doc = "Wipes one player's save completely. Worth having behind a reset " ..
			"button, and worth confirming first.",
		tags = "removeasync delete wipe reset save" }

D{ id = "saveRetry", cat = "save", group = "Writing", label = "save, retrying",
		head = "try up to {tries} times to save {value} in {store} under {key}",
		code = {
			"for attempt = 1, {tries} do",
			"\tlocal ok = pcall(function()",
			"\t\t{store}:SetAsync({key}, {value})",
			"\tend)",
			"\tif ok then",
			"\t\tbreak",
			"\tend",
			"\ttask.wait(attempt)",
			"end",
		},
		fields = { store = "expr|store|store", key = "expr|key|key", value = "expr|data|value",
			tries = "num|3|tries" },
		side = "server",
		doc = "Waits a little longer after each failure. A brief outage then " ..
			"costs nobody their progress.",
		tags = "retry backoff save reliability pcall" }

-- the usual shapes ---------------------------------------------------------------------
D{ id = "saveTable", cat = "save", group = "Patterns", label = "table of everyone's data",
		head = "make {name} = a table holding everyone's data",
		code = "local {name} = {}",
		fields = { name = "name|sessions|name" },
		side = "server",
		doc = "Keep each player's loaded data in memory and only touch the data " ..
			"store when they join and leave. Saving on every coin is far too often.",
		tags = "session cache memory table save" }

D{ id = "saveOnJoin", cat = "save", group = "Patterns", label = "load when a player joins",
		head = "when {player} joins, load their data from {store} into {into}",
		code = {
			"Players.PlayerAdded:Connect(function({player})",
			'\tlocal key = "player_" .. {player}.UserId',
			"\tlocal ok, saved = pcall(function()",
			"\t\treturn {store}:GetAsync(key)",
			"\tend)",
			"\t{into}[{player}] = ok and saved or {}",
			"end)",
		},
		fields = { player = "name|player|player", store = "expr|store|store",
			into = "expr|sessions|table to fill" },
		needs = { "Players" }, side = "server",
		doc = "The join half of the pattern. Everything afterwards reads from " ..
			"memory rather than from the data store.",
		tags = "playeradded load join session save" }

D{ id = "saveOnLeave", cat = "save", group = "Patterns", label = "save when a player leaves",
		head = "when {player} leaves, save {from} into {store}",
		code = {
			"Players.PlayerRemoving:Connect(function({player})",
			'\tlocal key = "player_" .. {player}.UserId',
			"\tpcall(function()",
			"\t\t{store}:SetAsync(key, {from}[{player}])",
			"\tend)",
			"\t{from}[{player}] = nil",
			"end)",
		},
		fields = { player = "name|player|player", store = "expr|store|store",
			from = "expr|sessions|table to save from" },
		needs = { "Players" }, side = "server",
		doc = "The leave half. Clearing the entry afterwards stops the table " ..
			"growing forever on a busy server.",
		tags = "playerremoving save leave session cleanup" }

D{ id = "saveOnClose", cat = "save", group = "Patterns", label = "save before shutdown",
		head = "before the server closes, save {from} into {store}",
		code = {
			"game:BindToClose(function()",
			"\tfor player, data in pairs({from}) do",
			"\t\tpcall(function()",
			'\t\t\t{store}:SetAsync("player_" .. player.UserId, data)',
			"\t\tend)",
			"\tend",
			"end)",
		},
		fields = { store = "expr|store|store", from = "expr|sessions|table to save from" },
		side = "server",
		doc = "When Roblox shuts a server down it gives you a few seconds. " ..
			"Without this, everyone still playing loses whatever they did last.",
		tags = "bindtoclose shutdown save server close" }

D{ id = "saveAutosave", cat = "save", group = "Patterns", label = "autosave loop",
		head = "save {from} into {store} every {seconds} seconds",
		code = {
			"task.spawn(function()",
			"\twhile true do",
			"\t\ttask.wait({seconds})",
			"\t\tfor player, data in pairs({from}) do",
			"\t\t\tpcall(function()",
			'\t\t\t\t{store}:SetAsync("player_" .. player.UserId, data)',
			"\t\t\tend)",
			"\t\tend",
			"\tend",
			"end)",
		},
		fields = { store = "expr|store|store", from = "expr|sessions|table to save from",
			seconds = "num|120|seconds" },
		side = "server",
		doc = "Insurance against a crash. Every two minutes is plenty; every ten " ..
			"seconds will hit Roblox's limits.",
		tags = "autosave loop periodic backup save" }

-- leaderboards -----------------------------------------------------------------------
D{ id = "saveScore", cat = "save", group = "Leaderboards", label = "record a score",
		head = "record {score} for {key} on the leaderboard {board}",
		code = {
			"pcall(function()",
			"\t{board}:SetAsync({key}, {score})",
			"end)",
		},
		fields = { board = "expr|board|leaderboard", key = "expr|key|key", score = "expr|score|score" },
		side = "server",
		doc = "Ordered stores only take whole numbers, so round anything with a " ..
			"decimal before recording it.",
		tags = "ordered leaderboard score record save" }

D{ id = "saveTopScores", cat = "save", group = "Leaderboards", label = "read the top scores",
		head = "for each place {rank} and entry {entry} in the top {count} of {board}",
		code = {
			"do",
			"\tlocal pages = {board}:GetSortedAsync(false, {count})",
			"\tfor {rank}, {entry} in ipairs(pages:GetCurrentPage()) do",
		},
		codeTail = { "\tend", "end" }, tail = "end",
		bodyIndent = 2,
		fields = { board = "expr|board|leaderboard", rank = "name|rank|place",
			entry = "name|entry", count = "num|10|how many" },
		slots = { { key = "body" } },
		side = "server",
		doc = "Each entry has a `key` and a `value`. `false` means highest first; " ..
			"pass true for a lowest-first board like fastest times.",
		tags = "getsortedasync top ten leaderboard ranking" }

--=============================================================================
-- NETWORKING
--=============================================================================

D{ id = "netMakeEvent", cat = "net", group = "Setting up", label = "make a message channel",
		head = 'make {name} = a message channel called "{label}"',
		code = {
			'local {name} = Instance.new("RemoteEvent")',
			'{name}.Name = "{label}"',
			"{name}.Parent = ReplicatedStorage",
		},
		fields = { name = "name|remote|name", label = "str|CoinCollected|channel name" },
		needs = { "ReplicatedStorage" }, side = "server",
		doc = "A RemoteEvent is a pipe between the server and the clients. Make " ..
			"it on the server, in ReplicatedStorage so both sides can see it.",
		tags = "remoteevent remote channel network make" }

D{ id = "netGetEvent", cat = "net", group = "Setting up", label = "find a message channel",
		head = 'make {name} = the message channel "{label}"',
		code = 'local {name} = ReplicatedStorage:WaitForChild("{label}")',
		fields = { name = "name|remote|name", label = "str|CoinCollected|channel name" },
		needs = { "ReplicatedStorage" },
		doc = "Waiting matters on the client, where the remote may not have " ..
			"arrived over the network yet.",
		tags = "waitforchild remote find channel" }

D{ id = "netMakeFunction", cat = "net", group = "Setting up", label = "make a question channel",
		head = 'make {name} = a question channel called "{label}"',
		code = {
			'local {name} = Instance.new("RemoteFunction")',
			'{name}.Name = "{label}"',
			"{name}.Parent = ReplicatedStorage",
		},
		fields = { name = "name|question|name", label = "str|GetShopStock|channel name" },
		needs = { "ReplicatedStorage" }, side = "server",
		doc = "A RemoteFunction is a remote that answers back. The asking side " ..
			"waits for the reply, so keep the work behind it short.",
		tags = "remotefunction question ask reply network" }

-- server side ---------------------------------------------------------------------------
D{ id = "netOnClientMessage", cat = "net", group = "On the server", label = "on a message from a client",
		head = "when a client sends on {remote}, with {player} and {args}",
		code = "{remote}.OnServerEvent:Connect(function({player}, {args})", tail = "end)",
		fields = { remote = "expr|remote|channel", player = "name|player|player",
			args = "params|amount|what they sent" },
		slots = { { key = "body" } },
		side = "server",
		doc = "Roblox fills in who sent it, and a client cannot lie about that. " ..
			"Everything after the player is theirs, and must be checked.",
		tags = "onserverevent receive message client network" }

D{ id = "netCheckSender", cat = "net", group = "On the server", label = "check what a client sent",
		head = "ignore this message unless {value} is a {kind}",
		code = 'if typeof({value}) ~= "{kind}" then return end',
		fields = { value = "expr|amount|value",
			kind = "choice|number|kind|number,string,boolean,Instance,Vector3,table" },
		side = "server",
		doc = "A client can send anything at all, including nothing. One line of " ..
			"checking stops most of the trouble that follows.",
		tags = "validate typeof security exploit check" }

D{ id = "netRateLimit", cat = "net", group = "On the server", label = "limit how often",
		head = "ignore {player} if they sent something within {seconds} seconds, tracked in {times}",
		code = {
			"do",
			"\tlocal now = os.clock()",
			"\tif {times}[{player}] and now - {times}[{player}] < {seconds} then",
			"\t\treturn",
			"\tend",
			"\t{times}[{player}] = now",
			"end",
		},
		fields = { player = "expr|player|player", times = "expr|lastSent|times table",
			seconds = "num|0.5|seconds" },
		side = "server",
		doc = "Stops a client firing a remote hundreds of times a second. Keep " ..
			"the times table next to the handler.",
		tags = "ratelimit cooldown spam exploit security" }

D{ id = "netToOne", cat = "net", group = "On the server", label = "send to one player",
		head = "send {args} to {player} on {remote}",
		code = "{remote}:FireClient({player}, {args})",
		fields = { remote = "expr|remote|channel", player = "expr|player|player",
			args = "expr|amount|what to send" },
		side = "server",
		doc = "Only that player's client hears it. Right for anything personal, " ..
			"like their own inventory.",
		tags = "fireclient send one player network" }

D{ id = "netToAll", cat = "net", group = "On the server", label = "send to everyone",
		head = "send {args} to everyone on {remote}",
		code = "{remote}:FireAllClients({args})",
		fields = { remote = "expr|remote|channel", args = "expr|message|what to send" },
		side = "server",
		doc = "Every client hears it. Right for announcements and world events, " ..
			"wasteful for anything one player cares about.",
		tags = "fireallclients broadcast everyone network" }

D{ id = "netToOthers", cat = "net", group = "On the server", label = "send to everyone else",
		head = "send {args} to everyone except {player} on {remote}",
		code = {
			"for _, other in ipairs(Players:GetPlayers()) do",
			"\tif other ~= {player} then",
			"\t\t{remote}:FireClient(other, {args})",
			"\tend",
			"end",
		},
		fields = { remote = "expr|remote|channel", player = "expr|player|player",
			args = "expr|message|what to send" },
		needs = { "Players" }, side = "server",
		doc = "There is no built-in call for this, so it is a loop. Useful when " ..
			"the sender has already seen the result on their own screen.",
		tags = "fireclient except others broadcast" }

D{ id = "netAnswer", cat = "net", group = "On the server", label = "answer a question",
		head = "when a client asks on {remote}, with {player} and {args}",
		code = "{remote}.OnServerInvoke = function({player}, {args})", tail = "end",
		fields = { remote = "expr|question|channel", player = "name|player|player",
			args = "params||what they asked" },
		slots = { { key = "body" } },
		side = "server",
		doc = "Give back a value with a `give back` block. Note this is an " ..
			"assignment, not a connection -- only one answerer is allowed.",
		tags = "onserverinvoke answer question reply" }

-- client side ------------------------------------------------------------------------
D{ id = "netOnServerMessage", cat = "net", group = "On the client", label = "on a message from the server",
		head = "when the server sends on {remote}, with {args}",
		code = "{remote}.OnClientEvent:Connect(function({args})", tail = "end)",
		fields = { remote = "expr|remote|channel", args = "params|amount|what was sent" },
		slots = { { key = "body" } },
		side = "client",
		doc = "There is no player argument here, because there is only one player " ..
			"on a client.",
		tags = "onclientevent receive server message" }

D{ id = "netToServer", cat = "net", group = "On the client", label = "send to the server",
		head = "send {args} to the server on {remote}",
		code = "{remote}:FireServer({args})",
		fields = { remote = "expr|remote|channel", args = "expr|amount|what to send" },
		side = "client",
		doc = "Ask, never tell. Send `I pressed the buy button`, not `give me the " ..
			"sword` -- the server decides.",
		tags = "fireserver send request client" }

D{ id = "netAsk", cat = "net", group = "On the client", label = "ask the server",
		head = "make {name} = the server's answer to {args} on {remote}",
		code = "local {name} = {remote}:InvokeServer({args})",
		fields = { name = "name|answer|name", remote = "expr|question|channel",
			args = "expr||what to ask" },
		side = "client",
		doc = "This waits for the reply, so the rest of the script stops until " ..
			"the server answers. Never do it every frame.",
		tags = "invokeserver ask wait answer client" }

-- inside one side -----------------------------------------------------------------------
D{ id = "netBindable", cat = "net", group = "Same side", label = "make an in-house channel",
		head = 'make {name} = an in-house channel called "{label}"',
		code = {
			'local {name} = Instance.new("BindableEvent")',
			'{name}.Name = "{label}"',
			"{name}.Parent = {parent}",
		},
		fields = { name = "name|signal|name", label = "str|RoundStarted|channel name",
			parent = "expr|script.Parent|parent" },
		doc = "A BindableEvent connects two scripts on the same side. No network " ..
			"is involved, so it is instant and cannot be exploited.",
		tags = "bindableevent signal same side script" }

D{ id = "netBindableFire", cat = "net", group = "Same side", label = "fire an in-house channel",
		head = "fire {signal} with {args}",
		code = "{signal}:Fire({args})",
		fields = { signal = "expr|signal|channel", args = "expr||what to send" },
		doc = "Everything connected to it runs, in the order it connected.",
		tags = "bindable fire signal trigger" }

D{ id = "netBindableOn", cat = "net", group = "Same side", label = "on an in-house channel",
		head = "when {signal} fires with {args}",
		code = "{signal}.Event:Connect(function({args})", tail = "end)",
		fields = { signal = "expr|signal|channel", args = "params||what was sent" },
		slots = { { key = "body" } },
		doc = "Note the `.Event` -- a BindableEvent keeps its signal in a child " ..
			"property, unlike a RemoteEvent.",
		tags = "bindable event connect listen" }

D{ id = "netAmServer", cat = "net", group = "Same side", label = "if this is the server",
		head = "if this is running on the server then",
		code = "if RunService:IsServer() then", tail = "end",
		slots = { { key = "body" } },
		needs = { "RunService" },
		doc = "Lets one ModuleScript behave differently depending on which side " ..
			"required it.",
		tags = "isserver check side runservice" }

D{ id = "netAmClient", cat = "net", group = "Same side", label = "if this is a client",
		head = "if this is running on a client then",
		code = "if RunService:IsClient() then", tail = "end",
		slots = { { key = "body" } },
		needs = { "RunService" },
		doc = "The other half of the pair, for shared modules.",
		tags = "isclient check side runservice" }

--=============================================================================
-- SHOP
--=============================================================================

D{ id = "shopAskPass", cat = "shop", group = "Passes", label = "offer a pass",
		head = "ask {player} to buy pass {id}",
		code = "MarketplaceService:PromptGamePassPurchase({player}, {id})",
		fields = { player = "expr|player|player", id = "num|0|pass id" },
		needs = { "MarketplaceService" },
		doc = "Opens Roblox's own buy window. You never handle the money -- you " ..
			"only react afterwards.",
		tags = "gamepass prompt purchase buy shop" }

D{ id = "shopOwnsPass", cat = "shop", group = "Passes", label = "if they own a pass",
		head = "if {player} owns pass {id} then",
		code = "if MarketplaceService:UserOwnsGamePassAsync({player}.UserId, {id}) then",
		tail = "end",
		fields = { player = "expr|player|player", id = "num|0|pass id" },
		slots = { { key = "body" } },
		needs = { "MarketplaceService" }, side = "server",
		doc = "This asks Roblox and waits for the answer, so it can be slow and " ..
			"can fail. Check once when they join rather than every frame.",
		tags = "userownsgamepass owns pass check shop" }

D{ id = "shopOnPassBought", cat = "shop", group = "Passes", label = "on a pass bought",
		head = "when {player} finishes the pass window, with pass {id} and {bought}",
		code = "MarketplaceService.PromptGamePassPurchaseFinished:Connect(" ..
			"function({player}, {id}, {bought})",
		tail = "end)",
		fields = { player = "name|player|player", id = "name|passId|pass id",
			bought = "name|wasBought|did they buy" },
		slots = { { key = "body" } },
		needs = { "MarketplaceService" }, side = "server",
		doc = "Fires whether they bought it or closed the window, so check the " ..
			"last value before handing anything over.",
		tags = "promptgamepasspurchasefinished bought pass event" }

D{ id = "shopGrantForPass", cat = "shop", group = "Passes", label = "give something for a pass",
		head = "when {player} joins, if they own pass {id}",
		code = {
			"Players.PlayerAdded:Connect(function({player})",
			"\tlocal ok, owns = pcall(function()",
			"\t\treturn MarketplaceService:UserOwnsGamePassAsync({player}.UserId, {id})",
			"\tend)",
			"\tif ok and owns then",
		},
		codeTail = { "\tend", "end)" }, tail = "end",
		bodyIndent = 2,
		fields = { player = "name|player|player", id = "num|0|pass id" },
		slots = { { key = "body" } },
		needs = { "MarketplaceService", "Players" }, side = "server",
		doc = "The whole shape of a pass perk: check on join, wrapped so a " ..
			"network hiccup cannot kill the script.",
		tags = "gamepass perk join grant owns" }

D{ id = "shopAskProduct", cat = "shop", group = "Products", label = "offer a product",
		head = "ask {player} to buy product {id}",
		code = "MarketplaceService:PromptProductPurchase({player}, {id})",
		fields = { player = "expr|player|player", id = "num|0|product id" },
		needs = { "MarketplaceService" },
		doc = "Developer products can be bought over and over, unlike passes. " ..
			"Coins and revives are products.",
		tags = "developer product prompt purchase repeat" }

D{ id = "shopOnProductBought", cat = "shop", group = "Products", label = "on a product bought",
		head = "when a product is bought, as {receipt} by {player}",
		code = {
			"MarketplaceService.ProcessReceipt = function({receipt})",
			"\tlocal {player} = Players:GetPlayerByUserId({receipt}.PlayerId)",
			"\tif not {player} then",
			"\t\treturn Enum.ProductPurchaseDecision.NotProcessedYet",
			"\tend",
		},
		codeTail = { "\treturn Enum.ProductPurchaseDecision.PurchaseGranted", "end" },
		tail = "end",
		fields = { receipt = "name|receipt|receipt", player = "name|player|player" },
		slots = { { key = "body" } },
		needs = { "MarketplaceService", "Players" }, side = "server",
		doc = "Roblox keeps asking until you say the purchase was granted, so a " ..
			"player who leaves mid-purchase still gets their goods next time. " ..
			"`receipt.ProductId` says which product it was.",
		tags = "processreceipt product purchase receipt grant" }

D{ id = "shopWhichProduct", cat = "shop", group = "Products", label = "if it was this product",
		head = "if {receipt} is for product {id} then",
		code = "if {receipt}.ProductId == {id} then", tail = "end",
		fields = { receipt = "expr|receipt|receipt", id = "num|0|product id" },
		slots = { { key = "body" } },
		side = "server",
		doc = "Goes inside the product handler, one branch per product you sell.",
		tags = "productid receipt branch product" }

D{ id = "shopProductInfo", cat = "shop", group = "Prices", label = "look up an item",
		head = "make {name} = the details of {kind} {id}",
		code = "local {name} = MarketplaceService:GetProductInfo({id}, Enum.InfoType.{kind})",
		fields = { name = "name|info|name", id = "num|0|id",
			kind = "choice|GamePass|kind|GamePass,Product,Asset" },
		needs = { "MarketplaceService" },
		doc = "Gives back a table with `Name`, `Description` and `PriceInRobux`, " ..
			"so a shop can build itself from the ids alone.",
		tags = "getproductinfo price name description shop" }

D{ id = "shopPrice", cat = "shop", group = "Prices", label = "the price of something",
		head = "make {name} = the price of {kind} {id}",
		code = "local {name} = MarketplaceService:GetProductInfo({id}, " ..
			"Enum.InfoType.{kind}).PriceInRobux",
		fields = { name = "name|price|name", id = "num|0|id",
			kind = "choice|GamePass|kind|GamePass,Product,Asset" },
		needs = { "MarketplaceService" },
		doc = "Reading the price rather than typing it means your shop is never " ..
			"out of date with what Roblox charges.",
		tags = "price robux cost shop" }

D{ id = "shopOwnsAsset", cat = "shop", group = "Prices", label = "if they own an asset",
		head = "if {player} owns asset {id} then",
		code = "if MarketplaceService:PlayerOwnsAsset({player}, {id}) then", tail = "end",
		fields = { player = "expr|player|player", id = "num|0|asset id" },
		slots = { { key = "body" } },
		needs = { "MarketplaceService" }, side = "server",
		doc = "Covers shirts, hats and models rather than passes. Useful for " ..
			"rewarding people who own your merchandise.",
		tags = "playerownsasset owns asset merch check" }

D{ id = "shopIsPremium", cat = "shop", group = "Prices", label = "if they have Premium",
		head = "if {player} has Roblox Premium then",
		code = "if {player}.MembershipType == Enum.MembershipType.Premium then", tail = "end",
		fields = { player = "expr|player|player" },
		slots = { { key = "body" } },
		doc = "Reading their membership costs nothing and never fails, unlike " ..
			"asking about a pass.",
		tags = "premium membership check benefit" }

D{ id = "shopAskPremium", cat = "shop", group = "Prices", label = "offer Premium",
		head = "show {player} the Premium window",
		code = "MarketplaceService:PromptPremiumPurchase({player})",
		fields = { player = "expr|player|player" },
		needs = { "MarketplaceService" },
		doc = "Opens Roblox's Premium page. Worth offering only where a Premium " ..
			"perk is actually visible.",
		tags = "premium prompt purchase upsell" }

D{ id = "shopAwardBadge", cat = "shop", group = "Badges", label = "award a badge",
		head = "award badge {id} to {player}",
		code = {
			"pcall(function()",
			"\tBadgeService:AwardBadge({player}.UserId, {id})",
			"end)",
		},
		fields = { player = "expr|player|player", id = "num|0|badge id" },
		needs = { "BadgeService" }, side = "server",
		doc = "Badges are free to award and show on a player's profile. Awarding " ..
			"one they already have does nothing.",
		tags = "badge award achievement profile" }

D{ id = "shopHasBadge", cat = "shop", group = "Badges", label = "if they have a badge",
		head = "if {player} already has badge {id} then",
		code = "if BadgeService:UserHasBadgeAsync({player}.UserId, {id}) then", tail = "end",
		fields = { player = "expr|player|player", id = "num|0|badge id" },
		slots = { { key = "body" } },
		needs = { "BadgeService" }, side = "server",
		doc = "Waits for Roblox to answer, so check it once on join rather than " ..
			"in a loop.",
		tags = "badge check has achievement" }

--=============================================================================
-- PLACES
--=============================================================================

D{ id = "placeSend", cat = "place", group = "Going somewhere", label = "send to another place",
		head = "send {player} to place {id}",
		code = "TeleportService:Teleport({id}, {player})",
		fields = { player = "expr|player|player", id = "num|0|place id" },
		needs = { "TeleportService" }, side = "server",
		doc = "Place ids come from the URL of a place in your experience. The " ..
			"player sees a loading screen and arrives in the other place.",
		tags = "teleport place send travel" }

D{ id = "placeSendMany", cat = "place", group = "Going somewhere", label = "send a group together",
		head = "send {list} to place {id} together",
		code = "TeleportService:TeleportPartyAsync({id}, {list})",
		fields = { list = "expr|team|list of players", id = "num|0|place id" },
		needs = { "TeleportService" }, side = "server",
		doc = "Everyone in the list lands in the same server, which is how a " ..
			"party stays together through a lobby.",
		tags = "teleportparty group together lobby" }

D{ id = "placeSendWith", cat = "place", group = "Going somewhere", label = "send with a message",
		head = "send {player} to place {id} carrying {data}",
		code = {
			"do",
			'\tlocal options = Instance.new("TeleportOptions")',
			"\toptions:SetTeleportData({data})",
			"\tTeleportService:TeleportAsync({id}, { {player} }, options)",
			"end",
		},
		fields = { player = "expr|player|player", id = "num|0|place id",
			data = "expr|{ score = 10 }|data to carry" },
		needs = { "TeleportService" }, side = "server",
		doc = "Teleport data travels with the player, which is how a lobby tells " ..
			"the next place what they chose. Never send anything cheatable.",
		tags = "teleportdata options carry data lobby" }

D{ id = "placeArrivedWith", cat = "place", group = "Going somewhere", label = "what they arrived with",
		head = "make {name} = the data {player} arrived with",
		code = "local {name} = {player}:GetJoinData().TeleportData",
		fields = { name = "name|arrived|name", player = "expr|player|player" },
		side = "server",
		doc = "Nil for anyone who joined normally rather than through a teleport, " ..
			"so always check before using it.",
		tags = "getjoindata teleportdata arrive receive" }

D{ id = "placeReserve", cat = "place", group = "Private servers", label = "reserve a server",
		head = "make {name} = a fresh private server for place {id}",
		code = "local {name} = TeleportService:ReserveServer({id})",
		fields = { name = "name|code|name", id = "num|0|place id" },
		needs = { "TeleportService" }, side = "server",
		doc = "Gives back a code for a server nobody else can join by accident. " ..
			"Matches and dungeons are built on these.",
		tags = "reserveserver private match dungeon" }

D{ id = "placeSendToReserved", cat = "place", group = "Private servers", label = "send to a reserved server",
		head = "send {list} to the reserved server {code} of place {id}",
		code = "TeleportService:TeleportToPrivateServer({id}, {code}, {list})",
		fields = { list = "expr|team|list of players", code = "expr|code|server code",
			id = "num|0|place id" },
		needs = { "TeleportService" }, side = "server",
		doc = "Everyone given the same code lands in the same private server.",
		tags = "teleporttoprivateserver reserved match private" }

D{ id = "placeIsPrivate", cat = "place", group = "Private servers", label = "if this is private",
		head = "if this server is private then",
		code = 'if game.PrivateServerId ~= "" then', tail = "end",
		slots = { { key = "body" } },
		doc = "True in both reserved servers and in private servers a player " ..
			"paid for. Check the owner id to tell them apart.",
		tags = "privateserverid private reserved check" }

D{ id = "placeOnSendFailed", cat = "place", group = "Private servers", label = "on a teleport failing",
		head = "when a teleport fails, with {player}, {reason} and {message}",
		code = "TeleportService.TeleportInitFailed:Connect(function({player}, {reason}, {message})",
		tail = "end)",
		fields = { player = "name|player|player", reason = "name|reason|reason",
			message = "name|message|message" },
		slots = { { key = "body" } },
		needs = { "TeleportService" }, side = "server",
		doc = "Teleports fail more often than you would think -- full servers, " ..
			"flood checks. Without this the player is left standing there.",
		tags = "teleportinitfailed error retry failure" }

D{ id = "placeRetrySend", cat = "place", group = "Private servers", label = "send, retrying",
		head = "try up to {tries} times to send {player} to place {id}",
		code = {
			"for attempt = 1, {tries} do",
			"\tlocal ok = pcall(function()",
			"\t\tTeleportService:TeleportAsync({id}, { {player} })",
			"\tend)",
			"\tif ok then",
			"\t\tbreak",
			"\tend",
			"\ttask.wait(attempt * 2)",
			"end",
		},
		fields = { player = "expr|player|player", id = "num|0|place id", tries = "num|3|tries" },
		needs = { "TeleportService" }, side = "server",
		doc = "Waiting longer after each failure gets past Roblox's flood checks, " ..
			"which are the usual cause.",
		tags = "teleport retry backoff reliability" }

D{ id = "placeServerId", cat = "place", group = "This server", label = "this server's id",
		head = "make {name} = this server's id",
		code = "local {name} = game.JobId",
		fields = { name = "name|serverId|name" },
		doc = "Unique to this running server. Empty in Studio, which is a handy " ..
			"way to tell you are testing.",
		tags = "jobid server id unique" }

D{ id = "placeId", cat = "place", group = "This server", label = "this place's id",
		head = "make {name} = this place's id",
		code = "local {name} = game.PlaceId",
		fields = { name = "name|placeId|name" },
		doc = "The id of the place this server is running. Compare it to a " ..
			"teleport target to avoid sending someone where they already are.",
		tags = "placeid place id current" }

D{ id = "placeHowManyHere", cat = "place", group = "This server", label = "how many are here",
		head = "make {name} = how many players are here",
		code = "local {name} = #Players:GetPlayers()",
		fields = { name = "name|here|name" },
		needs = { "Players" },
		doc = "Counts everyone currently connected to this server, not to the " ..
			"whole experience.",
		tags = "count players server population" }

D{ id = "placeRoom", cat = "place", group = "This server", label = "how many can fit",
		head = "make {name} = how many players can fit here",
		code = "local {name} = Players.MaxPlayers",
		fields = { name = "name|room|name" },
		needs = { "Players" },
		doc = "The server's cap, set in Game Settings. Compare with the count to " ..
			"know whether there is room for a party.",
		tags = "maxplayers capacity room server" }

D{ id = "placeUptime", cat = "place", group = "This server", label = "how long this server has run",
		head = "make {name} = how many seconds this server has been running",
		code = "local {name} = workspace.DistributedGameTime",
		fields = { name = "name|uptime|name" },
		doc = "Counts from when the server started, and is the same number for " ..
			"everybody in it.",
		tags = "uptime distributedgametime server clock" }

D{ id = "placeShutdownWarning", cat = "place", group = "This server", label = "warn before shutdown",
		head = "before the server closes, tell everyone",
		code = {
			"game:BindToClose(function()",
			"\tfor _, player in ipairs(Players:GetPlayers()) do",
			"\t\tpcall(function()",
			'\t\t\tplayer:Kick("This server is shutting down. Rejoin to keep playing.")',
			"\t\tend)",
			"\tend",
			"\ttask.wait({seconds})",
			"end)",
		},
		fields = { seconds = "num|3|seconds to wait" },
		needs = { "Players" }, side = "server",
		doc = "Roblox gives a closing server a few seconds. Using them to explain " ..
			"beats a silent disconnect.",
		tags = "bindtoclose shutdown kick warn close" }

end
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX21">
			<Properties>
				<string name="Name">u</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- u  ·  block definitions: physics, animation, NPCs, terrain
--
-- The movers here are the current ones -- LinearVelocity, AlignPosition,
-- VectorForce -- rather than the BodyVelocity family Roblox has retired.

return function(D)

--=============================================================================
-- PHYSICS
--=============================================================================

D{ id = "physPush", cat = "phys", group = "Moving things", label = "shove once",
		head = "shove {part} by ({x}, {y}, {z})",
		code = "{part}:ApplyImpulse(Vector3.new({x}, {y}, {z}))",
		fields = { part = "expr|part|part", x = "expr|0|x", y = "expr|50|y", z = "expr|0|z" },
		doc = "One instant kick, measured in mass times studs per second. Heavier " ..
			"parts need a bigger number for the same effect.",
		tags = "applyimpulse push launch knockback jump" }

D{ id = "physSpin", cat = "phys", group = "Moving things", label = "spin once",
		head = "spin {part} by ({x}, {y}, {z})",
		code = "{part}:ApplyAngularImpulse(Vector3.new({x}, {y}, {z}))",
		fields = { part = "expr|part|part", x = "expr|0|x", y = "expr|10|y", z = "expr|0|z" },
		doc = "The turning version of a shove. Each number is a spin around that " ..
			"axis.",
		tags = "angular impulse spin rotate torque" }

D{ id = "physSetSpeed", cat = "phys", group = "Moving things", label = "set the speed",
		head = "set the speed of {part} to ({x}, {y}, {z})",
		code = "{part}.AssemblyLinearVelocity = Vector3.new({x}, {y}, {z})",
		fields = { part = "expr|part|part", x = "expr|0|x", y = "expr|50|y", z = "expr|0|z" },
		doc = "Replaces whatever speed it had. Setting the upward part alone is " ..
			"how a jump pad works.",
		tags = "velocity speed assembly launch pad" }

D{ id = "physKeepMoving", cat = "phys", group = "Moving things", label = "keep it moving",
		head = "keep {part} moving at ({x}, {y}, {z})",
		code = {
			"do",
			'\tlocal spot = Instance.new("Attachment")',
			"\tspot.Parent = {part}",
			'\tlocal mover = Instance.new("LinearVelocity")',
			"\tmover.Attachment0 = spot",
			"\tmover.VectorVelocity = Vector3.new({x}, {y}, {z})",
			"\tmover.MaxForce = {force}",
			"\tmover.Parent = {part}",
			"end",
		},
		fields = { part = "expr|part|part", x = "expr|0|x", y = "expr|0|y", z = "expr|20|z",
			force = "num|100000|strength" },
		doc = "A LinearVelocity keeps pushing rather than kicking once. This is " ..
			"the modern replacement for BodyVelocity.",
		tags = "linearvelocity constant move conveyor mover" }

D{ id = "physKeepSpinning", cat = "phys", group = "Moving things", label = "keep it spinning",
		head = "keep {part} spinning at {speed} around its {axis} axis",
		code = {
			"do",
			'\tlocal spot = Instance.new("Attachment")',
			"\tspot.Parent = {part}",
			'\tlocal spin = Instance.new("AngularVelocity")',
			"\tspin.Attachment0 = spot",
			"\tspin.AngularVelocity = Vector3.{axis} * {speed}",
			"\tspin.MaxTorque = {force}",
			"\tspin.Parent = {part}",
			"end",
		},
		fields = { part = "expr|part|part", speed = "num|3|speed",
			axis = "choice|yAxis|axis|xAxis,yAxis,zAxis", force = "num|100000|strength" },
		doc = "Turntables, windmills and spinning traps. The Y axis is upright, " ..
			"so most things spin around that.",
		tags = "angularvelocity spin rotate turntable" }

D{ id = "physHoldAt", cat = "phys", group = "Moving things", label = "hold it in place",
		head = "hold {part} at ({x}, {y}, {z})",
		code = {
			"do",
			'\tlocal spot = Instance.new("Attachment")',
			"\tspot.Parent = {part}",
			'\tlocal hold = Instance.new("AlignPosition")',
			"\thold.Attachment0 = spot",
			"\thold.Mode = Enum.PositionAlignmentMode.OneAttachment",
			"\thold.Position = Vector3.new({x}, {y}, {z})",
			"\thold.MaxForce = {force}",
			"\thold.Responsiveness = {snap}",
			"\thold.Parent = {part}",
			"end",
		},
		fields = { part = "expr|part|part", x = "expr|0|x", y = "expr|10|y", z = "expr|0|z",
			force = "num|100000|strength", snap = "num|25|snappiness" },
		doc = "Pulls the part towards a point and keeps it there, still able to " ..
			"be knocked about. Higher snappiness is stiffer.",
		tags = "alignposition hold float hover follow" }

D{ id = "physFaceDirection", cat = "phys", group = "Moving things", label = "hold its facing",
		head = "keep {part} facing the same way",
		code = {
			"do",
			'\tlocal spot = Instance.new("Attachment")',
			"\tspot.Parent = {part}",
			'\tlocal face = Instance.new("AlignOrientation")',
			"\tface.Attachment0 = spot",
			"\tface.Mode = Enum.OrientationAlignmentMode.OneAttachment",
			"\tface.CFrame = {part}.CFrame",
			"\tface.MaxTorque = {force}",
			"\tface.Parent = {part}",
			"end",
		},
		fields = { part = "expr|part|part", force = "num|100000|strength" },
		doc = "Stops something tipping over without anchoring it, so it can still " ..
			"be pushed around.",
		tags = "alignorientation upright facing stable" }

D{ id = "physForce", cat = "phys", group = "Moving things", label = "apply a steady force",
		head = "push {part} steadily by ({x}, {y}, {z})",
		code = {
			"do",
			'\tlocal spot = Instance.new("Attachment")',
			"\tspot.Parent = {part}",
			'\tlocal push = Instance.new("VectorForce")',
			"\tpush.Attachment0 = spot",
			"\tpush.Force = Vector3.new({x}, {y}, {z})",
			"\tpush.RelativeTo = Enum.ActuatorRelativeTo.World",
			"\tpush.Parent = {part}",
			"end",
		},
		fields = { part = "expr|part|part", x = "expr|0|x", y = "expr|0|y", z = "expr|0|z" },
		doc = "A force fights gravity and friction rather than overriding them. " ..
			"To hover, the upward force must beat mass times gravity.",
		tags = "vectorforce force push thrust hover" }

D{ id = "physStop", cat = "phys", group = "Moving things", label = "stop it dead",
		head = "stop {part} moving",
		code = {
			"{part}.AssemblyLinearVelocity = Vector3.zero",
			"{part}.AssemblyAngularVelocity = Vector3.zero",
		},
		fields = { part = "expr|part|part" },
		doc = "Clears both the movement and the spin. Without the second line a " ..
			"stopped part can still be tumbling.",
		tags = "stop velocity zero halt freeze" }

-- joints ---------------------------------------------------------------------------
D{ id = "physWeld", cat = "phys", group = "Joints", label = "stick together",
		head = "stick {a} to {b}",
		code = {
			"do",
			'\tlocal weld = Instance.new("WeldConstraint")',
			"\tweld.Part0 = {a}",
			"\tweld.Part1 = {b}",
			"\tweld.Parent = {a}",
			"end",
		},
		fields = { a = "expr|partA|first", b = "expr|partB|second" },
		doc = "A WeldConstraint locks two parts together wherever they are when " ..
			"you make it. Move them into place first.",
		tags = "weldconstraint weld stick join attach" }

D{ id = "physUnweld", cat = "phys", group = "Joints", label = "unstick",
		head = "unstick everything welded to {part}",
		code = {
			"for _, joint in ipairs({part}:GetChildren()) do",
			'\tif joint:IsA("WeldConstraint") then',
			"\t\tjoint:Destroy()",
			"\tend",
			"end",
		},
		fields = { part = "expr|part|part" },
		doc = "Removes the welds this part is holding, letting whatever was stuck " ..
			"to it fall away.",
		tags = "unweld break destroy joint separate" }

D{ id = "physHinge", cat = "phys", group = "Joints", label = "make a hinge",
		head = "hinge {a} to {b}",
		code = {
			"do",
			'\tlocal one = Instance.new("Attachment")',
			"\tone.Parent = {a}",
			'\tlocal two = Instance.new("Attachment")',
			"\ttwo.Parent = {b}",
			'\tlocal hinge = Instance.new("HingeConstraint")',
			"\thinge.Attachment0 = one",
			"\thinge.Attachment1 = two",
			"\thinge.Parent = {a}",
			"end",
		},
		fields = { a = "expr|door|first", b = "expr|frame|second" },
		doc = "Lets one part swing around a line through both attachments. Doors " ..
			"and levers are hinges.",
		tags = "hingeconstraint hinge door swing pivot" }

D{ id = "physMotor", cat = "phys", group = "Joints", label = "make a powered hinge",
		head = "hinge {a} to {b} and drive it at {speed}",
		code = {
			"do",
			'\tlocal one = Instance.new("Attachment")',
			"\tone.Parent = {a}",
			'\tlocal two = Instance.new("Attachment")',
			"\ttwo.Parent = {b}",
			'\tlocal motor = Instance.new("HingeConstraint")',
			"\tmotor.Attachment0 = one",
			"\tmotor.Attachment1 = two",
			"\tmotor.ActuatorType = Enum.ActuatorType.Motor",
			"\tmotor.AngularVelocity = {speed}",
			"\tmotor.MotorMaxTorque = {force}",
			"\tmotor.Parent = {a}",
			"end",
		},
		fields = { a = "expr|wheel|first", b = "expr|axle|second", speed = "num|5|speed",
			force = "num|10000|strength" },
		doc = "A hinge with a motor in it. Wheels, conveyor rollers and automatic " ..
			"doors all run on these.",
		tags = "motor hinge wheel drive powered" }

D{ id = "physRope", cat = "phys", group = "Joints", label = "tie a rope",
		head = "tie {a} to {b} with a rope {length} studs long",
		code = {
			"do",
			'\tlocal one = Instance.new("Attachment")',
			"\tone.Parent = {a}",
			'\tlocal two = Instance.new("Attachment")',
			"\ttwo.Parent = {b}",
			'\tlocal rope = Instance.new("RopeConstraint")',
			"\trope.Attachment0 = one",
			"\trope.Attachment1 = two",
			"\trope.Length = {length}",
			"\trope.Visible = true",
			"\trope.Parent = {a}",
			"end",
		},
		fields = { a = "expr|anchor|first", b = "expr|weight|second", length = "num|10|length" },
		doc = "A rope stops the parts drifting further apart than its length, but " ..
			"lets them come closer. Swings and tows are ropes.",
		tags = "ropeconstraint rope tether swing tow" }

D{ id = "physSpring", cat = "phys", group = "Joints", label = "add a spring",
		head = "spring {a} to {b}, {length} studs at rest",
		code = {
			"do",
			'\tlocal one = Instance.new("Attachment")',
			"\tone.Parent = {a}",
			'\tlocal two = Instance.new("Attachment")',
			"\ttwo.Parent = {b}",
			'\tlocal spring = Instance.new("SpringConstraint")',
			"\tspring.Attachment0 = one",
			"\tspring.Attachment1 = two",
			"\tspring.FreeLength = {length}",
			"\tspring.Stiffness = {stiffness}",
			"\tspring.Damping = {damping}",
			"\tspring.Parent = {a}",
			"end",
		},
		fields = { a = "expr|body|first", b = "expr|wheel|second", length = "num|4|rest length",
			stiffness = "num|2000|stiffness", damping = "num|100|damping" },
		doc = "Pulls back towards its rest length from either direction. Damping " ..
			"stops it bouncing forever -- without it, nothing settles.",
		tags = "springconstraint spring suspension bounce" }

-- collisions --------------------------------------------------------------------------
D{ id = "physSolid", cat = "phys", group = "Collisions", label = "set solid",
		head = "set {part} solid to {value}",
		code = "{part}.CanCollide = {value}",
		fields = { part = "expr|part|part", value = "choice|true|value|true,false" },
		doc = "A part that is not solid is walked straight through, but still " ..
			"fires Touched. That is how checkpoints and triggers work.",
		tags = "cancollide solid pass through trigger" }

D{ id = "physTouchable", cat = "phys", group = "Collisions", label = "set touchable",
		head = "set {part} touchable to {value}",
		code = "{part}.CanTouch = {value}",
		fields = { part = "expr|part|part", value = "choice|true|value|true,false" },
		doc = "Switching CanTouch off stops Touched firing at all, which is worth " ..
			"doing on scenery that nothing needs to react to.",
		tags = "cantouch touched performance trigger" }

D{ id = "physQueryable", cat = "phys", group = "Collisions", label = "set findable by rays",
		head = "set {part} findable by rays to {value}",
		code = "{part}.CanQuery = {value}",
		fields = { part = "expr|part|part", value = "choice|true|value|true,false" },
		doc = "Rays pass straight through a part with this off, which is how you " ..
			"stop an aim ray hitting your own character.",
		tags = "canquery raycast ignore invisible" }

D{ id = "physGroup", cat = "phys", group = "Collisions", label = "put in a collision group",
		head = 'put {part} in the collision group "{group}"',
		code = '{part}.CollisionGroup = "{group}"',
		fields = { part = "expr|part|part", group = "str|Players|group name" },
		doc = "Groups let whole sets of parts ignore each other. Set up which " ..
			"groups collide in Studio's Collision Groups editor first.",
		tags = "collisiongroup ignore group physics" }

D{ id = "physRegisterGroup", cat = "phys", group = "Collisions", label = "create a collision group",
		head = 'create the collision group "{group}"',
		code = 'PhysicsService:RegisterCollisionGroup("{group}")',
		fields = { group = "str|Players|group name" },
		needs = { "PhysicsService" }, side = "server",
		doc = "Makes the group in code rather than in the editor. Do it once, on " ..
			"the server, before anything is put in it.",
		tags = "physicsservice registercollisiongroup create" }

D{ id = "physGroupsIgnore", cat = "phys", group = "Collisions", label = "make two groups pass through",
		head = 'let "{a}" and "{b}" pass through each other',
		code = 'PhysicsService:CollisionGroupSetCollidable("{a}", "{b}", false)',
		fields = { a = "str|Players|first group", b = "str|Enemies|second group" },
		needs = { "PhysicsService" }, side = "server",
		doc = "How players walk through each other while still standing on the " ..
			"floor.",
		tags = "collisiongroupsetcollidable ignore pass through" }

D{ id = "physOverlaps", cat = "phys", group = "Collisions", label = "for each part overlapping",
		head = "for each {found} overlapping {part}",
		code = "for _, {found} in ipairs(workspace:GetPartsInPart({part})) do", tail = "end",
		fields = { part = "expr|zone|part", found = "name|found|part found" },
		slots = { { key = "body" } },
		doc = "Asks once what is inside a part, rather than waiting for Touched. " ..
			"Right for a zone you check now and then.",
		tags = "getpartsinpart overlap zone region check" }

D{ id = "physNearby", cat = "phys", group = "Collisions", label = "for each part in a box",
		head = "for each {found} inside a {size} stud box at {where}",
		code = {
			"for _, {found} in ipairs(workspace:GetPartBoundsInBox(",
			"\tCFrame.new({where}), Vector3.new({size}, {size}, {size}))) do",
		},
		codeTail = { "end" }, tail = "end",
		fields = { where = "expr|part.Position|centre", size = "num|20|size",
			found = "name|found|part found" },
		slots = { { key = "body" } },
		doc = "A box search around a point. Explosions and area effects use this " ..
			"rather than looping over everything in the workspace.",
		tags = "getpartboundsinbox area explosion nearby" }

-- rays -----------------------------------------------------------------------------------
D{ id = "physRay", cat = "phys", group = "Rays", label = "fire a ray",
		head = "make {name} = what a ray from {from} going {direction} hits",
		code = "local {name} = workspace:Raycast({from}, {direction})",
		fields = { name = "name|hit|name", from = "expr|part.Position|start",
			direction = "expr|Vector3.new(0, -50, 0)|direction and length" },
		doc = "The direction is also the length -- a 50 stud drop is " ..
			"`Vector3.new(0, -50, 0)`. Gives nil when it hits nothing.",
		tags = "raycast ray hit trace line" }

D{ id = "physRayIgnoring", cat = "phys", group = "Rays", label = "fire a ray ignoring things",
		head = "make {name} = what a ray from {from} going {direction} hits, ignoring {ignore}",
		code = {
			"local {name}",
			"do",
			'\tlocal rules = RaycastParams.new()',
			"\trules.FilterType = Enum.RaycastFilterType.Exclude",
			"\trules.FilterDescendantsInstances = {ignore}",
			"\t{name} = workspace:Raycast({from}, {direction}, rules)",
			"end",
		},
		fields = { name = "name|hit|name", from = "expr|origin|start",
			direction = "expr|Vector3.new(0, -50, 0)|direction and length",
			ignore = "expr|{ character }|what to ignore" },
		doc = "Nearly every aiming ray needs to ignore the character firing it, " ..
			"or it hits their own chest.",
		tags = "raycastparams exclude ignore filter ray" }

D{ id = "physRayHitPart", cat = "phys", group = "Rays", label = "what the ray hit",
		head = "make {name} = the part {hit} found",
		code = "local {name} = {hit} and {hit}.Instance or nil",
		fields = { name = "name|target|name", hit = "expr|hit|ray result" },
		doc = "A ray result holds `Instance`, `Position`, `Normal` and `Material`. " ..
			"The `and ... or nil` guards against the ray having hit nothing.",
		tags = "raycastresult instance hit part" }

D{ id = "physRayHitWhere", cat = "phys", group = "Rays", label = "where the ray landed",
		head = "make {name} = where {hit} landed",
		code = "local {name} = {hit} and {hit}.Position or nil",
		fields = { name = "name|spot|name", hit = "expr|hit|ray result" },
		doc = "The exact point on the surface. Where you would put a bullet hole " ..
			"or a teleport marker.",
		tags = "raycastresult position point surface" }

D{ id = "physIfRayHit", cat = "phys", group = "Rays", label = "if the ray hit something",
		head = "if {hit} found something then",
		code = "if {hit} then", tail = "end",
		fields = { hit = "expr|hit|ray result" },
		slots = { { key = "body" } },
		doc = "Always check before reading anything out of a ray result.",
		tags = "raycast check nil hit condition" }

D{ id = "physGroundBelow", cat = "phys", group = "Rays", label = "find the ground below",
		head = "make {name} = how far the ground is below {part}",
		code = {
			"local {name} = nil",
			"do",
			"\tlocal found = workspace:Raycast({part}.Position, Vector3.new(0, -{depth}, 0))",
			"\tif found then",
			"\t\t{name} = ({part}.Position - found.Position).Magnitude",
			"\tend",
			"end",
		},
		fields = { name = "name|drop|name", part = "expr|part|part", depth = "num|100|how far to look" },
		doc = "Fires a ray straight down and measures the gap. Nil means nothing " ..
			"was found within range.",
		tags = "ground below raycast height drop" }

-- properties -----------------------------------------------------------------------------
D{ id = "physMass", cat = "phys", group = "Properties", label = "how heavy it is",
		head = "make {name} = how heavy {part} is",
		code = "local {name} = {part}.AssemblyMass",
		fields = { name = "name|mass|name", part = "expr|part|part" },
		doc = "The mass of everything welded to it, not just the one part. That " ..
			"is what forces actually push against.",
		tags = "mass weight assembly heavy" }

D{ id = "physMaterialFeel", cat = "phys", group = "Properties", label = "set how it feels",
		head = "make {part} {density} dense, with {friction} grip and {bounce} bounce",
		code = "{part}.CustomPhysicalProperties = PhysicalProperties.new({density}, " ..
			"{friction}, {bounce})",
		fields = { part = "expr|part|part", density = "num|0.7|density",
			friction = "num|0.3|grip", bounce = "num|0.5|bounce" },
		doc = "Overrides what the material would give. High bounce and low grip " ..
			"makes ice; the reverse makes rubber.",
		tags = "physicalproperties density friction bounce elasticity" }

D{ id = "physGravity", cat = "phys", group = "Properties", label = "set the world gravity",
		head = "set gravity to {n}",
		code = "workspace.Gravity = {n}",
		fields = { n = "num|196.2|gravity" },
		doc = "196.2 is Roblox's normal. Halve it for a moon feel; zero it for " ..
			"space, though characters then float away.",
		tags = "gravity workspace physics moon space" }

D{ id = "physOwner", cat = "phys", group = "Properties", label = "give physics control",
		head = "let {player} control the physics of {part}",
		code = "{part}:SetNetworkOwner({player})",
		fields = { part = "expr|part|part", player = "expr|player|player" },
		side = "server",
		doc = "Whoever owns a part simulates it, so giving a player their own " ..
			"vehicle makes it feel instant instead of laggy.",
		tags = "setnetworkowner ownership lag vehicle physics" }

D{ id = "physServerOwns", cat = "phys", group = "Properties", label = "take physics control back",
		head = "let the server control the physics of {part}",
		code = "{part}:SetNetworkOwner(nil)",
		fields = { part = "expr|part|part" },
		side = "server",
		doc = "The server simulates it instead. Slower to respond, but a player " ..
			"cannot cheat it.",
		tags = "setnetworkowner server physics anticheat" }

D{ id = "physSleepy", cat = "phys", group = "Properties", label = "stop it being pushed",
		head = "stop {part} being pushed around",
		code = "{part}.Massless = true",
		fields = { part = "expr|part|part" },
		doc = "A massless part adds no weight to whatever it is welded to. Right " ..
			"for decorations on a vehicle.",
		tags = "massless weight decoration vehicle" }

--=============================================================================
-- ANIMATION
--=============================================================================

D{ id = "animLoad", cat = "anim", group = "Playing", label = "load an animation",
		head = "make {name} = animation {id} loaded onto {hum}",
		code = {
			'local {name} = Instance.new("Animation")',
			'{name}.AnimationId = "rbxassetid://{id}"',
			"{name} = {hum}:FindFirstChildOfClass(\"Animator\"):LoadAnimation({name})",
		},
		fields = { name = "name|track|name", id = "num|0|animation id", hum = "expr|hum|humanoid" },
		doc = "Animations are loaded through the Animator inside the Humanoid, " ..
			"which is the current way to do it. Load once, play many times.",
		tags = "animation loadanimation animator track load" }

D{ id = "animPlay", cat = "anim", group = "Playing", label = "play an animation",
		head = "play {track}",
		code = "{track}:Play()",
		fields = { track = "expr|track|track" },
		doc = "Starts from the beginning and blends in over a moment.",
		tags = "play animation track start" }

D{ id = "animStop", cat = "anim", group = "Playing", label = "stop an animation",
		head = "stop {track} over {fade} seconds",
		code = "{track}:Stop({fade})",
		fields = { track = "expr|track|track", fade = "num|0.2|fade seconds" },
		doc = "Fading out rather than cutting stops the character snapping back " ..
			"to its pose.",
		tags = "stop animation fade blend" }

D{ id = "animSpeed", cat = "anim", group = "Playing", label = "set animation speed",
		head = "set the speed of {track} to {n}",
		code = "{track}:AdjustSpeed({n})",
		fields = { track = "expr|track|track", n = "num|1|speed" },
		doc = "1 is normal, 2 is double time, 0 freezes it on the current frame. " ..
			"Matching a run animation to walk speed uses this.",
		tags = "adjustspeed animation faster slower" }

D{ id = "animLoop", cat = "anim", group = "Playing", label = "set an animation looping",
		head = "set {track} to repeat: {value}",
		code = "{track}.Looped = {value}",
		fields = { track = "expr|track|track", value = "choice|true|value|true,false" },
		doc = "Idle and walk animations loop; a wave or a swing should not.",
		tags = "looped repeat animation idle" }

D{ id = "animPriority", cat = "anim", group = "Playing", label = "set animation priority",
		head = "set the priority of {track} to {level}",
		code = "{track}.Priority = Enum.AnimationPriority.{level}",
		fields = { track = "expr|track|track",
			level = "choice|Action|level|Core,Idle,Movement,Action,Action2,Action3" },
		doc = "When two animations both move an arm, the higher priority wins. " ..
			"An attack should be Action so it beats walking.",
		tags = "priority animation blend override action" }

D{ id = "animIfPlaying", cat = "anim", group = "Playing", label = "if an animation is playing",
		head = "if {track} is playing then",
		code = "if {track}.IsPlaying then", tail = "end",
		fields = { track = "expr|track|track" },
		slots = { { key = "body" } },
		doc = "Stops you restarting an animation that has not finished, which " ..
			"would make it stutter.",
		tags = "isplaying animation check" }

D{ id = "animOnEnded", cat = "anim", group = "Playing", label = "on an animation finishing",
		head = "when {track} finishes",
		code = "{track}.Stopped:Connect(function()", tail = "end)",
		fields = { track = "expr|track|track" },
		slots = { { key = "body" } },
		doc = "Fires when it stops for any reason, including being stopped by " ..
			"you. Good for chaining a combo.",
		tags = "stopped ended animation event combo" }

D{ id = "animOnMarker", cat = "anim", group = "Playing", label = "on an animation marker",
		head = 'when {track} reaches the marker "{marker}"',
		code = '{track}:GetMarkerReachedSignal("{marker}"):Connect(function()', tail = "end)",
		fields = { track = "expr|track|track", marker = "str|hit|marker name" },
		slots = { { key = "body" } },
		doc = "Markers are set in the animation editor. This is how a sword deals " ..
			"damage exactly when it connects rather than when the swing starts.",
		tags = "marker keyframe animation timing hit" }

D{ id = "animStopAll", cat = "anim", group = "Playing", label = "stop every animation",
		head = "stop every animation on {hum}",
		code = {
			'for _, track in ipairs({hum}:FindFirstChildOfClass("Animator"):GetPlayingAnimationTracks()) do',
			"\ttrack:Stop()",
			"end",
		},
		fields = { hum = "expr|hum|humanoid" },
		doc = "Clears everything at once, which is the simplest way to reset a " ..
			"character that has got into a strange pose.",
		tags = "stop all animations reset tracks" }

-- humanoid states -------------------------------------------------------------------------
D{ id = "animSit", cat = "anim", group = "States", label = "sit down",
		head = "make {hum} sit",
		code = "{hum}.Sit = true",
		fields = { hum = "expr|hum|humanoid" },
		doc = "Sits the character where it is. Setting it back to false stands " ..
			"them up again.",
		tags = "sit humanoid seat pose" }

D{ id = "animJump", cat = "anim", group = "States", label = "jump",
		head = "make {hum} jump",
		code = "{hum}.Jump = true",
		fields = { hum = "expr|hum|humanoid" },
		doc = "The same as the player pressing space. It only works if they are " ..
			"actually on the ground.",
		tags = "jump humanoid hop" }

D{ id = "animRagdoll", cat = "anim", group = "States", label = "go limp",
		head = "make {hum} go limp",
		code = "{hum}.PlatformStand = true",
		fields = { hum = "expr|hum|humanoid" },
		doc = "The character stops holding itself up and flops about. Setting it " ..
			"back to false stands them up.",
		tags = "platformstand ragdoll limp knocked down" }

D{ id = "animState", cat = "anim", group = "States", label = "force a state",
		head = "put {hum} into the {state} state",
		code = "{hum}:ChangeState(Enum.HumanoidStateType.{state})",
		fields = { hum = "expr|hum|humanoid",
			state = "choice|Jumping|state|Jumping,Freefall,Landed,Swimming,Climbing,Seated,GettingUp,Dead,Running" },
		doc = "Forces the character into a state rather than waiting for physics " ..
			"to put it there.",
		tags = "changestate humanoidstate force jump swim" }

D{ id = "animOnStateChange", cat = "anim", group = "States", label = "on a state change",
		head = "when {hum} changes state, from {old} to {new}",
		code = "{hum}.StateChanged:Connect(function({old}, {new})", tail = "end)",
		fields = { hum = "expr|hum|humanoid", old = "name|old|from", new = "name|new|to" },
		slots = { { key = "body" } },
		doc = "Fires on every landing, jump and fall. Compare the new state " ..
			"against `Enum.HumanoidStateType.Landed` for a landing thump.",
		tags = "statechanged humanoid landed jump event" }

D{ id = "animDisableState", cat = "anim", group = "States", label = "forbid a state",
		head = "stop {hum} being able to {state}",
		code = "{hum}:SetStateEnabled(Enum.HumanoidStateType.{state}, false)",
		fields = { hum = "expr|hum|humanoid",
			state = "choice|Jumping|state|Jumping,Climbing,Swimming,GettingUp,Seated,Dead" },
		doc = "Turning off Jumping is how you make a no-jump zone. Turning off " ..
			"GettingUp is how a ragdoll stays down.",
		tags = "setstateenabled forbid disable jump climb" }

D{ id = "animAutoRotate", cat = "anim", group = "States", label = "set turning to face movement",
		head = "set {hum} turning to face where it walks: {value}",
		code = "{hum}.AutoRotate = {value}",
		fields = { hum = "expr|hum|humanoid", value = "choice|true|value|true,false" },
		doc = "Off means the character keeps facing one way while strafing, which " ..
			"is what a shooter usually wants.",
		tags = "autorotate turn facing strafe" }

-- character bits -----------------------------------------------------------------------------
D{ id = "animGiveTool", cat = "anim", group = "Character", label = "give a tool",
		head = "give {tool} to {player}",
		code = "{tool}.Parent = {player}.Backpack",
		fields = { tool = "expr|tool|tool", player = "expr|player|player" },
		doc = "A tool in the Backpack appears in their hotbar. Put it in the " ..
			"character instead to force it into their hands.",
		tags = "tool backpack give item equip" }

D{ id = "animEquipTool", cat = "anim", group = "Character", label = "put a tool in their hands",
		head = "make {hum} hold {tool}",
		code = "{hum}:EquipTool({tool})",
		fields = { hum = "expr|hum|humanoid", tool = "expr|tool|tool" },
		doc = "Equips it immediately, whether or not they chose it.",
		tags = "equiptool hold equip tool hands" }

D{ id = "animUnequip", cat = "anim", group = "Character", label = "empty their hands",
		head = "make {hum} put everything away",
		code = "{hum}:UnequipTools()",
		fields = { hum = "expr|hum|humanoid" },
		doc = "Everything they were holding goes back to the backpack.",
		tags = "unequiptools drop hands empty" }

D{ id = "animAddHat", cat = "anim", group = "Character", label = "put an accessory on",
		head = "put the accessory {accessory} on {hum}",
		code = "{hum}:AddAccessory({accessory})",
		fields = { hum = "expr|hum|humanoid", accessory = "expr|hat|accessory" },
		doc = "Attaches it to the right place on the head or body on its own, " ..
			"using the attachment inside the accessory.",
		tags = "addaccessory hat accessory wear cosmetic" }

D{ id = "animScale", cat = "anim", group = "Character", label = "resize a character",
		head = "scale {hum} to {n} times its size",
		code = {
			"do",
			'\tlocal scale = {hum}:FindFirstChild("BodyHeightScale")',
			"\tif scale then",
			"\t\tscale.Value = {n}",
			"\tend",
			"end",
		},
		fields = { hum = "expr|hum|humanoid", n = "num|1.2|scale" },
		doc = "R15 characters carry scale values inside the Humanoid. R6 ones do " ..
			"not, which is why this checks first.",
		tags = "scale size r15 height character" }

D{ id = "animRigType", cat = "anim", group = "Character", label = "if it is an R15 character",
		head = "if {hum} is an R15 character then",
		code = "if {hum}.RigType == Enum.HumanoidRigType.R15 then", tail = "end",
		fields = { hum = "expr|hum|humanoid" },
		slots = { { key = "body" } },
		doc = "R6 and R15 have different body parts, so anything that reaches for " ..
			"a limb by name needs to know which it is dealing with.",
		tags = "rigtype r6 r15 character limbs" }

--=============================================================================
-- NPCs
--=============================================================================

D{ id = "npcPath", cat = "npc", group = "Paths", label = "make a path finder",
		head = "make {name} = a path finder",
		code = "local {name} = PathfindingService:CreatePath()",
		fields = { name = "name|path|name" },
		needs = { "PathfindingService" }, side = "server",
		doc = "A Path works out a route round obstacles. Make one and reuse it " ..
			"rather than making a new one every step.",
		tags = "pathfindingservice createpath route navigation" }

D{ id = "npcPathSized", cat = "npc", group = "Paths", label = "make a path finder for a size",
		head = "make {name} = a path finder for something {radius} wide and {height} tall",
		code = {
			"local {name} = PathfindingService:CreatePath({",
			"\tAgentRadius = {radius},",
			"\tAgentHeight = {height},",
			"\tAgentCanJump = {jump},",
			"})",
		},
		fields = { name = "name|path|name", radius = "num|2|radius", height = "num|5|height",
			jump = "choice|true|can jump|true,false" },
		needs = { "PathfindingService" }, side = "server",
		doc = "Telling it the size stops a big NPC routing through a gap it " ..
			"cannot fit through.",
		tags = "agentradius agentheight path size jump" }

D{ id = "npcWorkOutPath", cat = "npc", group = "Paths", label = "work out a route",
		head = "work out a route on {path} from {from} to {to}",
		code = {
			"pcall(function()",
			"\t{path}:ComputeAsync({from}, {to})",
			"end)",
		},
		fields = { path = "expr|path|path", from = "expr|npc.PrimaryPart.Position|from",
			to = "expr|target.Position|to" },
		side = "server",
		doc = "Computing takes a moment and can fail if either end is inside a " ..
			"wall, so it is wrapped.",
		tags = "computeasync path route calculate" }

D{ id = "npcPathWorked", cat = "npc", group = "Paths", label = "if the route worked",
		head = "if {path} found a route then",
		code = "if {path}.Status == Enum.PathStatus.Success then", tail = "end",
		fields = { path = "expr|path|path" },
		slots = { { key = "body" } },
		side = "server",
		doc = "Always check. Walking a failed path sends the NPC to the last " ..
			"place it managed to reach, which looks like a bug.",
		tags = "pathstatus success check route" }

D{ id = "npcEachStep", cat = "npc", group = "Paths", label = "for each step of a route",
		head = "for each step {point} of {path}",
		code = "for _, {point} in ipairs({path}:GetWaypoints()) do", tail = "end",
		fields = { path = "expr|path|path", point = "name|point|step" },
		slots = { { key = "body" } },
		side = "server",
		doc = "Each step has a `Position` and an `Action` saying whether the NPC " ..
			"has to jump to reach it.",
		tags = "getwaypoints waypoints steps path walk" }

D{ id = "npcStepNeedsJump", cat = "npc", group = "Paths", label = "if the step needs a jump",
		head = "if {point} needs a jump then",
		code = "if {point}.Action == Enum.PathWaypointAction.Jump then", tail = "end",
		fields = { point = "expr|point|step" },
		slots = { { key = "body" } },
		side = "server",
		doc = "Goes inside the step loop. Without it an NPC walks into ledges " ..
			"instead of hopping up them.",
		tags = "waypointaction jump path step" }

D{ id = "npcOnPathBlocked", cat = "npc", group = "Paths", label = "on the route being blocked",
		head = "when {path} is blocked, at step {at}",
		code = "{path}.Blocked:Connect(function({at})", tail = "end)",
		fields = { path = "expr|path|path", at = "name|blockedAt|step number" },
		slots = { { key = "body" } },
		side = "server",
		doc = "Fires when something moves into the route after it was worked out. " ..
			"The usual answer is to work the route out again.",
		tags = "blocked path obstacle recompute" }

D{ id = "npcWalkRoute", cat = "npc", group = "Paths", label = "walk a whole route",
		head = "walk {hum} along {path}",
		code = {
			"for _, point in ipairs({path}:GetWaypoints()) do",
			"\tif point.Action == Enum.PathWaypointAction.Jump then",
			"\t\t{hum}.Jump = true",
			"\tend",
			"\t{hum}:MoveTo(point.Position)",
			"\tlocal reached = {hum}.MoveToFinished:Wait()",
			"\tif not reached then",
			"\t\tbreak",
			"\tend",
			"end",
		},
		fields = { hum = "expr|hum|humanoid", path = "expr|path|path" },
		side = "server",
		doc = "The whole walk in one block: jump where needed, wait for each step, " ..
			"and give up if the NPC gets stuck.",
		tags = "movetofinished walk route follow path npc" }

-- following ---------------------------------------------------------------------------
D{ id = "npcWalkTo", cat = "npc", group = "Following", label = "walk to a point",
		head = "make {hum} walk to {where}",
		code = "{hum}:MoveTo({where})",
		fields = { hum = "expr|hum|humanoid", where = "expr|target.Position|where" },
		doc = "Walks in a straight line with no route finding, which is fine in " ..
			"open ground and useless in a maze.",
		tags = "moveto walk straight npc" }

D{ id = "npcWaitArrive", cat = "npc", group = "Following", label = "wait until it arrives",
		head = "make {name} = whether {hum} reached where it was going",
		code = "local {name} = {hum}.MoveToFinished:Wait()",
		fields = { name = "name|arrived|name", hum = "expr|hum|humanoid" },
		doc = "Waits, then says whether it actually got there. It gives up after " ..
			"eight seconds and hands back false.",
		tags = "movetofinished wait arrive timeout npc" }

D{ id = "npcStopWalking", cat = "npc", group = "Following", label = "stop walking",
		head = "make {hum} stop walking",
		code = "{hum}:Move(Vector3.zero)",
		fields = { hum = "expr|hum|humanoid" },
		doc = "Cancels whatever it was walking towards and leaves it standing.",
		tags = "move stop halt npc walk" }

D{ id = "npcNearestPlayer", cat = "npc", group = "Following", label = "the nearest player",
		head = "make {name} = the nearest player to {from}, within {range} studs",
		code = {
			"local {name} = nil",
			"do",
			"\tlocal best = {range}",
			"\tfor _, player in ipairs(Players:GetPlayers()) do",
			"\t\tlocal char = player.Character",
			"\t\tlocal root = char and char:FindFirstChild(\"HumanoidRootPart\")",
			"\t\tif root then",
			"\t\t\tlocal gap = (root.Position - {from}).Magnitude",
			"\t\t\tif gap < best then",
			"\t\t\t\tbest = gap",
			"\t\t\t\t{name} = player",
			"\t\t\tend",
			"\t\tend",
			"\tend",
			"end",
		},
		fields = { name = "name|nearest|name", from = "expr|npc.PrimaryPart.Position|from",
			range = "num|60|how far to look" },
		needs = { "Players" }, side = "server",
		doc = "Walks everyone, skips anyone without a body, and keeps the closest " ..
			"within range. Nil when nobody is near enough.",
		tags = "nearest closest player target range npc" }

D{ id = "npcChase", cat = "npc", group = "Following", label = "chase something",
		head = "make {hum} keep chasing {target} while it is within {range} studs",
		code = {
			"task.spawn(function()",
			"\twhile {target} and {target}.Parent do",
			"\t\tlocal gap = ({target}.Position - {hum}.Parent.PrimaryPart.Position).Magnitude",
			"\t\tif gap > {range} then",
			"\t\t\tbreak",
			"\t\tend",
			"\t\t{hum}:MoveTo({target}.Position)",
			"\t\ttask.wait(0.4)",
			"\tend",
			"end)",
		},
		fields = { hum = "expr|hum|humanoid", target = "expr|targetRoot|what to chase",
			range = "num|60|give up beyond" },
		side = "server",
		doc = "Re-aims a few times a second on its own thread. Cheaper and " ..
			"steadier than doing it every frame.",
		tags = "chase follow pursue npc loop" }

D{ id = "npcWander", cat = "npc", group = "Following", label = "wander about",
		head = "make {hum} wander within {range} studs of {home}",
		code = {
			"task.spawn(function()",
			"\twhile {hum}.Health > 0 do",
			"\t\tlocal spot = {home} + Vector3.new(",
			"\t\t\tmath.random(-{range}, {range}), 0, math.random(-{range}, {range}))",
			"\t\t{hum}:MoveTo(spot)",
			"\t\t{hum}.MoveToFinished:Wait()",
			"\t\ttask.wait(math.random({rest}, {rest} * 2))",
			"\tend",
			"end)",
		},
		fields = { hum = "expr|hum|humanoid", home = "expr|spawnPoint|home position",
			range = "num|20|range", rest = "num|2|pause seconds" },
		side = "server",
		doc = "Picks a random nearby spot, walks there, waits, and repeats until " ..
			"it dies. Idle villagers and animals are this block.",
		tags = "wander idle roam random walk npc" }

D{ id = "npcFace", cat = "npc", group = "Following", label = "turn to face",
		head = "turn {model} to face {target}",
		code = {
			"do",
			"\tlocal from = {model}:GetPivot().Position",
			"\tlocal to = Vector3.new({target}.X, from.Y, {target}.Z)",
			"\t{model}:PivotTo(CFrame.lookAt(from, to))",
			"end",
		},
		fields = { model = "expr|npc|model", target = "expr|target.Position|target position" },
		doc = "Levelling the target's height first stops the NPC tipping over " ..
			"backwards to look up at something.",
		tags = "lookat face turn rotate npc" }

D{ id = "npcCanSee", cat = "npc", group = "Following", label = "if it can see something",
		head = "if {from} can see {to}, ignoring {ignore}, then",
		code = {
			"local canSee = false",
			"do",
			"\tlocal rules = RaycastParams.new()",
			"\trules.FilterType = Enum.RaycastFilterType.Exclude",
			"\trules.FilterDescendantsInstances = {ignore}",
			"\tlocal found = workspace:Raycast({from}, {to} - {from}, rules)",
			"\tcanSee = found == nil or found.Instance:IsDescendantOf({target})",
			"end",
			"if canSee then",
		},
		codeTail = { "end" }, tail = "end",
		fields = { from = "expr|npc.PrimaryPart.Position|from", to = "expr|target.Position|to",
			ignore = "expr|{ npc }|what to ignore", target = "expr|targetModel|the target model" },
		slots = { { key = "body" } },
		side = "server",
		doc = "Fires a ray at the target and calls it visible if nothing solid is " ..
			"in the way. The core of any NPC that should not see through walls.",
		tags = "line of sight raycast see vision npc" }

-- setting one up -------------------------------------------------------------------------
D{ id = "npcSpawn", cat = "npc", group = "Setting up", label = "spawn an NPC",
		head = "make {name} = a copy of {template} at ({x}, {y}, {z})",
		code = {
			"local {name} = {template}:Clone()",
			"{name}:PivotTo(CFrame.new({x}, {y}, {z}))",
			"{name}.Parent = workspace",
		},
		fields = { name = "name|npc|name", template = "expr|game.ServerStorage.Guard|template",
			x = "expr|0|x", y = "expr|5|y", z = "expr|0|z" },
		side = "server",
		doc = "Keep the original in ServerStorage so players never bump into it. " ..
			"PivotTo moves the whole model in one piece.",
		tags = "spawn clone npc enemy place" }

D{ id = "npcHumanoidOf", cat = "npc", group = "Setting up", label = "the humanoid of an NPC",
		head = "make {name} = the humanoid inside {model}",
		code = 'local {name} = {model}:FindFirstChildOfClass("Humanoid")',
		fields = { name = "name|hum|name", model = "expr|npc|model" },
		doc = "Everything an NPC does goes through its Humanoid, exactly as with " ..
			"a player's character.",
		tags = "humanoid npc find model" }

D{ id = "npcNoNameTag", cat = "npc", group = "Setting up", label = "hide the name and health",
		head = "hide the name and health bar over {hum}",
		code = "{hum}.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None",
		fields = { hum = "expr|hum|humanoid" },
		doc = "Stops Roblox drawing the default name plate, so your own floating " ..
			"label is the only one.",
		tags = "displaydistancetype nameplate hide health npc" }

D{ id = "npcOnDied", cat = "npc", group = "Setting up", label = "on an NPC dying",
		head = "when {hum} dies, remove it after {seconds} seconds",
		code = {
			"{hum}.Died:Connect(function()",
			"\ttask.delay({seconds}, function()",
			"\t\tif {hum}.Parent then",
			"\t\t\t{hum}.Parent:Destroy()",
			"\t\tend",
			"\tend)",
			"end)",
		},
		fields = { hum = "expr|hum|humanoid", seconds = "num|4|seconds" },
		side = "server",
		doc = "Leaves the body long enough to be seen, then clears it up. Without " ..
			"this a busy game fills with corpses.",
		tags = "died despawn cleanup corpse npc" }

--=============================================================================
-- TERRAIN AND BUILDING
--=============================================================================

D{ id = "terrainBlock", cat = "terrain", group = "Filling", label = "fill a block",
		head = "fill a {size} stud block of {material} at ({x}, {y}, {z})",
		code = "workspace.Terrain:FillBlock(CFrame.new({x}, {y}, {z}), " ..
			"Vector3.new({size}, {size}, {size}), Enum.Material.{material})",
		fields = { x = "expr|0|x", y = "expr|0|y", z = "expr|0|z", size = "num|16|size",
			material = "choice|Grass|material|Grass,Sand,Rock,Snow,Ice,Mud,Water,Air,Sandstone,Basalt,Asphalt,LeafyGrass" },
		doc = "Terrain is filled by shape rather than placed by part. A block of " ..
			"Air is how you dig a hole.",
		tags = "terrain fillblock material ground dig" }

D{ id = "terrainBall", cat = "terrain", group = "Filling", label = "fill a ball",
		head = "fill a ball of {material}, {radius} studs across, at ({x}, {y}, {z})",
		code = "workspace.Terrain:FillBall(Vector3.new({x}, {y}, {z}), {radius}, " ..
			"Enum.Material.{material})",
		fields = { x = "expr|0|x", y = "expr|0|y", z = "expr|0|z", radius = "num|10|radius",
			material = "choice|Rock|material|Grass,Sand,Rock,Snow,Ice,Mud,Water,Air,Sandstone,Basalt" },
		doc = "Balls make softer shapes than blocks. A ball of Air carves a cave.",
		tags = "terrain fillball sphere cave carve" }

D{ id = "terrainCylinder", cat = "terrain", group = "Filling", label = "fill a pillar",
		head = "fill a pillar of {material}, {radius} across and {height} tall, at ({x}, {y}, {z})",
		code = "workspace.Terrain:FillCylinder(CFrame.new({x}, {y}, {z}), {height}, " ..
			"{radius}, Enum.Material.{material})",
		fields = { x = "expr|0|x", y = "expr|0|y", z = "expr|0|z", radius = "num|6|radius",
			height = "num|20|height",
			material = "choice|Rock|material|Grass,Sand,Rock,Snow,Ice,Water,Air,Basalt" },
		doc = "Towers, wells and tree trunks. Fill with Air to bore a shaft.",
		tags = "terrain fillcylinder pillar tower shaft" }

D{ id = "terrainDig", cat = "terrain", group = "Filling", label = "dig a hole",
		head = "dig a ball {radius} studs across at ({x}, {y}, {z})",
		code = "workspace.Terrain:FillBall(Vector3.new({x}, {y}, {z}), {radius}, " ..
			"Enum.Material.Air)",
		fields = { x = "expr|0|x", y = "expr|0|y", z = "expr|0|z", radius = "num|8|radius" },
		doc = "Filling with Air removes terrain. This is the whole of a digging " ..
			"tool or an explosion crater.",
		tags = "dig air remove crater explosion terrain" }

D{ id = "terrainWater", cat = "terrain", group = "Filling", label = "add water",
		head = "fill a {size} stud block of water at ({x}, {y}, {z})",
		code = "workspace.Terrain:FillBlock(CFrame.new({x}, {y}, {z}), " ..
			"Vector3.new({size}, {size}, {size}), Enum.Material.Water)",
		fields = { x = "expr|0|x", y = "expr|-10|y", z = "expr|0|z", size = "num|64|size" },
		doc = "Water is terrain like any other material, and characters swim in " ..
			"it automatically.",
		tags = "water swim terrain sea lake" }

D{ id = "terrainClear", cat = "terrain", group = "Filling", label = "clear all terrain",
		head = "clear all terrain",
		code = "workspace.Terrain:Clear()",
		doc = "Removes every voxel in the place. There is no undo for this at " ..
			"runtime, so be sure.",
		tags = "clear terrain wipe empty reset" }

D{ id = "terrainSwap", cat = "terrain", group = "Filling", label = "swap a material",
		head = "turn all {from} within a {size} stud block at ({x}, {y}, {z}) into {to}",
		code = {
			"workspace.Terrain:ReplaceMaterial(",
			"\tRegion3.new(",
			"\t\tVector3.new({x} - {size}, {y} - {size}, {z} - {size}),",
			"\t\tVector3.new({x} + {size}, {y} + {size}, {z} + {size})),",
			"\t4, Enum.Material.{from}, Enum.Material.{to})",
		},
		fields = { x = "expr|0|x", y = "expr|0|y", z = "expr|0|z", size = "num|64|size",
			from = "choice|Grass|from|Grass,Sand,Rock,Snow,Ice,Mud,Water,LeafyGrass",
			to = "choice|Snow|to|Grass,Sand,Rock,Snow,Ice,Mud,Water,LeafyGrass" },
		doc = "Repaints terrain without changing its shape. Turning grass to snow " ..
			"is how a season change is done.",
		tags = "replacematerial region3 repaint season terrain" }

D{ id = "terrainColour", cat = "terrain", group = "Filling", label = "recolour a material",
		head = "colour all {material} terrain red {r} green {g} blue {b}",
		code = "workspace.Terrain:SetMaterialColor(Enum.Material.{material}, " ..
			"Color3.fromRGB({r}, {g}, {b}))",
		fields = { material = "choice|Grass|material|Grass,Sand,Rock,Snow,Ice,Mud,LeafyGrass",
			r = "num|120|red", g = "num|150|green", b = "num|90|blue" },
		doc = "Changes the tint of one material everywhere at once, which is the " ..
			"cheapest way to give a place its own look.",
		tags = "setmaterialcolor terrain tint colour style" }

-- building ---------------------------------------------------------------------------------
D{ id = "buildPlace", cat = "terrain", group = "Building", label = "place a copy",
		head = "make {name} = a copy of {template} at ({x}, {y}, {z})",
		code = {
			"local {name} = {template}:Clone()",
			"{name}:PivotTo(CFrame.new({x}, {y}, {z}))",
			"{name}.Parent = workspace",
		},
		fields = { name = "name|placed|name", template = "expr|game.ServerStorage.Tree|template",
			x = "expr|0|x", y = "expr|0|y", z = "expr|0|z" },
		doc = "Clone, move, then parent. Doing it in that order means nobody sees " ..
			"it appear at the origin first.",
		tags = "clone place model build spawn" }

D{ id = "buildSnap", cat = "terrain", group = "Building", label = "snap to a grid",
		head = "make {name} = {value} snapped to the nearest {grid} studs",
		code = "local {name} = math.round({value} / {grid}) * {grid}",
		fields = { name = "name|snapped|name", value = "expr|mouse.Hit.Position.X|value",
			grid = "num|4|grid size" },
		doc = "The whole of grid snapping. Divide, round, multiply back -- it " ..
			"works for any spacing.",
		tags = "snap grid round placement building" }

D{ id = "buildAnchorAll", cat = "terrain", group = "Building", label = "anchor a whole model",
		head = "anchor everything inside {model}",
		code = {
			"for _, part in ipairs({model}:GetDescendants()) do",
			'\tif part:IsA("BasePart") then',
			"\t\tpart.Anchored = true",
			"\tend",
			"end",
		},
		fields = { model = "expr|model|model" },
		doc = "One unanchored part is enough to make a whole building sag. This " ..
			"catches every one of them.",
		tags = "anchor model parts building stable" }

D{ id = "buildWeldAll", cat = "terrain", group = "Building", label = "weld a whole model",
		head = "weld everything inside {model} to {main}",
		code = {
			"for _, part in ipairs({model}:GetDescendants()) do",
			'\tif part:IsA("BasePart") and part ~= {main} then',
			'\t\tlocal weld = Instance.new("WeldConstraint")',
			"\t\tweld.Part0 = {main}",
			"\t\tweld.Part1 = part",
			"\t\tweld.Parent = {main}",
			"\t\tpart.Anchored = false",
			"\tend",
			"end",
		},
		fields = { model = "expr|model|model", main = "expr|model.PrimaryPart|main part" },
		doc = "Holds a model together so it moves as one object. Unanchoring the " ..
			"welded parts is what lets the main part carry them.",
		tags = "weld model together join vehicle" }

D{ id = "buildPaintAll", cat = "terrain", group = "Building", label = "paint a whole model",
		head = "paint everything inside {model} red {r} green {g} blue {b}",
		code = {
			"for _, part in ipairs({model}:GetDescendants()) do",
			'\tif part:IsA("BasePart") then',
			"\t\tpart.Color = Color3.fromRGB({r}, {g}, {b})",
			"\tend",
			"end",
		},
		fields = { model = "expr|model|model", r = "num|200|red", g = "num|60|green",
			b = "num|60|blue" },
		doc = "Recolours a whole build at once, which is how team-coloured bases " ..
			"are made from one template.",
		tags = "paint colour model team recolour" }

D{ id = "buildMainPart", cat = "terrain", group = "Building", label = "set the main part",
		head = "make {part} the main part of {model}",
		code = "{model}.PrimaryPart = {part}",
		fields = { model = "expr|model|model", part = "expr|model.Base|part" },
		doc = "The main part is what a model is measured and moved from. A model " ..
			"without one cannot be pivoted reliably.",
		tags = "primarypart model pivot main" }

D{ id = "buildResize", cat = "terrain", group = "Building", label = "resize a model",
		head = "scale {model} by {n}",
		code = "{model}:ScaleTo({n})",
		fields = { model = "expr|model|model", n = "num|2|scale" },
		doc = "Scales every part, weld and attachment together, which doing it by " ..
			"hand almost never gets right.",
		tags = "scaleto resize model grow shrink" }

D{ id = "buildSize", cat = "terrain", group = "Building", label = "how big a model is",
		head = "make {name} = how big {model} is",
		code = "local {name} = {model}:GetExtentsSize()",
		fields = { name = "name|size|name", model = "expr|model|model" },
		doc = "The size of the box that just contains the whole model, as a " ..
			"Vector3.",
		tags = "getextentssize bounds size model" }

D{ id = "buildCountParts", cat = "terrain", group = "Building", label = "count the parts",
		head = "make {name} = how many parts are inside {model}",
		code = {
			"local {name} = 0",
			"for _, part in ipairs({model}:GetDescendants()) do",
			'\tif part:IsA("BasePart") then',
			"\t\t{name} = {name} + 1",
			"\tend",
			"end",
		},
		fields = { name = "name|partCount|name", model = "expr|model|model" },
		doc = "Worth checking against a limit if players can build -- a thousand " ..
			"part house will hurt everyone in the server.",
		tags = "count parts model limit performance" }

D{ id = "buildRow", cat = "terrain", group = "Building", label = "place a row of copies",
		head = "place {count} copies of {template} in a row from ({x}, {y}, {z}), {gap} studs apart",
		code = {
			"for index = 1, {count} do",
			"\tlocal copy = {template}:Clone()",
			"\tcopy:PivotTo(CFrame.new({x} + (index - 1) * {gap}, {y}, {z}))",
			"\tcopy.Parent = workspace",
			"end",
		},
		fields = { template = "expr|game.ServerStorage.Fence|template", count = "num|10|how many",
			x = "expr|0|x", y = "expr|0|y", z = "expr|0|z", gap = "num|8|gap" },
		doc = "Fences, pillars and street lights. Change which coordinate the " ..
			"index is added to for a different direction.",
		tags = "row repeat place fence loop build" }

D{ id = "buildRandomSpot", cat = "terrain", group = "Building", label = "a random spot nearby",
		head = "make {name} = a random spot within {range} studs of {centre}",
		code = "local {name} = {centre} + Vector3.new(math.random(-{range}, {range}), " ..
			"0, math.random(-{range}, {range}))",
		fields = { name = "name|spot|name", centre = "expr|Vector3.new(0, 5, 0)|centre",
			range = "num|30|range" },
		doc = "Scatters things on the flat. Raycast downward from the result if " ..
			"you want it to sit on uneven ground.",
		tags = "random spot scatter spawn position" }

end
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX22">
			<Properties>
				<string name="Name">v</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- v  ·  block definitions: lists and sorting, text patterns, space and angles,
--       debug and timing
--
-- The programming-craft half of the palette: things that are not about Roblox
-- at all, but about getting a job done in Luau.

return function(D)

--=============================================================================
-- LISTS AND SORTING
--=============================================================================

D{ id = "algoRepeatValue", cat = "algo", group = "Building", label = "list of copies",
		head = "make {name} = a list of {n} copies of {value}",
		code = "local {name} = table.create({n}, {value})",
		fields = { name = "name|list|name", n = "num|10|how many", value = "expr|0|value" },
		doc = "`table.create` makes the list at its final size in one go, which " ..
			"is faster than inserting one at a time.",
		tags = "table create fill repeat prefill" }

D{ id = "algoRange", cat = "algo", group = "Building", label = "list of numbers",
		head = "make {name} = the numbers from {a} to {b}",
		code = {
			"local {name} = {}",
			"for value = {a}, {b} do",
			"\ttable.insert({name}, value)",
			"end",
		},
		fields = { name = "name|numbers|name", a = "num|1|from", b = "num|10|to" },
		doc = "A list you can shuffle or pick from, which a plain loop cannot do.",
		tags = "range numbers sequence list build" }

D{ id = "algoCopy", cat = "algo", group = "Building", label = "copy a list",
		head = "make {name} = a copy of {list}",
		code = "local {name} = table.clone({list})",
		fields = { name = "name|copy|name", list = "expr|list|list" },
		doc = "Without this you get a second name for the same table, and " ..
			"changing one changes both.",
		tags = "clone copy duplicate table shallow" }

D{ id = "algoDeepCopy", cat = "algo", group = "Building", label = "copy a list of tables",
		head = "make {name} = a copy of {source}, one level deep",
		code = {
			"local {name} = {}",
			"for key, value in pairs({source}) do",
			'\tif typeof(value) == "table" then',
			"\t\t{name}[key] = table.clone(value)",
			"\telse",
			"\t\t{name}[key] = value",
			"\tend",
			"end",
		},
		fields = { name = "name|copy|name", source = "expr|source|source" },
		doc = "Copies the tables one layer down as well. Tables inside those are " ..
			"still shared, which is enough for most saved data.",
		tags = "deep copy clone nested table" }

D{ id = "algoAppendAll", cat = "algo", group = "Building", label = "add a whole list",
		head = "add everything in {source} to {target}",
		code = {
			"for _, item in ipairs({source}) do",
			"\ttable.insert({target}, item)",
			"end",
		},
		fields = { target = "expr|all|list to grow", source = "expr|more|list to add" },
		doc = "Joins two lists end to end, leaving the source untouched.",
		tags = "append concat join extend list" }

D{ id = "algoMerge", cat = "algo", group = "Building", label = "merge records",
		head = "copy everything from {source} into {target}",
		code = {
			"for key, value in pairs({source}) do",
			"\t{target}[key] = value",
			"end",
		},
		fields = { target = "expr|settings|record to fill", source = "expr|overrides|record to copy" },
		doc = "Later values win. This is how a settings table takes overrides on " ..
			"top of its defaults.",
		tags = "merge record dictionary settings override" }

D{ id = "algoSlice", cat = "algo", group = "Building", label = "part of a list",
		head = "make {name} = items {from} to {to} of {list}",
		code = "local {name} = table.move({list}, {from}, {to}, 1, {})",
		fields = { name = "name|part|name", list = "expr|list|list", from = "num|1|from",
			to = "num|5|to" },
		doc = "`table.move` copies a run of items into a fresh list. Handy for " ..
			"showing one page of a long list.",
		tags = "slice sublist page move range" }

D{ id = "algoReverse", cat = "algo", group = "Building", label = "reverse a list",
		head = "reverse {list}",
		code = {
			"for index = 1, math.floor(#{list} / 2) do",
			"\t{list}[index], {list}[#{list} - index + 1] = {list}[#{list} - index + 1], {list}[index]",
			"end",
		},
		fields = { list = "expr|list|list" },
		doc = "Swaps the ends inward until they meet. Reverses in place rather " ..
			"than making a new list.",
		tags = "reverse flip order list swap" }

D{ id = "algoShuffle", cat = "algo", group = "Building", label = "shuffle a list",
		head = "shuffle {list}",
		code = {
			"for index = #{list}, 2, -1 do",
			"\tlocal swap = math.random(1, index)",
			"\t{list}[index], {list}[swap] = {list}[swap], {list}[index]",
			"end",
		},
		fields = { list = "expr|deck|list" },
		doc = "The proper shuffle: walk backwards swapping each item with a " ..
			"random earlier one. Every order comes up equally often.",
		tags = "shuffle random order deck fisher yates" }

D{ id = "algoUnique", cat = "algo", group = "Building", label = "remove duplicates",
		head = "make {name} = {list} with duplicates removed",
		code = {
			"local {name} = {}",
			"do",
			"\tlocal seen = {}",
			"\tfor _, item in ipairs({list}) do",
			"\t\tif not seen[item] then",
			"\t\t\tseen[item] = true",
			"\t\t\ttable.insert({name}, item)",
			"\t\tend",
			"\tend",
			"end",
		},
		fields = { name = "name|unique|name", list = "expr|list|list" },
		doc = "Keeps the first of each value and the original order. The `seen` " ..
			"table is what makes it fast rather than a search per item.",
		tags = "unique duplicates distinct set list" }

-- searching -------------------------------------------------------------------------
D{ id = "algoWhere", cat = "algo", group = "Searching", label = "where a value is",
		head = "make {name} = where {value} is in {list}",
		code = "local {name} = table.find({list}, {value})",
		fields = { name = "name|at|name", list = "expr|list|list", value = "expr|item|value" },
		doc = "Gives the position, or nil when it is not there. Works on any kind " ..
			"of value, including instances.",
		tags = "find index position search list" }

D{ id = "algoFirst", cat = "algo", group = "Searching", label = "the first item",
		head = "make {name} = the first item of {list}",
		code = "local {name} = {list}[1]",
		fields = { name = "name|first|name", list = "expr|list|list" },
		doc = "Nil when the list is empty, so check before using it.",
		tags = "first head front item list" }

D{ id = "algoLast", cat = "algo", group = "Searching", label = "the last item",
		head = "make {name} = the last item of {list}",
		code = "local {name} = {list}[#{list}]",
		fields = { name = "name|last|name", list = "expr|list|list" },
		doc = "`#list` is the position of the last item, so this reads the end " ..
			"without knowing how long it is.",
		tags = "last end back item list" }

D{ id = "algoRandomItem", cat = "algo", group = "Searching", label = "a random item",
		head = "make {name} = a random item from {list}",
		code = "local {name} = {list}[math.random(1, #{list})]",
		fields = { name = "name|picked|name", list = "expr|list|list" },
		doc = "Errors on an empty list, because `math.random(1, 0)` is not a " ..
			"range. Check the length first if it might be empty.",
		tags = "random pick choose item list" }

D{ id = "algoWeightedPick", cat = "algo", group = "Searching", label = "a weighted random pick",
		head = "make {name} = a random key from {weights}, by weight",
		code = {
			"local {name} = nil",
			"do",
			"\tlocal total = 0",
			"\tfor _, weight in pairs({weights}) do",
			"\t\ttotal = total + weight",
			"\tend",
			"\tlocal roll = math.random() * total",
			"\tfor key, weight in pairs({weights}) do",
			"\t\troll = roll - weight",
			"\t\tif roll <= 0 then",
			"\t\t\t{name} = key",
			"\t\t\tbreak",
			"\t\tend",
			"\tend",
			"end",
		},
		fields = { name = "name|prize|name",
			weights = "expr|{ common = 70, rare = 25, legendary = 5 }|weights" },
		doc = "Loot tables in one block. The weights need not add up to a hundred " ..
			"-- they are shares of the total, whatever it is.",
		tags = "weighted random loot chance drop rarity" }

D{ id = "algoCountIf", cat = "algo", group = "Searching", label = "count matching items",
		head = "make {name} = how many {item} in {list} have {test}",
		code = {
			"local {name} = 0",
			"for _, {item} in ipairs({list}) do",
			"\tif {test} then",
			"\t\t{name} = {name} + 1",
			"\tend",
			"end",
		},
		fields = { name = "name|matches|name", list = "expr|list|list", item = "name|item|each",
			test = "expr|item.alive|condition" },
		doc = "The condition can mention the name you gave each item, so `count " ..
			"how many item have item.health > 0` reads as you would say it.",
		tags = "count filter condition tally list" }

D{ id = "algoFilter", cat = "algo", group = "Searching", label = "keep matching items",
		head = "make {name} = every {item} in {list} where {test}",
		code = {
			"local {name} = {}",
			"for _, {item} in ipairs({list}) do",
			"\tif {test} then",
			"\t\ttable.insert({name}, {item})",
			"\tend",
			"end",
		},
		fields = { name = "name|kept|name", list = "expr|list|list", item = "name|item|each",
			test = "expr|item.alive|condition" },
		doc = "Builds a new list of the ones that pass, leaving the original " ..
			"alone.",
		tags = "filter where keep select list" }

D{ id = "algoMap", cat = "algo", group = "Searching", label = "change every item",
		head = "make {name} = every {item} in {list} turned into {value}",
		code = {
			"local {name} = {}",
			"for _, {item} in ipairs({list}) do",
			"\ttable.insert({name}, {value})",
			"end",
		},
		fields = { name = "name|changed|name", list = "expr|players|list", item = "name|item|each",
			value = "expr|item.Name|new value" },
		doc = "One in, one out. Turning a list of players into a list of their " ..
			"names is a line of this.",
		tags = "map transform convert list each" }

D{ id = "algoBestBy", cat = "algo", group = "Searching", label = "the best item",
		head = "make {name} = the {item} in {list} with the {mode} {value}",
		code = {
			"local {name} = nil",
			"do",
			"\tlocal best = nil",
			"\tfor _, {item} in ipairs({list}) do",
			"\t\tlocal score = {value}",
			"\t\tif best == nil or score {compare} best then",
			"\t\t\tbest = score",
			"\t\t\t{name} = {item}",
			"\t\tend",
			"\tend",
			"end",
		},
		fields = { name = "name|winner|name", list = "expr|players|list", item = "name|item|each",
			value = "expr|item.score|value", mode = "choice|highest|mode|highest,lowest",
			compare = "choice|>|comparison|>,<" },
		doc = "One pass, keeping whichever is best so far. Set the comparison to " ..
			"match the wording -- `>` for highest, `<` for lowest.",
		tags = "max min best highest lowest winner" }

D{ id = "algoSum", cat = "algo", group = "Searching", label = "add a list up",
		head = "make {name} = the total of {list}",
		code = {
			"local {name} = 0",
			"for _, value in ipairs({list}) do",
			"\t{name} = {name} + value",
			"end",
		},
		fields = { name = "name|total|name", list = "expr|scores|list" },
		doc = "Only works on a list of numbers -- add a check inside if the list " ..
			"might hold anything else.",
		tags = "sum total add numbers list" }

D{ id = "algoAverage", cat = "algo", group = "Searching", label = "average a list",
		head = "make {name} = the average of {list}",
		code = {
			"local {name} = 0",
			"if #{list} > 0 then",
			"\tlocal total = 0",
			"\tfor _, value in ipairs({list}) do",
			"\t\ttotal = total + value",
			"\tend",
			"\t{name} = total / #{list}",
			"end",
		},
		fields = { name = "name|mean|name", list = "expr|scores|list" },
		doc = "Guards against an empty list, which would otherwise divide by " ..
			"zero and give you a very strange number.",
		tags = "average mean total numbers list" }

-- changing ---------------------------------------------------------------------------
D{ id = "algoRemoveIf", cat = "algo", group = "Changing", label = "remove matching items",
		head = "remove every {item} from {list} where {test}",
		code = {
			"for index = #{list}, 1, -1 do",
			"\tlocal {item} = {list}[index]",
			"\tif {test} then",
			"\t\ttable.remove({list}, index)",
			"\tend",
			"end",
		},
		fields = { list = "expr|list|list", item = "name|item|each", test = "expr|item.dead|condition" },
		doc = "Counts backwards, which is the only safe way to remove while " ..
			"looping -- forwards, removing one makes the loop skip the next.",
		tags = "remove filter delete backwards list" }

D{ id = "algoSwapItems", cat = "algo", group = "Changing", label = "swap two items",
		head = "swap items {a} and {b} of {list}",
		code = "{list}[{a}], {list}[{b}] = {list}[{b}], {list}[{a}]",
		fields = { list = "expr|list|list", a = "num|1|first", b = "num|2|second" },
		doc = "Luau assigns both sides at once, so no temporary variable is " ..
			"needed.",
		tags = "swap exchange positions list" }

D{ id = "algoPopFirst", cat = "algo", group = "Changing", label = "take the first item",
		head = "make {name} = the first item taken off {list}",
		code = "local {name} = table.remove({list}, 1)",
		fields = { name = "name|next|name", list = "expr|queue|list" },
		doc = "Removes and hands back the front item, which is what makes a " ..
			"queue. Everything else shuffles down one.",
		tags = "queue pop shift first remove" }

D{ id = "algoPopLast", cat = "algo", group = "Changing", label = "take the last item",
		head = "make {name} = the last item taken off {list}",
		code = "local {name} = table.remove({list})",
		fields = { name = "name|top|name", list = "expr|stack|list" },
		doc = "Removes and hands back the end item, which is what makes a stack. " ..
			"Faster than taking from the front, since nothing has to shuffle.",
		tags = "stack pop last remove undo" }

D{ id = "algoEmptyCheck", cat = "algo", group = "Changing", label = "if a list is empty",
		head = "if {list} is empty then",
		code = "if #{list} == 0 then", tail = "end",
		fields = { list = "expr|list|list" },
		slots = { { key = "body" } },
		doc = "Checks the length rather than comparing to an empty table, which " ..
			"would never be equal.",
		tags = "empty length check zero list" }

D{ id = "algoFreeze", cat = "algo", group = "Changing", label = "lock a table",
		head = "lock {table} so nothing can change it",
		code = "table.freeze({table})",
		fields = { table = "expr|SETTINGS|table" },
		doc = "Any later attempt to change it errors instead of silently " ..
			"succeeding. Worth doing to a table of constants.",
		tags = "freeze constant readonly immutable" }

-- order ---------------------------------------------------------------------------------
D{ id = "algoSortNumbers", cat = "algo", group = "Order", label = "sort numbers",
		head = "sort {list} {order}",
		code = {
			"table.sort({list}, function(a, b)",
			"\treturn a {compare} b",
			"end)",
		},
		fields = { list = "expr|scores|list", order = "choice|lowest first|order|lowest first,highest first",
			compare = "choice|<|comparison|<,>" },
		doc = "Sorting rearranges the list itself. Set the comparison to match " ..
			"the wording: `<` puts the smallest first.",
		tags = "sort order numbers ascending descending" }

D{ id = "algoSortBy", cat = "algo", group = "Order", label = "sort by a field",
		head = "sort {list} by each item's {field}, {order}",
		code = {
			"table.sort({list}, function(a, b)",
			"\treturn a.{field} {compare} b.{field}",
			"end)",
		},
		fields = { list = "expr|players|list", field = "str|score|field name",
			order = "choice|highest first|order|highest first,lowest first",
			compare = "choice|>|comparison|>,<" },
		doc = "For a list of records. Sorting players by score before showing a " ..
			"leaderboard is exactly this.",
		tags = "sort field record leaderboard order" }

D{ id = "algoSortText", cat = "algo", group = "Order", label = "sort text",
		head = "sort {list} into alphabetical order",
		code = {
			"table.sort({list}, function(a, b)",
			"\treturn string.lower(a) < string.lower(b)",
			"end)",
		},
		fields = { list = "expr|names|list" },
		doc = "Lowercasing both sides first stops every capitalised word sorting " ..
			"ahead of every lowercase one.",
		tags = "sort alphabetical text names order" }

-- records --------------------------------------------------------------------------------
D{ id = "algoKeys", cat = "algo", group = "Records", label = "list the keys",
		head = "make {name} = the keys of {record}",
		code = {
			"local {name} = {}",
			"for key in pairs({record}) do",
			"\ttable.insert({name}, key)",
			"end",
		},
		fields = { name = "name|keys|name", record = "expr|record|record" },
		doc = "Turns a dictionary into a list you can sort or count. The order " ..
			"they come out in is not guaranteed.",
		tags = "keys dictionary record list pairs" }

D{ id = "algoValues", cat = "algo", group = "Records", label = "list the values",
		head = "make {name} = the values of {record}",
		code = {
			"local {name} = {}",
			"for _, value in pairs({record}) do",
			"\ttable.insert({name}, value)",
			"end",
		},
		fields = { name = "name|values|name", record = "expr|record|record" },
		doc = "The other half of the pair. Useful when you care what is in a " ..
			"dictionary but not what it is filed under.",
		tags = "values dictionary record list pairs" }

D{ id = "algoCountKeys", cat = "algo", group = "Records", label = "count the entries",
		head = "make {name} = how many entries {record} has",
		code = {
			"local {name} = 0",
			"for _ in pairs({record}) do",
			"\t{name} = {name} + 1",
			"end",
		},
		fields = { name = "name|entries|name", record = "expr|record|record" },
		doc = "`#` cannot count a dictionary -- it only works on numbered lists " ..
			"-- so counting means walking it.",
		tags = "count size dictionary record entries" }

D{ id = "algoTally", cat = "algo", group = "Records", label = "tally up",
		head = "make {name} = how many times each item appears in {list}",
		code = {
			"local {name} = {}",
			"for _, item in ipairs({list}) do",
			"\t{name}[item] = ({name}[item] or 0) + 1",
			"end",
		},
		fields = { name = "name|counts|name", list = "expr|list|list" },
		doc = "The `or 0` handles the first time each value is seen. Counting " ..
			"votes and inventory stacks are both this.",
		tags = "tally count occurrences histogram inventory" }

D{ id = "algoSetAdd", cat = "algo", group = "Records", label = "mark as seen",
		head = "mark {value} as present in {set}",
		code = "{set}[{value}] = true",
		fields = { set = "expr|seen|set", value = "expr|item|value" },
		doc = "A table used as a set: the value is the key. Checking membership " ..
			"is then instant, however many items there are.",
		tags = "set add mark seen membership" }

D{ id = "algoSetHas", cat = "algo", group = "Records", label = "if it has been seen",
		head = "if {set} contains {value} then",
		code = "if {set}[{value}] then", tail = "end",
		fields = { set = "expr|seen|set", value = "expr|item|value" },
		slots = { { key = "body" } },
		doc = "Far faster than searching a list, and the reason sets are worth " ..
			"the odd-looking table.",
		tags = "set contains check membership fast" }

D{ id = "algoSetRemove", cat = "algo", group = "Records", label = "unmark",
		head = "unmark {value} in {set}",
		code = "{set}[{value}] = nil",
		fields = { set = "expr|seen|set", value = "expr|item|value" },
		doc = "Setting a key to nil is how you delete it. There is no separate " ..
			"remove for dictionaries.",
		tags = "set remove delete nil unmark" }

--=============================================================================
-- TEXT PATTERNS
--=============================================================================

D{ id = "patMatches", cat = "pattern", group = "Finding", label = "if it matches a pattern",
		head = 'if {text} matches "{pattern}" then',
		code = 'if string.match({text}, "{pattern}") then', tail = "end",
		fields = { text = "expr|text|text", pattern = "str|%d+|pattern" },
		slots = { { key = "body" } },
		doc = "In a Luau pattern `%d` is a digit, `%a` a letter, `%s` a space and " ..
			"`+` means one or more. `%d+` finds any run of digits.",
		tags = "match pattern regex find check" }

D{ id = "patPull", cat = "pattern", group = "Finding", label = "pull a piece out",
		head = 'make {name} = the "{pattern}" inside {text}',
		code = 'local {name} = string.match({text}, "{pattern}")',
		fields = { name = "name|found|name", text = "expr|text|text", pattern = "str|%d+|pattern" },
		doc = "Brackets in the pattern say which part you want back. Nil when " ..
			"nothing matches.",
		tags = "match capture extract pattern pull" }

D{ id = "patPullTwo", cat = "pattern", group = "Finding", label = "pull two pieces out",
		head = 'make {a} and {b} = the two parts of "{pattern}" in {text}',
		code = 'local {a}, {b} = string.match({text}, "{pattern}")',
		fields = { a = "name|first|first name", b = "name|second|second name",
			text = "expr|text|text", pattern = "str|(%a+)=(%d+)|pattern" },
		doc = "Two sets of brackets give two answers. `(%a+)=(%d+)` splits " ..
			"`speed=20` into its name and its number.",
		tags = "match captures two extract pattern" }

D{ id = "patEach", cat = "pattern", group = "Finding", label = "for each match",
		head = 'for each "{pattern}" found in {text} as {item}',
		code = 'for {item} in string.gmatch({text}, "{pattern}") do', tail = "end",
		fields = { text = "expr|text|text", pattern = "str|%a+|pattern", item = "name|word|each" },
		slots = { { key = "body" } },
		doc = "Walks every match rather than just the first. `%a+` gives you each " ..
			"word in turn.",
		tags = "gmatch each loop pattern words" }

D{ id = "patWords", cat = "pattern", group = "Finding", label = "for each word",
		head = "for each word {word} in {text}",
		code = 'for {word} in string.gmatch({text}, "%S+") do', tail = "end",
		fields = { text = "expr|message|text", word = "name|word|each word" },
		slots = { { key = "body" } },
		doc = "`%S+` means a run of anything that is not a space, which is a " ..
			"good enough definition of a word for most purposes.",
		tags = "words split gmatch loop text" }

D{ id = "patLines", cat = "pattern", group = "Finding", label = "for each line",
		head = "for each line {line} in {text}",
		code = 'for {line} in string.gmatch({text}, "[^\\n]+") do', tail = "end",
		fields = { text = "expr|text|text", line = "name|line|each line" },
		slots = { { key = "body" } },
		doc = "`[^\\n]+` means a run of anything that is not a newline. Blank " ..
			"lines are skipped.",
		tags = "lines split newline gmatch loop" }

D{ id = "patCount", cat = "pattern", group = "Finding", label = "count matches",
		head = 'make {name} = how many "{pattern}" are in {text}',
		code = {
			"local {name} = 0",
			'for _ in string.gmatch({text}, "{pattern}") do',
			"\t{name} = {name} + 1",
			"end",
		},
		fields = { name = "name|found|name", text = "expr|text|text", pattern = "str|%a+|pattern" },
		doc = "Counting words in a message, or commas in a line of data.",
		tags = "count matches gmatch tally pattern" }

D{ id = "patStartsWith", cat = "pattern", group = "Finding", label = "if it starts with",
		head = 'if {text} starts with "{start}" then',
		code = 'if string.sub({text}, 1, #"{start}") == "{start}" then', tail = "end",
		fields = { text = "expr|text|text", start = "str|/|beginning" },
		slots = { { key = "body" } },
		doc = "Comparing the first characters is safer than a pattern, because " ..
			"punctuation in the text means nothing special here.",
		tags = "startswith prefix begins command check" }

D{ id = "patEndsWith", cat = "pattern", group = "Finding", label = "if it ends with",
		head = 'if {text} ends with "{ending}" then',
		code = 'if string.sub({text}, -#"{ending}") == "{ending}" then', tail = "end",
		fields = { text = "expr|filename|text", ending = "str|.png|ending" },
		slots = { { key = "body" } },
		doc = "A negative position counts back from the end, so this compares " ..
			"just the last few characters.",
		tags = "endswith suffix extension check" }

-- changing -------------------------------------------------------------------------------
D{ id = "patReplace", cat = "pattern", group = "Changing", label = "replace a pattern",
		head = 'make {name} = {text} with "{pattern}" replaced by "{with}"',
		code = 'local {name} = string.gsub({text}, "{pattern}", "{with}")',
		fields = { name = "name|cleaned|name", text = "expr|text|text",
			pattern = "str|%s+|pattern", with = "str| |replacement" },
		doc = "Replaces every match. In the replacement, `%1` stands for the " ..
			"first bracketed piece of the pattern.",
		tags = "gsub replace substitute pattern clean" }

D{ id = "patReplaceSome", cat = "pattern", group = "Changing", label = "replace the first few",
		head = 'make {name} = {text} with the first {count} "{pattern}" replaced by "{with}"',
		code = 'local {name} = string.gsub({text}, "{pattern}", "{with}", {count})',
		fields = { name = "name|changed|name", text = "expr|text|text", pattern = "str|a|pattern",
			with = "str|b|replacement", count = "num|1|how many" },
		doc = "The last number caps how many are replaced, which is how you " ..
			"change only the first occurrence.",
		tags = "gsub replace limit first pattern" }

D{ id = "patTrim", cat = "pattern", group = "Changing", label = "trim the spaces",
		head = "make {name} = {text} with the spaces trimmed off each end",
		code = 'local {name} = string.match({text}, "^%s*(.-)%s*$")',
		fields = { name = "name|trimmed|name", text = "expr|typed|text" },
		doc = "Anything a player types is worth trimming. `.-` means as little " ..
			"as possible, which is what stops it eating the middle.",
		tags = "trim strip whitespace clean input" }

D{ id = "patPad", cat = "pattern", group = "Changing", label = "pad to a width",
		head = "make {name} = {text} padded to {width} characters on the {side}",
		code = {
			"local {name} = tostring({text})",
			"if #{name} < {width} then",
			'\tlocal gap = string.rep(" ", {width} - #{name})',
			'\tif "{side}" == "left" then',
			"\t\t{name} = gap .. {name}",
			"\telse",
			"\t\t{name} = {name} .. gap",
			"\tend",
			"end",
		},
		fields = { name = "name|padded|name", text = "expr|score|text", width = "num|8|width",
			side = "choice|left|side|left,right" },
		doc = "A minus sign pads on the right, nothing pads on the left. Lining " ..
			"up columns of text in the output window needs this.",
		tags = "pad align columns format width" }

D{ id = "patRepeat", cat = "pattern", group = "Changing", label = "repeat text",
		head = "make {name} = \"{text}\" repeated {count} times",
		code = 'local {name} = string.rep("{text}", {count})',
		fields = { name = "name|bar|name", text = "str|=|text", count = "num|20|times" },
		doc = "Drawing a bar out of characters, or indenting by a level, is one " ..
			"of these.",
		tags = "rep repeat string bar indent" }

D{ id = "patCapitalise", cat = "pattern", group = "Changing", label = "capitalise",
		head = "make {name} = {text} with its first letter capitalised",
		code = "local {name} = string.upper(string.sub({text}, 1, 1)) .. string.sub({text}, 2)",
		fields = { name = "name|proper|name", text = "expr|word|text" },
		doc = "Upper-cases the first character and glues the rest back on " ..
			"unchanged.",
		tags = "capitalise upper first letter proper" }

D{ id = "patTitleCase", cat = "pattern", group = "Changing", label = "capitalise every word",
		head = "make {name} = {text} with every word capitalised",
		code = 'local {name} = string.gsub({text}, "(%a)([%w]*)", function(first, rest)\n' ..
			"\treturn string.upper(first) .. string.lower(rest)\n" ..
			"end)",
		fields = { name = "name|title|name", text = "expr|text|text" },
		doc = "Handing gsub a function lets you decide the replacement per match, " ..
			"which is far more powerful than a fixed string.",
		tags = "title case capitalise words gsub function" }

D{ id = "patShorten", cat = "pattern", group = "Changing", label = "shorten with dots",
		head = "make {name} = {text} shortened to {width} characters",
		code = {
			"local {name} = {text}",
			"if #{name} > {width} then",
			'\t{name} = string.sub({name}, 1, {width} - 3) .. "..."',
			"end",
		},
		fields = { name = "name|short|name", text = "expr|title|text", width = "num|20|width" },
		doc = "Cuts long names down to fit a button, leaving room for the dots so " ..
			"the result is never longer than asked for.",
		tags = "truncate shorten ellipsis fit label" }

D{ id = "patEscape", cat = "pattern", group = "Changing", label = "make text safe as a pattern",
		head = "make {name} = {text} made safe to use as a pattern",
		code = 'local {name} = string.gsub({text}, "([%^%$%(%)%%%.%[%]%*%+%-%?])", "%%%1")',
		fields = { name = "name|safe|name", text = "expr|typed|text" },
		doc = "Characters like `.` and `-` mean something special in a pattern. " ..
			"Escaping them first lets you search for text a player typed.",
		tags = "escape pattern magic characters safe search" }

-- cleaning up ----------------------------------------------------------------------------
D{ id = "patDigitsOnly", cat = "pattern", group = "Cleaning", label = "keep only digits",
		head = "make {name} = only the digits in {text}",
		code = 'local {name} = string.gsub({text}, "%D", "")',
		fields = { name = "name|digits|name", text = "expr|typed|text" },
		doc = "`%D` means anything that is not a digit. Replacing them with " ..
			"nothing leaves the number.",
		tags = "digits numbers strip clean filter" }

D{ id = "patLettersOnly", cat = "pattern", group = "Cleaning", label = "keep only letters",
		head = "make {name} = only the letters and spaces in {text}",
		code = 'local {name} = string.gsub({text}, "[^%a%s]", "")',
		fields = { name = "name|clean|name", text = "expr|typed|text" },
		doc = "Strips punctuation and numbers. A rough way to tidy up anything " ..
			"typed by a player.",
		tags = "letters strip punctuation clean filter" }

D{ id = "patIsNumber", cat = "pattern", group = "Cleaning", label = "if it is a number",
		head = "if {text} is a number then",
		code = "if tonumber({text}) then", tail = "end",
		fields = { text = "expr|typed|text" },
		slots = { { key = "body" } },
		doc = "`tonumber` gives nil for anything that is not one, which makes it " ..
			"the check as well as the conversion.",
		tags = "tonumber check number valid input" }

D{ id = "patFilterText", cat = "pattern", group = "Cleaning", label = "filter for safety",
		head = "make {name} = {text} filtered for {player}",
		code = {
			"local {name} = \"\"",
			"do",
			"\tlocal ok, filtered = pcall(function()",
			"\t\treturn TextService:FilterStringAsync({text}, {player}.UserId)",
			"\tend)",
			"\tif ok then",
			"\t\t{name} = filtered:GetNonChatStringForBroadcastAsync()",
			"\tend",
			"end",
		},
		fields = { name = "name|safe|name", text = "expr|typed|text", player = "expr|player|who wrote it" },
		needs = { "TextService" }, side = "server",
		doc = "Any text one player typed that another will see has to go through " ..
			"this. It is a rule, not a suggestion, and it only works on the server.",
		tags = "filterstringasync filter safety chat moderation" }

-- numbers and dates ---------------------------------------------------------------------------
D{ id = "patCommas", cat = "pattern", group = "Numbers", label = "add thousands separators",
		head = "make {name} = {n} with commas between the thousands",
		code = {
			"local {name} = tostring(math.floor({n}))",
			"while true do",
			"\tlocal replaced",
			'\t{name}, replaced = string.gsub({name}, "^(-?%d+)(%d%d%d)", "%1,%2")',
			"\tif replaced == 0 then",
			"\t\tbreak",
			"\tend",
			"end",
		},
		fields = { name = "name|pretty|name", n = "expr|coins|number" },
		doc = "Works from the right in threes until there is nothing left to " ..
			"split. 1234567 becomes 1,234,567.",
		tags = "commas thousands format number pretty" }

D{ id = "patShortNumber", cat = "pattern", group = "Numbers", label = "shorten a big number",
		head = "make {name} = {n} written short",
		code = {
			"local {name}",
			"do",
			"\tlocal value = {n}",
			"\tif value >= 1000000 then",
			'\t\t{name} = string.format("%.1fM", value / 1000000)',
			"\telseif value >= 1000 then",
			'\t\t{name} = string.format("%.1fK", value / 1000)',
			"\telse",
			"\t\t{name} = tostring(math.floor(value))",
			"\tend",
			"end",
		},
		fields = { name = "name|short|name", n = "expr|coins|number" },
		doc = "1500 becomes 1.5K and 2400000 becomes 2.4M, which is how most " ..
			"games show big numbers on a button.",
		tags = "abbreviate short number k m suffix" }

D{ id = "patClock", cat = "pattern", group = "Numbers", label = "seconds as a clock",
		head = "make {name} = {seconds} written as minutes and seconds",
		code = 'local {name} = string.format("%d:%02d", math.floor({seconds} / 60), ' ..
			"math.floor({seconds} % 60))",
		fields = { name = "name|clock|name", seconds = "expr|timeLeft|seconds" },
		doc = "`%02d` pads to two digits, which is what stops 3:5 appearing " ..
			"instead of 3:05.",
		tags = "time clock minutes seconds format countdown" }

D{ id = "patLongClock", cat = "pattern", group = "Numbers", label = "seconds as hours",
		head = "make {name} = {seconds} written as hours, minutes and seconds",
		code = 'local {name} = string.format("%d:%02d:%02d", math.floor({seconds} / 3600), ' ..
			"math.floor({seconds} % 3600 / 60), math.floor({seconds} % 60))",
		fields = { name = "name|clock|name", seconds = "expr|played|seconds" },
		doc = "For play time and long timers. Same idea as the shorter version, " ..
			"with hours in front.",
		tags = "time hours clock format playtime" }

D{ id = "patPlural", cat = "pattern", group = "Numbers", label = "pluralise",
		head = 'make {name} = {n} and "{word}", made plural if needed',
		code = 'local {name} = {n} .. " {word}" .. ({n} == 1 and "" or "s")',
		fields = { name = "name|label|name", n = "expr|count|number", word = "str|coin|word" },
		doc = "`1 coin` and `2 coins` without an if block. Only works for words " ..
			"that pluralise with an s.",
		tags = "plural singular grammar count label" }

D{ id = "patDate", cat = "pattern", group = "Numbers", label = "today's date",
		head = "make {name} = today's date as text",
		code = 'local {name} = os.date("{format}")',
		fields = { name = "name|today|name", format = "str|%d %B %Y|format" },
		doc = "`%d` is the day, `%B` the month name, `%Y` the year. Uses the " ..
			"server's clock, which is always UTC.",
		tags = "date time os format today" }

D{ id = "patRandomId", cat = "pattern", group = "Numbers", label = "a random code",
		head = "make {name} = a random {length} letter code",
		code = {
			"local {name} = \"\"",
			"for _ = 1, {length} do",
			'\t{name} = {name} .. string.char(math.random(65, 90))',
			"end",
		},
		fields = { name = "name|code|name", length = "num|6|length" },
		doc = "Character codes 65 to 90 are the capital letters. Good enough for " ..
			"a party code; not good enough for anything secret.",
		tags = "random code id letters generate party" }

--=============================================================================
-- SPACE AND ANGLES
--=============================================================================

D{ id = "vecTowards", cat = "vec", group = "Directions", label = "direction towards",
		head = "make {name} = the direction from {from} to {to}",
		code = "local {name} = ({to} - {from}).Unit",
		fields = { name = "name|way|name", from = "expr|part.Position|from", to = "expr|target.Position|to" },
		doc = "Subtracting gives the arrow between them; `.Unit` shortens it to " ..
			"length one so it is purely a direction.",
		tags = "direction unit normalise towards aim" }

D{ id = "vecFlatDistance", cat = "vec", group = "Directions", label = "distance ignoring height",
		head = "make {name} = how far {a} is from {b}, ignoring height",
		code = {
			"local {name}",
			"do",
			"\tlocal gap = {a} - {b}",
			"\t{name} = Vector3.new(gap.X, 0, gap.Z).Magnitude",
			"end",
		},
		fields = { name = "name|gap|name", a = "expr|part.Position|first", b = "expr|target.Position|second" },
		doc = "Flattening the height first is what stops a player on a tower " ..
			"counting as far away from something directly below them.",
		tags = "distance flat horizontal ignore height" }

D{ id = "vecLength", cat = "vec", group = "Directions", label = "length of a direction",
		head = "make {name} = the length of {vector}",
		code = "local {name} = {vector}.Magnitude",
		fields = { name = "name|length|name", vector = "expr|velocity|vector" },
		doc = "The length of a velocity is the speed. The length of the gap " ..
			"between two positions is the distance.",
		tags = "magnitude length speed size vector" }

D{ id = "vecShorten", cat = "vec", group = "Directions", label = "shorten to length one",
		head = "make {name} = {vector} shortened to length one",
		code = "local {name} = {vector}.Unit",
		fields = { name = "name|way|name", vector = "expr|direction|vector" },
		doc = "Keeps the direction and throws away the distance, which is what " ..
			"you want before multiplying by a speed.",
		tags = "unit normalise direction length one" }

D{ id = "vecCapLength", cat = "vec", group = "Directions", label = "cap a length",
		head = "make {name} = {vector} capped at {max} long",
		code = {
			"local {name} = {vector}",
			"if {name}.Magnitude > {max} then",
			"\t{name} = {name}.Unit * {max}",
			"end",
		},
		fields = { name = "name|capped|name", vector = "expr|push|vector", max = "num|50|maximum" },
		doc = "Stops a knockback becoming absurd when something is very close. " ..
			"Directions under the cap are left alone.",
		tags = "clamp cap magnitude limit speed" }

D{ id = "vecBlend", cat = "vec", group = "Directions", label = "blend two positions",
		head = "make {name} = {a} moved {t} of the way to {b}",
		code = "local {name} = {a}:Lerp({b}, {t})",
		fields = { name = "name|between|name", a = "expr|start|from", b = "expr|finish|to",
			t = "expr|0.5|amount" },
		doc = "0 gives the first, 1 the second, 0.5 the midpoint. Running it " ..
			"every frame with a small amount is how smooth following is done.",
		tags = "lerp blend interpolate between smooth" }

D{ id = "vecDot", cat = "vec", group = "Directions", label = "how much two agree",
		head = "make {name} = how much {a} and {b} point the same way",
		code = "local {name} = {a}.Unit:Dot({b}.Unit)",
		fields = { name = "name|agreement|name", a = "expr|lookVector|first", b = "expr|toTarget|second" },
		doc = "1 means the same direction, 0 means at right angles, -1 means " ..
			"opposite. Checking something is in front is `> 0`.",
		tags = "dot product angle facing infront behind" }

D{ id = "vecCross", cat = "vec", group = "Directions", label = "the perpendicular",
		head = "make {name} = the direction at right angles to both {a} and {b}",
		code = "local {name} = {a}:Cross({b})",
		fields = { name = "name|sideways|name", a = "expr|forward|first", b = "expr|Vector3.yAxis|second" },
		doc = "Crossing a forward direction with straight up gives the sideways " ..
			"direction, which is how strafing is worked out.",
		tags = "cross product perpendicular sideways right" }

D{ id = "vecFacing", cat = "vec", group = "Directions", label = "which way it faces",
		head = "make {name} = the direction {part} is facing",
		code = "local {name} = {part}.CFrame.LookVector",
		fields = { name = "name|forward|name", part = "expr|part|part" },
		doc = "LookVector is straight ahead, RightVector is to its right, " ..
			"UpVector is out of its top.",
		tags = "lookvector forward facing direction cframe" }

D{ id = "vecInFront", cat = "vec", group = "Directions", label = "a spot in front",
		head = "make {name} = the spot {n} studs in front of {part}",
		code = "local {name} = {part}.Position + {part}.CFrame.LookVector * {n}",
		fields = { name = "name|ahead|name", part = "expr|part|part", n = "num|10|studs" },
		doc = "Spawning a projectile, or checking what is ahead, starts here. " ..
			"Multiply by a negative number for behind.",
		tags = "front ahead lookvector offset spawn" }

-- rotations -------------------------------------------------------------------------------
D{ id = "cfAt", cat = "vec", group = "Rotations", label = "a place",
		head = "make {name} = the place ({x}, {y}, {z})",
		code = "local {name} = CFrame.new({x}, {y}, {z})",
		fields = { name = "name|spot|name", x = "expr|0|x", y = "expr|5|y", z = "expr|0|z" },
		doc = "A CFrame is a position and a facing together. This one faces the " ..
			"default direction.",
		tags = "cframe position place new" }

D{ id = "cfLooking", cat = "vec", group = "Rotations", label = "a place looking at",
		head = "make {name} = standing at {from} looking at {to}",
		code = "local {name} = CFrame.lookAt({from}, {to})",
		fields = { name = "name|view|name", from = "expr|Vector3.new(0, 10, 0)|from",
			to = "expr|target.Position|looking at" },
		doc = "Works out the facing for you. Almost always easier than building " ..
			"a rotation out of angles.",
		tags = "lookat cframe facing aim camera" }

D{ id = "cfTurned", cat = "vec", group = "Rotations", label = "a rotation in degrees",
		head = "make {name} = a rotation of {x}, {y}, {z} degrees",
		code = "local {name} = CFrame.Angles(math.rad({x}), math.rad({y}), math.rad({z}))",
		fields = { name = "name|turn|name", x = "expr|0|x", y = "expr|90|y", z = "expr|0|z" },
		doc = "CFrame.Angles wants radians, so the degrees are converted. Y is " ..
			"the one that spins a thing on the spot.",
		tags = "cframe angles rotation degrees radians turn" }

D{ id = "cfCombine", cat = "vec", group = "Rotations", label = "move relative to something",
		head = "make {name} = {cf} moved {x}, {y}, {z} in its own directions",
		code = "local {name} = {cf} * CFrame.new({x}, {y}, {z})",
		fields = { name = "name|moved|name", cf = "expr|part.CFrame|starting place",
			x = "expr|0|right", y = "expr|0|up", z = "expr|-5|forward" },
		doc = "Multiplying applies the second as an offset in the first's own " ..
			"directions. Negative Z is forward, which catches everyone out once.",
		tags = "cframe multiply relative offset local forward" }

D{ id = "cfSpin", cat = "vec", group = "Rotations", label = "turn something on the spot",
		head = "make {name} = {cf} turned {n} degrees",
		code = "local {name} = {cf} * CFrame.Angles(0, math.rad({n}), 0)",
		fields = { name = "name|turned|name", cf = "expr|part.CFrame|starting place", n = "expr|90|degrees" },
		doc = "Turns around its own upright axis, keeping it where it is. Run it " ..
			"every frame with a small angle to spin something.",
		tags = "rotate spin turn cframe angles y" }

D{ id = "cfBlend", cat = "vec", group = "Rotations", label = "blend two places",
		head = "make {name} = {a} moved {t} of the way to {b}",
		code = "local {name} = {a}:Lerp({b}, {t})",
		fields = { name = "name|between|name", a = "expr|part.CFrame|from", b = "expr|goal|to",
			t = "expr|0.1|amount" },
		doc = "Blends the position and the facing together, so a camera swinging " ..
			"round to look at something takes one line.",
		tags = "cframe lerp blend smooth camera interpolate" }

D{ id = "cfPositionOf", cat = "vec", group = "Rotations", label = "the position part",
		head = "make {name} = just the position of {cf}",
		code = "local {name} = {cf}.Position",
		fields = { name = "name|spot|name", cf = "expr|part.CFrame|place" },
		doc = "Throws the facing away and keeps the point in space.",
		tags = "cframe position extract point" }

D{ id = "cfWithoutTilt", cat = "vec", group = "Rotations", label = "level it out",
		head = "make {name} = {cf} with its tilt removed",
		code = {
			"local {name}",
			"do",
			"\tlocal look = {cf}.LookVector",
			"\t{name} = CFrame.lookAt({cf}.Position,",
			"\t\t{cf}.Position + Vector3.new(look.X, 0, look.Z))",
			"end",
		},
		fields = { name = "name|level|name", cf = "expr|part.CFrame|place" },
		doc = "Keeps which way it faces but stands it upright. Stops NPCs and " ..
			"cameras leaning over when they look up or down.",
		tags = "level upright tilt flatten cframe" }

-- angles -------------------------------------------------------------------------------------
D{ id = "angBetween", cat = "vec", group = "Angles", label = "angle between",
		head = "make {name} = the angle in degrees between {a} and {b}",
		code = "local {name} = math.deg(math.acos(math.clamp({a}.Unit:Dot({b}.Unit), -1, 1)))",
		fields = { name = "name|angle|name", a = "expr|lookVector|first", b = "expr|toTarget|second" },
		doc = "The clamp guards against tiny rounding errors pushing the value " ..
			"outside what acos accepts, which would give you a nan.",
		tags = "angle between degrees acos dot facing" }

D{ id = "angCompass", cat = "vec", group = "Angles", label = "compass angle",
		head = "make {name} = the compass angle from {a} to {b}",
		code = {
			"local {name}",
			"do",
			"\tlocal gap = {b} - {a}",
			"\t{name} = math.deg(math.atan2(gap.X, gap.Z))",
			"end",
		},
		fields = { name = "name|bearing|name", a = "expr|part.Position|from", b = "expr|target.Position|to" },
		doc = "`atan2` turns an X and Z gap into an angle all the way round, " ..
			"which plain trigonometry cannot do without extra cases.",
		tags = "atan2 bearing compass angle direction minimap" }

D{ id = "angWrap", cat = "vec", group = "Angles", label = "wrap an angle",
		head = "make {name} = {angle} wrapped to between -180 and 180",
		code = "local {name} = ({angle} + 180) % 360 - 180",
		fields = { name = "name|wrapped|name", angle = "expr|turn|degrees" },
		doc = "Stops an angle growing forever, and makes turning the short way " ..
			"round possible: 350 degrees becomes -10.",
		tags = "wrap angle modulo shortest turn" }

D{ id = "angToRadians", cat = "vec", group = "Angles", label = "degrees to radians",
		head = "make {name} = {angle} degrees in radians",
		code = "local {name} = math.rad({angle})",
		fields = { name = "name|radians|name", angle = "expr|90|degrees" },
		doc = "Every Roblox rotation function wants radians. Degrees are for " ..
			"people; radians are for the maths.",
		tags = "rad degrees radians convert angle" }

D{ id = "angToDegrees", cat = "vec", group = "Angles", label = "radians to degrees",
		head = "make {name} = {angle} radians in degrees",
		code = "local {name} = math.deg({angle})",
		fields = { name = "name|degrees|name", angle = "expr|angle|radians" },
		doc = "The way back, for showing an angle to a person.",
		tags = "deg radians degrees convert angle" }

-- curves and easing ------------------------------------------------------------------------------
D{ id = "curveEase", cat = "vec", group = "Curves", label = "ease a fraction",
		head = "make {name} = {t} eased with {style}",
		code = "local {name} = TweenService:GetValue(math.clamp({t}, 0, 1), " ..
			"Enum.EasingStyle.{style}, Enum.EasingDirection.{direction})",
		fields = { name = "name|eased|name", t = "expr|progress|fraction",
			style = "choice|Quad|style|Linear,Quad,Cubic,Quart,Sine,Back,Bounce,Elastic,Exponential,Circular",
			direction = "choice|Out|direction|In,Out,InOut" },
		needs = { "TweenService" },
		doc = "Borrows the tween engine's curves for your own maths, so hand " ..
			"animation can feel the same as a tween.",
		tags = "easing getvalue curve tween interpolate" }

D{ id = "curveMap", cat = "vec", group = "Curves", label = "map one range to another",
		head = "make {name} = {value} mapped from {a} to {b} onto {c} to {d}",
		code = "local {name} = {c} + (({value} - {a}) / ({b} - {a})) * ({d} - {c})",
		fields = { name = "name|mapped|name", value = "expr|health|value", a = "expr|0|from low",
			b = "expr|100|from high", c = "expr|0|to low", d = "expr|1|to high" },
		doc = "Turning health out of 100 into a bar fraction out of 1, or a " ..
			"slider into a volume, is this one line.",
		tags = "map range remap scale normalise convert" }

D{ id = "curveHowFar", cat = "vec", group = "Curves", label = "how far between",
		head = "make {name} = how far {value} is between {a} and {b}",
		code = "local {name} = math.clamp(({value} - {a}) / ({b} - {a}), 0, 1)",
		fields = { name = "name|fraction|name", value = "expr|health|value", a = "expr|0|low",
			b = "expr|100|high" },
		doc = "The opposite of blending: given a value, work out the fraction. " ..
			"Clamped, so values outside the range give 0 or 1.",
		tags = "inverse lerp fraction progress normalise" }

D{ id = "curveApproach", cat = "vec", group = "Curves", label = "step towards",
		head = "make {name} = {current} moved towards {target} by at most {step}",
		code = {
			"local {name} = {current}",
			"do",
			"\tlocal gap = {target} - {current}",
			"\tif math.abs(gap) <= {step} then",
			"\t\t{name} = {target}",
			"\telse",
			"\t\t{name} = {current} + (gap > 0 and {step} or -{step})",
			"\tend",
			"end",
		},
		fields = { name = "name|moved|name", current = "expr|shown|current", target = "expr|actual|target",
			step = "expr|1|most to move" },
		doc = "Moves at a steady rate and lands exactly on the target rather " ..
			"than creeping up on it forever, which blending does.",
		tags = "approach movetowards step steady lerp" }

D{ id = "curveBezier", cat = "vec", group = "Curves", label = "a point on a curve",
		head = "make {name} = the point {t} along the curve from {a} through {control} to {b}",
		code = {
			"local {name}",
			"do",
			"\tlocal first = {a}:Lerp({control}, {t})",
			"\tlocal second = {control}:Lerp({b}, {t})",
			"\t{name} = first:Lerp(second, {t})",
			"end",
		},
		fields = { name = "name|point|name", a = "expr|start|start", control = "expr|midAir|control point",
			b = "expr|finish|end", t = "expr|progress|fraction" },
		doc = "Three blends make a curved path. Putting the control point high " ..
			"above the two ends gives a lobbed arc.",
		tags = "bezier curve arc lob projectile path" }

-- randomness --------------------------------------------------------------------------------------
D{ id = "randDirection", cat = "vec", group = "Randomness", label = "a random direction",
		head = "make {name} = a random direction",
		code = "local {name} = Vector3.new(math.random() - 0.5, math.random() - 0.5, " ..
			"math.random() - 0.5).Unit",
		fields = { name = "name|way|name" },
		doc = "Any direction at all, including up and down. Zero the Y part " ..
			"first if you want it flat.",
		tags = "random direction vector scatter unit" }

D{ id = "randInCircle", cat = "vec", group = "Randomness", label = "a random spot in a circle",
		head = "make {name} = a random spot within {radius} studs of {centre}",
		code = {
			"local {name}",
			"do",
			"\tlocal angle = math.random() * math.pi * 2",
			"\tlocal away = math.sqrt(math.random()) * {radius}",
			"\t{name} = {centre} + Vector3.new(math.cos(angle) * away, 0, " ..
				"math.sin(angle) * away)",
			"end",
		},
		fields = { name = "name|spot|name", centre = "expr|middle|centre", radius = "num|30|radius" },
		doc = "The square root is what stops everything bunching up in the " ..
			"middle -- without it, a circle of spawns looks wrong.",
		tags = "random circle spawn scatter disc even" }

D{ id = "randSeeded", cat = "vec", group = "Randomness", label = "a repeatable randomiser",
		head = "make {name} = a randomiser seeded with {seed}",
		code = "local {name} = Random.new({seed})",
		fields = { name = "name|rolls|name", seed = "expr|12345|seed" },
		doc = "The same seed always gives the same sequence, so a generated world " ..
			"can be rebuilt exactly. Use `{name}:NextNumber()` to draw from it.",
		tags = "random seed repeatable procedural generation" }

D{ id = "randChance", cat = "vec", group = "Randomness", label = "if a chance comes up",
		head = "if a {percent} percent chance comes up then",
		code = "if math.random() * 100 < {percent} then", tail = "end",
		fields = { percent = "expr|25|percent" },
		slots = { { key = "body" } },
		doc = "Reads exactly as it means. `math.random()` gives a decimal from 0 " ..
			"up to 1, so scaling it by 100 gives a percentage.",
		tags = "chance percent random probability drop" }

D{ id = "randNoise", cat = "vec", group = "Randomness", label = "smooth noise",
		head = "make {name} = smooth noise at ({x}, {y}), zoomed out by {scale}",
		code = "local {name} = math.noise({x} / {scale}, {y} / {scale})",
		fields = { name = "name|value|name", x = "expr|position.X|x", y = "expr|position.Z|y",
			scale = "num|50|zoom" },
		doc = "Unlike random, nearby inputs give nearby results, which is what " ..
			"makes rolling hills instead of static. Gives roughly -0.5 to 0.5.",
		tags = "noise perlin terrain smooth procedural hills" }

D{ id = "randNoiseHeight", cat = "vec", group = "Randomness", label = "a noise height",
		head = "make {name} = a hill height at ({x}, {z}), up to {height} studs",
		code = "local {name} = math.noise({x} / {scale}, {z} / {scale}) * {height}",
		fields = { name = "name|height|name", x = "expr|x|x", z = "expr|z|z",
			height = "num|30|maximum", scale = "num|60|zoom" },
		doc = "Multiply noise by a height and you have terrain. A bigger zoom " ..
			"makes wider, gentler hills.",
		tags = "noise terrain height hills procedural world" }

--=============================================================================
-- DEBUG AND TIMING
--=============================================================================

D{ id = "dbgLabelled", cat = "debug", group = "Looking", label = "print with a label",
		head = 'print "{label}" and {value}',
		code = 'print("{label}", {value})',
		fields = { label = "str|health|label", value = "expr|hum.Health|value" },
		doc = "Print takes as many values as you like and tabs between them. A " ..
			"label next to the value is worth ten prints without one.",
		tags = "print debug label value output" }

D{ id = "dbgTable", cat = "debug", group = "Looking", label = "print a table",
		head = "print everything inside {table}",
		code = {
			"for key, value in pairs({table}) do",
			'\tprint(key, "=", value)',
			"end",
		},
		fields = { table = "expr|data|table" },
		doc = "Printing a table itself only shows its address. This shows what " ..
			"is actually in it, one line per entry.",
		tags = "print table dump inspect debug" }

D{ id = "dbgType", cat = "debug", group = "Looking", label = "print what something is",
		head = "print what {value} is",
		code = 'print(typeof({value}), {value})',
		fields = { value = "expr|value|value" },
		doc = "When something behaves oddly, the first question is usually what " ..
			"type it actually is rather than what you assumed.",
		tags = "typeof type print debug inspect" }

D{ id = "dbgWhere", cat = "debug", group = "Looking", label = "print the full path",
		head = "print where {obj} is in the game",
		code = "print({obj}:GetFullName())",
		fields = { obj = "expr|part|object" },
		doc = "Gives the full path, like `Workspace.Model.Part`, which settles " ..
			"any argument about which object you actually have.",
		tags = "getfullname path print locate debug" }

D{ id = "dbgChildren", cat = "debug", group = "Looking", label = "print the children",
		head = "print everything inside {obj}",
		code = {
			"for _, child in ipairs({obj}:GetChildren()) do",
			"\tprint(child.Name, child.ClassName)",
			"end",
		},
		fields = { obj = "expr|model|object" },
		doc = "Names and classes of everything one level down, which is usually " ..
			"enough to find the thing you cannot find.",
		tags = "children print list explore debug" }

D{ id = "dbgTrace", cat = "debug", group = "Looking", label = "print how we got here",
		head = "print how the code got here",
		code = "print(debug.traceback())",
		doc = "Prints the chain of function calls leading to this line. The way " ..
			"to find out who is calling something unexpectedly.",
		tags = "traceback stack callers debug trace" }

D{ id = "dbgWarnIf", cat = "debug", group = "Looking", label = "warn when",
		head = 'warn "{message}" if {condition}',
		code = {
			"if {condition} then",
			'\twarn("{message}")',
			"end",
		},
		fields = { message = "str|that should not happen|message", condition = "expr|health < 0|condition" },
		doc = "A warning is orange in the output window, which makes your own " ..
			"messages findable in a busy log.",
		tags = "warn condition orange debug check" }

D{ id = "dbgMemory", cat = "debug", group = "Looking", label = "print memory used",
		head = "print how much memory is being used",
		code = 'print(string.format("%.1f MB", Stats:GetTotalMemoryUsageMb()))',
		needs = { "Stats" },
		doc = "A number that keeps climbing while nothing new is happening means " ..
			"something is being kept alive that should not be.",
		tags = "memory stats leak performance debug" }

-- timing --------------------------------------------------------------------------------------
D{ id = "dbgTimeThis", cat = "debug", group = "Timing", label = "time these blocks",
		head = 'time these blocks and print it as "{label}"',
		code = {
			"do",
			"\tlocal started = os.clock()",
		},
		codeTail = {
			'\tprint(string.format("{label} took %.3f seconds", os.clock() - started))',
			"end",
		},
		tail = "end",
		bodyIndent = 1,
		fields = { label = "str|that bit|label" },
		slots = { { key = "body" } },
		doc = "Wraps anything and reports how long it took. Measuring beats " ..
			"guessing which part is slow.",
		tags = "timing profile measure clock performance" }

D{ id = "dbgSince", cat = "debug", group = "Timing", label = "seconds since",
		head = "make {name} = the seconds since {start}",
		code = "local {name} = os.clock() - {start}",
		fields = { name = "name|elapsed|name", start = "expr|startedAt|start time" },
		doc = "`os.clock` is a precise stopwatch. Subtracting two readings gives " ..
			"the gap; the numbers themselves mean nothing on their own.",
		tags = "elapsed clock stopwatch timing since" }

D{ id = "dbgEverySeconds", cat = "debug", group = "Timing", label = "every few seconds",
		head = "every {seconds} seconds, forever",
		code = {
			"task.spawn(function()",
			"\twhile true do",
			"\t\ttask.wait({seconds})",
		},
		codeTail = { "\tend", "end)" }, tail = "end",
		bodyIndent = 2,
		fields = { seconds = "num|5|seconds" },
		slots = { { key = "body" } },
		doc = "Runs on its own thread, so a wait in here does not hold up the " ..
			"rest of the script.",
		tags = "loop timer repeat interval spawn" }

D{ id = "dbgWaitUntil", cat = "debug", group = "Timing", label = "wait until",
		head = "wait until {condition}, checking every {seconds} seconds",
		code = {
			"while not ({condition}) do",
			"\ttask.wait({seconds})",
			"end",
		},
		fields = { condition = "expr|ready|condition", seconds = "num|0.2|seconds" },
		doc = "The brackets round the condition matter: without them `not` would " ..
			"only apply to the first part of a longer test.",
		tags = "wait until poll condition loop" }

D{ id = "dbgWaitUpTo", cat = "debug", group = "Timing", label = "wait, but give up",
		head = "wait up to {seconds} seconds for {condition}",
		code = {
			"do",
			"\tlocal giveUpAt = os.clock() + {seconds}",
			"\twhile not ({condition}) and os.clock() < giveUpAt do",
			"\t\ttask.wait(0.1)",
			"\tend",
			"end",
		},
		fields = { condition = "expr|loaded|condition", seconds = "num|10|seconds" },
		doc = "A wait with no way out is how a script hangs forever. This one " ..
			"always finishes, whether or not the thing happened.",
		tags = "wait timeout give up condition safety" }

D{ id = "dbgCountdown", cat = "debug", group = "Timing", label = "count down",
		head = "count down from {n}, printing each second",
		code = {
			"for remaining = {n}, 1, -1 do",
			"\tprint(remaining)",
			"\ttask.wait(1)",
			"end",
		},
		fields = { n = "num|10|from" },
		doc = "A round timer in four lines. Swap the print for a label update to " ..
			"put it on screen.",
		tags = "countdown timer round seconds loop" }

-- guarding ----------------------------------------------------------------------------------------
D{ id = "dbgDebounce", cat = "debug", group = "Guarding", label = "stop repeat firing",
		head = "stop this repeating within {seconds} seconds, using {flag}",
		code = {
			"if {flag} then return end",
			"{flag} = true",
			"task.delay({seconds}, function()",
			"\t{flag} = false",
			"end)",
		},
		fields = { flag = "expr|busy|flag variable", seconds = "num|1|seconds" },
		doc = "A debounce. Touched fires many times a second, so without one of " ..
			"these a single step collects the coin ten times.",
		tags = "debounce cooldown repeat touched guard" }

D{ id = "dbgCooldownPer", cat = "debug", group = "Guarding", label = "a cooldown per player",
		head = "stop {player} repeating within {seconds} seconds, tracked in {times}",
		code = {
			"do",
			"\tlocal now = os.clock()",
			"\tif {times}[{player}] and now - {times}[{player}] < {seconds} then",
			"\t\treturn",
			"\tend",
			"\t{times}[{player}] = now",
			"end",
		},
		fields = { player = "expr|player|player", times = "expr|lastUsed|times table",
			seconds = "num|3|seconds" },
		doc = "One shared flag would let one player's cooldown block everybody. " ..
			"A table keyed by player gives each their own.",
		tags = "cooldown per player table debounce fair" }

D{ id = "dbgOnlyOnce", cat = "debug", group = "Guarding", label = "only the first time",
		head = "only do this the first time, using {flag}",
		code = {
			"if {flag} then return end",
			"{flag} = true",
		},
		fields = { flag = "expr|done|flag variable" },
		doc = "Never resets, so whatever follows happens exactly once however " ..
			"often the event fires.",
		tags = "once flag guard first time" }

D{ id = "dbgEveryNth", cat = "debug", group = "Guarding", label = "every few times",
		head = "only do this every {n} times, counting in {counter}",
		code = {
			"{counter} = {counter} + 1",
			"if {counter} % {n} ~= 0 then return end",
		},
		fields = { counter = "expr|ticks|counter variable", n = "num|10|every" },
		doc = "Thins out something that runs every frame. Checking distance ten " ..
			"times a second instead of sixty is rarely noticeable.",
		tags = "throttle every nth counter modulo performance" }

D{ id = "dbgTryThese", cat = "debug", group = "Guarding", label = "try these and report",
		head = "try these blocks, printing any error",
		code = {
			"do",
			"\tlocal ok, err = pcall(function()",
		},
		codeTail = {
			"\tend)",
			"\tif not ok then",
			'\t\twarn("failed: " .. tostring(err))',
			"\tend",
			"end",
		},
		tail = "end",
		bodyIndent = 2,
		slots = { { key = "body" } },
		doc = "Like `try safely`, but it complains rather than swallowing the " ..
			"problem silently. What you want while building.",
		tags = "pcall try error report debug safe" }

D{ id = "dbgRetryThese", cat = "debug", group = "Guarding", label = "try these a few times",
		head = "try these blocks up to {tries} times",
		code = {
			"for attempt = 1, {tries} do",
			"\tlocal ok = pcall(function()",
		},
		codeTail = {
			"\tend)",
			"\tif ok then",
			"\t\tbreak",
			"\tend",
			"\ttask.wait(attempt)",
			"end",
		},
		tail = "end",
		bodyIndent = 2,
		fields = { tries = "num|3|tries" },
		slots = { { key = "body" } },
		doc = "Stops as soon as it works, and waits a little longer after each " ..
			"failure. Anything touching the network wants this.",
		tags = "retry pcall backoff network reliability" }

D{ id = "dbgFrameRate", cat = "debug", group = "Guarding", label = "frames per second",
		head = "make {name} = the current frames per second, from {dt}",
		code = "local {name} = math.floor(1 / math.max({dt}, 0.0001))",
		fields = { name = "name|fps|name", dt = "expr|dt|seconds since last frame" },
		doc = "One divided by the time a frame took. The max guards against " ..
			"dividing by zero on a very fast frame.",
		tags = "fps framerate performance delta debug" }

D{ id = "dbgProfileStart", cat = "debug", group = "Guarding", label = "mark for the profiler",
		head = 'mark these blocks as "{label}" in the profiler',
		code = { 'debug.profilebegin("{label}")' },
		codeTail = { "debug.profileend()" }, tail = "end",
		fields = { label = "str|my work|label" },
		slots = { { key = "body" } },
		doc = "Names a section so it shows up in Studio's MicroProfiler (Ctrl+F6 " ..
			"while playing) rather than being lumped in with everything else.",
		tags = "profilebegin microprofiler performance measure" }

end
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX23">
			<Properties>
				<string name="Name">w</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- w  ·  block definitions: more of the original ten categories
--
-- The ten teaching categories keep their lessons and their first, simplest
-- blocks in c.luau.  This file deepens them: the same subjects, more of the
-- things people actually reach for once they are past the first hour.

return function(D)

--=============================================================================
-- EVENTS
--=============================================================================

D{ id = "onPrompt", cat = "events", group = "In the world", label = "on a prompt used",
		head = "when {prompt} is used by {player}",
		code = "{prompt}.Triggered:Connect(function({player})", tail = "end)",
		fields = { prompt = "expr|script.Parent.ProximityPrompt|prompt", player = "name|player|player" },
		slots = { { key = "body" } },
		doc = "A ProximityPrompt is the hold-E popup. It handles the distance, " ..
			"the key and the mobile button for you.",
		tags = "proximityprompt triggered interact use e key" }

D{ id = "onSeat", cat = "events", group = "In the world", label = "on someone sitting",
		head = "when someone sits in {seat}, as {hum}",
		code = {
			"{seat}:GetPropertyChangedSignal(\"Occupant\"):Connect(function()",
			"\tlocal {hum} = {seat}.Occupant",
			"\tif {hum} then",
		},
		codeTail = { "\tend", "end)" }, tail = "end",
		bodyIndent = 2,
		fields = { seat = "expr|script.Parent|seat", hum = "name|hum|humanoid" },
		slots = { { key = "body" } },
		doc = "Occupant is the Humanoid sitting there, or nil when they get up, " ..
			"which is why this checks before running.",
		tags = "seat occupant sit vehicle chair" }

D{ id = "onTouchEnded", cat = "events", group = "In the world", label = "on stopped touching",
		head = "when {part} stops being touched by {hit}",
		code = "{part}.TouchEnded:Connect(function({hit})", tail = "end)",
		fields = { part = "expr|script.Parent|part", hit = "name|hit|what left" },
		slots = { { key = "body" } },
		doc = "The other half of Touched. Leaving a zone fires this, though it " ..
			"can be missed if the part is destroyed first.",
		tags = "touchended leave zone exit" }

D{ id = "onChildAdded", cat = "events", group = "Objects", label = "on something added",
		head = "when something is added to {parent}, as {child}",
		code = "{parent}.ChildAdded:Connect(function({child})", tail = "end)",
		fields = { parent = "expr|workspace|parent", child = "name|child|what was added" },
		slots = { { key = "body" } },
		doc = "Only one level down. Use the descendant version to catch things " ..
			"added deeper inside.",
		tags = "childadded added parent watch" }

D{ id = "onChildRemoved", cat = "events", group = "Objects", label = "on something removed",
		head = "when something is removed from {parent}, as {child}",
		code = "{parent}.ChildRemoved:Connect(function({child})", tail = "end)",
		fields = { parent = "expr|workspace|parent", child = "name|child|what was removed" },
		slots = { { key = "body" } },
		doc = "Fires when a child is destroyed or reparented away.",
		tags = "childremoved removed parent watch" }

D{ id = "onDescendantAdded", cat = "events", group = "Objects", label = "on anything added below",
		head = "when anything is added anywhere inside {parent}, as {thing}",
		code = "{parent}.DescendantAdded:Connect(function({thing})", tail = "end)",
		fields = { parent = "expr|workspace|parent", thing = "name|thing|what was added" },
		slots = { { key = "body" } },
		doc = "Catches things added at any depth, which is how you apply a rule " ..
			"to every part that ever appears.",
		tags = "descendantadded deep watch anywhere" }

D{ id = "onDestroying", cat = "events", group = "Objects", label = "on being destroyed",
		head = "just before {obj} is destroyed",
		code = "{obj}.Destroying:Connect(function()", tail = "end)",
		fields = { obj = "expr|part|object" },
		slots = { { key = "body" } },
		doc = "Your last chance to clean up connections or save something about " ..
			"an object before it goes.",
		tags = "destroying cleanup before removed" }

D{ id = "onAttributeChanged", cat = "events", group = "Objects", label = "on any attribute changed",
		head = "when any attribute of {obj} changes, as {which}",
		code = "{obj}.AttributeChanged:Connect(function({which})", tail = "end)",
		fields = { obj = "expr|part|object", which = "name|attribute|which one" },
		slots = { { key = "body" } },
		doc = "Hands you the name of whichever attribute changed, so one handler " ..
			"can cover them all.",
		tags = "attributechanged attribute watch any" }

D{ id = "onChat", cat = "events", group = "Players", label = "on a player chatting",
		head = "when {player} says something, as {message}",
		code = "{player}.Chatted:Connect(function({message})", tail = "end)",
		fields = { player = "expr|player|player", message = "name|message|what they said" },
		slots = { { key = "body" } },
		side = "server",
		doc = "The simplest way to add chat commands. Anything you show to other " ..
			"players from here has to be filtered first.",
		tags = "chatted chat message command say" }

D{ id = "onIdle", cat = "events", group = "Players", label = "on a player going idle",
		head = "when {player} has been still for a while, as {seconds}",
		code = "{player}.Idled:Connect(function({seconds})", tail = "end)",
		fields = { player = "expr|player|player", seconds = "name|idleFor|seconds idle" },
		slots = { { key = "body" } },
		doc = "Fires after about twenty minutes of no input, and again every so " ..
			"often after that.",
		tags = "idled afk away inactive" }

D{ id = "onKeyUp", cat = "events", group = "Input", label = "on a key released",
		head = "when the {key} key is let go",
		code = {
			"UserInputService.InputEnded:Connect(function(input)",
			"\tif input.KeyCode == Enum.KeyCode.{key} then",
		},
		codeTail = { "\tend", "end)" }, tail = "end",
		bodyIndent = 2,
		fields = { key = "choice:keycode|E|key|E,F,Q,R,T,Space,LeftShift,LeftControl,One,Two,Three" },
		slots = { { key = "body" } },
		needs = { "UserInputService" }, side = "client",
		doc = "The release half of a key press, for anything held down like " ..
			"sprinting or aiming.",
		tags = "inputended key release let go client" }

D{ id = "onClick3D", cat = "events", group = "Input", label = "on a mouse click in the world",
		head = "when the player clicks, as {where}",
		code = {
			"UserInputService.InputBegan:Connect(function(input, typing)",
			"\tif typing then return end",
			"\tif input.UserInputType == Enum.UserInputType.MouseButton1 then",
			"\t\tlocal {where} = UserInputService:GetMouseLocation()",
		},
		codeTail = { "\t\tend", "end)" }, tail = "end",
		bodyIndent = 2,
		fields = { where = "name|at|screen position" },
		slots = { { key = "body" } },
		needs = { "UserInputService" }, side = "client",
		doc = "Gives the click position on screen. Turn it into a world position " ..
			"with a camera ray if you need what was clicked.",
		tags = "click mouse input world position client" }

D{ id = "onStepped", cat = "events", group = "Input", label = "before physics each frame",
		head = "before physics each frame, {dt} seconds later",
		code = "RunService.Stepped:Connect(function(_, {dt})", tail = "end)",
		fields = { dt = "name|dt|delta" },
		slots = { { key = "body" } },
		needs = { "RunService" },
		doc = "Runs just before the physics step, which is where a force should " ..
			"be applied so it takes effect the same frame.",
		tags = "stepped physics before frame runservice" }

--=============================================================================
-- CONTROL
--=============================================================================

D{ id = "forEachChild", cat = "control", group = "Over objects", label = "for each child",
		head = "for each {child} inside {parent}",
		code = "for _, {child} in ipairs({parent}:GetChildren()) do", tail = "end",
		fields = { parent = "expr|workspace|parent", child = "name|child|each" },
		slots = { { key = "body" } },
		doc = "One level down only. The most common loop in Roblox code after " ..
			"the player one.",
		tags = "getchildren loop children each" }

D{ id = "forEachDescendant", cat = "control", group = "Over objects", label = "for each thing inside",
		head = "for each {thing} anywhere inside {parent}",
		code = "for _, {thing} in ipairs({parent}:GetDescendants()) do", tail = "end",
		fields = { parent = "expr|model|parent", thing = "name|thing|each" },
		slots = { { key = "body" } },
		doc = "Every depth, which on a big model can be thousands of objects. " ..
			"Worth filtering inside with an `if it is a` block.",
		tags = "getdescendants loop deep every" }

D{ id = "forEachPart", cat = "control", group = "Over objects", label = "for each part inside",
		head = "for each part {part} inside {parent}",
		code = {
			"for _, {part} in ipairs({parent}:GetDescendants()) do",
			'\tif {part}:IsA("BasePart") then',
		},
		codeTail = { "\tend", "end" }, tail = "end",
		bodyIndent = 2,
		fields = { parent = "expr|model|parent", part = "name|part|each part" },
		slots = { { key = "body" } },
		doc = "The filtered version, which is what you nearly always meant. " ..
			"Skips scripts, values and everything else that is not a part.",
		tags = "parts loop basepart filter descendants" }

D{ id = "repeatForSeconds", cat = "control", group = "Timing", label = "repeat for a while",
		head = "keep doing this for {seconds} seconds",
		code = {
			"do",
			"\tlocal stopAt = os.clock() + {seconds}",
			"\twhile os.clock() < stopAt do",
		},
		codeTail = { "\t\ttask.wait()", "\tend", "end" }, tail = "end",
		bodyIndent = 2,
		fields = { seconds = "num|3|seconds" },
		slots = { { key = "body" } },
		doc = "A loop with a built-in end and a built-in wait, so it can never " ..
			"run away with itself.",
		tags = "loop duration seconds timed while" }

D{ id = "waitFrame", cat = "control", group = "Timing", label = "wait one frame",
		head = "wait for the next frame",
		code = "task.wait()",
		doc = "Lets everything else have a turn and carries on next frame. Not " ..
			"free, but the shortest possible pause.",
		tags = "wait frame yield next tick" }

D{ id = "waitFrames", cat = "control", group = "Timing", label = "wait several frames",
		head = "wait for {n} frames",
		code = {
			"for _ = 1, {n} do",
			"\ttask.wait()",
			"end",
		},
		fields = { n = "num|3|frames" },
		doc = "Sometimes something needs a moment to settle -- a character to " ..
			"load, a part to fall -- and a fixed wait is too blunt.",
		tags = "wait frames pause settle" }

D{ id = "forGrid", cat = "control", group = "Counting", label = "for each square of a grid",
		head = "for each square {x} across and {y} down, up to {width} by {height}",
		code = {
			"for {x} = 1, {width} do",
			"\tfor {y} = 1, {height} do",
		},
		codeTail = { "\tend", "end" }, tail = "end",
		bodyIndent = 2,
		fields = { x = "name|x|across", y = "name|y|down", width = "num|8|width", height = "num|8|height" },
		slots = { { key = "body" } },
		doc = "A loop inside a loop. Building a floor, a chessboard or an " ..
			"inventory grid all start here.",
		tags = "nested loop grid rows columns two dimensional" }

D{ id = "forBackwards", cat = "control", group = "Counting", label = "count backwards",
		head = "count {var} down from {from} to {to}",
		code = "for {var} = {from}, {to}, -1 do", tail = "end",
		fields = { var = "name|i|name", from = "num|10|from", to = "num|1|to" },
		slots = { { key = "body" } },
		doc = "The only safe direction when you are removing items from a list " ..
			"as you go.",
		tags = "loop backwards countdown reverse for" }

D{ id = "breakIf", cat = "control", group = "Counting", label = "stop the loop if",
		head = "stop the loop if {condition}",
		code = {
			"if {condition} then",
			"\tbreak",
			"end",
		},
		fields = { condition = "expr|found|condition" },
		doc = "Leaves the loop the moment the condition is true, rather than " ..
			"finishing every remaining pass.",
		tags = "break stop loop early exit condition" }

D{ id = "skipIf", cat = "control", group = "Counting", label = "skip this turn if",
		head = "skip to the next turn if {condition}",
		code = {
			"if {condition} then",
			"\tcontinue",
			"end",
		},
		fields = { condition = "expr|not part.CanCollide|condition" },
		doc = "A filter inside a loop, and flatter to read than wrapping the " ..
			"whole body in an if block.",
		tags = "continue skip filter loop guard" }

D{ id = "doInOrder", cat = "control", group = "Timing", label = "do these one at a time",
		head = "do these blocks with {gap} seconds between each",
		code = {
			"do",
			"\tlocal gap = {gap}",
		},
		codeTail = { "end" }, tail = "end",
		fields = { gap = "num|1|seconds" },
		slots = { { key = "body" } },
		doc = "Names the gap once so the waits inside can all use it. Put a " ..
			"`wait gap seconds` block between the steps.",
		tags = "sequence order steps timing group" }

--=============================================================================
-- LOGIC
--=============================================================================

D{ id = "ifBetween", cat = "logic", group = "Ranges", label = "if between",
		head = "if {value} is between {low} and {high} then",
		code = "if {value} >= {low} and {value} <= {high} then", tail = "end",
		fields = { value = "expr|health|value", low = "expr|1|low", high = "expr|50|high" },
		slots = { { key = "body" } },
		doc = "Both ends count. Two comparisons joined with `and`, which Luau has " ..
			"no shorter way to write.",
		tags = "between range within bounds compare" }

D{ id = "ifOutside", cat = "logic", group = "Ranges", label = "if outside",
		head = "if {value} is outside {low} to {high} then",
		code = "if {value} < {low} or {value} > {high} then", tail = "end",
		fields = { value = "expr|position.Y|value", low = "expr|0|low", high = "expr|100|high" },
		slots = { { key = "body" } },
		doc = "The opposite test. Catching a player who has fallen out of the " ..
			"world is this with a low bound.",
		tags = "outside range bounds fell out check" }

D{ id = "ifOneOf", cat = "logic", group = "Ranges", label = "if it is one of",
		head = "if {value} is one of {list} then",
		code = "if table.find({list}, {value}) then", tail = "end",
		fields = { value = "expr|material|value", list = "expr|allowed|list" },
		slots = { { key = "body" } },
		doc = "Beats a chain of `or` comparisons, and the list can be changed " ..
			"without touching the check.",
		tags = "oneof list find allowed whitelist" }

D{ id = "ifNothing", cat = "logic", group = "Nothing", label = "if it is nothing",
		head = "if {value} is nothing then",
		code = "if {value} == nil then", tail = "end",
		fields = { value = "expr|found|value" },
		slots = { { key = "body" } },
		doc = "Explicitly nil, rather than false. Worth being exact when false " ..
			"is a value you might legitimately store.",
		tags = "nil nothing missing check empty" }

D{ id = "ifEmptyText", cat = "logic", group = "Nothing", label = "if the text is empty",
		head = "if {text} is empty then",
		code = 'if {text} == nil or {text} == "" then', tail = "end",
		fields = { text = "expr|typed|text" },
		slots = { { key = "body" } },
		doc = "Covers both nothing at all and an empty string, which is what " ..
			"an untouched typing box gives you.",
		tags = "empty blank string check input" }

D{ id = "ifSame", cat = "logic", group = "Nothing", label = "if it is the same object",
		head = "if {a} is the same object as {b} then",
		code = "if {a} == {b} then", tail = "end",
		fields = { a = "expr|hit.Parent|first", b = "expr|character|second" },
		slots = { { key = "body" } },
		doc = "Instances compare by identity, not by name, so this is true only " ..
			"for the very same object.",
		tags = "same identity equal instance compare" }

D{ id = "ifDivisible", cat = "logic", group = "Numbers", label = "if it divides evenly",
		head = "if {value} divides evenly by {n} then",
		code = "if {value} % {n} == 0 then", tail = "end",
		fields = { value = "expr|count|value", n = "expr|2|divisor" },
		slots = { { key = "body" } },
		doc = "The remainder being zero means it divides exactly. With 2 this is " ..
			"an even-number check.",
		tags = "modulo divisible even remainder multiple" }

D{ id = "ifBoth3", cat = "logic", group = "Combining", label = "if all three",
		head = "if {a}, {b} and {c} are all true then",
		code = "if {a} and {b} and {c} then", tail = "end",
		fields = { a = "expr|alive|first", b = "expr|ready|second", c = "expr|inRange|third" },
		slots = { { key = "body" } },
		doc = "Three conditions without nesting three if blocks. They are checked " ..
			"left to right and stop at the first false.",
		tags = "and three all conditions combine" }

D{ id = "ifNeither", cat = "logic", group = "Combining", label = "if neither",
		head = "if neither {a} nor {b} then",
		code = "if not {a} and not {b} then", tail = "end",
		fields = { a = "expr|busy|first", b = "expr|dead|second" },
		slots = { { key = "body" } },
		doc = "True only when both are false. Reads better than the alternative, " ..
			"`not (a or b)`.",
		tags = "neither nor not both false" }

D{ id = "pickValue", cat = "logic", group = "Combining", label = "pick a value",
		head = "make {name} = {a} if {condition}, otherwise {b}",
		code = "local {name} = {condition} and {a} or {b}",
		fields = { name = "name|chosen|name", condition = "expr|isNight|condition",
			a = "expr|0.8|if true", b = "expr|0.1|if false" },
		doc = "Luau's shorthand for a small choice. The catch: it fails if the " ..
			"true value is itself false or nil, so keep it to real values.",
		tags = "ternary and or choose conditional value" }

D{ id = "valueOrDefault", cat = "logic", group = "Combining", label = "value or a default",
		head = "make {name} = {value}, or {fallback} if there is none",
		code = "local {name} = {value} or {fallback}",
		fields = { name = "name|setting|name", value = "expr|part:GetAttribute(\"Speed\")|value",
			fallback = "expr|16|fallback" },
		doc = "`or` hands back the first thing that is not nil or false. The " ..
			"standard way to give a missing value a default.",
		tags = "or default fallback nil attribute" }

--=============================================================================
-- MATH
--=============================================================================

D{ id = "mathPercentOf", cat = "math", group = "Portions", label = "percent of",
		head = "make {var} = {percent} percent of {value}",
		code = "{var} = {value} * {percent} / 100",
		fields = { var = "expr|part|variable", percent = "expr|25|percent", value = "expr|total|value" },
		doc = "A quarter of something, without working out the decimal yourself.",
		tags = "percent portion fraction of" }

D{ id = "mathAsPercent", cat = "math", group = "Portions", label = "as a percentage",
		head = "make {var} = {value} as a percentage of {total}",
		code = "{var} = math.floor({value} / {total} * 100)",
		fields = { var = "expr|percent|variable", value = "expr|health|value", total = "expr|maxHealth|total" },
		doc = "For showing a fraction to a player. Flooring keeps it a whole " ..
			"number so it does not read as 99.99999.",
		tags = "percentage progress ratio display" }

D{ id = "mathChangeByPercent", cat = "math", group = "Portions", label = "change by a percentage",
		head = "change {var} by {percent} percent",
		code = "{var} = {var} * (1 + {percent} / 100)",
		fields = { var = "expr|price|variable", percent = "expr|10|percent" },
		doc = "A negative percentage reduces it. Compounding prices and growing " ..
			"difficulty are this line in a loop.",
		tags = "percent increase decrease multiply scale" }

D{ id = "mathRoundStep", cat = "math", group = "Rounding", label = "round to the nearest",
		head = "make {var} = {value} rounded to the nearest {step}",
		code = "{var} = math.round({value} / {step}) * {step}",
		fields = { var = "expr|snapped|variable", value = "expr|position.X|value", step = "expr|4|step" },
		doc = "Rounding to 4 gives 0, 4, 8 and so on. The whole of grid snapping " ..
			"and of rounding money to five.",
		tags = "round nearest step snap grid multiple" }

D{ id = "mathWholeNumber", cat = "math", group = "Rounding", label = "make it a whole number",
		head = "make {var} = {value} with the decimals dropped",
		code = "{var} = math.floor({value})",
		fields = { var = "expr|whole|variable", value = "expr|amount|value" },
		doc = "Always downward, even for negative numbers. Use round instead if " ..
			"you want the nearest.",
		tags = "floor whole integer truncate round down" }

D{ id = "mathWrap", cat = "math", group = "Rounding", label = "wrap a number round",
		head = "make {var} = {value} wrapped to between 0 and {limit}",
		code = "{var} = {value} % {limit}",
		fields = { var = "expr|index|variable", value = "expr|counter|value", limit = "expr|4|limit" },
		doc = "The remainder loops back to zero when it reaches the limit, which " ..
			"is how you cycle through a list forever.",
		tags = "modulo wrap cycle loop remainder" }

D{ id = "mathSquare", cat = "math", group = "Working out", label = "square a number",
		head = "make {var} = {value} squared",
		code = "{var} = {value} ^ 2",
		fields = { var = "expr|area|variable", value = "expr|side|value" },
		doc = "`^` is the power operator. Squaring is often faster than a square " ..
			"root when you only need to compare two distances.",
		tags = "square power exponent multiply" }

D{ id = "mathHypotenuse", cat = "math", group = "Working out", label = "diagonal length",
		head = "make {var} = the diagonal across {a} by {b}",
		code = "{var} = math.sqrt({a} ^ 2 + {b} ^ 2)",
		fields = { var = "expr|diagonal|variable", a = "expr|width|first side", b = "expr|height|second side" },
		doc = "Pythagoras. The straight-line distance across a rectangle of those " ..
			"two sides.",
		tags = "pythagoras hypotenuse diagonal distance sqrt" }

D{ id = "mathAverageTwo", cat = "math", group = "Working out", label = "average of two",
		head = "make {var} = the average of {a} and {b}",
		code = "{var} = ({a} + {b}) / 2",
		fields = { var = "expr|middle|variable", a = "expr|low|first", b = "expr|high|second" },
		doc = "The midpoint. The brackets matter -- without them only the second " ..
			"number would be halved.",
		tags = "average mean midpoint two brackets" }

D{ id = "mathDifference", cat = "math", group = "Working out", label = "difference between",
		head = "make {var} = how far apart {a} and {b} are",
		code = "{var} = math.abs({a} - {b})",
		fields = { var = "expr|gap|variable", a = "expr|score|first", b = "expr|target|second" },
		doc = "Always a positive number, whichever way round they are.",
		tags = "difference abs gap distance apart" }

D{ id = "mathCountUpTo", cat = "math", group = "Working out", label = "step towards a number",
		head = "move {var} towards {target} by at most {step}",
		code = {
			"if math.abs({target} - {var}) <= {step} then",
			"\t{var} = {target}",
			"else",
			"\t{var} = {var} + ({target} > {var} and {step} or -{step})",
			"end",
		},
		fields = { var = "expr|shown|variable", target = "expr|actual|target", step = "expr|1|most to move" },
		doc = "Lands exactly on the target instead of creeping towards it. A " ..
			"score counter ticking up uses this.",
		tags = "approach step towards counter animate" }

D{ id = "mathSignOf", cat = "math", group = "Working out", label = "which way",
		head = "make {var} = which way {value} points",
		code = "{var} = math.sign({value})",
		fields = { var = "expr|way|variable", value = "expr|difference|value" },
		doc = "Gives -1, 0 or 1. Useful for turning a difference into a " ..
			"direction without caring how big it is.",
		tags = "sign direction positive negative" }

--=============================================================================
-- TEXT
--=============================================================================

D{ id = "textJoinThree", cat = "text", group = "Building", label = "join three",
		head = "make {var} = {a}, {b} and {c} joined together",
		code = "{var} = tostring({a}) .. tostring({b}) .. tostring({c})",
		fields = { var = "expr|line|variable", a = "expr|\"Score: \"|first", b = "expr|score|second",
			c = "expr|\" points\"|third" },
		doc = "`tostring` round each part means numbers and other values join " ..
			"without complaint.",
		tags = "join concat three tostring build" }

D{ id = "textLetterAt", cat = "text", group = "Reading", label = "the letter at",
		head = "make {var} = letter {n} of {text}",
		code = "{var} = string.sub({text}, {n}, {n})",
		fields = { var = "expr|letter|variable", text = "expr|word|text", n = "expr|1|position" },
		doc = "Counting starts at 1. Asking past the end gives an empty string " ..
			"rather than an error.",
		tags = "letter character position sub index" }

D{ id = "textFirstWord", cat = "text", group = "Reading", label = "the first word",
		head = "make {var} = the first word of {text}",
		code = '{var} = string.match({text}, "%S+")',
		fields = { var = "expr|first|variable", text = "expr|message|text" },
		doc = "Reading the command out of a chat message starts here.",
		tags = "first word command match split" }

D{ id = "textAfterFirstWord", cat = "text", group = "Reading", label = "everything after the first word",
		head = "make {var} = everything after the first word of {text}",
		code = '{var} = string.match({text}, "%S+%s+(.*)") or ""',
		fields = { var = "expr|rest|variable", text = "expr|message|text" },
		doc = "The other half of a chat command: the argument. The `or \"\"` " ..
			"covers a message with only one word in it.",
		tags = "rest arguments command after split" }

D{ id = "textNoSpaces", cat = "text", group = "Reading", label = "without spaces",
		head = "make {var} = {text} with the spaces taken out",
		code = '{var} = string.gsub({text}, "%s", "")',
		fields = { var = "expr|tight|variable", text = "expr|typed|text" },
		doc = "Every space, not just the ends. Useful before comparing something " ..
			"a player typed.",
		tags = "spaces remove strip whitespace" }

D{ id = "textSameIgnoringCase", cat = "text", group = "Comparing", label = "if the same, ignoring case",
		head = "if {a} is the same as {b}, ignoring capitals, then",
		code = "if string.lower({a}) == string.lower({b}) then", tail = "end",
		fields = { a = "expr|typed|first", b = "expr|\"yes\"|second" },
		slots = { { key = "body" } },
		doc = "Comparing anything a player typed should nearly always ignore " ..
			"case, or `Yes` will not match `yes`.",
		tags = "lower compare case insensitive input" }

D{ id = "textHowLong", cat = "text", group = "Comparing", label = "if it is too long",
		head = "if {text} is longer than {n} characters then",
		code = "if #{text} > {n} then", tail = "end",
		fields = { text = "expr|typed|text", n = "num|20|length" },
		slots = { { key = "body" } },
		doc = "Worth checking before showing anything a player typed, or a very " ..
			"long name will break your layout.",
		tags = "length limit long check input" }

D{ id = "textAsTrueFalse", cat = "text", group = "Converting", label = "text to true or false",
		head = "make {var} = whether {text} means yes",
		code = '{var} = string.lower({text}) == "true" or string.lower({text}) == "yes"',
		fields = { var = "expr|agreed|variable", text = "expr|typed|text" },
		doc = "There is no built-in conversion from text to a true-or-false " ..
			"value, so this decides what counts as yes.",
		tags = "boolean parse yes true convert input" }

D{ id = "textDefault", cat = "text", group = "Converting", label = "text or a default",
		head = 'make {var} = {text}, or "{fallback}" if it is empty',
		code = '{var} = ({text} ~= nil and {text} ~= "") and {text} or "{fallback}"',
		fields = { var = "expr|shown|variable", text = "expr|typed|text", fallback = "str|Anonymous|fallback" },
		doc = "Plain `or` would not catch an empty string, only nil, so this " ..
			"checks for both.",
		tags = "default fallback empty placeholder text" }

D{ id = "textLineCount", cat = "text", group = "Converting", label = "count the lines",
		head = "make {var} = how many lines are in {text}",
		code = {
			"{var} = 1",
			'for _ in string.gmatch({text}, "\\n") do',
			"\t{var} = {var} + 1",
			"end",
		},
		fields = { var = "expr|lines|variable", text = "expr|text|text" },
		doc = "One more than the number of newlines, since the last line has no " ..
			"newline after it.",
		tags = "lines count newline text measure" }

--=============================================================================
-- VARIABLES
--=============================================================================

D{ id = "makeNumber", cat = "vars", group = "Making", label = "make a number",
		head = "make {name} = the number {value}",
		code = "local {name} = {value}",
		fields = { name = "name|count|name", value = "num|0|value" },
		doc = "The same as `make`, worded so it is obvious a number is what " ..
			"belongs in the field.",
		tags = "number local make variable" }

D{ id = "makeText", cat = "vars", group = "Making", label = "make some text",
		head = 'make {name} = the text "{value}"',
		code = 'local {name} = "{value}"',
		fields = { name = "name|title|name", value = "str|hello|value" },
		doc = "No quotes to type: the field is the words themselves.",
		tags = "string text local make variable" }

D{ id = "makeTrueFalse", cat = "vars", group = "Making", label = "make a yes or no",
		head = "make {name} = {value}",
		code = "local {name} = {value}",
		fields = { name = "name|isOpen|name", value = "choice|false|value|true,false" },
		doc = "Name these so `if` plus the name reads as a sentence: `isOpen`, " ..
			"`hasKey`, `canJump`.",
		tags = "boolean true false flag variable" }

D{ id = "makeConstant", cat = "vars", group = "Making", label = "make a fixed value",
		head = "make the fixed value {name} = {value}",
		code = "local {name} = {value}",
		fields = { name = "name|MAX_HEALTH|name", value = "expr|100|value" },
		doc = "Capitals with underscores is the convention for a value that " ..
			"never changes. It tells a reader not to look for it being set.",
		tags = "constant fixed uppercase convention settings" }

D{ id = "makeCounter", cat = "vars", group = "Making", label = "make a counter",
		head = "make the counter {name}, starting at {value}",
		code = "local {name} = {value}",
		fields = { name = "name|count|name", value = "num|0|start" },
		doc = "Make it outside whatever loop or event changes it, or it will " ..
			"reset to nothing every time.",
		tags = "counter tally count variable scope" }

D{ id = "makeFromOther", cat = "vars", group = "Making", label = "copy a value",
		head = "make {name} = whatever {other} is now",
		code = "local {name} = {other}",
		fields = { name = "name|previous|name", other = "expr|current|other value" },
		doc = "For numbers and text this makes a real copy. For tables and " ..
			"instances it is a second name for the same thing.",
		tags = "copy snapshot previous value assign" }

D{ id = "setIfNothing", cat = "vars", group = "Changing", label = "set only if empty",
		head = "set {name} to {value} only if it has nothing",
		code = {
			"if {name} == nil then",
			"\t{name} = {value}",
			"end",
		},
		fields = { name = "expr|choice|name", value = "expr|\"default\"|value" },
		doc = "Fills a gap without overwriting a value that is already there.",
		tags = "default nil set once fill" }

D{ id = "swapValues", cat = "vars", group = "Changing", label = "swap two values",
		head = "swap {a} and {b}",
		code = "{a}, {b} = {b}, {a}",
		fields = { a = "expr|first|first", b = "expr|second|second" },
		doc = "Luau works out the right side first, so no temporary variable is " ..
			"needed.",
		tags = "swap exchange values assign" }

D{ id = "attrOrDefault", cat = "vars", group = "Attributes", label = "attribute or a default",
		head = 'make {name} = attribute "{attr}" of {inst}, or {fallback}',
		code = 'local {name} = {inst}:GetAttribute("{attr}") or {fallback}',
		fields = { name = "name|speed|name", inst = "expr|script.Parent|instance",
			attr = "str|Speed|attribute", fallback = "expr|16|fallback" },
		doc = "The pattern that makes attributes pleasant: never set means the " ..
			"default applies, and setting it in Properties overrides it.",
		tags = "attribute default fallback settings tunable" }

D{ id = "attrCopyAll", cat = "vars", group = "Attributes", label = "copy every attribute",
		head = "copy every attribute from {from} to {to}",
		code = {
			"for key, value in pairs({from}:GetAttributes()) do",
			"\t{to}:SetAttribute(key, value)",
			"end",
		},
		fields = { from = "expr|template|from", to = "expr|copy|to" },
		doc = "Cloning copies attributes already, so this is for when the two " ..
			"objects are not copies of each other.",
		tags = "attributes copy all transfer getattributes" }

--=============================================================================
-- FUNCTIONS
--=============================================================================

D{ id = "defReturning", cat = "funcs", group = "Defining", label = "define that gives back",
		head = "to work out {name} from {params}:",
		code = "local function {name}({params})", tail = "end",
		fields = { name = "name|workOut|name", params = "params|a, b|inputs" },
		slots = { { key = "body" } },
		doc = "The same as `define`, worded for a function whose whole point is " ..
			"the value it gives back.",
		tags = "function define return value calculate" }

D{ id = "defOnTable", cat = "funcs", group = "Defining", label = "define inside a module",
		head = "to {name} of the module {module} with {params}:",
		code = "function {module}.{name}({params})", tail = "end",
		fields = { module = "expr|Module|module", name = "name|doThing|name", params = "params||inputs" },
		slots = { { key = "body" } },
		doc = "A dot rather than a colon, so there is no hidden `self`. This is " ..
			"how most module functions are written.",
		tags = "module function dot define library" }

D{ id = "defAnonymous", cat = "funcs", group = "Defining", label = "define a function value",
		head = "make {name} = a function taking {params}",
		code = "local {name} = function({params})", tail = "end",
		fields = { name = "name|handler|name", params = "params|value|inputs" },
		slots = { { key = "body" } },
		doc = "A function kept in a variable, which can then be passed to " ..
			"something else or stored in a table.",
		tags = "anonymous function value callback handler" }

D{ id = "callMethod", cat = "funcs", group = "Running", label = "run a method",
		head = "run {name} on {obj} with {args}",
		code = "{obj}:{name}({args})",
		fields = { obj = "expr|thing|object", name = "name|doThing|method", args = "expr||inputs" },
		doc = "The colon passes the object itself as a hidden first input, which " ..
			"is what makes it a method rather than a plain function.",
		tags = "method colon call self invoke" }

D{ id = "callIfThere", cat = "funcs", group = "Running", label = "run it if it exists",
		head = "run {name} with {args}, if there is one",
		code = {
			"if {name} then",
			"\t{name}({args})",
			"end",
		},
		fields = { name = "expr|onFinished|function", args = "expr||inputs" },
		doc = "Optional callbacks are common: a function is handed in or it is " ..
			"not, and this covers both.",
		tags = "optional callback nil check call" }

D{ id = "returnTwo", cat = "funcs", group = "Running", label = "give back two things",
		head = "give back {a} and {b}",
		code = "return {a}, {b}",
		fields = { a = "expr|true|first", b = "expr|result|second" },
		doc = "Luau functions can hand back several values. Catching them takes " ..
			"a `make several` block.",
		tags = "return multiple two values tuple" }

D{ id = "paramDefault", cat = "funcs", group = "Running", label = "give an input a default",
		head = "make {name} default to {fallback} if it was not given",
		code = "{name} = {name} or {fallback}",
		fields = { name = "expr|amount|input name", fallback = "expr|1|default" },
		doc = "The first line of many functions. A missing input arrives as nil, " ..
			"which `or` replaces.",
		tags = "default optional parameter argument or" }

D{ id = "funcOnce", cat = "funcs", group = "Running", label = "run it later, once",
		head = "run {name} after {seconds} seconds",
		code = "task.delay({seconds}, {name})",
		fields = { name = "expr|cleanUp|function", seconds = "num|3|seconds" },
		doc = "Passing the function itself rather than calling it is the point: " ..
			"no brackets, or it would run immediately.",
		tags = "delay later schedule callback timer" }

D{ id = "moduleReturn", cat = "funcs", group = "Modules", label = "hand the module back",
		head = "hand the module {name} back",
		code = "return {name}",
		fields = { name = "expr|Module|module" },
		doc = "The last line of every ModuleScript. Without it, everything that " ..
			"requires this file gets nothing.",
		tags = "return module end require table" }

D{ id = "requireChild", cat = "funcs", group = "Modules", label = "use a module beside this one",
		head = 'make {name} = the module "{child}" next to this script',
		code = 'local {name} = require(script.Parent:WaitForChild("{child}"))',
		fields = { name = "name|Helper|name", child = "str|Helper|module name" },
		doc = "Waiting for the child first means this works on the client too, " ..
			"where things arrive over the network in their own time.",
		tags = "require module sibling waitforchild import" }

--=============================================================================
-- INSTANCES
--=============================================================================

D{ id = "instRename", cat = "inst", group = "Basics", label = "rename",
		head = 'rename {obj} to "{name}"',
		code = '{obj}.Name = "{name}"',
		fields = { obj = "expr|part|object", name = "str|Door|new name" },
		doc = "Names need not be unique, which is why FindFirstChild gives you " ..
			"the first one rather than the one.",
		tags = "name rename label object" }

D{ id = "instResize", cat = "inst", group = "Basics", label = "resize a part",
		head = "resize {obj} to {x} by {y} by {z} studs",
		code = "{obj}.Size = Vector3.new({x}, {y}, {z})",
		fields = { obj = "expr|part|part", x = "expr|4|width", y = "expr|1|height", z = "expr|4|depth" },
		doc = "Parts resize around their centre, so a part on the floor will " ..
			"sink into it when it grows.",
		tags = "size resize scale part dimensions" }

D{ id = "instFade", cat = "inst", group = "Basics", label = "set see-through",
		head = "set how see-through {obj} is to {value}",
		code = "{obj}.Transparency = {value}",
		fields = { obj = "expr|part|part", value = "num|0.5|amount" },
		doc = "1 is fully invisible but still solid. Turn off CanCollide as well " ..
			"if it should be walked through.",
		tags = "transparency invisible fade part" }

D{ id = "instMaterial", cat = "inst", group = "Basics", label = "set the material",
		head = "make {obj} out of {material}",
		code = "{obj}.Material = Enum.Material.{material}",
		fields = { obj = "expr|part|part",
			material = "choice|Plastic|material|Plastic,SmoothPlastic,Neon,Glass,Wood,WoodPlanks,Metal,DiamondPlate,Concrete,Brick,Grass,Sand,Ice,Marble,Slate,ForceField" },
		doc = "Material changes the look and, for terrain-like materials, some " ..
			"of the physics feel too.",
		tags = "material texture look neon glass wood" }

D{ id = "instNudge", cat = "inst", group = "Moving", label = "nudge",
		head = "nudge {obj} by ({x}, {y}, {z})",
		code = "{obj}.Position = {obj}.Position + Vector3.new({x}, {y}, {z})",
		fields = { obj = "expr|part|part", x = "expr|0|x", y = "expr|1|y", z = "expr|0|z" },
		doc = "Relative to where it already is, rather than an absolute place.",
		tags = "move offset nudge relative position" }

D{ id = "instMoveModel", cat = "inst", group = "Moving", label = "nudge a model",
		head = "nudge {model} by ({x}, {y}, {z})",
		code = "{model}:PivotTo({model}:GetPivot() * CFrame.new({x}, {y}, {z}))",
		fields = { model = "expr|model|model", x = "expr|0|x", y = "expr|5|y", z = "expr|0|z" },
		doc = "Takes where the model is, offsets it, and puts it back. The only " ..
			"safe way to move a model without pulling it apart.",
		tags = "pivotto move model offset relative" }

D{ id = "instTurn", cat = "inst", group = "Moving", label = "turn a part",
		head = "turn {obj} by {n} degrees",
		code = "{obj}.CFrame = {obj}.CFrame * CFrame.Angles(0, math.rad({n}), 0)",
		fields = { obj = "expr|part|part", n = "expr|90|degrees" },
		doc = "Turns it on the spot around its own upright axis.",
		tags = "rotate turn cframe angles degrees" }

D{ id = "instFaceTowards", cat = "inst", group = "Moving", label = "point a part at",
		head = "point {obj} at {target}",
		code = "{obj}.CFrame = CFrame.lookAt({obj}.Position, {target})",
		fields = { obj = "expr|turret|part", target = "expr|player.Character.PrimaryPart.Position|target" },
		doc = "Keeps it where it is and swings it round to face something. " ..
			"Turrets and signs use this.",
		tags = "lookat face point aim turret" }

D{ id = "instFindDeep", cat = "inst", group = "Finding", label = "find anywhere inside",
		head = 'make {name} = the first "{child}" anywhere inside {obj}',
		code = 'local {name} = {obj}:FindFirstChild("{child}", true)',
		fields = { name = "name|found|name", obj = "expr|model|where to look", child = "str|Handle|name" },
		doc = "The `true` makes it search all the way down rather than one level. " ..
			"Slower, so do it once and keep the result.",
		tags = "findfirstchild recursive deep search nested" }

D{ id = "instFindByClass", cat = "inst", group = "Finding", label = "find by kind",
		head = "make {name} = the first {class} inside {obj}",
		code = 'local {name} = {obj}:FindFirstChildOfClass("{class}")',
		fields = { name = "name|found|name", obj = "expr|character|where to look",
			class = "choice:class|Humanoid|class|Humanoid,BasePart,Part,Model,Sound,Tool,Animator,ClickDetector,ProximityPrompt" },
		doc = "By kind rather than by name, which is more reliable when you did " ..
			"not choose the names.",
		tags = "findfirstchildofclass class kind find" }

D{ id = "instParentOf", cat = "inst", group = "Finding", label = "what it is inside",
		head = "make {name} = what {obj} is inside",
		code = "local {name} = {obj}.Parent",
		fields = { name = "name|holder|name", obj = "expr|hit|object" },
		doc = "For a limb hit by a Touched event, the parent is the character " ..
			"model. That single step is most of hit detection.",
		tags = "parent holder container hit character" }

D{ id = "instRemoveChildren", cat = "inst", group = "Finding", label = "empty something out",
		head = "remove everything inside {obj}",
		code = "{obj}:ClearAllChildren()",
		fields = { obj = "expr|folder|object" },
		doc = "Destroys every child but keeps the object itself. Clearing a " ..
			"folder between rounds is one line.",
		tags = "clearallchildren empty clear reset folder" }

D{ id = "instCountChildren", cat = "inst", group = "Finding", label = "count what is inside",
		head = "make {name} = how many things are inside {obj}",
		code = "local {name} = #{obj}:GetChildren()",
		fields = { name = "name|count|name", obj = "expr|folder|object" },
		doc = "One level only. Use descendants for everything at any depth.",
		tags = "count children how many folder" }

D{ id = "instMakeIn", cat = "inst", group = "Basics", label = "make a new one inside",
		head = "make {name} = a new {class} inside {parent}",
		code = {
			'local {name} = Instance.new("{class}")',
			"{name}.Parent = {parent}",
		},
		fields = { name = "name|made|name", parent = "expr|script.Parent|parent",
			class = "choice:class|Folder|class|Folder,IntValue,StringValue,BoolValue,NumberValue,ObjectValue,Attachment,Highlight,ProximityPrompt,ClickDetector,Sound" },
		doc = "Making and parenting in one block, for the small helper objects " ..
			"where there is nothing to set in between.",
		tags = "instance new parent create shortcut" }

--=============================================================================
-- PLAYERS
--=============================================================================

D{ id = "playerFromPart", cat = "player", group = "Finding", label = "the player from a part",
		head = "make {name} = the player that {part} belongs to",
		code = "local {name} = Players:GetPlayerFromCharacter({part}.Parent)",
		fields = { name = "name|who|name", part = "expr|hit|part" },
		needs = { "Players" },
		doc = "Turns a limb from a Touched event back into a player. Nil when it " ..
			"was scenery or an NPC rather than a person.",
		tags = "getplayerfromcharacter hit touched player who" }

D{ id = "playerRoot", cat = "player", group = "Finding", label = "the middle of a character",
		head = "make {name} = the middle part of {char}",
		code = 'local {name} = {char}:FindFirstChild("HumanoidRootPart")',
		fields = { name = "name|root|name", char = "expr|char|character" },
		doc = "The HumanoidRootPart is the invisible part everything else hangs " ..
			"off. Measure distances and move characters from here.",
		tags = "humanoidrootpart root position character middle" }

D{ id = "playerIsAlive", cat = "player", group = "Finding", label = "if they are alive",
		head = "if {player} is alive then",
		code = {
			"local char = {player}.Character",
			'local hum = char and char:FindFirstChildOfClass("Humanoid")',
			"if hum and hum.Health > 0 then",
		},
		codeTail = { "end" }, tail = "end",
		fields = { player = "expr|player|player" },
		slots = { { key = "body" } },
		doc = "The full check in one block: they have a body, it has a Humanoid, " ..
			"and it has health left.",
		tags = "alive health check character humanoid" }

D{ id = "playerHealthFraction", cat = "player", group = "Finding", label = "health as a fraction",
		head = "make {name} = the health of {hum} as a fraction",
		code = "local {name} = {hum}.Health / {hum}.MaxHealth",
		fields = { name = "name|fraction|name", hum = "expr|hum|humanoid" },
		doc = "A number from 0 to 1, which is exactly what a health bar wants.",
		tags = "health fraction bar percentage humanoid" }

D{ id = "playerSetMaxHealth", cat = "player", group = "Changing", label = "set the maximum health",
		head = "set the maximum health of {hum} to {n}",
		code = { "{hum}.MaxHealth = {n}", "{hum}.Health = {n}" },
		fields = { hum = "expr|hum|humanoid", n = "num|200|health" },
		doc = "Raising the maximum alone leaves them short of full, so this " ..
			"tops them up as well.",
		tags = "maxhealth health humanoid upgrade" }

D{ id = "playerFreeze", cat = "player", group = "Changing", label = "freeze a player",
		head = "freeze {hum}",
		code = { "{hum}.WalkSpeed = 0", "{hum}.JumpPower = 0", "{hum}.UseJumpPower = true" },
		fields = { hum = "expr|hum|humanoid" },
		doc = "Stops them walking and jumping without any of the strangeness of " ..
			"anchoring a character.",
		tags = "freeze stop walkspeed jump cutscene" }

D{ id = "playerUnfreeze", cat = "player", group = "Changing", label = "unfreeze a player",
		head = "unfreeze {hum}",
		code = { "{hum}.WalkSpeed = 16", "{hum}.JumpPower = 50" },
		fields = { hum = "expr|hum|humanoid" },
		doc = "Puts them back to Roblox's defaults. Store the old numbers first " ..
			"if you changed them.",
		tags = "unfreeze restore walkspeed jump defaults" }

D{ id = "playerForceField", cat = "player", group = "Changing", label = "protect a player",
		head = "protect {char} for {seconds} seconds",
		code = {
			"do",
			'\tlocal shield = Instance.new("ForceField")',
			"\tshield.Visible = {visible}",
			"\tshield.Parent = {char}",
			"\tDebris:AddItem(shield, {seconds})",
			"end",
		},
		fields = { char = "expr|char|character", seconds = "num|5|seconds",
			visible = "choice|true|visible|true,false" },
		needs = { "Debris" },
		doc = "A ForceField blocks TakeDamage entirely. Debris removes it after " ..
			"the time is up without a wait of your own.",
		tags = "forcefield spawn protection invulnerable shield" }

D{ id = "playerTeam", cat = "player", group = "Teams", label = "put on a team",
		head = 'put {player} on the team "{team}"',
		code = 'local team = game:GetService("Teams"):FindFirstChild("{team}")\n' ..
			"if team then\n\t{player}.Team = team\nend",
		fields = { player = "expr|player|player", team = "str|Red|team name" },
		side = "server",
		doc = "Teams live in the Teams service. Checking it exists first means a " ..
			"typo does not kill the script.",
		tags = "team teams assign side red blue" }

D{ id = "playerSameTeam", cat = "player", group = "Teams", label = "if on the same team",
		head = "if {a} and {b} are on the same team then",
		code = "if {a}.Team == {b}.Team then", tail = "end",
		fields = { a = "expr|player|first", b = "expr|other|second" },
		slots = { { key = "body" } },
		doc = "Stopping friendly fire is this check in front of the damage.",
		tags = "team same friendly fire check" }

D{ id = "playerEachOnTeam", cat = "player", group = "Teams", label = "for each player on a team",
		head = 'for each {player} on the team "{team}"',
		code = {
			"for _, {player} in ipairs(Players:GetPlayers()) do",
			'\tif {player}.Team and {player}.Team.Name == "{team}" then',
		},
		codeTail = { "\tend", "end" }, tail = "end",
		bodyIndent = 2,
		fields = { player = "name|player|player", team = "str|Red|team name" },
		slots = { { key = "body" } },
		needs = { "Players" },
		doc = "Walks everyone and skips anyone not on that team. Checking the " ..
			"team exists first covers players who have not been assigned one.",
		tags = "team players loop each side" }

D{ id = "playerStatValue", cat = "player", group = "Leaderboard", label = "read a leaderboard stat",
		head = 'make {name} = the "{stat}" of {player}',
		code = {
			"local {name} = 0",
			"do",
			'\tlocal folder = {player}:FindFirstChild("leaderstats")',
			'\tlocal stat = folder and folder:FindFirstChild("{stat}")',
			"\tif stat then",
			"\t\t{name} = stat.Value",
			"\tend",
			"end",
		},
		fields = { name = "name|coins|name", player = "expr|player|player", stat = "str|Coins|stat name" },
		doc = "Checks each step, so a player without leaderstats yet reads as " ..
			"zero rather than erroring.",
		tags = "leaderstats read value stat safe" }

D{ id = "playerSetStat", cat = "player", group = "Leaderboard", label = "set a leaderboard stat",
		head = 'set the "{stat}" of {player} to {value}',
		code = {
			"do",
			'\tlocal folder = {player}:FindFirstChild("leaderstats")',
			'\tlocal stat = folder and folder:FindFirstChild("{stat}")',
			"\tif stat then",
			"\t\tstat.Value = {value}",
			"\tend",
			"end",
		},
		fields = { player = "expr|player|player", stat = "str|Coins|stat name", value = "expr|0|value" },
		side = "server",
		doc = "Setting outright rather than adding. Only the server should touch " ..
			"these, or the change will not stick.",
		tags = "leaderstats set value stat server" }

--=============================================================================
-- DATA
--=============================================================================

D{ id = "dataNestedGet", cat = "data", group = "Nesting", label = "read a nested value",
		head = "make {name} = {key} of {sub} of {tbl}",
		code = "local {name} = {tbl}[{sub}] and {tbl}[{sub}][{key}] or nil",
		fields = { name = "name|value|name", tbl = "expr|data|table", sub = "expr|player|first key",
			key = "expr|\"coins\"|second key" },
		doc = "Checking the middle step first stops the whole thing erroring when " ..
			"the outer key is missing.",
		tags = "nested table deep read safe index" }

D{ id = "dataNestedSet", cat = "data", group = "Nesting", label = "write a nested value",
		head = "set {key} of {sub} of {tbl} to {value}",
		code = {
			"if {tbl}[{sub}] == nil then",
			"\t{tbl}[{sub}] = {}",
			"end",
			"{tbl}[{sub}][{key}] = {value}",
		},
		fields = { tbl = "expr|data|table", sub = "expr|player|first key", key = "expr|\"coins\"|second key",
			value = "expr|0|value" },
		doc = "Makes the inner table if it is not there yet, which is what stops " ..
			"the write failing the first time.",
		tags = "nested table write create deep" }

D{ id = "dataHasKey", cat = "data", group = "Nesting", label = "if a key is there",
		head = "if {tbl} has {key} then",
		code = "if {tbl}[{key}] ~= nil then", tail = "end",
		fields = { tbl = "expr|record|table", key = "expr|\"name\"|key" },
		slots = { { key = "body" } },
		doc = "Comparing to nil rather than testing truth, so a key holding " ..
			"`false` still counts as present.",
		tags = "haskey contains nil check dictionary" }

D{ id = "dataChangeKey", cat = "data", group = "Nesting", label = "change a number in a table",
		head = "change {key} of {tbl} by {amount}",
		code = "{tbl}[{key}] = ({tbl}[{key}] or 0) + {amount}",
		fields = { tbl = "expr|scores|table", key = "expr|player|key", amount = "expr|1|amount" },
		doc = "The `or 0` covers the first time, so there is no need to set it " ..
			"up beforehand.",
		tags = "increment tally counter table key" }

D{ id = "dataPushUnique", cat = "data", group = "Lists", label = "add if not already there",
		head = "add {value} to {list} if it is not there already",
		code = {
			"if not table.find({list}, {value}) then",
			"\ttable.insert({list}, {value})",
			"end",
		},
		fields = { list = "expr|list|list", value = "expr|item|value" },
		doc = "Keeps a list free of duplicates without a separate check every " ..
			"time you add to it.",
		tags = "unique insert duplicate once list" }

D{ id = "dataToText", cat = "data", group = "Saving", label = "table to text",
		head = "make {name} = {tbl} written as text",
		code = "local {name} = HttpService:JSONEncode({tbl})",
		fields = { name = "name|text|name", tbl = "expr|data|table" },
		needs = { "HttpService" },
		doc = "Turns a table into a single string, which is how you save " ..
			"something complicated in one value.",
		tags = "json encode text save serialise" }

D{ id = "dataFromText", cat = "data", group = "Saving", label = "text to table",
		head = "make {name} = the table inside {text}",
		code = {
			"local {name} = nil",
			"do",
			"\tlocal ok, decoded = pcall(function()",
			"\t\treturn HttpService:JSONDecode({text})",
			"\tend)",
			"\tif ok then",
			"\t\t{name} = decoded",
			"\tend",
			"end",
		},
		fields = { name = "name|data|name", text = "expr|saved|text" },
		needs = { "HttpService" },
		doc = "Wrapped, because text that is not valid JSON throws rather than " ..
			"handing back nil.",
		tags = "json decode parse load safe" }

D{ id = "dataListOfNames", cat = "data", group = "Lists", label = "list of names",
		head = "make {name} = the names of everything in {list}",
		code = {
			"local {name} = {}",
			"for _, thing in ipairs({list}) do",
			"\ttable.insert({name}, thing.Name)",
			"end",
		},
		fields = { name = "name|names|name", list = "expr|players|list" },
		doc = "Turning a list of players or parts into a list of names, which is " ..
			"what you want before joining them into a sentence.",
		tags = "names list map players parts" }

--=============================================================================
-- ODDS AND ENDS
--=============================================================================

D{ id = "onToolUsed", cat = "events", group = "Tools", label = "on a tool used",
		head = "when {tool} is used",
		code = "{tool}.Activated:Connect(function()", tail = "end)",
		fields = { tool = "expr|script.Parent|tool" },
		slots = { { key = "body" } },
		doc = "Fires when the player clicks while holding it. The whole of a " ..
			"sword swing or a gun shot starts here.",
		tags = "tool activated click use swing" }

D{ id = "onToolHeld", cat = "events", group = "Tools", label = "on a tool taken out",
		head = "when {tool} is taken out, with {char}",
		code = {
			"{tool}.Equipped:Connect(function()",
			"\tlocal {char} = {tool}.Parent",
		},
		codeTail = { "end)" }, tail = "end",
		fields = { tool = "expr|script.Parent|tool", char = "name|char|character" },
		slots = { { key = "body" } },
		doc = "While a tool is held its parent is the character, which is how it " ..
			"finds out whose hands it is in.",
		tags = "tool equipped hold character take out" }

D{ id = "onToolAway", cat = "events", group = "Tools", label = "on a tool put away",
		head = "when {tool} is put away",
		code = "{tool}.Unequipped:Connect(function()", tail = "end)",
		fields = { tool = "expr|script.Parent|tool" },
		slots = { { key = "body" } },
		doc = "Stop any looping effects here, or a holstered tool keeps running.",
		tags = "tool unequipped away holster stop" }

D{ id = "onFirstSpawn", cat = "events", group = "Players", label = "on their first spawn only",
		head = "when {player} spawns for the first time, as {char}",
		code = "{player}.CharacterAdded:Once(function({char})", tail = "end)",
		fields = { player = "expr|player|player", char = "name|char|character" },
		slots = { { key = "body" } },
		doc = "`Once` disconnects itself, so this skips every respawn after the " ..
			"first. Good for a welcome message.",
		tags = "once first spawn characteradded welcome" }

D{ id = "onZoneEnter", cat = "events", group = "In the world", label = "on a player entering",
		head = "when a player walks into {part}, as {player}",
		code = {
			"{part}.Touched:Connect(function(hit)",
			"\tlocal {player} = Players:GetPlayerFromCharacter(hit.Parent)",
			"\tif {player} then",
		},
		codeTail = { "\tend", "end)" }, tail = "end",
		bodyIndent = 2,
		fields = { part = "expr|script.Parent|part", player = "name|player|player" },
		slots = { { key = "body" } },
		needs = { "Players" }, side = "server",
		doc = "Touched plus the player lookup plus the check, which is the shape " ..
			"nearly every zone needs. Add a debounce inside.",
		tags = "zone touched player enter trigger area" }

D{ id = "ctrlDoNothing", cat = "control", group = "Timing", label = "do nothing",
		head = "do nothing",
		code = "-- nothing to do here",
		doc = "A placeholder for a branch you have not written yet, so the shape " ..
			"of the program is visible before the details are.",
		tags = "nothing placeholder empty todo stub" }

D{ id = "ctrlWaitRandom", cat = "control", group = "Timing", label = "wait a random time",
		head = "wait between {low} and {high} seconds",
		code = "task.wait({low} + math.random() * ({high} - {low}))",
		fields = { low = "num|1|shortest", high = "num|3|longest" },
		doc = "Staggering waits stops fifty NPCs all acting on exactly the same " ..
			"frame, which both looks wrong and costs more.",
		tags = "wait random stagger delay vary" }

D{ id = "ctrlEachCharacter", cat = "control", group = "Over objects", label = "for each character",
		head = "for each spawned character {char}",
		code = {
			"for _, player in ipairs(Players:GetPlayers()) do",
			"\tlocal {char} = player.Character",
			"\tif {char} then",
		},
		codeTail = { "\tend", "end" }, tail = "end",
		bodyIndent = 2,
		fields = { char = "name|char|character" },
		slots = { { key = "body" } },
		needs = { "Players" },
		doc = "Skips anyone who is dead or still loading, which a plain player " ..
			"loop would not.",
		tags = "characters loop players spawned each" }

D{ id = "logicOnGround", cat = "logic", group = "Characters", label = "if standing on the ground",
		head = "if {hum} is on the ground then",
		code = "if {hum}.FloorMaterial ~= Enum.Material.Air then", tail = "end",
		fields = { hum = "expr|hum|humanoid" },
		slots = { { key = "body" } },
		doc = "FloorMaterial is Air when nothing is underfoot, which is a more " ..
			"reliable ground check than watching for jump states.",
		tags = "floormaterial ground grounded jump check" }

D{ id = "logicMoving", cat = "logic", group = "Characters", label = "if moving",
		head = "if {hum} is moving then",
		code = "if {hum}.MoveDirection.Magnitude > 0 then", tail = "end",
		fields = { hum = "expr|hum|humanoid" },
		slots = { { key = "body" } },
		doc = "MoveDirection is which way they are trying to go. Length zero " ..
			"means standing still.",
		tags = "movedirection moving walking still check" }

D{ id = "logicHoldingTool", cat = "logic", group = "Characters", label = "if holding a tool",
		head = "if {char} is holding a tool then",
		code = 'if {char}:FindFirstChildOfClass("Tool") then', tail = "end",
		fields = { char = "expr|char|character" },
		slots = { { key = "body" } },
		doc = "A held tool sits inside the character. In the backpack it is not " ..
			"held, so it will not be found here.",
		tags = "tool holding equipped check character" }

D{ id = "mathSpeedOf", cat = "math", group = "Working out", label = "how fast something is going",
		head = "make {var} = how fast {part} is going",
		code = "{var} = {part}.AssemblyLinearVelocity.Magnitude",
		fields = { var = "expr|speed|variable", part = "expr|part|part" },
		doc = "The length of its velocity, in studs per second. A walking " ..
			"character is about 16.",
		tags = "speed velocity magnitude fast measure" }

D{ id = "mathFlatDistance", cat = "math", group = "Working out", label = "distance on the flat",
		head = "make {var} = how far {a} is from {b} on the flat",
		code = {
			"do",
			"\tlocal gap = {a} - {b}",
			"\t{var} = Vector3.new(gap.X, 0, gap.Z).Magnitude",
			"end",
		},
		fields = { var = "expr|gap|variable", a = "expr|part.Position|first", b = "expr|target.Position|second" },
		doc = "Ignores height, so somebody on a balcony still counts as near " ..
			"what is below them.",
		tags = "distance flat horizontal ignore height" }

D{ id = "textList", cat = "text", group = "Building", label = "join a list nicely",
		head = 'make {var} = {list} joined with commas and "and"',
		code = {
			"if #{list} <= 1 then",
			'\t{var} = {list}[1] or ""',
			"else",
			'\t{var} = table.concat({list}, ", ", 1, #{list} - 1) .. " and " .. {list}[#{list}]',
			"end",
		},
		fields = { var = "expr|sentence|variable", list = "expr|names|list" },
		doc = "Gives `Ana, Ben and Cara` rather than `Ana, Ben, Cara`. Small " ..
			"touch, and it makes generated text read like writing.",
		tags = "join list and commas sentence readable" }

D{ id = "instShape", cat = "inst", group = "Basics", label = "set the shape",
		head = "make {obj} a {shape}",
		code = "{obj}.Shape = Enum.PartType.{shape}",
		fields = { obj = "expr|part|part",
			shape = "choice|Ball|shape|Block,Ball,Cylinder,Wedge,CornerWedge" },
		doc = "Only works on a plain Part. MeshParts and unions have their shape " ..
			"baked in.",
		tags = "shape parttype ball cylinder wedge" }

D{ id = "instPlaceExactly", cat = "inst", group = "Moving", label = "place with a facing",
		head = "place {obj} at {cf}",
		code = "{obj}.CFrame = {cf}",
		fields = { obj = "expr|part|part", cf = "expr|CFrame.new(0, 10, 0)|place" },
		doc = "Sets position and facing together. Anything built out of `a place " ..
			"looking at` ends up here.",
		tags = "cframe place position facing set" }

D{ id = "instToggleAnchor", cat = "inst", group = "Basics", label = "flip anchored",
		head = "flip whether {obj} is anchored",
		code = "{obj}.Anchored = not {obj}.Anchored",
		fields = { obj = "expr|part|part" },
		doc = "Turns it into the opposite of whatever it is now, which is what a " ..
			"switch or a lever wants.",
		tags = "anchor toggle flip physics switch" }

D{ id = "playerBoostSpeed", cat = "player", group = "Changing", label = "boost speed for a while",
		head = "give {hum} {n} walk speed for {seconds} seconds",
		code = {
			"do",
			"\tlocal was = {hum}.WalkSpeed",
			"\t{hum}.WalkSpeed = {n}",
			"\ttask.delay({seconds}, function()",
			"\t\tif {hum}.Parent then",
			"\t\t\t{hum}.WalkSpeed = was",
			"\t\tend",
			"\tend)",
			"end",
		},
		fields = { hum = "expr|hum|humanoid", n = "num|32|speed", seconds = "num|10|seconds" },
		doc = "Remembers the old speed rather than assuming 16, so two boosts " ..
			"cannot leave someone permanently slow.",
		tags = "speed boost powerup temporary restore" }

D{ id = "playerRespawnAfter", cat = "player", group = "Changing", label = "respawn after a delay",
		head = "respawn {player} after {seconds} seconds",
		code = {
			"task.delay({seconds}, function()",
			"\tif {player}.Parent then",
			"\t\t{player}:LoadCharacter()",
			"\tend",
			"end)",
		},
		fields = { player = "expr|player|player", seconds = "num|5|seconds" },
		side = "server",
		doc = "Checking they are still in the game first avoids an error when " ..
			"somebody leaves during the wait.",
		tags = "respawn delay loadcharacter death timer" }

D{ id = "dataRandomKey", cat = "data", group = "Nesting", label = "a random key",
		head = "make {name} = a random key from {record}",
		code = {
			"local {name} = nil",
			"do",
			"\tlocal keys = {}",
			"\tfor key in pairs({record}) do",
			"\t\ttable.insert(keys, key)",
			"\tend",
			"\tif #keys > 0 then",
			"\t\t{name} = keys[math.random(1, #keys)]",
			"\tend",
			"end",
		},
		fields = { name = "name|picked|name", record = "expr|record|record" },
		doc = "Dictionaries cannot be indexed by number, so picking at random " ..
			"means listing the keys first.",
		tags = "random key dictionary pick choose" }

D{ id = "sectionNote", cat = "special", group = "Notes", label = "section heading",
		head = "-- {text} --",
		code = { "", "-- {text}" },
		fields = { text = "str|set up|heading" },
		doc = "A blank line and a comment, for breaking a long script into parts " ..
			"a reader can scan.",
		tags = "comment section heading divider organise" }

D{ id = "todoNote", cat = "special", group = "Notes", label = "to do",
		head = "to do: {text}",
		code = "-- TODO: {text}",
		fields = { text = "str|handle the empty case|what to do" },
		doc = "Marks something unfinished. Studio's script analysis can list " ..
			"every TODO in your place.",
		tags = "todo comment unfinished note reminder" }

D{ id = "rawMultiline", cat = "special", group = "Notes", label = "long comment",
		head = "long note: {text}",
		code = { "--[[", "\t{text}", "]]" },
		fields = { text = "multiline|Explain the tricky bit here.|note" },
		doc = "A comment spanning several lines, for explaining something that " ..
			"needs more than one.",
		tags = "comment long block multiline explain" }

end
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
</roblox>
