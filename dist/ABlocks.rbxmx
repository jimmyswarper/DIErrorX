--=============================================================================
-- the rest of the definitions
--
-- Split across files so no single one is unreadable.  Each returns a function
-- taking the define helper, which is what keeps them from having to require
-- this module back and make a cycle.
--=============================================================================

for _, load in ipairs({
		require(script.Parent.s),
		require(script.Parent.t),
		require(script.Parent.u),
		require(script.Parent.v),
		require(script.Parent.w),
}) do
		load(D)
end

--=============================================================================
-- lookups
--=============================================================================

function c.get(id)
		return c.defs[id]
end

-- Custom blocks come and go as they are edited, so the registry has to be able
-- to forget one.
function c.undefine(id)
		if not c.defs[id] then return false end
		c.defs[id] = nil
		for index, def in ipairs(c.order) do
			if def.id == id then
				table.remove(c.order, index)
				break
			end
		end
		return true
end

function c.byCat(catId)
		local out = {}
		for _, def in ipairs(c.order) do
			if def.cat == catId then out[#out + 1] = def end
		end
		return out
end

function c.count()
		return #c.order
end

-- Every field key a definition actually uses, in the order they are read.
function c.fieldOrder(def)
		local seen, order = {}, {}
		local function scan(parts)
			for _, part in ipairs(parts) do
				if part.t == "field" and not seen[part.k] then
					seen[part.k] = true
					order[#order + 1] = part.k
				end
			end
		end
		for _, line in ipairs(def.headTpl) do scan(line) end
		for _, slot in ipairs(def.slots) do
			if slot.preTpl then scan(slot.preTpl) end
		end
		if def.tailTpl then scan(def.tailTpl) end
		return order
end

-- Sanity pass used by the test suite: every `{key}` must have a field, and
-- every field must be referenced by a template.
function c.validate()
		local problems = {}
		for _, def in ipairs(c.order) do
			local used = {}
			local function scan(text, where)
				for key in string.gmatch(text, FIELD_PATTERN) do
					used[key] = true
					if not def.fields[key] then
						problems[#problems + 1] = def.id .. ": " .. where ..
							" uses undeclared field {" .. key .. "}"
					end
				end
			end
			for _, line in ipairs(def.headLines) do scan(line, "head") end
			for _, line in ipairs(def.codeLines) do scan(line, "code") end
			for _, line in ipairs(def.tailLines or {}) do scan(line, "tail") end
			for _, line in ipairs(def.codeTailLines or {}) do scan(line, "codeTail") end
			for _, slot in ipairs(def.slots) do
				if slot.pre then scan(slot.pre, "slot pre") end
				if slot.codePre then scan(slot.codePre, "slot code") end
			end
			for key in pairs(def.fields) do
				if not used[key] then
					problems[#problems + 1] = def.id .. ": field {" .. key ..
						"} is declared but never used"
				end
			end
			if not def.doc or #def.doc < 20 then
				problems[#problems + 1] = def.id .. ": missing or thin documentation"
			end
		end
		return problems
end

return c
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX4">
			<Properties>
				<string name="Name">d</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- d  ·  document model
--
-- A program is a flat map of blocks plus a list of stacks.  A stack is a run of
-- blocks sitting at one spot on the canvas; slots inside a block hold runs too,
-- so every list of blocks in the editor -- top level or nested -- is the same
-- shape and the layout, drag and codegen passes only ever learn one structure.
--
--   block = {
--     id = "b7", k = "if",           -- k is a registry id from `c`
--     f = { cond = "hp <= 0" },      -- field values, always strings
--     s = { body = {"b8","b9"} },    -- slot name -> ordered child ids
--     p = "b3", ps = "body",         -- parent block + slot, when nested
--     st = "s1",                     -- owning stack, when top level
--   }
--   stack = { id = "s1", x = 40, y = 120, ids = {"b7","b12"} }

local c = require(script.Parent.c)

local d = {}

d.FORMAT = 1

function d.newDoc(name)
		return {
			format = d.FORMAT,
			name = name or "Untitled",
			nextId = 1,
			blocks = {},
			stacks = {},
			-- Where this came from, when it was read out of a script in the place:
			-- { kind = "Script", path = "ServerScriptService.Main", name = "Main" }.
			-- Kept so the code can be written straight back where it belongs.
			origin = nil,
		}
end

local function nextId(doc, prefix)
		local id = prefix .. doc.nextId
		doc.nextId = doc.nextId + 1
		return id
end

function d.newStack(doc, x, y)
		local stack = { id = nextId(doc, "s"), x = x or 24, y = y or 24, ids = {} }
		doc.stacks[#doc.stacks + 1] = stack
		return stack
end

function d.stack(doc, id)
		for _, stack in ipairs(doc.stacks) do
			if stack.id == id then return stack end
		end
		return nil
end

-- Creates a block with its slots ready, belonging to nothing yet.
function d.create(doc, kind)
		local def = c.get(kind)
		assert(def, "unknown block kind: " .. tostring(kind))
		local block = { id = nextId(doc, "b"), k = kind, f = {}, s = {} }
		for _, slot in ipairs(def.slots) do
			block.s[slot.key] = {}
		end
		doc.blocks[block.id] = block
		return block
end

function d.get(doc, id)
		return id and doc.blocks[id] or nil
end

function d.def(block)
		return block and c.get(block.k) or nil
end

-- The list a block lives in, plus its position in that list.
function d.listOf(doc, block)
		if block.p then
			local parent = doc.blocks[block.p]
			if not parent then return nil, nil end
			return parent.s[block.ps], parent
		end
		local stack = d.stack(doc, block.st)
		if not stack then return nil, nil end
		return stack.ids, stack
end

local function indexOf(list, value)
		for index, item in ipairs(list) do
			if item == value then return index end
		end
		return nil
end

function d.indexOf(doc, block)
		local list = d.listOf(doc, block)
		return list and indexOf(list, block.id) or nil
end

function d.children(doc, block, slotKey)
		local out = {}
		for _, id in ipairs((block.s and block.s[slotKey]) or {}) do
			local child = doc.blocks[id]
			if child then out[#out + 1] = child end
		end
		return out
end

-- Blocks in a stack, resolved.
function d.stackBlocks(doc, stack)
		local out = {}
		for _, id in ipairs(stack.ids) do
			local block = doc.blocks[id]
			if block then out[#out + 1] = block end
		end
		return out
end

-- Only ever prunes the stack a block just left.  Sweeping every empty stack
-- would also take the fresh one a block is on its way into.
local function dropIfEmpty(doc, owner)
		if not owner or not owner.ids or #owner.ids > 0 then return end
		for index, stack in ipairs(doc.stacks) do
			if stack == owner then
				table.remove(doc.stacks, index)
				return
			end
		end
end

-- Removes a block from its list without deleting it.  Returns the siblings that
-- followed it, which the caller may want to carry along.
local function unlink(doc, block, takeFollowing)
		local list, owner = d.listOf(doc, block)
		local following = {}
		if list then
			local at = indexOf(list, block.id)
			if at then
				if takeFollowing then
					for index = #list, at + 1, -1 do
						following[#following + 1] = doc.blocks[list[index]]
						table.remove(list, index)
					end
					-- collected back to front; put them back in reading order
					local flipped = {}
					for index = #following, 1, -1 do
						flipped[#flipped + 1] = following[index]
					end
					following = flipped
				end
				table.remove(list, at)
			end
		end
		block.p, block.ps, block.st = nil, nil, nil
		dropIfEmpty(doc, owner)
		return following
end

function d.isAncestor(doc, maybeAncestor, block)
		local walker = block
		while walker do
			if walker.id == maybeAncestor.id then return true end
			walker = walker.p and doc.blocks[walker.p] or nil
		end
		return false
end

-- Would dropping `block` here swallow the block itself?
function d.canDropIn(doc, block, parent)
		if not parent then return true end
		return not d.isAncestor(doc, block, parent)
end

local function place(doc, block, list, index, ownerFields)
		index = math.clamp(index or (#list + 1), 1, #list + 1)
		table.insert(list, index, block.id)
		block.p, block.ps, block.st = ownerFields.p, ownerFields.ps, ownerFields.st
		return index
end

-- Inserts `block` into a slot.  When `following` is omitted the blocks below it
-- come along, the way dragging works; pass an empty table to move it alone.
function d.attachToSlot(doc, block, parent, slotKey, index, following)
		if not d.canDropIn(doc, block, parent) then return false end
		if following then
			unlink(doc, block, false)
		else
			following = unlink(doc, block, true)
		end
		local list = parent.s[slotKey]
		if not list then
			list = {}
			parent.s[slotKey] = list
		end
		local at = place(doc, block, list, index, { p = parent.id, ps = slotKey })
		for offset, sibling in ipairs(following) do
			place(doc, sibling, list, at + offset, { p = parent.id, ps = slotKey })
		end
		return true
end

function d.attachToStack(doc, block, stack, index, following)
		if following then
			unlink(doc, block, false)
		else
			following = unlink(doc, block, true)
		end
		local at = place(doc, block, stack.ids, index, { st = stack.id })
		for offset, sibling in ipairs(following) do
			place(doc, sibling, stack.ids, at + offset, { st = stack.id })
		end
		return true
end

-- Pulls a block (and everything under it in its list) onto open canvas.
function d.detach(doc, block, x, y)
		local following = unlink(doc, block, true)
		local stack = d.newStack(doc, x, y)
		d.attachToStack(doc, block, stack, 1, following)
		return stack
end

function d.remove(doc, block)
		unlink(doc, block, false)
		local pending = { block }
		while #pending > 0 do
			local current = table.remove(pending)
			for _, ids in pairs(current.s or {}) do
				for _, id in ipairs(ids) do
					local child = doc.blocks[id]
					if child then pending[#pending + 1] = child end
				end
			end
			doc.blocks[current.id] = nil
		end
end

-- Deep copy onto the canvas at (x, y).
function d.duplicate(doc, block, x, y)
		local function copy(source)
			local made = { id = nextId(doc, "b"), k = source.k, f = {}, s = {} }
			for key, value in pairs(source.f or {}) do made.f[key] = value end
			doc.blocks[made.id] = made
			for slotKey, ids in pairs(source.s or {}) do
				local list = {}
				for _, id in ipairs(ids) do
					local child = doc.blocks[id]
					if child then
						local madeChild = copy(child)
						madeChild.p, madeChild.ps = made.id, slotKey
						list[#list + 1] = madeChild.id
					end
				end
				made.s[slotKey] = list
			end
			return made
		end

		local root = copy(block)
		local stack = d.newStack(doc, x, y)
		d.attachToStack(doc, root, stack, 1, {})
		return root, stack
end

-- Stacks read top-to-bottom, then left-to-right, the way a person would.
function d.sortedStacks(doc)
		local list = {}
		for _, stack in ipairs(doc.stacks) do
			if #stack.ids > 0 then list[#list + 1] = stack end
		end
		table.sort(list, function(a, b)
			if math.abs((a.y or 0) - (b.y or 0)) > 8 then return (a.y or 0) < (b.y or 0) end
			return (a.x or 0) < (b.x or 0)
		end)
		return list
end

function d.walk(doc, visit)
		local function step(block, depth)
			visit(block, depth)
			local def = c.get(block.k)
			for _, slot in ipairs(def and def.slots or {}) do
				for _, child in ipairs(d.children(doc, block, slot.key)) do
					step(child, depth + 1)
				end
			end
		end
		for _, stack in ipairs(d.sortedStacks(doc)) do
			for _, block in ipairs(d.stackBlocks(doc, stack)) do
				step(block, 0)
			end
		end
end

function d.count(doc)
		local total = 0
		d.walk(doc, function() total = total + 1 end)
		return total
end

-- Every name the document introduces, so IntelliSense can complete your own
-- variables next to the built-in ones.
function d.symbols(doc)
		local found = {}
		local function add(text, kind, detail)
			if not text or text == "" then return end
			for word in string.gmatch(text, "[%a_][%w_]*") do
				if not found[word] then
					found[word] = { name = word, kind = kind, detail = detail }
				end
			end
		end

		d.walk(doc, function(block)
			local def = c.get(block.k)
			if not def then return end
			if block.k == "svc" then
				local service = c.fieldValue(def, block, "name")
				found[service] = { name = service, kind = "service", detail = service }
				return
			end
			for key, field in pairs(def.fields) do
				local value = c.fieldValue(def, block, key)
				if field.kind == "name" then
					local detail
					if block.k == "create" then
						detail = c.fieldValue(def, block, "class")
					elseif block.k == "clone" then
						detail = "Instance"
					end
					add(value, block.k == "def" and "function" or "variable", detail)
				elseif field.kind == "params" then
					add(value, "parameter")
				end
			end
		end)

		local list = {}
		for _, entry in pairs(found) do list[#list + 1] = entry end
		table.sort(list, function(a, b) return a.name < b.name end)
		return list
end

--=============================================================================
-- storage
--=============================================================================

function d.toSave(doc)
		local blocks = {}
		for id, block in pairs(doc.blocks) do
			local slim = { id = id, k = block.k }
			for _ in pairs(block.f or {}) do
				slim.f = block.f
				break
			end
			for slotKey, ids in pairs(block.s or {}) do
				if #ids > 0 then
					slim.s = slim.s or {}
					slim.s[slotKey] = ids
				end
			end
			blocks[#blocks + 1] = slim
		end
		table.sort(blocks, function(a, b) return a.id < b.id end)

		local stacks = {}
		for _, stack in ipairs(doc.stacks) do
			if #stack.ids > 0 then
				stacks[#stacks + 1] = {
					id = stack.id,
					x = math.floor(stack.x or 0),
					y = math.floor(stack.y or 0),
					ids = stack.ids,
				}
			end
		end

		return {
			format = d.FORMAT,
			name = doc.name,
			nextId = doc.nextId,
			origin = doc.origin,
			-- Custom blocks the document uses travel with it, so opening someone
			-- else's project adds their blocks rather than breaking.
			customs = doc.customs,
			blocks = blocks,
			stacks = stacks,
		}
end

function d.fromSave(saved)
		if type(saved) ~= "table" or type(saved.blocks) ~= "table"
			or type(saved.stacks) ~= "table" then
			return nil, "that does not look like a ABlocks project"
		end

		local doc = d.newDoc(saved.name)
		doc.nextId = saved.nextId or 1
		if type(saved.customs) == "table" then
			doc.customs = saved.customs
		end
		if type(saved.origin) == "table" and saved.origin.kind then
			doc.origin = {
				kind = saved.origin.kind,
				path = saved.origin.path,
				name = saved.origin.name,
			}
		end
		for _, slim in ipairs(saved.blocks) do
			if type(slim) == "table" and c.get(slim.k) then
				doc.blocks[slim.id] = {
					id = slim.id, k = slim.k, f = slim.f or {}, s = slim.s or {},
				}
			end
		end

		local claimed = {}
		for id, block in pairs(doc.blocks) do
			for slotKey, ids in pairs(block.s) do
				local kept = {}
				for _, childId in ipairs(ids) do
					local child = doc.blocks[childId]
					if child and not claimed[childId] then
						claimed[childId] = true
						child.p, child.ps = id, slotKey
						kept[#kept + 1] = childId
					end
				end
				block.s[slotKey] = kept
			end
		end

		for _, savedStack in ipairs(saved.stacks) do
			local stack = { id = savedStack.id, x = savedStack.x or 24,
				y = savedStack.y or 24, ids = {} }
			for _, id in ipairs(savedStack.ids or {}) do
				local block = doc.blocks[id]
				if block and not claimed[id] then
					claimed[id] = true
					block.st = stack.id
					stack.ids[#stack.ids + 1] = id
				end
			end
			if #stack.ids > 0 then doc.stacks[#doc.stacks + 1] = stack end
		end

		-- Anything a damaged file left stranded still shows up, off to one side,
		-- rather than silently disappearing.
		local stranded = {}
		for id, block in pairs(doc.blocks) do
			if not claimed[id] then stranded[#stranded + 1] = id end
		end
		table.sort(stranded)
		if #stranded > 0 then
			local stack = d.newStack(doc, 24, 24)
			for _, id in ipairs(stranded) do
				doc.blocks[id].st = stack.id
				stack.ids[#stack.ids + 1] = id
			end
		end

		return doc
end

return d
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX5">
			<Properties>
				<string name="Name">e</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- e  ·  code generator
--
-- Walks the document and writes Luau.  Two things make the output feel
-- hand-written rather than machine-stamped:
--
--   * services are hoisted -- blocks declare what they need ("Players",
--     "TweenService") and one tidy preamble appears at the top, skipping any
--     service you already declared yourself;
--   * `if` blocks nested in an `otherwise` slot collapse back into `elseif`,
--     so a five-way branch does not march off the right edge of the screen.
--
--   local code, meta = e.generate(doc)
--   meta.blockOfLine[12] -- which block wrote line 12

local c = require(script.Parent.c)
local d = require(script.Parent.d)
local g = require(script.Parent.g)

local e = {}

local INDENT = "\t"

local Writer = {}
Writer.__index = Writer

local function newWriter()
		return setmetatable({
			lines = {},
			owners = {},
			depth = 0,
			needs = {},
			declared = {},
			declaredFunctions = {},
			helpers = {},
		}, Writer)
end

function Writer:line(text, owner)
		local body = text or ""
		if body == "" then
			self.lines[#self.lines + 1] = ""
		else
			self.lines[#self.lines + 1] = string.rep(INDENT, self.depth) .. body
		end
		self.owners[#self.lines] = owner
		-- Notice services the author declared by hand so the preamble stays quiet.
		local name = string.match(body, '^local%s+([%a_][%w_]*)%s*=%s*game:GetService')
		if name then self.declared[name] = true end
		-- Same for functions: a custom block's helper is not written twice if the
		-- document already defines one by that name.
		local fn = string.match(body, "^local%s+function%s+([%a_][%w_]*)")
		if fn then self.declaredFunctions[fn] = true end
		return #self.lines
end

-- Template lines may start with tabs to nest inside their own block.
function Writer:tpl(text, owner)
		local extra = 0
		local body = text
		while string.sub(body, 1, 1) == INDENT do
			extra = extra + 1
			body = string.sub(body, 2)
		end
		self.depth = self.depth + extra
		local at = self:line(body, owner)
		self.depth = self.depth - extra
		return at
end

function Writer:push(levels) self.depth = self.depth + (levels or 1) end
function Writer:pop(levels) self.depth = math.max(0, self.depth - (levels or 1)) end

--=============================================================================

local emitStack

local function fillLine(def, block, template)
		return c.fill(c.parseTemplate(template), def, block)
end

-- `if a then ... otherwise (single if) ...` -> `if a then ... elseif b then ...`
-- Writes the chain without its closing `end`; the caller owns that, so the
-- recursion cannot lose it.
local function emitIfChain(w, doc, block, keyword)
		local def = c.get(block.k)
		w:tpl(string.gsub(fillLine(def, block, def.codeLines[1]), "^if", keyword, 1), block.id)
		w:push()
		emitStack(w, doc, d.children(doc, block, "body"))
		w:pop()

		local els = d.children(doc, block, "els")
		if #els == 1 and (els[1].k == "if" or els[1].k == "ifelse") then
			emitIfChain(w, doc, els[1], "elseif")
			return
		end
		if #els > 0 then
			w:line("else", block.id)
			w:push()
			emitStack(w, doc, els)
			w:pop()
		end
end

local function emitBlock(w, doc, block)
		local def = c.get(block.k)
		if not def then
			w:line("-- [ABlocks] unknown block '" .. tostring(block.k) .. "'", block.id)
			return
		end

		for _, service in ipairs(def.needs or {}) do
			w.needs[service] = true
		end

		if def.raw then
			local source = c.fieldValue(def, block, "code")
			if source == "" then return end
			for piece in string.gmatch(source .. "\n", "([^\n]*)\n") do
				w:line(piece, block.id)
			end
			return
		end

		-- Custom blocks with no slots compile to one function at the top and a
		-- call here; ones with slots fall through and inline, because what goes
		-- inside them changes from use to use.
		local custom = def.custom
		if custom and (custom.helper or custom.returnsHelper) then
			local args = {}
			for _, key in ipairs(custom.params) do
				args[#args + 1] = c.fieldValue(def, block, key)
			end
			local call = custom.fn .. "(" .. table.concat(args, ", ") .. ")"
			w.helpers[custom.fn] = custom
			if custom.returnsHelper then
				w:line("local " .. c.fieldValue(def, block, custom.out) .. " = " .. call,
					block.id)
			else
				w:line(call, block.id)
			end
			return
		end

		if def.elseifCollapse then
			emitIfChain(w, doc, block, "if")
			w:line("end", block.id)
			return
		end

		for _, template in ipairs(def.codeLines) do
			w:tpl(fillLine(def, block, template), block.id)
		end

		for _, slot in ipairs(def.slots) do
			local lead = slot.codePreLines or (slot.codePre and { slot.codePre })
			if lead then
				local at = slot.codeIndent or (def.bodyIndent - 1)
				w:push(at)
				for _, line in ipairs(lead) do
					w:tpl(fillLine(def, block, line), block.id)
				end
				w:pop(at)
			end
			w:push(def.bodyIndent)
			emitStack(w, doc, d.children(doc, block, slot.key))
			w:pop(def.bodyIndent)
		end

		for _, template in ipairs(def.codeTailLines or {}) do
			w:tpl(fillLine(def, block, template), block.id)
		end
end

function emitStack(w, doc, blocks)
		for _, block in ipairs(blocks) do
			emitBlock(w, doc, block)
		end
end

--=============================================================================

local SERVICE_ORDER = {
		Players = 1, RunService = 2, ReplicatedStorage = 3, ServerStorage = 4,
		TweenService = 5, UserInputService = 6, CollectionService = 7, Debris = 8,
}

-- Generates the script for a document.
-- opts.header = false turns off the two-line banner.
function e.generate(doc, opts)
		opts = opts or {}
		local w = newWriter()

		for index, stack in ipairs(d.sortedStacks(doc)) do
			if index > 1 then w:line("") end
			emitStack(w, doc, d.stackBlocks(doc, stack))
		end

		local preamble = {}
		local pending = {}
		for service in pairs(w.needs) do
			if not w.declared[service] then pending[#pending + 1] = service end
		end
		table.sort(pending, function(a, b)
			local ra, rb = SERVICE_ORDER[a] or 50, SERVICE_ORDER[b] or 50
			if ra ~= rb then return ra < rb end
			return a < b
		end)
		for _, service in ipairs(pending) do
			preamble[#preamble + 1] =
				string.format('local %s = game:GetService("%s")', service, service)
		end

		-- helper functions for the custom blocks that were used
		local helperNames = {}
		for name in pairs(w.helpers) do
			if not w.declaredFunctions[name] then helperNames[#helperNames + 1] = name end
		end
		table.sort(helperNames)

		local helpers = {}
		for _, name in ipairs(helperNames) do
			local custom = w.helpers[name]
			helpers[#helpers + 1] = string.format("local function %s(%s)", name,
				table.concat(custom.params, ", "))
			for _, line in ipairs(custom.body) do
				-- inside the helper the placeholders are simply its parameters
				local filled = string.gsub(line, "{([%a_][%w_]*)}", "%1")
				helpers[#helpers + 1] = filled == "" and "" or ("\t" .. filled)
			end
			if custom.returns then
				-- a value-producing block's body is the expression to hand back
				helpers[#helpers] = nil
				local body = {}
				for _, line in ipairs(custom.body) do
					body[#body + 1] = (string.gsub(line, "{([%a_][%w_]*)}", "%1"))
				end
				helpers[#helpers + 1] = "\treturn " .. table.concat(body, " ")
			end
			helpers[#helpers + 1] = "end"
			helpers[#helpers + 1] = ""
		end

		local head = {}
		if opts.header ~= false then
			head[#head + 1] = "-- " .. (doc.name or "Untitled")
			head[#head + 1] = "-- built with ABlocks -- edits here do not travel back to the blocks"
			head[#head + 1] = ""
		end
		if #preamble > 0 then
			for _, line in ipairs(preamble) do head[#head + 1] = line end
			head[#head + 1] = ""
		end
		for _, line in ipairs(helpers) do head[#head + 1] = line end

		local out = {}
		local blockOfLine = {}
		local lineOfBlock = {}
		for _, line in ipairs(head) do out[#out + 1] = line end
		local offset = #out
		for index, line in ipairs(w.lines) do
			out[#out + 1] = line
			local owner = w.owners[index]
			if owner then
				blockOfLine[index + offset] = owner
				if not lineOfBlock[owner] then lineOfBlock[owner] = index + offset end
			end
		end

		while #out > 0 and out[#out] == "" do out[#out] = nil end
		if #out == 0 then
			out[1] = "-- Nothing on the canvas yet."
			out[2] = "-- Drag a block out of the palette on the left to start."
		end

		return table.concat(out, "\n"), {
			blockOfLine = blockOfLine,
			lineOfBlock = lineOfBlock,
			services = pending,
			lineCount = #out,
		}
end

--=============================================================================
-- advice
--
-- The three script kinds do not run in the same place or at the same time, and
-- most beginner bugs are a script in the wrong one.  These checks are plain
-- text searches on the generated code: cheap, and honest about being rules of
-- thumb rather than analysis.
--=============================================================================

local CLIENT_ONLY = {
		{ "Players.LocalPlayer", "LocalPlayer only exists on the client" },
		{ "UserInputService", "UserInputService only hears input on the client" },
		{ "RenderStepped", "RenderStepped only fires on the client" },
		{ ":GetMouse()", "GetMouse only exists on the client" },
		{ "CurrentCamera", "the camera belongs to one client" },
}

local SERVER_ONLY = {
		{ "ServerStorage", "ServerStorage is invisible to the client" },
		{ "ServerScriptService", "ServerScriptService is invisible to the client" },
		{ "DataStoreService", "data stores can only be reached from the server" },
		{ ":Kick(", "only the server can remove a player" },
		{ ":LoadCharacter()", "only the server can respawn a character" },
}

local function mentions(code, needle)
		return string.find(code, needle, 1, true) ~= nil
end

-- Returns { { level = "warn" | "note", text = "..." }, ... }
function e.advise(code, kind)
		local notes = {}

		if kind == "ModuleScript" then
			local chunk = g.parse(code)
			local last = chunk and chunk.body[#chunk.body]
			if chunk and (not last or last.k ~= "return") then
				notes[#notes + 1] = {
					level = "warn",
					text = "A ModuleScript has to hand something back. End with a " ..
						"`give back` block, or nothing that requires this will get " ..
						"anything.",
				}
			end
		end

		if kind == "LocalScript" then
			for _, rule in ipairs(SERVER_ONLY) do
				if mentions(code, rule[1]) then
					notes[#notes + 1] = { level = "warn",
						text = "This is a LocalScript, but " .. rule[2] .. "." }
				end
			end
		elseif kind == "Script" then
			for _, rule in ipairs(CLIENT_ONLY) do
				if mentions(code, rule[1]) then
					notes[#notes + 1] = { level = "warn",
						text = "This is a server Script, but " .. rule[2] .. "." }
				end
			end
		end

		return notes
end

-- Just the code for one block and its children, used by tutorials and tooltips.
function e.snippet(doc, block)
		local w = newWriter()
		emitBlock(w, doc, block)
		return table.concat(w.lines, "\n")
end

return e
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX6">
			<Properties>
				<string name="Name">f</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- f  ·  Luau lexer
--
-- Turns source text into a flat token list.  Every token carries the byte range
-- it came from (`s`..`e`) so later stages can slice the original source back out
-- verbatim -- that is how the importer keeps expressions byte-perfect instead of
-- trying to pretty-print them again.
--
--   local tok, err = f.tokenize(src)
--   tok[1] = { t = "name", v = "print", s = 1, e = 5, line = 1, col = 1 }
--
-- Token kinds: name · number · string · kw · sym · eof
-- Comments are not returned inline; they land in `tok.comments` so the parser
-- never has to step over them but the importer can still recover them.

local f = {}

local KEYWORDS = {}
for word in string.gmatch(
		"and break do else elseif end false for function if in local nil not or " ..
		"repeat return then true until while", "%S+") do
		KEYWORDS[word] = true
end
f.KEYWORDS = KEYWORDS

-- Contextual keywords: real identifiers to the language, but highlighted and
-- treated as statement heads when they appear in the right position.
f.SOFT = { continue = true, type = true, export = true }

local SYM3 = { ["..."] = true, ["//="] = true, ["..="] = true }
local SYM2 = {
		["=="] = true, ["~="] = true, ["<="] = true, [">="] = true, [".."] = true,
		["::"] = true, ["->"] = true, ["+="] = true, ["-="] = true, ["*="] = true,
		["/="] = true, ["%="] = true, ["^="] = true, ["//"] = true,
}
local SYM1 = {}
-- `@` opens a function attribute such as `@native`.
for ch in string.gmatch("+-*/%^#<>=(){}[];:,.?&|@", ".") do SYM1[ch] = true end

local function isDigit(c) return c >= "0" and c <= "9" end
local function isHex(c)
		return isDigit(c) or (c >= "a" and c <= "f") or (c >= "A" and c <= "F")
end
local function isAlpha(c)
		return c == "_" or (c >= "a" and c <= "z") or (c >= "A" and c <= "Z")
end
local function isAlnum(c) return isAlpha(c) or isDigit(c) end

-- Reads the `[==[` opener at `i`. Returns the level and the index just past the
-- opening bracket, or nil when `i` is not a long-bracket start.
local function longOpen(src, i)
		if string.sub(src, i, i) ~= "[" then return nil end
		local j = i + 1
		local level = 0
		while string.sub(src, j, j) == "=" do
			level = level + 1
			j = j + 1
		end
		if string.sub(src, j, j) ~= "[" then return nil end
		return level, j + 1
end

local function longClose(src, i, level)
		local close = "]" .. string.rep("=", level) .. "]"
		local a, b = string.find(src, close, i, true)
		if not a then return nil end
		return a, b
end

function f.tokenize(src)
		local tokens = {}
		local comments = {}
		local i = 1
		local n = #src
		local line = 1
		local lineStart = 1
		local err = nil

		local function fail(msg, at)
			err = { msg = msg, line = line, col = at - lineStart + 1, pos = at }
		end

		local function push(t, v, s, e)
			tokens[#tokens + 1] = {
				t = t, v = v, s = s, e = e, line = line, col = s - lineStart + 1,
			}
		end

		-- Advances `line`/`lineStart` across a span that may contain newlines.
		local function consumeSpan(from, to)
			local j = from
			while j <= to do
				local c = string.sub(src, j, j)
				if c == "\n" then
					line = line + 1
					lineStart = j + 1
				end
				j = j + 1
			end
		end

		while i <= n and not err do
			local c = string.sub(src, i, i)

			if c == "\n" then
				line = line + 1
				i = i + 1
				lineStart = i
			elseif c == " " or c == "\t" or c == "\r" then
				i = i + 1
			elseif c == "-" and string.sub(src, i + 1, i + 1) == "-" then
				local start = i
				local startLine = line
				local level, after = longOpen(src, i + 2)
				if level then
					local a, b = longClose(src, after, level)
					if not a then
						fail("unfinished long comment", start)
						break
					end
					consumeSpan(start, b)
					comments[#comments + 1] = {
						s = start, e = b, line = startLine, long = true,
						text = string.sub(src, after, a - 1),
					}
					i = b + 1
				else
					local stop = string.find(src, "\n", i, true) or (n + 1)
					comments[#comments + 1] = {
						s = start, e = stop - 1, line = startLine, long = false,
						text = string.sub(src, i + 2, stop - 1),
					}
					i = stop
				end
			elseif isAlpha(c) then
				local s = i
				while i <= n and isAlnum(string.sub(src, i, i)) do i = i + 1 end
				local word = string.sub(src, s, i - 1)
				push(KEYWORDS[word] and "kw" or "name", word, s, i - 1)
			elseif isDigit(c) or (c == "." and isDigit(string.sub(src, i + 1, i + 1))) then
				local s = i
				local two = string.lower(string.sub(src, i, i + 1))
				if two == "0x" then
					i = i + 2
					while i <= n and (isHex(string.sub(src, i, i)) or string.sub(src, i, i) == "_") do
						i = i + 1
					end
				elseif two == "0b" then
					i = i + 2
					while i <= n and string.find(string.sub(src, i, i), "[01_]") do
						i = i + 1
					end
				else
					local seenDot, seenExp = false, false
					while i <= n do
						local d = string.sub(src, i, i)
						if isDigit(d) or d == "_" then
							i = i + 1
						elseif d == "." and not seenDot and not seenExp then
							seenDot = true
							i = i + 1
						elseif (d == "e" or d == "E") and not seenExp then
							seenExp = true
							i = i + 1
							local sign = string.sub(src, i, i)
							if sign == "+" or sign == "-" then i = i + 1 end
						else
							break
						end
					end
				end
				push("number", string.sub(src, s, i - 1), s, i - 1)
			elseif c == '"' or c == "'" then
				local quote = c
				local s = i
				i = i + 1
				local closed = false
				while i <= n do
					local d = string.sub(src, i, i)
					if d == "\\" then
						if string.sub(src, i + 1, i + 1) == "\n" then
							line = line + 1
							lineStart = i + 2
						end
						i = i + 2
					elseif d == quote then
						closed = true
						i = i + 1
						break
					elseif d == "\n" then
						break
					else
						i = i + 1
					end
				end
				if not closed then
					fail("unfinished string", s)
					break
				end
				push("string", string.sub(src, s, i - 1), s, i - 1)
			elseif c == "`" then
				-- Interpolated string. Kept as one token: the importer only ever
				-- copies it back out as source text.
				local s = i
				i = i + 1
				local depth = 0
				local closed = false
				while i <= n do
					local d = string.sub(src, i, i)
					if d == "\\" then
						i = i + 2
					elseif d == "{" then
						depth = depth + 1
						i = i + 1
					elseif d == "}" then
						if depth > 0 then depth = depth - 1 end
						i = i + 1
					elseif d == "`" and depth == 0 then
						closed = true
						i = i + 1
						break
					else
						if d == "\n" then
							line = line + 1
							lineStart = i + 1
						end
						i = i + 1
					end
				end
				if not closed then
					fail("unfinished interpolated string", s)
					break
				end
				push("string", string.sub(src, s, i - 1), s, i - 1)
			elseif c == "[" and longOpen(src, i) then
				local s = i
				local startLine = line
				local level, after = longOpen(src, i)
				local a, b = longClose(src, after, level)
				if not a then
					fail("unfinished long string", s)
					break
				end
				local text = string.sub(src, s, b)
				consumeSpan(s, b)
				tokens[#tokens + 1] = {
					t = "string", v = text, s = s, e = b,
					line = startLine, col = s - lineStart + 1,
				}
				i = b + 1
			else
				local three = string.sub(src, i, i + 2)
				local two = string.sub(src, i, i + 1)
				if SYM3[three] then
					push("sym", three, i, i + 2)
					i = i + 3
				elseif SYM2[two] then
					push("sym", two, i, i + 1)
					i = i + 2
				elseif SYM1[c] then
					push("sym", c, i, i)
					i = i + 1
				else
					fail("unexpected character '" .. c .. "'", i)
					break
				end
			end
		end

		if err then return nil, err end

		tokens[#tokens + 1] = {
			t = "eof", v = "<eof>", s = n + 1, e = n, line = line, col = n + 1 - lineStart + 1,
		}
		tokens.comments = comments
		return tokens, nil
end

-- Convenience for the syntax highlighter: a lossy pass that never fails and
-- keeps comments in document order alongside everything else.
function f.scan(src)
		local tokens = f.tokenize(src)
		if not tokens then
			-- Highlighting must survive half-typed code, so retry line by line and
			-- keep whatever lexes cleanly.
			tokens = { comments = {} }
			local offset = 0
			for lineText in string.gmatch(src .. "\n", "([^\n]*)\n") do
				local got = f.tokenize(lineText)
				if got then
					for _, tk in ipairs(got) do
						if tk.t ~= "eof" then
							tokens[#tokens + 1] = {
								t = tk.t, v = tk.v, s = tk.s + offset, e = tk.e + offset,
							}
						end
					end
					for _, cm in ipairs(got.comments) do
						tokens.comments[#tokens.comments + 1] = {
							s = cm.s + offset, e = cm.e + offset,
						}
					end
				end
				offset = offset + #lineText + 1
			end
		end

		local merged = {}
		for _, tk in ipairs(tokens) do
			if tk.t ~= "eof" then merged[#merged + 1] = tk end
		end
		for _, cm in ipairs(tokens.comments) do
			merged[#merged + 1] = { t = "comment", v = "", s = cm.s, e = cm.e }
		end
		table.sort(merged, function(x, y) return x.s < y.s end)
		return merged
end

return f
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX7">
			<Properties>
				<string name="Name">g</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- g  ·  Luau parser
--
-- Recursive descent over the token list from `f`.  The tree is deliberately
-- shallow: every node records the byte range it spans, and the importer copies
-- expressions straight out of the source with `src:sub(node.s, node.e)` instead
-- of re-printing them.  That is why round-tripping code through the block editor
-- never mangles an expression it did not understand.
--
--   local chunk, err = g.parse(src)
--   chunk.body -- array of statement nodes
--
-- Type annotations are parsed (so they cannot desync the statement stream) and
-- kept as source text, never as structure.

local f = require(script.Parent.f)

local g = {}

local BINPRI = {
		["or"] = { 1, 1 }, ["and"] = { 2, 2 },
		["<"] = { 3, 3 }, [">"] = { 3, 3 }, ["<="] = { 3, 3 },
		[">="] = { 3, 3 }, ["~="] = { 3, 3 }, ["=="] = { 3, 3 },
		[".."] = { 9, 8 },
		["+"] = { 10, 10 }, ["-"] = { 10, 10 },
		["*"] = { 11, 11 }, ["/"] = { 11, 11 }, ["//"] = { 11, 11 }, ["%"] = { 11, 11 },
		["^"] = { 14, 13 },
}
local UNARY_PRI = 12

local BLOCK_END = {
		["end"] = true, ["else"] = true, ["elseif"] = true, ["until"] = true,
}

local Parser = {}
Parser.__index = Parser

local function new(src, tokens)
		return setmetatable({ src = src, tk = tokens, i = 1 }, Parser)
end

function Parser:peek(offset)
		return self.tk[self.i + (offset or 0)]
end

function Parser:next()
		local t = self.tk[self.i]
		self.i = self.i + 1
		return t
end

function Parser:is(kind, value)
		local t = self.tk[self.i]
		return t.t == kind and (value == nil or t.v == value)
end

function Parser:accept(kind, value)
		if self:is(kind, value) then return self:next() end
		return nil
end

function Parser:fail(msg, token)
		token = token or self:peek()
		error({ __parse = true, msg = msg, line = token.line, col = token.col }, 0)
end

function Parser:expect(kind, value, what)
		local t = self:accept(kind, value)
		if not t then
			local got = self:peek()
			self:fail("expected " .. (what or ("'" .. tostring(value) .. "'")) ..
				" but found '" .. tostring(got.v) .. "'")
		end
		return t
end

function Parser:slice(a, b)
		return string.sub(self.src, a, b)
end

--=============================================================================
-- Types.  Parsed only so they cannot throw the statement stream off; the result
-- is the source text of the annotation.
--=============================================================================

function Parser:typeParams()
		-- '<' ... '>' with nesting, used for both generic declarations and args.
		local open = self:expect("sym", "<", "'<'")
		local depth = 1
		while depth > 0 do
			local t = self:peek()
			if t.t == "eof" then self:fail("unfinished type parameters", open) end
			if t.t == "sym" and t.v == "<" then
				depth = depth + 1
			elseif t.t == "sym" and t.v == ">" then
				depth = depth - 1
			elseif t.t == "sym" and t.v == ">=" then
				-- '>>' style closing shows up as '>=' only in odd code; treat the
				-- '>' half as a close and leave '=' behind is not representable, so
				-- bail out rather than silently mis-parse.
				self:fail("unexpected '>=' inside type parameters", t)
			end
			self:next()
		end
		return true
end

function Parser:typeTable()
		local open = self:expect("sym", "{", "'{'")
		while not self:is("sym", "}") do
			if self:is("eof") then self:fail("unfinished table type", open) end
			if self:accept("sym", "[") then
				self:parseType()
				self:expect("sym", "]", "']'")
				self:expect("sym", ":", "':'")
				self:parseType()
			elseif (self:is("name") or self:is("kw")) and self:peek(1).t == "sym"
				and self:peek(1).v == ":" then
				self:next()
				self:next()
				self:parseType()
			else
				self:parseType()
			end
			if not (self:accept("sym", ",") or self:accept("sym", ";")) then break end
		end
		self:expect("sym", "}", "'}'")
end

function Parser:typeSimple()
		if self:is("sym", "(") then
			local open = self:next()
			while not self:is("sym", ")") do
				if self:is("eof") then self:fail("unfinished type", open) end
				if (self:is("name") or self:is("sym", "...")) and self:peek(1).t == "sym"
					and self:peek(1).v == ":" then
					self:next()
					self:next()
				end
				self:parseType()
				if not self:accept("sym", ",") then break end
			end
			self:expect("sym", ")", "')'")
			if self:accept("sym", "->") then self:parseType() end
			return
		end
		if self:is("sym", "{") then
			self:typeTable()
			return
		end
		if self:is("sym", "<") then
			self:typeParams()
			self:typeSimple()
			return
		end
		if self:is("string") or self:is("kw", "nil") or self:is("kw", "true")
			or self:is("kw", "false") then
			self:next()
			return
		end
		if self:is("sym", "...") then
			self:next()
			self:parseType()
			return
		end
		if self:is("name", "typeof") and self:peek(1).t == "sym" and self:peek(1).v == "(" then
			self:next()
			self:next()
			self:expression()
			self:expect("sym", ")", "')'")
			return
		end
		if self:is("name") or self:is("kw", "function") then
			self:next()
			while self:is("sym", ".") and self:peek(1).t == "name" do
				self:next()
				self:next()
			end
			if self:is("sym", "<") then self:typeParams() end
			return
		end
		self:fail("expected a type but found '" .. tostring(self:peek().v) .. "'")
end

-- Returns the annotation's source text.
function Parser:parseType()
		local start = self:peek().s
		self:accept("sym", "?")
		self:typeSimple()
		while true do
			if self:accept("sym", "?") then
				-- optional marker, keep going
			elseif self:is("sym", "|") or self:is("sym", "&") then
				self:next()
				self:typeSimple()
			elseif self:accept("sym", "->") then
				self:typeSimple()
			else
				break
			end
		end
		return self:slice(start, self.tk[self.i - 1].e)
end

--=============================================================================
-- Expressions
--=============================================================================

function Parser:tableCons()
		local open = self:expect("sym", "{", "'{'")
		local fields = {}
		while not self:is("sym", "}") do
			if self:is("eof") then self:fail("unfinished table", open) end
			if self:is("sym", "[") then
				self:next()
				local key = self:expression()
				self:expect("sym", "]", "']'")
				self:expect("sym", "=", "'='")
				fields[#fields + 1] = { key = key, value = self:expression(), kind = "index" }
			elseif self:is("name") and self:peek(1).t == "sym" and self:peek(1).v == "=" then
				local name = self:next()
				self:next()
				fields[#fields + 1] = { name = name.v, value = self:expression(), kind = "named" }
			else
				fields[#fields + 1] = { value = self:expression(), kind = "array" }
			end
			if not (self:accept("sym", ",") or self:accept("sym", ";")) then break end
		end
		local close = self:expect("sym", "}", "'}'")
		return { k = "table", fields = fields, s = open.s, e = close.e }
end

-- '(' params ')' [':' type] block 'end'
function Parser:funcBody(startToken, nameInfo)
		if self:is("sym", "<") then self:typeParams() end
		self:expect("sym", "(", "'('")
		local params = {}
		while not self:is("sym", ")") do
			if self:accept("sym", "...") then
				if self:accept("sym", ":") then self:parseType() end
				params[#params + 1] = { name = "...", vararg = true }
			else
				local nameTok = self:expect("name", nil, "a parameter name")
				local ty = nil
				if self:accept("sym", ":") then ty = self:parseType() end
				params[#params + 1] = { name = nameTok.v, type = ty }
			end
			if not self:accept("sym", ",") then break end
		end
		self:expect("sym", ")", "')'")
		local retType = nil
		if self:accept("sym", ":") then retType = self:parseType() end
		local body = self:block()
		local last = self:expect("kw", "end", "'end'")
		return {
			k = "func", params = params, body = body, retType = retType,
			name = nameInfo and nameInfo.name or nil,
			isMethod = nameInfo and nameInfo.isMethod or false,
			s = startToken.s, e = last.e,
		}
end

function Parser:primary()
		local t = self:peek()
		if t.t == "name" then
			self:next()
			return { k = "name", name = t.v, s = t.s, e = t.e }
		end
		if t.t == "sym" and t.v == "(" then
			self:next()
			local inner = self:expression()
			local close = self:expect("sym", ")", "')'")
			return { k = "paren", inner = inner, s = t.s, e = close.e }
		end
		self:fail("unexpected '" .. tostring(t.v) .. "'")
		return nil
end

function Parser:callArgs(callee, startTok)
		local t = self:peek()
		if t.t == "string" then
			self:next()
			return { { k = "str", value = t.v, s = t.s, e = t.e } }, t.e
		end
		if t.t == "sym" and t.v == "{" then
			local tbl = self:tableCons()
			return { tbl }, tbl.e
		end
		self:expect("sym", "(", "'('")
		local args = {}
		while not self:is("sym", ")") do
			args[#args + 1] = self:expression()
			if not self:accept("sym", ",") then break end
		end
		local close = self:expect("sym", ")", "')'")
		return args, close.e
end

function Parser:suffixed()
		local node = self:primary()
		while true do
			local t = self:peek()
			if t.t == "sym" and t.v == "." and self:peek(1).t ~= "sym" then
				self:next()
				local nameTok = self:peek()
				if nameTok.t ~= "name" and nameTok.t ~= "kw" then
					self:fail("expected a field name after '.'")
				end
				self:next()
				node = {
					k = "index", obj = node, name = nameTok.v, dot = true,
					s = node.s, e = nameTok.e,
				}
			elseif t.t == "sym" and t.v == "[" then
				self:next()
				local key = self:expression()
				local close = self:expect("sym", "]", "']'")
				node = { k = "index", obj = node, key = key, s = node.s, e = close.e }
			elseif t.t == "sym" and t.v == ":" then
				local nameTok = self:peek(1)
				if nameTok.t ~= "name" then break end
				self:next()
				self:next()
				local args, endPos = self:callArgs()
				node = {
					k = "call", fn = node, method = nameTok.v, args = args,
					s = node.s, e = endPos,
				}
			elseif (t.t == "sym" and (t.v == "(" or t.v == "{")) or t.t == "string" then
				local args, endPos = self:callArgs()
				node = { k = "call", fn = node, args = args, s = node.s, e = endPos }
			else
				break
			end
		end
		return node
end

function Parser:simpleExpr()
		local t = self:peek()
		if t.t == "number" then
			self:next()
			return { k = "num", value = t.v, s = t.s, e = t.e }
		end
		if t.t == "string" then
			self:next()
			return { k = "str", value = t.v, s = t.s, e = t.e }
		end
		if t.t == "kw" and (t.v == "true" or t.v == "false") then
			self:next()
			return { k = "bool", value = t.v == "true", s = t.s, e = t.e }
		end
		if t.t == "kw" and t.v == "nil" then
			self:next()
			return { k = "nil", s = t.s, e = t.e }
		end
		if t.t == "sym" and t.v == "..." then
			self:next()
			return { k = "vararg", s = t.s, e = t.e }
		end
		if t.t == "sym" and t.v == "{" then
			return self:tableCons()
		end
		if t.t == "kw" and t.v == "function" then
			self:next()
			return self:funcBody(t, nil)
		end
		if t.t == "kw" and t.v == "if" then
			-- Luau's `if a then b else c` expression form.
			self:next()
			local cond = self:expression()
			self:expect("kw", "then", "'then'")
			local yes = self:expression()
			local clauses = { { cond = cond, value = yes } }
			while self:is("kw", "elseif") do
				self:next()
				local c = self:expression()
				self:expect("kw", "then", "'then'")
				clauses[#clauses + 1] = { cond = c, value = self:expression() }
			end
			self:expect("kw", "else", "'else'")
			local els = self:expression()
			return { k = "ifexp", clauses = clauses, els = els, s = t.s, e = els.e }
		end
		return self:suffixed()
end

function Parser:subExpr(limit)
		local node
		local t = self:peek()
		if (t.t == "kw" and t.v == "not") or (t.t == "sym" and (t.v == "-" or t.v == "#")) then
			self:next()
			local operand = self:subExpr(UNARY_PRI)
			node = { k = "unop", op = t.v, operand = operand, s = t.s, e = operand.e }
		else
			node = self:simpleExpr()
		end

		while true do
			local op = self:peek()
			local key = nil
			if op.t == "sym" or op.t == "kw" then key = op.v end
			local pri = key and BINPRI[key]
			if not pri or pri[1] <= limit then break end
			self:next()
			local rhs = self:subExpr(pri[2])
			node = { k = "binop", op = key, left = node, right = rhs, s = node.s, e = rhs.e }
		end

		while self:is("sym", "::") do
			self:next()
			local ty = self:parseType()
			node = {
				k = "typeassert", inner = node, type = ty,
				s = node.s, e = self.tk[self.i - 1].e,
			}
		end
		return node
end

function Parser:expression()
		return self:subExpr(0)
end

--=============================================================================
-- Statements
--=============================================================================

function Parser:block()
		local body = {}
		while true do
			local t = self:peek()
			if t.t == "eof" then break end
			if t.t == "kw" and BLOCK_END[t.v] then break end
			if t.t == "kw" and t.v == "return" then
				body[#body + 1] = self:returnStat()
				self:accept("sym", ";")
				break
			end
			local stat = self:statement()
			if stat then body[#body + 1] = stat end
		end
		return body
end

function Parser:returnStat()
		local kw = self:next()
		local exprs = {}
		local t = self:peek()
		local ends = t.t == "eof" or (t.t == "kw" and BLOCK_END[t.v])
			or (t.t == "sym" and t.v == ";")
		if not ends then
			repeat
				exprs[#exprs + 1] = self:expression()
			until not self:accept("sym", ",")
		end
		local last = self.tk[self.i - 1]
		return { k = "return", exprs = exprs, s = kw.s, e = last.e, line = kw.line }
end

-- `continue` and `type` are ordinary identifiers unless they start a statement
-- and are not being used as a value.
function Parser:softKeywordStat()
		local t = self:peek()
		local after = self:peek(1)
		if t.v == "continue" then
			local blocksIt = after.t == "sym" and (after.v == "=" or after.v == "," or
				after.v == "." or after.v == ":" or after.v == "[" or after.v == "(" or
				after.v == "{")
			if not blocksIt and after.t ~= "string" then
				self:next()
				return { k = "continue", s = t.s, e = t.e, line = t.line }
			end
		elseif t.v == "type" or t.v == "export" then
			local head = t.v == "export" and self:peek(1) or t
			local nameTok = t.v == "export" and self:peek(2) or self:peek(1)
			local follow = t.v == "export" and self:peek(3) or self:peek(2)
			if head.t == "name" and head.v == "type" and nameTok.t == "name"
				and follow.t == "sym" and (follow.v == "=" or follow.v == "<") then
				self:next()
				if t.v == "export" then self:next() end
				self:next()
				if self:is("sym", "<") then self:typeParams() end
				self:expect("sym", "=", "'='")
				self:parseType()
				local last = self.tk[self.i - 1]
				return { k = "typedef", s = t.s, e = last.e, line = t.line }
			end
		end
		return nil
end

local COMPOUND = {
		["+="] = "+", ["-="] = "-", ["*="] = "*", ["/="] = "/",
		["%="] = "%", ["^="] = "^", ["..="] = "..", ["//="] = "//",
}

function Parser:statement()
		local t = self:peek()

		if t.t == "sym" and t.v == ";" then
			self:next()
			return nil
		end

		-- Function attributes such as `@native`.
		if t.t == "sym" and t.v == "@" then
			self:next()
			self:expect("name", nil, "an attribute name")
			return self:statement()
		end

		if t.t == "kw" then
			local v = t.v
			if v == "local" then
				self:next()
				if self:is("kw", "function") then
					local fnKw = self:next()
					local nameTok = self:expect("name", nil, "a function name")
					local fn = self:funcBody(fnKw, { name = nameTok.v })
					return {
						k = "localfunc", name = nameTok.v, fn = fn,
						s = t.s, e = fn.e, line = t.line,
					}
				end
				local names = {}
				repeat
					local nameTok = self:expect("name", nil, "a variable name")
					local ty = nil
					if self:accept("sym", ":") then ty = self:parseType() end
					names[#names + 1] = { name = nameTok.v, type = ty }
				until not self:accept("sym", ",")
				local exprs = {}
				if self:accept("sym", "=") then
					repeat
						exprs[#exprs + 1] = self:expression()
					until not self:accept("sym", ",")
				end
				local last = self.tk[self.i - 1]
				return {
					k = "local", names = names, exprs = exprs,
					s = t.s, e = last.e, line = t.line,
				}
			elseif v == "function" then
				self:next()
				local nameTok = self:expect("name", nil, "a function name")
				local isMethod = false
				local parts = { nameTok.v }
				while true do
					if self:accept("sym", ".") then
						parts[#parts + 1] = "." .. self:expect("name", nil, "a name").v
					elseif self:is("sym", ":") and self:peek(1).t == "name" then
						self:next()
						parts[#parts + 1] = ":" .. self:next().v
						isMethod = true
						break
					else
						break
					end
				end
				local fullName = table.concat(parts)
				local fn = self:funcBody(t, { name = fullName, isMethod = isMethod })
				return {
					k = "func", name = fullName, isMethod = isMethod, fn = fn,
					s = t.s, e = fn.e, line = t.line,
				}
			elseif v == "do" then
				self:next()
				local body = self:block()
				local last = self:expect("kw", "end", "'end'")
				return { k = "do", body = body, s = t.s, e = last.e, line = t.line }
			elseif v == "while" then
				self:next()
				local cond = self:expression()
				self:expect("kw", "do", "'do'")
				local body = self:block()
				local last = self:expect("kw", "end", "'end'")
				return {
					k = "while", cond = cond, body = body,
					s = t.s, e = last.e, line = t.line,
				}
			elseif v == "repeat" then
				self:next()
				local body = self:block()
				self:expect("kw", "until", "'until'")
				local cond = self:expression()
				return {
					k = "repeat", cond = cond, body = body,
					s = t.s, e = cond.e, line = t.line,
				}
			elseif v == "if" then
				self:next()
				local clauses = {}
				local cond = self:expression()
				self:expect("kw", "then", "'then'")
				clauses[1] = { cond = cond, body = self:block() }
				while self:is("kw", "elseif") do
					self:next()
					local c = self:expression()
					self:expect("kw", "then", "'then'")
					clauses[#clauses + 1] = { cond = c, body = self:block() }
				end
				local els = nil
				if self:accept("kw", "else") then els = self:block() end
				local last = self:expect("kw", "end", "'end'")
				return {
					k = "if", clauses = clauses, els = els,
					s = t.s, e = last.e, line = t.line,
				}
			elseif v == "for" then
				self:next()
				local firstName = self:expect("name", nil, "a loop variable")
				if self:accept("sym", ":") then self:parseType() end
				if self:accept("sym", "=") then
					local from = self:expression()
					self:expect("sym", ",", "','")
					local to = self:expression()
					local step = nil
					if self:accept("sym", ",") then step = self:expression() end
					self:expect("kw", "do", "'do'")
					local body = self:block()
					local last = self:expect("kw", "end", "'end'")
					return {
						k = "fornum", var = firstName.v, from = from, to = to, step = step,
						body = body, s = t.s, e = last.e, line = t.line,
					}
				end
				local names = { firstName.v }
				while self:accept("sym", ",") do
					names[#names + 1] = self:expect("name", nil, "a loop variable").v
					if self:accept("sym", ":") then self:parseType() end
				end
				self:expect("kw", "in", "'in'")
				local exprs = {}
				repeat
					exprs[#exprs + 1] = self:expression()
				until not self:accept("sym", ",")
				self:expect("kw", "do", "'do'")
				local body = self:block()
				local last = self:expect("kw", "end", "'end'")
				return {
					k = "forin", names = names, exprs = exprs, body = body,
					s = t.s, e = last.e, line = t.line,
				}
			elseif v == "break" then
				self:next()
				return { k = "break", s = t.s, e = t.e, line = t.line }
			elseif v == "return" then
				return self:returnStat()
			end
			self:fail("unexpected '" .. v .. "'")
		end

		if t.t == "name" and (t.v == "continue" or t.v == "type" or t.v == "export") then
			local soft = self:softKeywordStat()
			if soft then return soft end
		end

		-- Expression statement: either a call or an assignment.
		local first = self:suffixed()
		local nextTok = self:peek()

		if nextTok.t == "sym" and COMPOUND[nextTok.v] then
			self:next()
			local value = self:expression()
			return {
				k = "compound", op = COMPOUND[nextTok.v], target = first, value = value,
				s = t.s, e = value.e, line = t.line,
			}
		end

		if nextTok.t == "sym" and (nextTok.v == "=" or nextTok.v == ",") then
			local targets = { first }
			while self:accept("sym", ",") do
				targets[#targets + 1] = self:suffixed()
			end
			self:expect("sym", "=", "'='")
			local exprs = {}
			repeat
				exprs[#exprs + 1] = self:expression()
			until not self:accept("sym", ",")
			local last = self.tk[self.i - 1]
			return {
				k = "assign", targets = targets, exprs = exprs,
				s = t.s, e = last.e, line = t.line,
			}
		end

		if first.k ~= "call" then
			self:fail("this line is not a statement -- did you mean to assign to it?", t)
		end
		return { k = "call", call = first, s = first.s, e = first.e, line = t.line }
end

--=============================================================================

-- Returns `chunk, nil` or `nil, err` where err = { msg, line, col }.
function g.parse(src)
		local tokens, lexErr = f.tokenize(src)
		if not tokens then return nil, lexErr end

		local p = new(src, tokens)
		local ok, result = pcall(function()
			local body = p:block()
			if not p:is("eof") then
				p:fail("unexpected '" .. tostring(p:peek().v) .. "'")
			end
			return body
		end)

		if not ok then
			if type(result) == "table" and result.__parse then
				return nil, { msg = result.msg, line = result.line, col = result.col }
			end
			return nil, { msg = tostring(result), line = 1, col = 1 }
		end

		return { body = result, comments = tokens.comments, src = src }, nil
end

-- Flattens `a.b.c` / `a:b` chains into text, or nil when the expression is not a
-- plain path.  Used by the importer to recognise things like `Players.PlayerAdded`.
function g.pathOf(node)
		if not node then return nil end
		if node.k == "name" then return node.name end
		if node.k == "index" and node.dot then
			local base = g.pathOf(node.obj)
			if not base then return nil end
			return base .. "." .. node.name
		end
		return nil
end

return g
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX8">
			<Properties>
				<string name="Name">h</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- h  ·  Luau -> blocks
--
-- Reads a script and rebuilds it on the canvas.  Two rules keep this honest:
--
--   1. Nothing is ever thrown away.  A statement no block matches becomes a
--      `raw Luau` block holding the exact source text, so importing a file you
--      do not fully understand still gives you a working, editable program.
--   2. Patterns are only matched when the block would emit the same code back.
--      `hum.WalkSpeed = 24` becomes a walk-speed block because that block
--      writes exactly that line; `hum.JumpPower = 50` stays raw because the
--      jump-power block writes two lines.  Import then export is stable.
--
-- Blank lines at the top level split the program into separate stacks, which is
-- also how the canvas ends up looking like the script you started with.

local c = require(script.Parent.c)
local d = require(script.Parent.d)
local g = require(script.Parent.g)

local h = {}

--=============================================================================
-- small helpers over the AST
--=============================================================================

local function slice(ctx, node)
		if not node then return "" end
		return string.sub(ctx.src, node.s, node.e)
end

local function argsText(ctx, args, from)
		from = from or 1
		if #args < from then return "" end
		return string.sub(ctx.src, args[from].s, args[#args].e)
end

-- A double-quoted string with nothing that needs escaping, unwrapped.
local function plainString(node)
		if not node or node.k ~= "str" then return nil end
		local inner = string.match(node.value, '^"([^"\\]*)"$')
		return inner
end

local function isCallTo(node, path)
		return node and node.k == "call" and not node.method and g.pathOf(node.fn) == path
end

local function isMethodCall(node, method)
		return node and node.k == "call" and node.method == method
end

local function isFunc(node)
		return node and node.k == "func"
end

local function paramText(params)
		local names = {}
		for _, param in ipairs(params or {}) do
			names[#names + 1] = param.name
		end
		return table.concat(names, ", ")
end

-- The callee written the way the `run` block wants it: `obj:Method` or `path`.
local function calleeText(ctx, node)
		if node.method then
			return slice(ctx, node.fn) .. ":" .. node.method
		end
		return slice(ctx, node.fn)
end

local function lineAt(ctx, offset)
		local lo, hi = 1, #ctx.lineStarts
		while lo < hi do
			local mid = math.floor((lo + hi + 1) / 2)
			if ctx.lineStarts[mid] <= offset then lo = mid else hi = mid - 1 end
		end
		return lo
end

--=============================================================================
-- block construction
--=============================================================================

local function mk(ctx, kind, fields)
		local block = d.create(ctx.doc, kind)
		for key, value in pairs(fields or {}) do
			block.f[key] = value
		end
		ctx.matched = ctx.matched + 1
		return block
end

local function fill(ctx, block, slotKey, children)
		for _, child in ipairs(children) do
			d.attachToSlot(ctx.doc, child, block, slotKey, nil, {})
		end
		return block
end

local function rawBlock(ctx, node, why)
		local text = string.sub(ctx.src, node.s, node.e)

		-- Re-indent relative to the statement's own line so the block re-emits at
		-- whatever depth it is dropped into.
		local lineStart = ctx.lineStarts[lineAt(ctx, node.s)]
		local baseIndent = string.match(string.sub(ctx.src, lineStart, node.s - 1), "^[\t ]*") or ""
		if baseIndent ~= "" then
			text = string.gsub(text, "\n" .. baseIndent, "\n")
		end

		local block = d.create(ctx.doc, "raw")
		block.f.code = text
		ctx.raw = ctx.raw + 1
		if why then
			ctx.notes[#ctx.notes + 1] = {
				line = node.line or lineAt(ctx, node.s),
				text = why,
			}
		end
		return block
end

local convertList

--=============================================================================
-- statement conversion
--=============================================================================

-- `X.Touched:Connect(function(hit) ... end)` and friends.
local function convertConnect(ctx, call, verb)
		local handler = call.args[1]
		local params = paramText(handler.params)
		local signal = call.fn
		local body = convertList(ctx, handler.body)

		local kind, fields
		local path = g.pathOf(signal)
		local first = handler.params[1] and handler.params[1].name or ""

		if verb == "Connect" then
			if signal.k == "index" and signal.dot then
				local objText = slice(ctx, signal.obj)
				local event = signal.name
				if event == "Touched" then
					kind, fields = "onTouch", { part = objText, hit = first ~= "" and first or "hit" }
				elseif event == "PlayerAdded" and objText == "Players" then
					kind, fields = "onPlayerAdded", { player = first }
				elseif event == "PlayerRemoving" and objText == "Players" then
					kind, fields = "onPlayerRemoving", { player = first }
				elseif event == "CharacterAdded" then
					kind, fields = "onCharacterAdded", { player = objText, char = first }
				elseif event == "Died" then
					kind, fields = "onDied", { hum = objText }
				elseif event == "Heartbeat" and objText == "RunService" then
					kind, fields = "onHeartbeat", { dt = first }
				elseif event == "RenderStepped" and objText == "RunService" then
					kind, fields = "onRender", { dt = first }
				end
			elseif signal.k == "call" and signal.method then
				local objText = slice(ctx, signal.fn)
				local key = plainString(signal.args[1])
				if key then
					if signal.method == "GetPropertyChangedSignal" then
						kind, fields = "onPropertyChanged", { obj = objText, prop = key }
					elseif signal.method == "GetAttributeChangedSignal" then
						kind, fields = "onAttrChanged", { inst = objText, attr = key }
					elseif signal.method == "GetInstanceAddedSignal"
						and objText == "CollectionService" then
						kind, fields = "onTagAdded", { tag = key, inst = first }
					end
				end
			end
		end

		if not kind then
			kind = verb == "Once" and "onSignalOnce" or "onSignal"
			fields = { sig = slice(ctx, signal), args = params }
		end

		return fill(ctx, mk(ctx, kind, fields), "body", body)
end

-- Custom blocks compile to a call to a named helper, so a call to one of those
-- names rebuilds the block rather than arriving as a plain call.
local function customByFunctionName()
		local map = {}
		for _, def in ipairs(c.order) do
			if def.custom and def.custom.fn then map[def.custom.fn] = def end
		end
		return map
end

local function convertCustomCall(ctx, call, path, wanted)
		if not path then return nil end
		local def = customByFunctionName()[path]
		if not def then return nil end
		if def.custom.returnsHelper ~= (wanted == "value") then return nil end
		if #call.args ~= #def.custom.params then return nil end

		local fields = {}
		for index, key in ipairs(def.custom.params) do
			fields[key] = slice(ctx, call.args[index])
		end
		return def, fields
end

local function convertCallStatement(ctx, stmt)
		local call = stmt.call
		local args = call.args
		local path = not call.method and g.pathOf(call.fn) or nil

		local customDef, customFields = convertCustomCall(ctx, call, path, "statement")
		if customDef then
			return mk(ctx, customDef.id, customFields)
		end

		-- event connections
		if (call.method == "Connect" or call.method == "Once")
			and #args == 1 and isFunc(args[1]) then
			return convertConnect(ctx, call, call.method)
		end

		-- deferred work
		if isCallTo(call, "task.spawn") and #args == 1 and isFunc(args[1])
			and #args[1].params == 0 then
			return fill(ctx, mk(ctx, "spawn", {}), "body", convertList(ctx, args[1].body))
		end
		if isCallTo(call, "task.delay") and #args == 2 and isFunc(args[2])
			and #args[2].params == 0 then
			return fill(ctx, mk(ctx, "delay", { n = slice(ctx, args[1]) }), "body",
				convertList(ctx, args[2].body))
		end

		if path then
			local one = args[1] and slice(ctx, args[1]) or ""
			local two = args[2] and slice(ctx, args[2]) or ""
			local three = args[3] and slice(ctx, args[3]) or ""

			if path == "task.wait" and #args <= 1 then
				return mk(ctx, "wait", { n = one })
			elseif path == "print" and #args == 1 then
				local text = plainString(args[1])
				if text then return mk(ctx, "printText", { msg = text }) end
				return mk(ctx, "printValue", { value = one })
			elseif path == "warn" and #args == 1 then
				local text = plainString(args[1])
				if text then return mk(ctx, "warnText", { msg = text }) end
			elseif path == "assert" and #args == 2 then
				local text = plainString(args[2])
				if text then return mk(ctx, "assert", { cond = one, msg = text }) end
			elseif path == "table.insert" then
				if #args == 2 then
					return mk(ctx, "push", { list = one, value = two })
				elseif #args == 3 then
					return mk(ctx, "insertAt", { list = one, index = two, value = three })
				end
			elseif path == "table.remove" and #args == 2 then
				return mk(ctx, "removeAt", { list = one, index = two })
			elseif path == "table.sort" and #args == 1 then
				return mk(ctx, "sortList", { list = one })
			elseif path == "table.clear" and #args == 1 then
				return mk(ctx, "clearList", { list = one })
			end
		end

		if call.method then
			local objText = slice(ctx, call.fn)
			local one = args[1] and slice(ctx, args[1]) or ""
			local two = args[2] and slice(ctx, args[2]) or ""
			local method = call.method

			if method == "Destroy" and #args == 0 then
				return mk(ctx, "destroy", { obj = objText })
			elseif method == "Disconnect" and #args == 0 then
				return mk(ctx, "disconnect", { conn = objText })
			elseif method == "LoadCharacter" and #args == 0 then
				return mk(ctx, "respawn", { player = objText })
			elseif method == "PivotTo" and #args == 1 then
				local cf = args[1]
				if isCallTo(cf, "CFrame.new") and #cf.args == 3 then
					return mk(ctx, "teleportChar", {
						char = objText,
						x = slice(ctx, cf.args[1]), y = slice(ctx, cf.args[2]),
						z = slice(ctx, cf.args[3]),
					})
				end
				return mk(ctx, "pivotTo", { obj = objText, cf = one })
			elseif method == "TakeDamage" and #args == 1 then
				return mk(ctx, "damage", { hum = objText, n = one })
			elseif method == "SetAttribute" and #args == 2 then
				local key = plainString(args[1])
				if key then
					return mk(ctx, "setAttr", { inst = objText, attr = key, value = two })
				end
			elseif method == "AddTag" and objText == "CollectionService" and #args == 2 then
				local tag = plainString(args[2])
				if tag then return mk(ctx, "addTag", { obj = one, tag = tag }) end
			elseif method == "AddItem" and objText == "Debris" and #args == 2 then
				return mk(ctx, "cleanupAfter", { obj = one, time = two })
			elseif method == "Play" and #args == 0 and isMethodCall(call.fn, "Create") then
				local create = call.fn
				local info = create.args[2]
				if g.pathOf(create.fn) == "TweenService" and #create.args == 3
					and isCallTo(info, "TweenInfo.new") and #info.args == 1 then
					return mk(ctx, "tween", {
						obj = slice(ctx, create.args[1]),
						time = slice(ctx, info.args[1]),
						goal = slice(ctx, create.args[3]),
					})
				end
			end
		end

		return mk(ctx, "call", {
			name = calleeText(ctx, call),
			args = argsText(ctx, args),
		})
end

local function convertLocal(ctx, stmt)
		local names, exprs = stmt.names, stmt.exprs

		-- local ok, err = pcall(function() ... end)
		if #names == 2 and #exprs == 1 and isCallTo(exprs[1], "pcall")
			and #exprs[1].args == 1 and isFunc(exprs[1].args[1])
			and #exprs[1].args[1].params == 0 then
			local block = mk(ctx, "pcall", { ok = names[1].name, err = names[2].name })
			return fill(ctx, block, "body", convertList(ctx, exprs[1].args[1].body))
		end

		if #names == 1 and #exprs == 1 and not names[1].type then
			local name = names[1].name
			local value = exprs[1]
			local valueText = slice(ctx, value)

			if value.k == "call" then
				local customDef, customFields = convertCustomCall(ctx, value,
					not value.method and g.pathOf(value.fn) or nil, "value")
				if customDef then
					customFields.out = name
					return mk(ctx, customDef.id, customFields)
				end
			end

			if isCallTo(value, "Instance.new") and #value.args == 1 then
				local class = plainString(value.args[1])
				if class then return mk(ctx, "create", { name = name, class = class }) end
			end
			if isMethodCall(value, "GetService") and g.pathOf(value.fn) == "game" then
				local service = plainString(value.args[1])
				if service == name then return mk(ctx, "svc", { name = name }) end
			end
			if isCallTo(value, "require") and #value.args == 1 then
				return mk(ctx, "require", { name = name, path = slice(ctx, value.args[1]) })
			end
			if isMethodCall(value, "Clone") and #value.args == 0 then
				return mk(ctx, "clone", { name = name, obj = slice(ctx, value.fn) })
			end
			if isMethodCall(value, "FindFirstChild") and #value.args == 1 then
				local child = plainString(value.args[1])
				if child then
					return mk(ctx, "findChild",
						{ name = name, obj = slice(ctx, value.fn), child = child })
				end
			end
			if isMethodCall(value, "WaitForChild") and #value.args == 1 then
				local child = plainString(value.args[1])
				if child then
					return mk(ctx, "waitChild",
						{ name = name, obj = slice(ctx, value.fn), child = child })
				end
			end
			if isMethodCall(value, "FindFirstChildOfClass") and #value.args == 1
				and plainString(value.args[1]) == "Humanoid" then
				return mk(ctx, "humanoidOf", { name = name, char = slice(ctx, value.fn) })
			end
			if value.k == "table" and #value.fields == 0 then
				return mk(ctx, "newList", { name = name })
			end
			if valueText == "script.Parent" then
				return mk(ctx, "scriptParent", { name = name })
			end
			if valueText == "Players.LocalPlayer" then
				return mk(ctx, "localPlayer", { name = name })
			end
			if value.k == "index" and value.dot and value.name == "Character" then
				return mk(ctx, "charOf", { name = name, player = slice(ctx, value.obj) })
			end
			if value.k == "unop" and value.op == "#" then
				return mk(ctx, "countList", { name = name, list = slice(ctx, value.operand) })
			end
			if value.k == "table" then
				return mk(ctx, "listOf", { name = name,
					items = string.match(valueText, "^{%s*(.-)%s*}$") or valueText })
			end
			return mk(ctx, "local", { name = name, value = valueText })
		end

		if #names == 1 and #exprs == 1 and names[1].type then
			return mk(ctx, "localTyped", {
				name = names[1].name, type = names[1].type, value = slice(ctx, exprs[1]),
			})
		end

		if #names > 1 and #exprs > 0 then
			local list = {}
			for _, entry in ipairs(names) do list[#list + 1] = entry.name end
			return mk(ctx, "setMany", {
				names = table.concat(list, ", "),
				values = string.sub(ctx.src, exprs[1].s, exprs[#exprs].e),
			})
		end

		return nil
end

local function convertAssign(ctx, stmt)
		if #stmt.targets ~= 1 or #stmt.exprs ~= 1 then return nil end
		local target, value = stmt.targets[1], stmt.exprs[1]
		local targetText, valueText = slice(ctx, target), slice(ctx, value)

		-- x = not x
		if value.k == "unop" and value.op == "not" and slice(ctx, value.operand) == targetText then
			return mk(ctx, "flip", { var = targetText })
		end

		if target.k == "index" and target.dot then
			local objText = slice(ctx, target.obj)
			local prop = target.name

			if prop == "Parent" then
				return mk(ctx, "setParent", { obj = objText, parent = valueText })
			elseif prop == "Anchored" and value.k == "bool" then
				return mk(ctx, "anchor", { obj = objText, value = valueText })
			elseif prop == "WalkSpeed" then
				return mk(ctx, "walkSpeed", { hum = objText, n = valueText })
			elseif prop == "Position" and isCallTo(value, "Vector3.new") and #value.args == 3 then
				return mk(ctx, "moveTo", {
					obj = objText,
					x = slice(ctx, value.args[1]), y = slice(ctx, value.args[2]),
					z = slice(ctx, value.args[3]),
				})
			elseif prop == "Color" and isCallTo(value, "Color3.fromRGB") and #value.args == 3 then
				return mk(ctx, "paint", {
					obj = objText,
					r = slice(ctx, value.args[1]), g = slice(ctx, value.args[2]),
					b = slice(ctx, value.args[3]),
				})
			end
			return mk(ctx, "setProp", { obj = objText, prop = prop, value = valueText })
		end

		if target.k == "index" and target.key then
			return mk(ctx, "setKey", {
				tbl = slice(ctx, target.obj),
				key = slice(ctx, target.key),
				value = valueText,
			})
		end

		if valueText == "nil" then
			return mk(ctx, "clearVar", { name = targetText })
		end

		return mk(ctx, "set", { name = targetText, value = valueText })
end

-- Conditions get their own block when one reads better than a bare `if`.
local function conditionBlock(ctx, cond)
		if cond.k == "binop" then
			local op = cond.op
			local left, right = cond.left, cond.right
			if op == "and" then
				return "ifBoth", { a = slice(ctx, left), b = slice(ctx, right) }
			elseif op == "or" then
				return "ifEither", { a = slice(ctx, left), b = slice(ctx, right) }
			elseif op == "==" or op == "~=" or op == "<" or op == ">"
				or op == "<=" or op == ">=" then
				if op == "==" and isCallTo(left, "typeof") and #left.args == 1 then
					local kind = plainString(right)
					if kind then
						return "ifType", { value = slice(ctx, left.args[1]), type = kind }
					end
				end
				return "ifCompare", { a = slice(ctx, left), op = op, b = slice(ctx, right) }
			end
		elseif cond.k == "unop" and cond.op == "not" then
			return "ifNot", { cond = slice(ctx, cond.operand) }
		elseif cond.k == "call" then
			if isMethodCall(cond, "IsA") and #cond.args == 1 then
				local class = plainString(cond.args[1])
				if class then
					return "ifIsA", { inst = slice(ctx, cond.fn), class = class }
				end
			end
			if isMethodCall(cond, "HasTag") and g.pathOf(cond.fn) == "CollectionService"
				and #cond.args == 2 then
				local tag = plainString(cond.args[2])
				if tag then
					return "ifHasTag", { inst = slice(ctx, cond.args[1]), tag = tag }
				end
			end
			if isCallTo(cond, "table.find") and #cond.args == 2 then
				return "containsValue", {
					list = slice(ctx, cond.args[1]), value = slice(ctx, cond.args[2]),
				}
			end
			if isCallTo(cond, "string.find") and #cond.args == 4
				and cond.args[4].k == "bool" and cond.args[4].value
				and slice(ctx, cond.args[3]) == "1" then
				local needle = plainString(cond.args[2])
				if needle then
					return "containsText", { value = slice(ctx, cond.args[1]), needle = needle }
				end
			end
		end
		return "ifExists", { value = slice(ctx, cond) }
end

local function convertIf(ctx, stmt, clauseIndex)
		clauseIndex = clauseIndex or 1
		local clause = stmt.clauses[clauseIndex]
		local more = stmt.clauses[clauseIndex + 1] ~= nil
		local hasElse = more or (stmt.els ~= nil)

		-- if <cond> then return end  ->  a single-line exit block
		if not hasElse and #clause.body == 1 and clause.body[1].k == "return"
			and #clause.body[1].exprs == 0 then
			local cond = clause.cond
			if cond.k == "unop" and cond.op == "not" then
				return mk(ctx, "guard", { cond = slice(ctx, cond.operand) })
			end
			return mk(ctx, "earlyReturnIf", { cond = slice(ctx, cond) })
		end

		local kind, fields = conditionBlock(ctx, clause.cond)
		local block
		if hasElse then
			-- Only the plain if/else block carries an `otherwise` slot, so a
			-- decorated condition falls back to it with the condition inline.
			local condText = slice(ctx, clause.cond)
			block = mk(ctx, "ifelse", { cond = condText })
			fill(ctx, block, "body", convertList(ctx, clause.body))
			if more then
				fill(ctx, block, "els", { convertIf(ctx, stmt, clauseIndex + 1) })
			else
				fill(ctx, block, "els", convertList(ctx, stmt.els))
			end
			return block
		end

		block = mk(ctx, kind, fields)
		return fill(ctx, block, "body", convertList(ctx, clause.body))
end

local function convertForIn(ctx, stmt)
		local names, exprs = stmt.names, stmt.exprs
		local body = convertList(ctx, stmt.body)

		if #exprs == 1 and #names == 2 then
			local iter = exprs[1]
			if isCallTo(iter, "ipairs") and #iter.args == 1 then
				local listText = slice(ctx, iter.args[1])
				if names[1] == "_" and isMethodCall(iter.args[1], "GetPlayers")
					and g.pathOf(iter.args[1].fn) == "Players" then
					return fill(ctx, mk(ctx, "eachPlayer", { player = names[2] }), "body", body)
				end
				return fill(ctx, mk(ctx, "foripairs",
					{ i = names[1], v = names[2], tbl = listText }), "body", body)
			end
			if isCallTo(iter, "pairs") and #iter.args == 1 then
				return fill(ctx, mk(ctx, "forpairs",
					{ k = names[1], v = names[2], tbl = slice(ctx, iter.args[1]) }), "body", body)
			end
		end

		return fill(ctx, mk(ctx, "forin", {
			names = table.concat(names, ", "),
			iter = string.sub(ctx.src, exprs[1].s, exprs[#exprs].e),
		}), "body", body)
end

local function convertStatement(ctx, stmt)
		local kind = stmt.k

		if kind == "local" then
			return convertLocal(ctx, stmt) or rawBlock(ctx, stmt, "an unusual `local` line")
		elseif kind == "assign" then
			return convertAssign(ctx, stmt) or rawBlock(ctx, stmt, "a multiple assignment")
		elseif kind == "compound" then
			if stmt.op == "+" then
				return mk(ctx, "changeBy", {
					var = slice(ctx, stmt.target), n = slice(ctx, stmt.value),
				})
			end
			return rawBlock(ctx, stmt)
		elseif kind == "call" then
			return convertCallStatement(ctx, stmt)
		elseif kind == "if" then
			return convertIf(ctx, stmt)
		elseif kind == "while" then
			return fill(ctx, mk(ctx, "while", { cond = slice(ctx, stmt.cond) }), "body",
				convertList(ctx, stmt.body))
		elseif kind == "repeat" then
			return fill(ctx, mk(ctx, "repeat", { cond = slice(ctx, stmt.cond) }), "body",
				convertList(ctx, stmt.body))
		elseif kind == "fornum" then
			local body = convertList(ctx, stmt.body)
			if stmt.step then
				return fill(ctx, mk(ctx, "forstep", {
					var = stmt.var, from = slice(ctx, stmt.from),
					to = slice(ctx, stmt.to), step = slice(ctx, stmt.step),
				}), "body", body)
			end
			if stmt.var == "_" and slice(ctx, stmt.from) == "1" then
				return fill(ctx, mk(ctx, "repeatN", { n = slice(ctx, stmt.to) }), "body", body)
			end
			return fill(ctx, mk(ctx, "for", {
				var = stmt.var, from = slice(ctx, stmt.from), to = slice(ctx, stmt.to),
			}), "body", body)
		elseif kind == "forin" then
			return convertForIn(ctx, stmt)
		elseif kind == "do" then
			return fill(ctx, mk(ctx, "doblock", {}), "body", convertList(ctx, stmt.body))
		elseif kind == "localfunc" then
			return fill(ctx, mk(ctx, "def", {
				name = stmt.name, params = paramText(stmt.fn.params),
			}), "body", convertList(ctx, stmt.fn.body))
		elseif kind == "func" then
			local object, method = string.match(stmt.name, "^(.+):([%w_]+)$")
			if object then
				return fill(ctx, mk(ctx, "defMethod", {
					obj = object, name = method, params = paramText(stmt.fn.params),
				}), "body", convertList(ctx, stmt.fn.body))
			end
			return rawBlock(ctx, stmt, "a global function definition")
		elseif kind == "return" then
			if #stmt.exprs == 0 then return mk(ctx, "returnNone", {}) end
			return mk(ctx, "return", {
				value = string.sub(ctx.src, stmt.exprs[1].s, stmt.exprs[#stmt.exprs].e),
			})
		elseif kind == "break" then
			return mk(ctx, "break", {})
		elseif kind == "continue" then
			return mk(ctx, "continue", {})
		elseif kind == "typedef" then
			return rawBlock(ctx, stmt)
		end

		return rawBlock(ctx, stmt, "a statement with no matching block")
end

--=============================================================================
-- comments and lists
--=============================================================================

-- Emits any comments that appear before `limit`, as note blocks.
local function flushComments(ctx, limit, out)
		while ctx.commentAt <= #ctx.comments do
			local comment = ctx.comments[ctx.commentAt]
			if comment.s >= limit then break end
			ctx.commentAt = ctx.commentAt + 1
			if comment.long then
				local block = d.create(ctx.doc, "raw")
				block.f.code = string.sub(ctx.src, comment.s, comment.e)
				out[#out + 1] = block
			else
				local block = d.create(ctx.doc, "comment")
				block.f.text = (string.gsub(comment.text, "^%s", ""))
				out[#out + 1] = block
			end
		end
end

function convertList(ctx, statements)
		local out = {}
		for _, stmt in ipairs(statements or {}) do
			flushComments(ctx, stmt.s, out)
			out[#out + 1] = convertStatement(ctx, stmt)
		end
		if statements and #statements > 0 then
			local last = statements[#statements]
			flushComments(ctx, last.e, out)
		end
		return out
end

--=============================================================================
-- entry point
--=============================================================================

local BANNER = "built with ABlocks"

-- Drops the two-line banner this plugin writes, so re-importing your own
-- exported script does not stack up headers.
local function skipOwnBanner(ctx)
		local first = ctx.comments[1]
		local second = ctx.comments[2]
		if first and second and second.line <= 3
			and string.find(second.text, BANNER, 1, true) then
			ctx.commentAt = 3
			return string.match(first.text, "^%s*(.-)%s*$")
		end
		return nil
end

-- src -> document.  Returns doc, report  (or nil, nil, err on a parse failure).
function h.fromCode(src, name)
		src = string.gsub(src, "\r\n", "\n")
		local chunk, err = g.parse(src)
		if not chunk then
			return nil, nil, err
		end

		local lineStarts = { 1 }
		for offset in string.gmatch(src, "()\n") do
			lineStarts[#lineStarts + 1] = offset + 1
		end

		local doc = d.newDoc(name or "Imported")
		local ctx = {
			src = src, doc = doc, lineStarts = lineStarts,
			comments = chunk.comments, commentAt = 1,
			matched = 0, raw = 0, notes = {},
		}

		local banner = skipOwnBanner(ctx)
		if banner and banner ~= "" and not name then doc.name = banner end

		-- Top level splits into stacks wherever the source left a blank line.
		local groups = {}
		local current = nil
		local previousEnd = nil
		for _, stmt in ipairs(chunk.body) do
			local startLine = stmt.line
			local comment = ctx.comments[ctx.commentAt]
			if comment and comment.s < stmt.s then startLine = comment.line end
			if not current or (previousEnd and startLine > previousEnd + 1) then
				current = {}
				groups[#groups + 1] = current
			end
			current[#current + 1] = stmt
			previousEnd = lineAt(ctx, stmt.e)
		end

		local y = 24
		for _, group in ipairs(groups) do
			local blocks = convertList(ctx, group)
			if #blocks > 0 then
				local stack = d.newStack(doc, 24, y)
				for _, block in ipairs(blocks) do
					d.attachToStack(doc, block, stack, nil, {})
				end
				y = y + 40 * (#blocks + 1)
			end
		end

		-- Trailing comments after the last statement.
		local tail = {}
		flushComments(ctx, #src + 1, tail)
		if #tail > 0 then
			local stack = d.newStack(doc, 24, y)
			for _, block in ipairs(tail) do
				d.attachToStack(doc, block, stack, nil, {})
			end
		end

		return doc, {
			matched = ctx.matched,
			raw = ctx.raw,
			total = ctx.matched + ctx.raw,
			notes = ctx.notes,
			stacks = #doc.stacks,
		}
end

return h
]]></ProtectedString>
			</Properties>
		</Item>
	<Item class="ModuleScript" referent="RBX9">
			<Properties>
				<string name="Name">i</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- i  ·  IntelliSense
--
-- Completion for the text fields inside blocks.  It knows three things a plain
-- word list does not:
--
--   * what you are typing against -- `part.` offers properties, `part:` offers
--     methods and events, and a field that wants a class name offers classes;
--   * what your own document declared -- a `make part = a new Part` block above
--     teaches it that `part` is a Part, so `part.` lists BasePart properties;
--   * how people actually type -- matching is fuzzy and subsequence-based, so
--     "ffc" finds FindFirstChild and "gsv" finds GetService.
--
--   local result = i.complete({ text = "part.Anch", cursor = 9, doc = doc })
--   result.items[1].name  --> "Anchored"

local d = require(script.Parent.d)
local q = require(script.Parent.q)

local i = {}

--=============================================================================
-- API surface
--
-- Members are written as  Name|detail|one-line doc  separated by ';'.
-- Keeping it as text costs one parse at load and keeps the table readable.
--=============================================================================

local function members(kind, text, into)
		for entry in string.gmatch(text or "", "[^;]+") do
			local name, detail, doc = string.match(entry, "^([^|]*)|([^|]*)|?(.*)$")
			if name and name ~= "" then
				into[#into + 1] = {
					name = name, kind = kind, detail = detail ~= "" and detail or nil,
					doc = doc ~= "" and doc or nil,
				}
			end
		end
		return into
end

local CLASSES = {
		Instance = {
			p = "Name|string|What the object is called;Parent|Instance|The object this one sits inside;ClassName|string|The kind of object this is;Archivable|boolean|Whether Clone copies it",
			m = "Destroy|()|Removes the object and everything in it, permanently;Clone|(): Instance|Copies the object and its children;FindFirstChild|(name, recursive?): Instance?|The child with that name, or nil;FindFirstChildOfClass|(class): Instance?|The first child of that class;FindFirstChildWhichIsA|(class): Instance?|The first child of that class or a subclass;FindFirstAncestor|(name): Instance?|Searches upward instead of down;WaitForChild|(name, timeout?): Instance|Pauses until the child exists;GetChildren|(): {Instance}|Everything one level down;GetDescendants|(): {Instance}|Everything below, at any depth;IsA|(class): boolean|True for the class and any it inherits;IsDescendantOf|(ancestor): boolean|True when it sits somewhere below;GetAttribute|(name): any|Reads a custom attribute;SetAttribute|(name, value)|Writes a custom attribute;GetAttributes|(): {[string]: any}|Every attribute at once;GetFullName|(): string|The full path, for printing",
